<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap mp rescap desktop uap5">

  <Identity
    Name="Flyshelf.FlyShelfClipboard"
    Publisher="CN=C2F3380D-0EB4-4864-94C5-F83F2F17646C"
    Version="3.0.7.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="c1ba92ce-7355-4ff8-89e1-6c830457ecdf" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>FlyShelf Clipboard</DisplayName>
    <PublisherDisplayName>Flyshelf</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="FlyShelf"
      Executable="FlyShelf.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="FlyShelf Clipboard"
        Description="Seamless Cross-Device Clipboard — sync text, images, files, and screenshots across all your devices in real-time."
        BackgroundColor="#1A1A2E"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="FlyShelf"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1a1a2e"/>
        <uap:LockScreen Notification="badge" BadgeLogo="Assets\BadgeLogo.png"/>
      </uap:VisualElements>

      <Extensions>
        <!-- Auto-start with Windows (matches StartupHelper.StartupTaskId) -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="FlyShelfStartupTask" Enabled="false" DisplayName="FlyShelf Clipboard Sync"/>
        </desktop:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <!-- Internet access for Firebase sync, Cloudflare discovery, peer connectivity -->
    <Capability Name="internetClient" />
    <!-- Local network server for cross-device clipboard sync (port 8999) -->
    <Capability Name="privateNetworkClientServer" />
    <!-- Full trust required for: P/Invoke (DWM, user32), HttpListener, system tray, clipboard monitoring -->
    <rescap:Capability Name="runFullTrust" />
    <!-- NOTE: systemAIModels removed for initial Store certification (requires separate Microsoft approval) -->
  </Capabilities>

</Package>
