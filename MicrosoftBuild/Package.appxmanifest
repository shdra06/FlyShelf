<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap mp rescap desktop uap5">

  <Identity
    Name="Shivendra.FlyShelf"
    Publisher="CN=Shivendra"
    Version="2.0.1.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="a1b2c3d4-e5f6-7890-abcd-ef1234567890" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>FlyShelf</DisplayName>
    <PublisherDisplayName>Shivendra</PublisherDisplayName>
    <Logo>Assets\StoreLogo.scale-200.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="FlyShelf"
      Executable="FlyShelf.exe"
      EntryPoint="$targetentrypoint$">

      <uap:VisualElements
        DisplayName="FlyShelf"
        Description="Seamless Cross-Device Clipboard — sync text, images, files, and screenshots across all your devices in real-time."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.scale-200.png"
        Square44x44Logo="Assets\Square44x44Logo.scale-200.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.scale-200.png"
          Square310x310Logo="Assets\Square310x310Logo.scale-100.png"
          ShortName="FlyShelf"/>
        <uap:SplashScreen Image="Assets\SplashScreen.scale-200.png" BackgroundColor="#1a1a2e"/>
        <uap:LockScreen Notification="badge" BadgeLogo="Assets\BadgeLogo.scale-200.png"/>
      </uap:VisualElements>

      <Extensions>
        <!-- Auto-start with Windows (matches StartupHelper.StartupTaskId) -->
        <desktop:Extension Category="windows.startupTask" Executable="FlyShelf.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FlyShelfStartupTask" Enabled="false" DisplayName="FlyShelf Clipboard Sync"/>
        </desktop:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <!-- Internet access for Firebase sync, Cloudflare discovery, peer connectivity -->
    <Capability Name="internetClient" />
    <!-- Local network server for cross-device clipboard sync (port 8999) -->
    <Capability Name="privateNetworkClientServer" />
    <!-- Full trust required for: P/Invoke (DWM, user32), HttpListener, system tray, clipboard monitoring -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
