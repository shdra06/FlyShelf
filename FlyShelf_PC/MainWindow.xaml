<controls:MicaWindow x:Class="FlyShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:vm="clr-namespace:FlyShelf.ViewModels"
        xmlns:settings="clr-namespace:FlyShelf.Classes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:local="clr-namespace:FlyShelf.Controls"
        Title="FlyShelf" 
        Width="360" 
        Opacity="0"
        MaxHeight="300" SizeToContent="Manual" MinHeight="100" BorderThickness="0"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" SystemBackdropType="Mica"
        ShowInTaskbar="False" Margin="0" Topmost="True" ShowActivated="False"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" PreviewDragOver="Window_PreviewDragOver"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="MicaWindow_Loaded" Deactivated="MicaWindow_Deactivated">

    <controls:MicaWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Premium Glassmorphism Style for Header Toolbar Buttons -->
            <Style x:Key="PremiumHeaderButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Background" Value="{DynamicResource ThemeHeaderBtnBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeHeaderBtnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeHeaderBtnFg}"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Focusable" Value="False"/>
                <Style.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ThemeHeaderBtnBgColor}"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource ThemeHeaderBtnBorderColor}"/>

                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ThemeHeaderBtnBgHoverColor}"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ThemeHeaderBtnBorderHoverColor}"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeHeaderBtnFgHoverColor}"/>
                    
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource ThemeHeaderBtnBgPressedColor}"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource ThemeHeaderBtnBorderPressedColor}"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource ThemeHeaderBtnFgPressedColor}"/>
                </Style.Resources>
            </Style>


            <!-- Shared ContextMenu cached at Window level to prevent duplicate MenuItem element allocations -->
            <ContextMenu x:Key="CardContextMenu" StaysOpen="True">
                <ContextMenu.Resources>
                    <Style TargetType="Separator">
                        <Setter Property="Margin" Value="8,4"/>
                        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontSize" Value="12.5"/>
                    </Style>
                </ContextMenu.Resources>

                <!-- ═══ Universal: Pin / Unpin ═══ -->
                <MenuItem Header="{Binding PlacementTarget.DataContext.PinLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                <!-- ═══ Universal: Copy Content ═══ -->
                <MenuItem Header="Copy to Clipboard" 
                          Command="{Binding PlacementTarget.Tag.CopyRawContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                <Separator />

                <!-- ═══ TEXT / CODE Actions ═══ -->
                <MenuItem Header="🔍 Search on Google" Click="GoogleSearch_Click" 
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsTextPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 🔒 Mark as Password -->
                <MenuItem Header="🔒 Mark as Password" Click="MarkAsPassword_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.CanConvertToPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 🔑 View/Edit Password -->
                <MenuItem Header="🔑 View/Edit Password" Click="ViewEditPassword_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ✏️ Rename Label -->
                <MenuItem Header="✏️ Rename Label" Click="RenamePasswordLabel_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Revert to Normal Text -->
                <MenuItem Header="Revert to Normal Text" Click="RevertToText_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ CODE: VS Code + Terminal ═══ -->
                <MenuItem Header="Open in VS Code" 
                          Command="{Binding PlacementTarget.Tag.LaunchSandboxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Run in Terminal" 
                          Command="{Binding PlacementTarget.Tag.LaunchTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Compile C++ &amp; Run" 
                          Command="{Binding PlacementTarget.Tag.CompileNativeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsCPlusPlusPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ IMAGE: OCR Extract + Gemini Table ═══ -->
                <MenuItem Header="Extract Text (OCR)" 
                          Command="{Binding PlacementTarget.Tag.ExtractTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="📊 Extract Table Data" 
                          Command="{Binding PlacementTarget.Tag.ExtractTableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Foreground="{DynamicResource GeminiAccentColor}"
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Convert Image to PDF" 
                          Command="{Binding PlacementTarget.Tag.ConvertImageToPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Scan QR Code" 
                          Command="{Binding PlacementTarget.Tag.ManualScanQRCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Foreground="{DynamicResource GeminiAccentColor}"
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ PDF: Open + Convert ═══ -->
                <MenuItem Header="Open PDF in Browser" 
                          Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsPdfPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Convert PDF to Word" Click="ConvertPdfToWord_Click" 
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPdfPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ DOCUMENT: Convert to PDF ═══ -->
                <MenuItem Header="Convert to PDF" 
                          Command="{Binding PlacementTarget.Tag.ConvertDocumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsDocPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ URL: Open in Browser ═══ -->
                <MenuItem Header="Open in Browser" 
                          Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsUrlPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Separator />

                <!-- ═══ FILE-BACKED: Rename ═══ -->
                <MenuItem Header="✏️ Rename" Click="RenameItem_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.CanRename, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ FILE-BACKED: Show in Explorer ═══ -->
                <MenuItem Header="Show in Explorer" 
                          Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.CanShowInExplorer, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>



                <!-- ═══ Universal: Delete ═══ -->
                <MenuItem Header="Delete" Click="DeleteContextMenu_Click" Foreground="{DynamicResource DangerColor}"/>
            </ContextMenu>
        </ResourceDictionary>
    </controls:MicaWindow.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CornerRadius="14" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Border CornerRadius="14" ClipToBounds="True">
    <Grid x:Name="RootContent" Margin="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ WALLPAPER LAYERS (hidden when no wallpaper set) ═══ -->
        <!-- Layer 1: Full background image (center, fills entire window) -->
        <Image x:Name="WallpaperBg" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.42"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <!-- Layer 2: Theme color gradient overlay emanating from center -->
        <Border x:Name="WallpaperThemeOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush x:Name="WallpaperRadialBrush" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#60000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Layer 3: Frosted glass header — subtle blur with smooth fade-out -->
        <Border x:Name="WallpaperFrostHeader" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                ClipToBounds="True" CornerRadius="12,12,0,0" Height="90" VerticalAlignment="Top">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC000000" Offset="0"/>
                    <GradientStop Color="#66000000" Offset="0.35"/>
                    <GradientStop Color="#22000000" Offset="0.65"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid>
                <Image x:Name="WallpaperFrostImg" Stretch="UniformToFill" Opacity="0.15"
                       RenderOptions.BitmapScalingMode="LowQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- Subtle tinted glass overlay -->
                <Border x:Name="WallpaperFrostTint" Background="#18000000"/>
            </Grid>
        </Border>

        <tray:NotifyIcon
            FocusOnLeftClick="False"
            Icon="pack://application:,,,/Resources/FlyShelfLogo.ico"
            MenuOnRightClick="True"
            LeftClick="nIcon_LeftClick"
            TooltipText="FlyShelf">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Open Clipboard  (Alt+C)" Click="TrayOpenClipboard_Click" />
                    <MenuItem Header="Open FlyShelf Hub" Click="TrayOpenHub_Click" />
                    <Separator />
                    <MenuItem Header="Quit FlyShelf" Click="NotifyIconQuit_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
        
        <StackPanel Grid.Row="0" x:Name="HeaderAndFiltersStack">
            <Grid x:Name="TopHeaderGrid" Margin="14,14,14,8" Background="#01000000" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <!-- Inline Search Bar (covers the left area up to the search icon) -->
                <Border x:Name="SearchBarContainer" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Center"
                        Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="8"
                        BorderThickness="1"
                        Padding="4,0,4,0" Margin="0,0,6,0" Height="32" MinWidth="200" HorizontalAlignment="Stretch"
                        Panel.ZIndex="10" PreviewMouseLeftButtonDown="SearchBar_PreviewMouseDown"
                        RenderTransformOrigin="1,0.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderStrong}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Search input with integrated placeholder -->
                        <TextBox x:Name="SearchTextBox" Grid.Column="0" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                                 FontSize="13" VerticalAlignment="Center" VerticalContentAlignment="Center" 
                                 CaretBrush="{DynamicResource ThemeAccent}" Padding="0" Margin="0"
                                 HorizontalContentAlignment="Left" MinWidth="120"
                                 TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid Background="Transparent">
                                                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="-2,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                    <TextBlock x:Name="PlaceholderText" Text="Search clipboard..." 
                                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                                               VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False" Margin="0"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- Clear search button -->
                        <ui:Button Grid.Column="1" Focusable="False" Appearance="Transparent" Foreground="{DynamicResource SubtleTextColor}" Click="ClearSearch_Click" ToolTip="Clear Search" 
                                   Margin="2,0,0,0" Padding="4,4" CornerRadius="6" Width="24" Height="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                   Background="Transparent" BorderThickness="0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss12" FontSize="10"/></ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>
                
                <Grid Grid.Column="1" HorizontalAlignment="Right">
                    <!-- Layer 1: Toolbar buttons (hidden when search is active) -->
                    <StackPanel x:Name="ToolbarButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    
                        <!-- Search Toggle -->
                        <ui:Button x:Name="SearchToggleBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="SearchToggle_Click" ToolTip="Search Clipboard (Ctrl+F)" Margin="0,0,6,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Search24" /></ui:Button.Icon>
                        </ui:Button>
 
                         <!-- Bouncy Drag Drop Arrow Indicator — borderless, appears only when dragging -->
                         <Grid Width="28" Height="28" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                             <Grid.Style>
                                 <Style TargetType="Grid">
                                     <Setter Property="Visibility" Value="Collapsed"/>
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding IsDragHovering, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                             <Setter Property="Visibility" Value="Visible"/>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </Grid.Style>
                             <ui:SymbolIcon Symbol="ArrowDown24" Foreground="{DynamicResource SyncIncomingColor}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                 <ui:SymbolIcon.RenderTransform>
                                     <TranslateTransform x:Name="ArrowTranslate" Y="0"/>
                                 </ui:SymbolIcon.RenderTransform>
                                 <ui:SymbolIcon.Style>
                                     <Style TargetType="ui:SymbolIcon">
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsDragHovering, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                 <DataTrigger.EnterActions>
                                                     <BeginStoryboard x:Name="BounceArrowStory">
                                                         <Storyboard RepeatBehavior="Forever">
                                                             <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                              From="-4" To="4" Duration="0:0:0.6" AutoReverse="True">
                                                                 <DoubleAnimation.EasingFunction>
                                                                     <SineEase EasingMode="EaseInOut"/>
                                                                 </DoubleAnimation.EasingFunction>
                                                             </DoubleAnimation>
                                                         </Storyboard>
                                                     </BeginStoryboard>
                                                 </DataTrigger.EnterActions>
                                                 <DataTrigger.ExitActions>
                                                     <StopStoryboard BeginStoryboardName="BounceArrowStory"/>
                                                 </DataTrigger.ExitActions>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </ui:SymbolIcon.Style>
                             </ui:SymbolIcon>
                         </Grid>
 
                         <!-- Quick Notes Toggle -->
                         <ui:Button x:Name="NotesToggleBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="NotesToggle_Click" ToolTip="Quick Notes" Margin="0,0,6,0">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#288B5CF6"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#608B5CF6"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="List24" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- To-Do List Toggle -->
                         <ui:Button x:Name="TodoToggleBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="TodoToggle_Click" ToolTip="To-Do List" Margin="0,0,6,0">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#288B5CF6"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#608B5CF6"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="TaskListSquareLtr24" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- Sort/Filter by Category -->
                         <ui:Button x:Name="SortFilterBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="SortFilter_Click" ToolTip="Filter by Category" Margin="0,0,6,0">
                             <ui:Button.Icon><ui:FontIcon Glyph="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- Stopwatch Button (only visible in To-Do list mode) -->
                         <ui:Button x:Name="TodoStopwatchBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="TodoStopwatch_Click" ToolTip="Stopwatch Timer" Margin="0,0,6,0" Visibility="Collapsed">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#288B5CF6"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#608B5CF6"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:Button.Icon>
                         </ui:Button>

                          <!-- More Options Button -->
                          <ui:Button x:Name="MoreBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="MoreBtn_Click" ToolTip="More Options" Margin="0,0,6,0" Visibility="Collapsed">
                              <ui:Button.Icon><ui:SymbolIcon Symbol="MoreHorizontal24" /></ui:Button.Icon>
                          </ui:Button>

                          <!-- ═══ Update Available Badge ═══ -->
                          <Border x:Name="UpdateBadge" Visibility="Collapsed" Cursor="Hand"
                                  CornerRadius="8" Margin="0,0,6,0" Padding="6,4" VerticalAlignment="Center"
                                  MouseLeftButtonDown="UpdateBadge_Click"
                                  ToolTip="Update available — click to open Hub">
                              <Border.Background>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                      <GradientStop Color="#2810B981" Offset="0"/>
                                      <GradientStop Color="#1834D399" Offset="1"/>
                                  </LinearGradientBrush>
                              </Border.Background>
                              <Border.BorderBrush>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                      <GradientStop Color="#5010B981" Offset="0"/>
                                      <GradientStop Color="#3034D399" Offset="1"/>
                                  </LinearGradientBrush>
                              </Border.BorderBrush>
                              <Border.BorderThickness>1</Border.BorderThickness>
                              <StackPanel Orientation="Horizontal">
                                  <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                  <TextBlock x:Name="UpdateBadgeText" Text="Update" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>
                              </StackPanel>
                          </Border>

                          <ui:Button Style="{StaticResource PremiumHeaderButtonStyle}" Click="CloseWindow_Click" ToolTip="Hide (Esc)">
                              <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" Filled="True"/></ui:Button.Icon>
                          </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Dynamic Inline Category Filter Panel — Premium Pill Chips -->
            <Border x:Name="SortFilterInlineBar" Margin="14,0,14,8" Visibility="Collapsed" Opacity="0"
                    CornerRadius="14" Padding="6,5"
                    Background="{DynamicResource MicaWPF.Brushes.SmokeFillColorDefault}"
                    BorderBrush="#12000000" BorderThickness="1"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#000000" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Images Chip -->
                    <Border x:Name="FilterBtn_Images" CornerRadius="10" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="Images"
                            Background="{DynamicResource FilterImageBg}"
                            BorderBrush="{DynamicResource FilterImageBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Image24" Foreground="{DynamicResource TypeImageColor}" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Images" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pinned Chip -->
                    <Border x:Name="FilterBtn_Pinned" CornerRadius="10" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="Pinned"
                            Background="{DynamicResource FilterPinnedBg}"
                            BorderBrush="{DynamicResource FilterPinnedBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Pin24" Foreground="{DynamicResource PinActiveColor}" Filled="True" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Pinned" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF Chip -->
                    <Border x:Name="FilterBtn_Pdf" CornerRadius="10" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="PDF"
                            Background="{DynamicResource FilterPdfBg}"
                            BorderBrush="{DynamicResource FilterPdfBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="{DynamicResource DangerColor}" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="PDF" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Docs Chip -->
                    <Border x:Name="FilterBtn_Docs" CornerRadius="10" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="Docs"
                            Background="{DynamicResource FilterDocsBg}"
                            BorderBrush="{DynamicResource FilterDocsBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Document24" Foreground="{DynamicResource InfoColor}" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Docs" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Width="1" Height="20" Margin="3,0" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" VerticalAlignment="Center"/>

                    <!-- Dismiss Chip -->
                    <Border CornerRadius="10" Margin="1,0" Cursor="Hand" MouseLeftButtonDown="FilterClear_Click"
                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                            Padding="6,5" SnapsToDevicePixels="True" ToolTip="Clear Filter">
                        <ui:SymbolIcon Symbol="Dismiss16" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Sync Direction Control Bar — Inline popup for granular incoming/outgoing toggles -->
            <Border x:Name="SyncDirectionBar" Margin="14,0,14,8" Visibility="Collapsed" Opacity="0"
                    CornerRadius="10" Padding="4"
                    Background="{DynamicResource MicaWPF.Brushes.SmokeFillColorDefault}" 
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <UniformGrid Rows="1" HorizontalAlignment="Center" MaxWidth="420" Width="{Binding ActualWidth, ElementName=TopHeaderGrid}">
                    <!-- Incoming Toggle -->
                    <Border x:Name="SyncBtn_Incoming" CornerRadius="7" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncIncoming_Click" Tag="Incoming"
                            Background="{DynamicResource SyncIncomingBg}" BorderBrush="{DynamicResource SyncIncomingBorder}" BorderThickness="1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource SyncIncomingColor}" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="In" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse x:Name="SyncDot_Incoming" Grid.Column="1" Width="8" Height="8" Margin="6,0,2,0" VerticalAlignment="Center"
                                     Fill="#33888888" Stroke="#22FFFFFF" StrokeThickness="0.5"/>
                        </Grid>
                    </Border>
                    <!-- Outgoing Toggle -->
                    <Border x:Name="SyncBtn_Outgoing" CornerRadius="7" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncOutgoing_Click" Tag="Outgoing"
                            Background="{DynamicResource SyncOutgoingBg}" BorderBrush="{DynamicResource SyncOutgoingBorder}" BorderThickness="1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowUpload24" Foreground="{DynamicResource InfoColor}" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="Out" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse x:Name="SyncDot_Outgoing" Grid.Column="1" Width="8" Height="8" Margin="6,0,2,0" VerticalAlignment="Center"
                                     Fill="#33888888" Stroke="#22FFFFFF" StrokeThickness="0.5"/>
                        </Grid>
                    </Border>
                    <!-- Both Master Toggle -->
                    <Border x:Name="SyncBtn_Both" CornerRadius="7" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncBoth_Click" Tag="Both"
                            Background="{DynamicResource SyncBothBg}" BorderBrush="{DynamicResource SyncBothBorder}" BorderThickness="1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource TypeTextColor}" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="Both" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse x:Name="SyncDot_Both" Grid.Column="1" Width="8" Height="8" Margin="6,0,2,0" VerticalAlignment="Center"
                                     Fill="#33888888" Stroke="#22FFFFFF" StrokeThickness="0.5"/>
                        </Grid>
                    </Border>
                    <!-- Dismiss -->
                    <Border CornerRadius="7" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncBarDismiss_Click"
                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" Padding="0,5">
                        <ui:SymbolIcon Symbol="Dismiss16" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                </UniformGrid>
            </Border>


            <!-- Floating Overflow Menu Popup -->
            <Popup x:Name="OverflowPopup" PlacementTarget="{x:Reference MoreBtn}" 
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" 
                   VerticalOffset="8" HorizontalOffset="-72" PopupAnimation="Fade"
                   Closed="OverflowPopup_Closed">
                <!-- Floating Glassmorphism Container with Premium Toolbar Look -->
                <Border CornerRadius="16" Padding="0" BorderThickness="1"
                        Background="{DynamicResource ThemeOverflowBg}"
                        BorderBrush="{DynamicResource ThemeOverflowBorder}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource ThemeOverflowShadowColor}"/>
                    </Border.Effect>
                    <!-- Inner glow border for depth -->
                    <Border CornerRadius="15" Padding="8,6" BorderThickness="1"
                            BorderBrush="#0AFFFFFF" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <!-- Emoji Picker -->
                        <ui:Button x:Name="EmojiBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="EmojiPicker_Click" ToolTip="Emoji Picker" Margin="0,0,4,0" Padding="0">
                            <emoji:TextBlock Text="😊" FontSize="16" 
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Margin="0,-1,0,0"/>
                        </ui:Button>

                        <!-- Merge PDF button — hidden by default, replaces emoji space when PDFs selected -->
                        <ui:Button x:Name="MergePdfToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Visibility="Collapsed" Click="MergeSelectedPdfsBtn_Click" ToolTip="Merge Selected PDFs" Margin="0,0,4,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentCopy24"/></ui:Button.Icon>
                        </ui:Button>
                        
                        <!-- Global Sync Toggle -->
                        <ui:Button x:Name="SyncToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ToggleGlobalSync_Click" ToolTip="Toggle All Sync" Margin="0,0,4,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" Filled="True"/></ui:Button.Icon>
                        </ui:Button>

                        <!-- Unpin toolbar button — hidden by default, replaces sync space when pinned items selected -->
                        <ui:Button x:Name="UnpinToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Visibility="Collapsed" Click="UnpinSelectedBtn_Click" ToolTip="Unpin Selected Items" Margin="0,0,4,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="PinOff24"/></ui:Button.Icon>
                        </ui:Button>

                        <!-- Shortcuts Button -->
                        <ui:Button x:Name="ShortcutsToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ShortcutsBtn_Click" ToolTip="Text Shortcuts" Margin="0,0,4,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Rocket24" /></ui:Button.Icon>
                        </ui:Button>

                        <!-- Reminders Button -->
                        <ui:Button x:Name="ReminderToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ReminderBtn_Click" ToolTip="Reminders" Margin="0,0,4,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Alert24" /></ui:Button.Icon>
                        </ui:Button>

                        <!-- Clear Shelf Button -->
                        <ui:Button x:Name="ClearAllToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ClearAllToolbar_Click" ToolTip="Clear Shelf (Delete Unpinned)" Margin="0,0,4,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24"/></ui:Button.Icon>
                        </ui:Button>

                        <!-- Open Settings Hub -->
                        <ui:Button x:Name="OpenSettingsBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="OpenApp_Click" ToolTip="Open Hub (Settings)">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    </Border>
                </Border>
            </Popup>

            <!-- Clear Shelf Confirmation Popup (same style as SortFilterInlineBar) -->
            <Border x:Name="ClearConfirmPanel" Margin="14,0,14,8" Visibility="Collapsed" Opacity="0"
                    CornerRadius="10" Padding="8,6"
                    Background="{DynamicResource MicaWPF.Brushes.SmokeFillColorDefault}" 
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource WarningColor}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Clear all clips?" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                    <!-- Confirm button (red danger pill) -->
                    <Border CornerRadius="7" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="ClearShelf_Confirm"
                            Background="#28EF4444" BorderBrush="#40EF4444" BorderThickness="1" Padding="12,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource DangerColor}" Filled="True" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock Text="Confirm" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Cancel button (neutral pill) -->
                    <Border CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="ClearShelf_Cancel"
                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" Padding="12,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Dismiss24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock Text="Cancel" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ MASCOT THEME OVERLAYS ═══ -->
        <!-- Header Mascot: beside the search icon (top-right of toolbar) -->
        <Canvas Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="42" Height="42" Margin="8,6,0,0" Panel.ZIndex="20" IsHitTestVisible="False">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Hide mascot when search bar is visible -->
                        <DataTrigger Binding="{Binding ElementName=SearchBarContainer, Path=Visibility}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <local:SpriteAnimator x:Name="MascotIdle" 
                                  SpriteWidth="42" SpriteHeight="42"
                                  Width="42" Height="42"/>
        </Canvas>

        <!-- Premium frosted veil — subtly dims the Mica/wallpaper backdrop for crisp content readability -->
        <Border Grid.RowSpan="2" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="#000000" Opacity="0.12" />
            </Border.Background>
        </Border>

        <ListView Name="ShelfListView" Grid.Row="1" ItemsSource="{Binding DroppedItems}" Background="#01000000" BorderThickness="0" Margin="12,0,2,12" Padding="0,0,0,250"
                  Focusable="True" KeyboardNavigation.DirectionalNavigation="Contained" FocusVisualStyle="{x:Null}"
                  UseLayoutRounding="True" SnapsToDevicePixels="True"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="ClearType"
                  TextOptions.TextHintingMode="Auto"
                  RenderOptions.ClearTypeHint="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.CacheLength="3,2"
                  VirtualizingPanel.CacheLengthUnit="Page"
                  SelectionMode="Extended" MouseMove="ShelfListView_MouseMove" PreviewMouseLeftButtonDown="ShelfListView_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="ShelfListView_PreviewMouseLeftButtonUp"
                  MouseDoubleClick="ShelfListView_MouseDoubleClick" SelectionChanged="ShelfListView_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  AlternationCount="10"
                  PreviewKeyDown="ShelfListView_KeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Focusable" Value="True"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                        BorderThickness="0" CornerRadius="14" Margin="4,1,14,2">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <ControlTemplate.Triggers>

                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!-- NOTE: Loaded animation REMOVED — virtualization recycling fires Loaded on every scroll, causing severe lag -->
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Name="CardBorder" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="14" Margin="0" Padding="0" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource MicaWPF.Colors.SubtleFillColorSecondary}" Opacity="0.38" />
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Opacity" Value="1" />
                                <!-- NOTE: Loaded animation REMOVED — virtualization recycling causes lag -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="-2" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform Y="0"/>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>

                        <Grid>


                            <!-- Inner highlight border for frosted glass effect -->
                            <Border Name="InnerHighlightBorder" BorderThickness="1" CornerRadius="14" Padding="12">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{DynamicResource MicaWPF.Colors.ControlStrokeColorDefault}" Offset="0.0"/>
                                        <GradientStop Color="Transparent" Offset="0.08"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            <Grid Name="ItemGrid" HorizontalAlignment="Stretch" Background="Transparent" Tag="{Binding DataContext, ElementName=ShelfListView}" ContextMenu="{StaticResource CardContextMenu}">
                                <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>




                            <!-- Inline Action Buttons — compact individual pills (hover reveals) -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Panel.ZIndex="5" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.AllowHover, ElementName=ShelfListView}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel.Resources>
                                    <Style x:Key="ActionPillStyle" TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Background" Value="{DynamicResource ActionPillBg}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ActionPillBorder}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </StackPanel.Resources>

                                <!-- ═══ Smart Action ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSmartAction}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorLight1}" PreviewMouseLeftButtonDown="SmartActionSpecific_Click">
                                        <ui:Button.ToolTip><ToolTip Content="{Binding SmartActionName}" /></ui:Button.ToolTip>
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="14">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Flash24"/><Setter Property="Filled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="CompileAndRun"><Setter Property="Symbol" Value="Play24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF"><Setter Property="Symbol" Value="Document24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="ConvertToPdf"><Setter Property="Symbol" Value="DocumentPdf24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="JoinMeeting"><Setter Property="Symbol" Value="Video24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenBrowser"><Setter Property="Symbol" Value="Globe24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="SetTimer"><Setter Property="Symbol" Value="Clock24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenMap"><Setter Property="Symbol" Value="Map24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="CopyQRText"><Setter Property="Symbol" Value="Copy24"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Run Script ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SyncIncomingColor}" PreviewMouseLeftButtonDown="RunTerminalSpecific_Click" ToolTip="Run Script">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Open File ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource DeviceLaptopColor}" PreviewMouseLeftButtonDown="OpenSpecific_Click" ToolTip="Open">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Open24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Show in Explorer ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Group"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource PinActiveColor}" ToolTip="Show in Explorer"
                                               PreviewMouseLeftButtonDown="OpenExplorer_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Open Folder (Folder only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Folder"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource PinActiveColor}" ToolTip="Open Folder"
                                               PreviewMouseLeftButtonDown="OpenExplorer_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Convert to .zip (Group/Folder only, no zip yet) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource CyanAccentColor}" ToolTip="Convert to .zip"
                                               PreviewMouseLeftButtonDown="ConvertToZip_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderZip24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Sync via LAN (Group/Folder with zip ready) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SuccessColor}" ToolTip="Sync via LAN"
                                               PreviewMouseLeftButtonDown="SyncZipLan_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Send24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Convert Image to PDF ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border CornerRadius="5" Cursor="Hand" Padding="4,3" Background="Transparent"
                                            PreviewMouseLeftButtonDown="ConvertImageToPdfSpecific_Click" ToolTip="Convert Image to PDF">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#18FF6666"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon Symbol="DocumentPdf24" Filled="True" FontSize="14" Foreground="{DynamicResource DangerColor}"/>
                                    </Border>
                                </Border>

                                <!-- ═══ Quick Look ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource TypeImageColor}" PreviewMouseLeftButtonDown="QuickLookSpecific_Click" ToolTip="Quick Look">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Search Google ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <!-- Hide search for password items -->
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SyncIncomingColor}" ToolTip="Search on Google"
                                               PreviewMouseLeftButtonDown="GoogleSearchSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Search24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Peek Password (Password only — replaces Search) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource WarningColor}" ToolTip="Peek password (5s)"
                                               PreviewMouseLeftButtonDown="PeekPasswordSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Sanitize URL (Url only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Url">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SanitizeColor}" ToolTip="Sanitize URL (Remove trackers)"
                                               PreviewMouseLeftButtonDown="SanitizeUrlSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Shield24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Protect/Make Password (Text only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanConvertToPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource WarningColor}" ToolTip="Protect as Password"
                                               PreviewMouseLeftButtonDown="MakePasswordSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Key24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Pin/Unpin ═══ -->
                                <Border Style="{StaticResource ActionPillStyle}" Margin="0,0,2,0" Padding="0">
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" PreviewMouseLeftButtonDown="PinSpecific_Click" ToolTip="{Binding PinLabel}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="14">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Pin24"/><Setter Property="Filled" Value="True"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Symbol" Value="PinOff24"/>
                                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Rename Password (Password Card only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource WarningColor}" ToolTip="Rename Password Label"
                                               PreviewMouseLeftButtonDown="RenamePasswordSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Edit24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Delete ═══ -->
                                <Border Style="{StaticResource ActionPillStyle}" Padding="0">
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource DangerColor}" PreviewMouseLeftButtonDown="DeleteSpecific_Click" ToolTip="Delete">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                            </StackPanel>

                            <!-- Standard File Icon (Images, Zips) -->
                            <Border Name="IconBorder" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                                    CornerRadius="8" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ItemType}" Value="Text"/>
                                                    <Condition Binding="{Binding IsPassword}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Url">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Code">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Name="ItemIcon" Source="{Binding Icon}" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGifPreview}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image Name="GifItemIcon" gif:AnimationBehavior.SourceUri="{Binding GifFilePath}" gif:AnimationBehavior.RepeatBehavior="Forever" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding IsGifPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                             <!-- Image Placeholder — shown when Icon hasn't loaded yet for image items -->
                             <Border Name="ImagePlaceholderBorder">
                                 <Border.Style>
                                     <Style TargetType="Border">
                                         <Setter Property="Grid.Row" Value="0"/>
                                         <Setter Property="Grid.Column" Value="0"/>
                                         <Setter Property="Width" Value="40"/>
                                         <Setter Property="Height" Value="40"/>
                                         <Setter Property="Margin" Value="0,0,12,0"/>
                                         <Setter Property="CornerRadius" Value="8"/>
                                         <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                         <Setter Property="Visibility" Value="Collapsed"/>
                                         <Style.Triggers>
                                             <!-- Show only when Icon is null AND item is an Image -->
                                             <MultiDataTrigger>
                                                 <MultiDataTrigger.Conditions>
                                                     <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                     <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                 </MultiDataTrigger.Conditions>
                                                 <Setter Property="Visibility" Value="Visible"/>
                                             </MultiDataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Border.Style>
                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                     <TextBlock Text="🖼" FontSize="22" HorizontalAlignment="Center"/>
                                     <TextBlock Text="Image" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"
                                                HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                 </StackPanel>
                             </Border>

                            <!-- ═══ Rotate Image — round floating button, bottom-right of icon ═══ -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Margin="0,0,-6,10" Panel.ZIndex="8" Focusable="False"
                                    Tag="RotateImage" PreviewMouseLeftButtonDown="RotateImageSpecific_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="26" Height="26" CornerRadius="13"
                                                            Background="{DynamicResource ThemeOverlayButtonBg}" BorderBrush="{DynamicResource ThemeOverlayBorderStrong}" BorderThickness="1"
                                                            ToolTip="Rotate 90°">
                                                        <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="13" Foreground="{DynamicResource TypeGroupColor}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                              <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.AllowHover, ElementName=ShelfListView}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="1"/>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                             </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- PDF Merge Toggle — top-left of icon, PDF only. Uses Button to avoid ListView CheckBox conflicts -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Margin="-4,-4,0,0" Panel.ZIndex="10" Focusable="False"
                                    Tag="PdfMergeToggle" Click="PdfMergeToggle_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="26" Height="26" Background="Transparent">
                                                        <!-- Unchecked state: dark rounded square with red border -->
                                                        <Border x:Name="UncheckedBg" Width="22" Height="22" CornerRadius="6"
                                                                Background="#80181818" BorderBrush="#60EF4444" BorderThickness="1.5"/>
                                                        <!-- Checked state: solid red with checkmark -->
                                                        <Border x:Name="CheckedBg" Width="22" Height="22" CornerRadius="6"
                                                                Background="#EF4444" BorderBrush="#EF4444" BorderThickness="1.5" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="CheckMark" Text="✓" FontSize="13" FontWeight="Bold"
                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="0,-1,0,0" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckedForMerge}" Value="True">
                                                            <Setter TargetName="UncheckedBg" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="CheckedBg" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="UncheckedBg" Property="BorderBrush" Value="#EF4444"/>
                                                            <Setter TargetName="UncheckedBg" Property="Background" Value="#40EF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Show on hover for PDF -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <!-- Show on hover for Document -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <!-- Show on hover for Image -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Circular Expand/Collapse Chevron Toggle Button for Long Text / Code cards -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Margin="-4,-4,0,0" Panel.ZIndex="10" Focusable="False"
                                    PreviewMouseLeftButtonDown="ExpandToggleSpecific_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- 26x26 container with interactive circular border -->
                                                    <Grid Width="26" Height="26" Background="Transparent">
                                                        <Border x:Name="CircleBorder" Width="22" Height="22" CornerRadius="11"
                                                                Background="{DynamicResource ChevronBg}" BorderBrush="{DynamicResource ChevronBorder}" BorderThickness="1.5">
                                                            <!-- PERF: DropShadowEffect removed — was per-item software shader -->
                                                            <!-- Toggle Icon: Blue chevron down when collapsed, Red chevron up when expanded -->
                                                            <ui:SymbolIcon x:Name="ChevronIcon" Symbol="ChevronDown24" FontSize="13" Foreground="{DynamicResource InfoColor}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0.5,0,0"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronUp24"/>
                                                            <Setter TargetName="ChevronIcon" Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CircleBorder" Property="Background" Value="#E62C2C32"/>
                                                            <Setter TargetName="CircleBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLongText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Semantic Icon Fallback — only shown when system Icon is NOT available -->
                            <Border Name="SemanticIconBorder" Grid.Row="0" Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="10" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <!-- Only show the generic semantic icon when no system icon is available -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Code"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Archive"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Document"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Presentation"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Video"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Audio"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Pdf"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="File"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            
                                            <!-- Hide generic fallback icon if color is detected -->
                                            <DataTrigger Binding="{Binding HasDetectedColor}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon FontSize="20" Filled="True">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Document24" />
                                            <Setter Property="Foreground" Value="#60A5FA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Code">
                                                    <Setter Property="Symbol" Value="Code24"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive">
                                                    <Setter Property="Symbol" Value="FolderZip24"/>
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Group">
                                                    <Setter Property="Symbol" Value="FolderMultiple24"/>
                                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="Document24"/>
                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="DocumentPdf24"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUrlPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="Globe24"/>
                                                    <Setter Property="Foreground" Value="#0EA5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation">
                                                    <Setter Property="Symbol" Value="Document24"/>
                                                    <Setter Property="Foreground" Value="#F97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video">
                                                    <Setter Property="Symbol" Value="VideoClip24"/>
                                                    <Setter Property="Foreground" Value="#8B5CF6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio">
                                                    <Setter Property="Symbol" Value="MusicNote124"/>
                                                    <Setter Property="Foreground" Value="#EC4899"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Folder">
                                                    <Setter Property="Symbol" Value="Folder24"/>
                                                    <Setter Property="Foreground" Value="#EAB308"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>

                            <!-- Color Swatch Premium Preview — shown when a HEX, RGB, or HSL color is detected -->
                            <Border Name="ColorSwatchBorder" Grid.Row="0" Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                                    Background="{Binding DetectedColorBrush}" CornerRadius="10" 
                                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDetectedColor}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Sender Badge — Top-right corner overlay -->
                            <StackPanel Name="SenderBadge" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Panel.ZIndex="4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SourceDeviceName}" Value="Local">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                    <Border CornerRadius="6" Padding="5,2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="10" Margin="0,0,3,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Laptop24" />
                                                    <Setter Property="Foreground" Value="#60A5FA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceDeviceType}" Value="Mobile">
                                                            <Setter Property="Symbol" Value="Phone24"/>
                                                            <Setter Property="Foreground" Value="#A78BFA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding SourceDeviceName}" Foreground="{DynamicResource SubtleTextColor}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="·" Foreground="{DynamicResource SeparatorDotColor}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☁️ Cloud"/>
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="Cloudflare">
                                                            <Setter Property="Text" Value="🌐 Cloudflare"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="LAN">
                                                            <Setter Property="Text" Value="📡 LAN"/>
                                                            <Setter Property="Foreground" Value="#6366F1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="ForceSend">
                                                            <Setter Property="Text" Value="🎯 Direct"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="Local">
                                                            <Setter Property="Text" Value="📋 Local"/>
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- The Text Body -->
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Name="TitleText" 
                                           Text="{Binding FileName}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" FontWeight="SemiBold" FontSize="13" LineHeight="19" TextWrapping="Wrap" 
                                           TextTrimming="CharacterEllipsis" MaxHeight="{Binding CollapsedMaxHeight}" />
                                
                                <!-- File Transfer / Download Progress Panel -->
                                <StackPanel Margin="0,4,0,0" Visibility="{Binding IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Height="4" Foreground="{DynamicResource SyncIncomingColor}" Background="#15FFFFFF" BorderThickness="0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding TransferStatusText}" FontSize="10.5" Foreground="{DynamicResource SyncIncomingColor}" Margin="0,3,0,0" FontWeight="Medium" Opacity="0.9"/>
                                </StackPanel>

                                <!-- Inline Audio Player Panel -->
                                <Grid Margin="0,6,0,2" Visibility="{Binding IsAudioPreview, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Play/Pause Button -->
                                    <ui:Button Grid.Column="0" Focusable="False" Padding="6" CornerRadius="18" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Command="{Binding PlayPauseAudioCommand}" Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="18">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Play24"/>
                                                        <Setter Property="Filled" Value="True"/>
                                                        <Setter Property="Foreground" Value="#EC4899"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAudioPlaying}" Value="True">
                                                                <Setter Property="Symbol" Value="Pause24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <!-- Progress Slider -->
                                    <Slider Grid.Column="1" Value="{Binding AudioPosition, Mode=TwoWay}" Maximum="{Binding AudioDuration}" Minimum="0"
                                            VerticalAlignment="Center" Height="22" Focusable="False" Foreground="#EC4899"/>

                                    <!-- Time indicator text -->
                                    <TextBlock Grid.Column="2" Text="{Binding AudioPlaybackText}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"
                                               FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                </Grid>
                            </StackPanel>

                        </Grid>
                        </Border>
                        </Grid>
                        </Border>
                        <!-- Selection / focus ring — sits OUTSIDE ClipToBounds so border pixels are never clipped -->
                        <Border Name="SelectionRing" BorderThickness="2" CornerRadius="14"
                                IsHitTestVisible="False" BorderBrush="Transparent"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <!-- Dynamic sizing for Large Images vs Standard Files -->
                        <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                             <Setter TargetName="InnerHighlightBorder" Property="Padding" Value="6" />
                             <Setter TargetName="InnerHighlightBorder" Property="BorderThickness" Value="0" />
                             <Setter TargetName="CardBorder" Property="Margin" Value="0,2,0,2" />
                             <Setter TargetName="ItemIcon" Property="Stretch" Value="Uniform" />
                             <Setter TargetName="ItemIcon" Property="Height" Value="165" />
                             <Setter TargetName="ItemIcon" Property="MaxHeight" Value="165" />
                             <Setter TargetName="ItemIcon" Property="Width" Value="Auto" />
                             <Setter TargetName="ItemIcon" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="ItemIcon" Property="HorizontalAlignment" Value="Center" />
                             <Setter TargetName="ItemIcon" Property="VerticalAlignment" Value="Center" />
                             <Setter TargetName="ItemIcon" Property="Margin" Value="0" />
                             <Setter TargetName="GifItemIcon" Property="Stretch" Value="Uniform" />
                             <Setter TargetName="GifItemIcon" Property="Height" Value="165" />
                             <Setter TargetName="GifItemIcon" Property="MaxHeight" Value="165" />
                             <Setter TargetName="GifItemIcon" Property="Width" Value="Auto" />
                             <Setter TargetName="GifItemIcon" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="GifItemIcon" Property="HorizontalAlignment" Value="Center" />
                             <Setter TargetName="GifItemIcon" Property="VerticalAlignment" Value="Center" />
                             <Setter TargetName="GifItemIcon" Property="Margin" Value="0" />
                             <Setter TargetName="IconBorder" Property="Margin" Value="0" />
                             <Setter TargetName="IconBorder" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="IconBorder" Property="HorizontalAlignment" Value="Stretch" />
                             <Setter TargetName="IconBorder" Property="Background" Value="Transparent" />
                             <Setter TargetName="IconBorder" Property="Padding" Value="0" />
                             <Setter TargetName="IconBorder" Property="CornerRadius" Value="12" />
                             <Setter TargetName="IconBorder" Property="Width" Value="Auto" />
                             <Setter TargetName="IconBorder" Property="Height" Value="165" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Margin" Value="0" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="HorizontalAlignment" Value="Stretch" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Width" Value="Auto" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Height" Value="165" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="CornerRadius" Value="14" />
                             <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Apply Font Modifiers for Code Types -->
                        <DataTrigger Binding="{Binding IsCodePreview}" Value="True">
                             <Setter TargetName="TitleText" Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
                             <Setter TargetName="TitleText" Property="Foreground" Value="#6EE7B7" />
                             <Setter TargetName="TitleText" Property="FontSize" Value="11.5" />
                        </DataTrigger>
                        
                        <!-- Hover Effect on the Container -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.ControlStrokeColorSecondary}"/>
                        </Trigger>

                        <!-- Focused State Trigger for Highlight Border -->
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True">
                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource ShelfCardFocusBorder}"/>
                        </DataTrigger>

                        <!-- Selected State Trigger for Highlight Border -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True">
                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource ShelfCardSelectionBorder}"/>
                        </DataTrigger>


                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ═══ Floating Multi-Action Bar — pill-shaped, frosted glass, Google-searchbar inspired ═══ -->
        <!-- Priority: Merge PDF is shown first (left), Unpin second (right) -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Panel.ZIndex="50"
                CornerRadius="24" Padding="4" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=MergeSelectedPdfsBtn}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=UnpinSelectedBtn}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <SolidColorBrush Color="#D0181818"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#30FFFFFF"/>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <!-- PERF: DropShadowEffect removed — was software-rendered every frame -->
            <StackPanel Orientation="Horizontal">
                <!-- Merge PDF action (primary — always left, theme-aware accent pill) -->
                <Button x:Name="MergeSelectedPdfsBtn" Visibility="Collapsed" Click="MergeSelectedPdfsBtn_Click" Cursor="Hand"
                        Focusable="False" OverridesDefaultStyle="True" Content="Merge 2 PDFs">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MergePillBg" CornerRadius="20" Padding="16,9" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource FloatingMergeAccentBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FloatingMergeAccentBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingMergeAccentBgHover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource FloatingMergeAccentBorderHover}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingMergeAccentBgPressed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="15"
                                                   Foreground="{DynamicResource FloatingMergeAccentIcon}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource FloatingMergeAccentText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Separator dot (only visible when both are shown) -->
                <Ellipse Width="4" Height="4" Margin="8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#40FFFFFF"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Visibility, ElementName=MergeSelectedPdfsBtn}" Value="Visible"/>
                                        <Condition Binding="{Binding Visibility, ElementName=UnpinSelectedBtn}" Value="Visible"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Unpin action (secondary — right side, theme-aware amber pill) -->
                <Button x:Name="UnpinSelectedBtn" Visibility="Collapsed" Click="UnpinSelectedBtn_Click" Cursor="Hand"
                        Focusable="False" OverridesDefaultStyle="True" Content="Unpin Selected">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="UnpinPillBg" CornerRadius="20" Padding="14,9" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource FloatingUnpinBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FloatingUnpinBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingUnpinBgHover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource FloatingUnpinBorderHover}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingUnpinBgPressed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PinOff24" FontSize="14"
                                                   Foreground="{DynamicResource FloatingUnpinIcon}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="Medium" FontSize="12.5"
                                               Foreground="{DynamicResource FloatingUnpinText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Empty State -->
        <StackPanel Name="EmptyStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DroppedItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" Storyboard.DesiredFrameRate="15">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-6" Duration="0:0:1.5" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="28" Foreground="{DynamicResource ThemeEmptyIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Your shelf is empty" Opacity="0.45" FontWeight="SemiBold" FontSize="14" TextAlignment="Center"/>
            <TextBlock Opacity="0.28" FontSize="11.5" Margin="0,10,0,0" TextAlignment="Center" LineHeight="20">
                <Run Text="⌨️ Press"/><Run Text=" Alt+C " FontWeight="SemiBold"/><Run Text="anywhere to open"/>
                <LineBreak/>
                <Run Text="🖱️ Shake mouse to summon"/>
                <LineBreak/>
                <Run Text="📁 Drag files here to shelve"/>
                <LineBreak/>
                <Run Text="🔍 "/><Run Text="Ctrl+F" FontWeight="SemiBold"/><Run Text=" to search your clips"/>
            </TextBlock>
        </StackPanel>

        <!-- Alt+C Watermark Hint — visible until clipboard view is filled (controlled from code-behind) -->
        <Border x:Name="AltCWatermarkHint" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Margin="0,0,0,16" Opacity="0.35" IsHitTestVisible="False"
                Background="Transparent" Visibility="Visible">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" 
                        CornerRadius="8" Padding="12,6,12,6">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" TextAlignment="Center">
                        <Run Text="⌨️" FontSize="10"/><Run Text=" Press "/><Run Text="Alt+C" FontWeight="SemiBold"/><Run Text=" anywhere to summon clipboard"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- AERO ALTERNATE CLIPBOARD UI — clean minimal design with accent bars   -->
        <!-- Shares the same DroppedItems collection and event handlers              -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="AltClipboardPanel" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="40"
              Background="#01000000">

            <!-- Themed gradient background -->
            <Border CornerRadius="14" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="{DynamicResource SystemAccentColorDark3}" Offset="0.0"/>
                        <GradientStop Color="#FF0D0D14" Offset="0.5"/>
                        <GradientStop Color="#FF080810" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Arctic frost overlay -->
            <Border x:Name="AltArcticOverlay" CornerRadius="14" ClipToBounds="True" Visibility="Visible" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                        <GradientStop Color="#FFF0F7FF" Offset="0.0"/>
                        <GradientStop Color="#FFE8F0FE" Offset="0.3"/>
                        <GradientStop Color="#FFF5F5F5" Offset="0.7"/>
                        <GradientStop Color="#FFFAFAFA" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Subtle inner glow -->
            <Border CornerRadius="14" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.3,0" RadiusX="0.7" RadiusY="0.5" GradientOrigin="0.3,0">
                        <GradientStop Color="#10FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Grid Grid.Row="0" Margin="16,14,16,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{DynamicResource ThemeLogoIcon}" Width="22" Height="22" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FlyShelf" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource AltTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Pill -->
                    <Border Grid.Column="1" Margin="12,0,6,0" Height="30" CornerRadius="15" Padding="10,0"
                            Background="{DynamicResource AltSearchBg}" BorderBrush="{DynamicResource AltSearchBorder}" BorderThickness="1"
                            VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="AltSearchToggle_Click"
                            MinWidth="80">
                        <Grid VerticalAlignment="Center">
                            <StackPanel x:Name="AltSearchPlaceholder" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Search24" FontSize="12" Foreground="{DynamicResource AltSearchFg}" Margin="0,0,5,0"/>
                                <TextBlock Text="Search" FontSize="12" Foreground="{DynamicResource AltSearchFg}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid x:Name="AltSearchContainer" Visibility="Collapsed" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="12" Foreground="{DynamicResource AltSearchFg}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="AltSearchTextBox" Grid.Column="1" Padding="0" Margin="0"
                                         FontSize="12" Foreground="{DynamicResource AltTextPrimary}" CaretBrush="{DynamicResource AltTextPrimary}"
                                         TextChanged="AltSearch_TextChanged" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         MinWidth="100">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                                                      Margin="0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="#15000000"
                                        Cursor="Hand" MouseLeftButtonDown="AltSearchToggle_Click" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="8" Foreground="{DynamicResource AltTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Settings -->
                    <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="AltSettings_Click" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger>
                        </Style.Triggers></Style></Border.Style>
                        <ui:SymbolIcon Symbol="Settings24" FontSize="14" Foreground="{DynamicResource AltTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Close -->
                    <Border Grid.Column="3" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="AltClose_Click" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltCloseHoverBg}"/></Trigger>
                        </Style.Triggers></Style></Border.Style>
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource AltTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- SIDEBAR + CONTENT -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDEBAR -->
                    <StackPanel Grid.Column="0" Width="36" Margin="6,4,0,0" VerticalAlignment="Top">
                        <Border x:Name="AltSidebarAll" Width="30" Height="30" CornerRadius="8" Margin="0,0,0,4" Cursor="Hand" Background="{DynamicResource ThemeAccentBg}" ToolTip="All Items" Tag="All" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeAccentBgHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="14" Foreground="{DynamicResource ThemeAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarText" Width="30" Height="30" CornerRadius="8" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Text" Tag="Text" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="TextT24" FontSize="14" Foreground="{DynamicResource AltAccent_Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarImage" Width="30" Height="30" CornerRadius="8" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Images" Tag="Image" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="Image24" FontSize="14" Foreground="{DynamicResource AltAccent_Image}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarPinned" Width="30" Height="30" CornerRadius="8" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Pinned" Tag="Pinned" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="Pin24" FontSize="14" Foreground="{DynamicResource AltPinDot}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarPdf" Width="30" Height="30" CornerRadius="8" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="PDFs" Tag="PDF" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="14" Foreground="{DynamicResource AltAccent_Pdf}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarDocument" Width="30" Height="30" CornerRadius="8" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Documents" Tag="Document" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="Document24" FontSize="14" Foreground="{DynamicResource AltAccent_Document}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="20" Height="1" Margin="5,4,5,8" Background="{DynamicResource AltCardBorder}"/>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Convert to PDF" MouseLeftButtonDown="AltConvertPdf_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Foreground="{DynamicResource AltAccent_Pdf}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- CARD LIST -->
                    <ListView x:Name="AltShelfListView" Grid.Column="1" ItemsSource="{Binding DroppedItems}"
                              Background="Transparent" BorderThickness="0" Margin="4,4,4,12" Padding="0,0,0,50"
                              Focusable="True" FocusVisualStyle="{x:Null}" UseLayoutRounding="True" SnapsToDevicePixels="True"
                              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" SelectionMode="Extended"
                              MouseMove="AltShelfListView_MouseMove"
                              PreviewMouseLeftButtonDown="AltShelfListView_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="AltShelfListView_PreviewMouseLeftButtonUp"
                              MouseDoubleClick="AltShelfListView_MouseDoubleClick"
                              SelectionChanged="AltShelfListView_SelectionChanged"
                              PreviewKeyDown="AltShelfListView_KeyDown"
                              ScrollViewer.ScrollChanged="AltShelfListView_ScrollChanged"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <Border x:Name="AltItemBorder" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="Transparent" CornerRadius="10" Margin="2,1.5,10,1.5" ClipToBounds="True">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="AltItemBorder" Property="Background" Value="{DynamicResource ShelfCardSelectionBg}"/>
                                                    <Setter TargetName="AltItemBorder" Property="BorderBrush" Value="{DynamicResource ShelfCardSelectionBorder}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="AltItemBorder" Property="BorderBrush" Value="{DynamicResource ShelfCardFocusBorder}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Name="AltCardBorder" CornerRadius="10" Padding="0" ClipToBounds="True" Background="{DynamicResource AltCardBg}" BorderBrush="{DynamicResource AltCardBorder}" BorderThickness="1">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AltCardBgHover}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AltCardBorderHover}"/>
                                        </Trigger>
                                    </Style.Triggers></Style></Border.Style>
                                    <Grid Tag="{Binding DataContext, ElementName=AltShelfListView}" ContextMenu="{StaticResource CardContextMenu}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- HOVER ACTION BUTTONS -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Panel.ZIndex="5" Orientation="Horizontal" Tag="AeroHoverActions">
                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/>
                                                <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.AllowHover, ElementName=AltShelfListView}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsHitTestVisible" Value="True"/><Setter Property="Opacity" Value="1"/>
                                                <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" FillBehavior="Stop"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" FillBehavior="Stop"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger></Style.Triggers>
                                            </Style></StackPanel.Style>
                                            <StackPanel.Resources><Style x:Key="AeroPill" TargetType="Border"><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="{DynamicResource AltBottomBarBg}"/><Setter Property="BorderBrush" Value="{DynamicResource AltCardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,0,1,0"/><Setter Property="Cursor" Value="Hand"/></Style></StackPanel.Resources>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="QuickLookSpecific_Click"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="12" Foreground="{DynamicResource AltAccent_Image}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="OpenSpecific_Click"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Open24" FontSize="12" Foreground="{DynamicResource AltAccent_Document}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="GoogleSearchSpecific_Click"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Search24" FontSize="12" Foreground="{DynamicResource AltAccent_Url}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="PeekPasswordSpecific_Click" ToolTip="Peek password (5s)"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Eye24" Filled="True" FontSize="12" Foreground="{DynamicResource AltAccent_Password}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Style="{StaticResource AeroPill}" PreviewMouseLeftButtonDown="PinSpecific_Click"><ui:SymbolIcon FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="Pin24"/><Setter Property="Filled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource AltPinDot}"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Symbol" Value="PinOff24"/><Setter Property="Foreground" Value="{DynamicResource AltTextTertiary}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Border>
                                            <Border Style="{StaticResource AeroPill}" PreviewMouseLeftButtonDown="DeleteSpecific_Click"><ui:SymbolIcon Symbol="Delete24" Filled="True" FontSize="12" Foreground="{DynamicResource DangerColor}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                        </StackPanel>
                                        <!-- PDF MERGE TOGGLE — top-left checkbox for PDF/Document/Image items -->
                                        <Button Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="0,-2,0,0" Panel.ZIndex="10" Focusable="False"
                                                Tag="AltPdfMergeToggle" Click="AltPdfMergeToggle_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid Width="22" Height="22" Background="Transparent">
                                                                    <Border x:Name="UncheckedBg" Width="18" Height="18" CornerRadius="5"
                                                                            Background="#60FFFFFF" BorderBrush="#40EF4444" BorderThickness="1.5"/>
                                                                    <Border x:Name="CheckedBg" Width="18" Height="18" CornerRadius="5"
                                                                            Background="#EF4444" BorderBrush="#EF4444" BorderThickness="1.5" Visibility="Collapsed"/>
                                                                    <TextBlock x:Name="CheckMark" Text="✓" FontSize="11" FontWeight="Bold"
                                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Margin="0,-1,0,0" Visibility="Collapsed"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCheckedForMerge}" Value="True">
                                                                        <Setter TargetName="UncheckedBg" Property="Visibility" Value="Collapsed"/>
                                                                        <Setter TargetName="CheckedBg" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="UncheckedBg" Property="BorderBrush" Value="#EF4444"/>
                                                                        <Setter TargetName="UncheckedBg" Property="Background" Value="#40EF4444"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Show on hover for PDF -->
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <!-- Show on hover for Document -->
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <!-- Show on hover for Image -->
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- ACCENT BAR -->
                                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="1,6,0,6" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AltAccent_Default}"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Background" Value="{DynamicResource AltAccent_Text}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Background" Value="{DynamicResource AltAccent_Code}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Background" Value="{DynamicResource AltAccent_Image}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Background" Value="{DynamicResource AltAccent_Pdf}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Background" Value="{DynamicResource AltAccent_Url}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Background" Value="{DynamicResource AltAccent_Document}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Background" Value="{DynamicResource AltAccent_Archive}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Folder"><Setter Property="Background" Value="{DynamicResource AltAccent_Folder}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Background" Value="{DynamicResource AltAccent_Video}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Background" Value="{DynamicResource AltAccent_Audio}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Password"><Setter Property="Background" Value="{DynamicResource AltAccent_Password}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Background" Value="{DynamicResource AltAccent_Presentation}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Background" Value="{DynamicResource AltAccent_QRCode}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Group"><Setter Property="Background" Value="{DynamicResource AltAccent_Group}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Background" Value="{DynamicResource AltAccent_File}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                                        <!-- ICON -->
                                        <Grid Grid.Column="1" Width="32" Height="32" Margin="8,8,6,8">
                                            <Border CornerRadius="7" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding Icon}" Width="32" Height="32" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                            <!-- Expand/Collapse button for long text -->
                                            <Border CornerRadius="7" Width="32" Height="32" Cursor="Hand" Tag="AeroExpandToggle"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Border.Background><SolidColorBrush Color="#3B82F6" Opacity="0.08"/></Border.Background><Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}"/></Border.InputBindings><ui:SymbolIcon FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="ChevronDown24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Symbol" Value="ChevronUp24"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Border>
                                            <!-- Fallback icon for items without a custom icon (text, url, code, etc.) -->
                                            <Border CornerRadius="7" Width="32" Height="32"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Border.Background><SolidColorBrush Color="#000000" Opacity="0.05"/></Border.Background><ui:SymbolIcon FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="Document24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_File}"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Symbol" Value="TextDescription24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Text}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Symbol" Value="Code24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Code}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Symbol" Value="Image24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Image}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Symbol" Value="DocumentPdf24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Pdf}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Symbol" Value="Globe24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Url}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Password"><Setter Property="Symbol" Value="ShieldKeyhole24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Password}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Border>
                                        </Grid>
                                        <!-- TEXT BODY -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,5,4,5">
                                            <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,8,4" HorizontalAlignment="Stretch"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding Icon, IsAsync=True}" MaxHeight="90" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AltTextPrimary}" TextTrimming="CharacterEllipsis" MaxHeight="18" LineHeight="18"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AltTextPrimary}" TextWrapping="Wrap" MaxHeight="{Binding CollapsedMaxHeight}" LineHeight="18"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="{Binding FormatIdentifier}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource AltSubtitleFg}" TextTrimming="CharacterEllipsis" MaxHeight="15" LineHeight="15" Opacity="0.7"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </StackPanel>
                                        <!-- TIMESTAMP + PIN -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,10,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:h:mm tt}'}" FontSize="10.5" Foreground="{DynamicResource AltTimestampFg}" HorizontalAlignment="Right"/>
                                            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" Margin="0,4,2,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Fill" Value="{DynamicResource AltPinDot}"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DroppedItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,14"><Border.Background><SolidColorBrush Color="#000000" Opacity="0.06"/></Border.Background><ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="24" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Your shelf is empty" Opacity="0.5" FontWeight="SemiBold" FontSize="14" TextAlignment="Center" Foreground="{DynamicResource AltTextPrimary}"/>
                        <TextBlock Opacity="0.35" FontSize="11" Margin="0,8,0,0" TextAlignment="Center" LineHeight="20" Foreground="{DynamicResource AltTextSecondary}"><Run Text="Copy anything to see it here"/></TextBlock>
                    </StackPanel>
                </Grid>

                <!-- BOTTOM BAR -->
                <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0,8,8" Padding="10,6" CornerRadius="12" Background="{DynamicResource AltBottomBarBg}" BorderBrush="{DynamicResource AltBottomBarBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="Transparent" Cursor="Hand" ToolTip="More Options" MouseLeftButtonDown="AltMoreOptions_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Width="28" Height="28" CornerRadius="7" Background="Transparent" Cursor="Hand" Margin="0,0,2,0" ToolTip="Keyboard Shortcuts" MouseLeftButtonDown="AltShortcuts_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Keyboard24" FontSize="14" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border Width="28" Height="28" CornerRadius="7" Background="Transparent" Cursor="Hand" Margin="0,0,2,0" ToolTip="Sync" MouseLeftButtonDown="AltSync_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border Width="28" Height="28" CornerRadius="7" Background="Transparent" Cursor="Hand" Margin="0,0,2,0" ToolTip="Clear Shelf" MouseLeftButtonDown="AltClear_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerBgHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="{DynamicResource DangerColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border Width="28" Height="28" CornerRadius="7" Background="Transparent" Cursor="Hand" ToolTip="Reminders" MouseLeftButtonDown="ReminderBtn_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Alert24" FontSize="13" Foreground="{DynamicResource AltPinDot}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- QUICK NOTES PANEL — overlays ShelfListView in Grid.Row=1     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="NotesPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="0"
              RenderTransformOrigin="0.5,0" PreviewMouseDown="NotesPanel_PreviewMouseDown"
              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
              RenderOptions.ClearTypeHint="Enabled" UseLayoutRounding="True" SnapsToDevicePixels="True"
              Validation.ErrorTemplate="{x:Null}"
              Background="#1A1A2E">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Notes header -->
                <RowDefinition Height="*"/>     <!-- Content area -->
            </Grid.RowDefinitions>

            <!-- ═══ NOTES HEADER BAR ═══ -->
            <Border Grid.Row="0" CornerRadius="0" Padding="10,6" Margin="0,0,0,0"
                    Background="#16162A" 
                    BorderBrush="#2A2A45" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Back -->
                        <ColumnDefinition Width="Auto"/> <!-- Day label -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Mode toggle -->
                        <ColumnDefinition Width="Auto"/> <!-- Add -->
                        <ColumnDefinition Width="Auto"/> <!-- Undo -->
                        <ColumnDefinition Width="Auto"/> <!-- Templates -->
                        <ColumnDefinition Width="Auto"/> <!-- Dropdown menu -->
                    </Grid.ColumnDefinitions>

                    <!-- Back to clipboard -->
                    <Border Grid.Column="0" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="NotesBack_Click" Padding="6,3" Margin="0,0,4,0"
                            Background="#14FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ToolTip="Back to Clipboard">
                        <ui:SymbolIcon Symbol="ArrowLeft24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="14"/>
                    </Border>

                    <!-- Current day label (clickable for month navigation) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                                Cursor="Hand" MouseLeftButtonDown="CurrentDayLabel_Click" ToolTip="Toggle Day / Month View">
                        <ui:SymbolIcon Symbol="List24" Foreground="#8B5CF6" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock x:Name="NotesCurrentDayLabel" Text="27, May" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>



                    <!-- Mode toggle: Bullets ↔ Freeform -->
                    <Border Grid.Column="3" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="NotesModeToggle_Click" Padding="8,3" Margin="0,0,4,0"
                            Background="#188B5CF6" BorderBrush="#308B5CF6" BorderThickness="1" ToolTip="Toggle Bullets / Freeform">
                        <TextBlock x:Name="NotesModeToggleText" Text="📄 Freeform" FontSize="10" FontWeight="SemiBold" 
                                   Foreground="#C4B5FD" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Add card (bullet or freeform depending on mode) -->
                    <Border Grid.Column="4" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="NotesAddBullet_Click" Padding="6,3" Margin="0,0,4,0"
                            Background="#208B5CF6" BorderBrush="#408B5CF6" BorderThickness="1" ToolTip="Add Card">
                        <ui:SymbolIcon Symbol="Add24" Foreground="#8B5CF6" FontSize="13"/>
                    </Border>

                    <!-- Undo -->
                    <Border x:Name="NotesUndoBtn" Grid.Column="5" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="NotesUndo_Click" Padding="6,3" Margin="0,0,4,0"
                            ToolTip="Undo last change" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#18F59E0B"/>
                                <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#30F59E0B"/>
                                        <Setter Property="BorderBrush" Value="#60F59E0B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="ArrowUndo24" Foreground="#F59E0B" FontSize="13"/>
                    </Border>

                    <!-- Templates -->
                    <Border x:Name="NotesTemplatesBtn" Grid.Column="6" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="NotesTemplates_Click" Padding="6,3" Margin="0,0,4,0"
                            Background="{DynamicResource MicaWPF.Brushes.ControlFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="1" 
                            ToolTip="Note Templates">
                        <ui:SymbolIcon Symbol="DocumentCopy24" Foreground="{DynamicResource ThemeAccent}" FontSize="13"/>
                    </Border>

                    <!-- Dropdown menu (Sort, Trash, Export, Templates) -->
                    <Border Grid.Column="7" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="NotesHeaderMenu_Click" Padding="6,3"
                            ToolTip="More options">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0C8B5CF6"/>
                                <Setter Property="BorderBrush" Value="#188B5CF6"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#208B5CF6"/>
                                        <Setter Property="BorderBrush" Value="#408B5CF6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="ChevronDown24" Foreground="#A78BFA" FontSize="12"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ═══ MAIN CONTENT: SIDEBAR + NOTEPAD ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NotesSidebarColumn" Width="42"/>  <!-- Day Sidebar (collapses to 0) -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>

                <!-- ═══ DAY SIDEBAR (Toggle + Newest-first list of dates) ═══ -->
                <Border x:Name="NotesSidebarBorder" Grid.Column="0" BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="0,0,1,0" Background="{DynamicResource MicaWPF.Brushes.ControlAltFillColorTertiary}">
                    <DockPanel>
                        <!-- Toggle button at top -->
                        <Border DockPanel.Dock="Top" Cursor="Hand" Height="22"
                                Background="Transparent"
                                MouseLeftButtonDown="NotesSidebarToggle_Click" ToolTip="Collapse Sidebar">
                            <TextBlock x:Name="NotesSidebarCollapseIcon" Text="◂" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- Date list -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NotesDaySidebar" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Day badge container -->
                                        <Border x:Name="NotesDayBorder" CornerRadius="8" Width="30" Height="30" Margin="0,0,0,4"
                                                Cursor="Hand" MouseLeftButtonDown="NotesDayItem_Click"
                                                BorderThickness="1" SnapsToDevicePixels="True"
                                                Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}"
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}"
                                                ToolTip="{Binding FullLabel}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Day number -->
                                                <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Bold" 
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextAlignment="Center" Margin="0,-2,0,0"/>
                                                <!-- Abbreviated Month -->
                                                <TextBlock Text="{Binding MonthName}" FontSize="7" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" TextAlignment="Center" Margin="0,-2,0,0" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Expand arrow (visible when sidebar collapsed) -->
                <Border x:Name="NotesSidebarExpandBtn" Grid.Column="1" Width="20" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Cursor="Hand" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0"
                        MouseLeftButtonDown="NotesSidebarToggle_Click" ToolTip="Show Sidebar" Panel.ZIndex="5">
                    <TextBlock Text="▸" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Month Picker Popup -->
                <Popup x:Name="NotesMonthPopup" Placement="Right" PlacementTarget="{Binding ElementName=NotesSidebarBorder}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border CornerRadius="10" Padding="6,6" Background="#1E1E38" BorderBrush="#3A3A5C" BorderThickness="1"
                            MinWidth="120" MaxHeight="300">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NotesMonthList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,6" Margin="1,1" Cursor="Hand"
                                                MouseLeftButtonDown="NotesMonthItem_Click"
                                                Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2A2A50"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MonthName}" FontSize="12" FontWeight="SemiBold" 
                                                           Foreground="#D0D0E0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding YearText}" FontSize="10" FontWeight="Medium" 
                                                           Foreground="#7878A0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding DayCount}" FontSize="9" FontWeight="Medium" 
                                                           Foreground="#5858A0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!-- ═══ NOTES CONTENT AREA ═══ -->
                <Grid x:Name="NotesContentArea" Grid.Column="1">
                    <!-- BULLET MODE: Scrollable list of bullet cards -->
                    <ScrollViewer x:Name="NotesBulletScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="NotesBulletList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Bullet Card -->
                                    <Border x:Name="BulletCard" CornerRadius="8" Margin="6,0,6,4" Padding="0" ClipToBounds="True"
                                            BorderThickness="1" BorderBrush="#2A2A45"
                                            PreviewMouseLeftButtonDown="BulletCard_PreviewMouseDown">
                                        <Border.Background>
                                            <SolidColorBrush Color="#222240"/>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Color strip -->
                                                <ColumnDefinition Width="*"/>    <!-- Main content -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Color accent strip (left edge) -->
                                            <Border x:Name="BulletColorStrip" Grid.Column="0" Width="3" CornerRadius="8,0,0,8"
                                                    Background="{Binding Color}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Header row -->
                                                <RowDefinition Height="Auto"/> <!-- Content row (collapsible) -->
                                                <RowDefinition Height="Auto"/> <!-- Sub-bullets row (collapsible) -->
                                                <RowDefinition Height="Auto"/> <!-- Tags row -->
                                                <RowDefinition Height="Auto"/> <!-- Image row (optional) -->
                                            </Grid.RowDefinitions>


                                            <!-- Bullet header: dot + collapse toggle + delete -->
                                            <Grid Grid.Row="0" Margin="8,5,6,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Bullet dot -->
                                                    <ColumnDefinition Width="*"/>    <!-- Header Box + Spacer -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Last Edited Time -->
                                                    <ColumnDefinition Width="Auto"/> <!-- More menu -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Right panel: Collapse + Pin + Reminder -->
                                                </Grid.ColumnDefinitions>
                                                <!-- Bullet dot -->
                                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#8B5CF6" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                                
                                                <!-- Bullet Header (Topic) -->
                                                <Grid Grid.Column="1" Margin="4,0,8,0">
                                                    <TextBox x:Name="NoteBulletHeaderBox"
                                                             Text="{Binding Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="13" FontWeight="SemiBold"
                                                             Background="Transparent" BorderThickness="0" Padding="0"
                                                             Foreground="#F3F4F6" CaretBrush="#F3F4F6"
                                                             SelectionBrush="#608B5CF6"
                                                             TextChanged="NoteBulletHeader_TextChanged"
                                                             PreviewKeyDown="NoteBulletHeader_PreviewKeyDown">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBlock Text="Add header..." FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#6B7280" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Header}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Header}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Last Edited Timestamp (always visible) -->
                                                <TextBlock Grid.Column="2" Text="{Binding LastEditedDisplay}" FontSize="10.5" 
                                                           Foreground="#8B8BA8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           IsHitTestVisible="False" Opacity="0.8"/>
                                                
                                                <!-- Right panel: AI + More in a compact horizontal row -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <!-- AI button -->
                                                    <Border x:Name="BulletAIBtn" CornerRadius="4" Cursor="Hand" 
                                                            Padding="6,2" Margin="0,0,2,0" Opacity="0" IsHitTestVisible="False"
                                                            MouseLeftButtonDown="NoteBulletAI_Click" ToolTip="AI Assistant">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#188B5CF6"/>
                                                                <Setter Property="BorderBrush" Value="#308B5CF6"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#308B5CF6"/>
                                                                        <Setter Property="BorderBrush" Value="#608B5CF6"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="11" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <TextBlock Text="AI" FontSize="9.5" FontWeight="SemiBold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- More options dropdown button -->
                                                    <Border x:Name="BulletMoreBtn" CornerRadius="4" Cursor="Hand" 
                                                            Padding="3,2" Margin="0,0,1,0" Opacity="0" IsHitTestVisible="False"
                                                            MouseLeftButtonDown="NoteBulletMore_Click" ToolTip="More options">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0CFFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="#18808080"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#20FFFFFF"/>
                                                                        <Setter Property="BorderBrush" Value="#40808080"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ui:SymbolIcon Symbol="MoreHorizontal24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <!-- Collapse toggle (always visible, separate column) -->
                                                <Border x:Name="BulletCollapseBtn" Grid.Column="4" CornerRadius="4" Cursor="Hand" Padding="4,1"
                                                        MouseLeftButtonDown="NoteBulletCollapse_Click" Background="Transparent"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CollapseIcon}" FontSize="11" FontWeight="Bold" 
                                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Bullet text content (collapsible) -->
                                            <Border x:Name="BulletContent" Grid.Row="1" Margin="22,0,8,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBox x:Name="NoteBulletContentBox"
                                                         Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"

                                                         FontSize="12" Background="Transparent" BorderThickness="0" Padding="0,2"
                                                         Foreground="#E8E8F0"
                                                         CaretBrush="#E8E8F0"
                                                         SelectionBrush="#608B5CF6"
                                                         TextChanged="NoteBulletText_TextChanged"
                                                         PreviewKeyDown="NoteBulletText_PreviewKeyDown"
                                                         GotFocus="NoteBulletText_GotFocus"
                                                         DataObject.Pasting="NoteBulletText_Paste">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>

                                            <!-- ── Sub-bullets (nested items, Shift+Enter) ── -->
                                            <Border Grid.Row="2" Margin="26,0,8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSubBullets}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2"/>  <!-- accent bar -->
                                                        <ColumnDefinition Width="*"/>  <!-- sub-bullet list -->
                                                    </Grid.ColumnDefinitions>
                                                    <!-- left accent bar -->
                                                    <Border Grid.Column="0" Background="#40A78BFA" CornerRadius="1" Margin="0,2,6,2"/>
                                                    <!-- sub-bullet rows -->
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SubBullets}" Margin="4,0,0,0"
                                                                  x:Name="SubBulletsItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1,0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- sub-bullet dot -->
                                                                    <TextBlock Grid.Column="0" Text="◦" FontSize="11"
                                                                               Foreground="#80A78BFA" VerticalAlignment="Top"
                                                                               Margin="0,3,5,0"/>
                                                                    <!-- sub-bullet text -->
                                                                    <TextBox Grid.Column="1"
                                                                             x:Name="SubBulletTextBox"
                                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             TextWrapping="Wrap" AcceptsReturn="False" AcceptsTab="False"
                                                                             FontSize="11.5" Background="Transparent" BorderThickness="0"
                                                                             Padding="0,1" Foreground="#C8C8E0"
                                                                             CaretBrush="#C8C8E0" SelectionBrush="#608B5CF6"
                                                                             PreviewKeyDown="SubBulletText_PreviewKeyDown"
                                                                             Tag="{Binding}">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="TextBox">
                                                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>

                                            <!-- Embedded image (optional, resizable via mouse wheel, up to 2 images) -->
                                            <Border x:Name="BulletImageArea" Grid.Row="4" Margin="22,0,8,6">

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasImage2}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Image 1 -->
                                                    <Grid x:Name="Image1Grid" Margin="0,0,8,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border CornerRadius="6" ClipToBounds="True" 
                                                                BorderBrush="#308B5CF6" BorderThickness="1" 
                                                                HorizontalAlignment="Left" Cursor="Hand"
                                                                MouseLeftButtonDown="NoteImage_Click"
                                                                ToolTip="Click to open">
                                                            <Image Source="{Binding ImagePath}" 
                                                                   Width="{Binding ImageDisplayWidth}" 
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <!-- Remove image button -->
                                                        <Border CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                                Margin="4,4,0,0" Padding="3,1" Cursor="Hand" Background="#80000000"
                                                                MouseLeftButtonDown="NoteImageRemove_Click" ToolTip="Remove image">
                                                            <ui:SymbolIcon Symbol="Dismiss12" Foreground="#CCFFFFFF" FontSize="9"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Image 2 -->
                                                    <Grid x:Name="Image2Grid" Margin="0,0,8,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasImage2}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border CornerRadius="6" ClipToBounds="True" 
                                                                BorderBrush="#308B5CF6" BorderThickness="1" 
                                                                HorizontalAlignment="Left" Cursor="Hand"
                                                                MouseLeftButtonDown="NoteImage2_Click"
                                                                ToolTip="Click to open">
                                                            <Image Source="{Binding ImagePath2}" 
                                                                   Width="{Binding ImageDisplayWidth2}" 
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <!-- Remove image button -->
                                                        <Border CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                                Margin="4,4,0,0" Padding="3,1" Cursor="Hand" Background="#80000000"
                                                                MouseLeftButtonDown="NoteImageRemove2_Click" ToolTip="Remove image">
                                                            <ui:SymbolIcon Symbol="Dismiss12" Foreground="#CCFFFFFF" FontSize="9"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- ═══ Tags chips row (visible when tags exist) ═══ -->
                                            <ItemsControl x:Name="NoteTagsRow" Grid.Row="3" ItemsSource="{Binding Tags}" Margin="22,0,8,4">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTags}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="5,1,5,1" Margin="0,0,3,2"
                                                                Background="#208B5CF6" BorderBrush="#308B5CF6" BorderThickness="1">
                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#C4B5FD"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            </Grid> <!-- close inner Grid -->
                                        </Grid> <!-- close outer Grid with color strip -->
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Show action buttons on card hover (Opacity-based to prevent layout shift) -->
                                        <Trigger SourceName="BulletCard" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BulletAIBtn" Property="Opacity" Value="1"/>
                                            <Setter TargetName="BulletAIBtn" Property="IsHitTestVisible" Value="True"/>
                                            <Setter TargetName="BulletMoreBtn" Property="Opacity" Value="1"/>
                                            <Setter TargetName="BulletMoreBtn" Property="IsHitTestVisible" Value="True"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- FREEFORM MODE: Text area + images strip -->
                    <ScrollViewer x:Name="NotesFreeformArea" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- FREEFORM SECTIONS: Multiple text cards -->
                            <ItemsControl x:Name="NotesFreeformSectionsList" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="FreeformSectionCard" CornerRadius="8" Margin="4,2,4,3" Padding="0" ClipToBounds="True"
                                                BorderThickness="1" BorderBrush="#2A2A45">
                                            <Grid>
                                                <TextBox x:Name="FreeformSectionTextBox" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                                         FontSize="12.5" Background="Transparent" BorderThickness="0" Padding="10,6,10,8" MinHeight="80"
                                                         Foreground="#E8E8F0"
                                                         CaretBrush="#E8E8F0"
                                                         SelectionBrush="#608B5CF6"
                                                         Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="NotesFreeformBox_TextChanged"
                                                         GotFocus="NotesFreeformBox_GotFocus"
                                                         PreviewKeyDown="NotesFreeformBox_PreviewKeyDown"
                                                         DataObject.Pasting="NotesFreeformBox_Paste">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <!-- Remove section button (top-right, always visible) -->
                                                <Border x:Name="FreeformSectionRemoveBtn" CornerRadius="6" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,30,0" Panel.ZIndex="10"
                                                        Background="#18FF4444" BorderBrush="#30FF4444" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="FreeformSectionRemove_Click" ToolTip="Remove this section">
                                                    <ui:SymbolIcon Symbol="Delete24" Foreground="#FF6666" FontSize="12" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- AI Button (top-right, always visible) -->
                                                <Border x:Name="FreeformSectionAIBtn" CornerRadius="6" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,56,0" Panel.ZIndex="10"
                                                        Background="#188B5CF6" BorderBrush="#308B5CF6" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="NotesFreeformAI_Click" ToolTip="AI Assistant">
                                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="12" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Reminder Button (top-right floating, always visible) -->
                                                <Border x:Name="FreeformSectionReminderBtn" CornerRadius="6" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,4,0" Panel.ZIndex="10"
                                                        Background="#18F59E0B" BorderBrush="#30F59E0B" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="NotesFreeformReminder_Click" ToolTip="Set Reminder from Notes">
                                                    <ui:SymbolIcon Symbol="Alert24" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Expand Button (top-right floating, opens NoteExpandWindow) -->
                                                <Border x:Name="FreeformSectionExpandBtn" CornerRadius="6" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,82,0" Panel.ZIndex="10"
                                                        Background="#1822D3EE" BorderBrush="#3022D3EE" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="NotesFreeformExpand_Click" ToolTip="Expand Note">
                                                    <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="12" Foreground="#22D3EE" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Alternating backgrounds: even = darker, odd = subtly lighter -->
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter TargetName="FreeformSectionCard" Property="Background" Value="#222240"/>
                                            </Trigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter TargetName="FreeformSectionCard" Property="Background" Value="#282850"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                            <!-- Freeform images strip (pasted images shown below text) -->
                            <ItemsControl x:Name="NotesFreeformImageList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="FreeformImgCard" CornerRadius="8" Margin="6,0,6,4" Padding="4" ClipToBounds="True"
                                                BorderThickness="1" BorderBrush="#2A2A45" Background="#222240">
                                            <Grid>
                                                <Border CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left" Cursor="Hand"
                                                        BorderBrush="#308B5CF6" BorderThickness="1"
                                                        MouseLeftButtonDown="FreeformImage_Click"
                                                        ToolTip="Click to open">
                                                    <Image Source="{Binding ImagePath}" Width="{Binding DisplayWidth}"
                                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <!-- Remove button -->
                                                <Border x:Name="FreeformImgRemoveBtn" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="4,4,0,0" Padding="3,1" Cursor="Hand" Background="#80000000" Opacity="0" IsHitTestVisible="False"
                                                        MouseLeftButtonDown="FreeformImageRemove_Click" ToolTip="Remove image">
                                                    <ui:SymbolIcon Symbol="Dismiss12" Foreground="#CCFFFFFF" FontSize="9"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="FreeformImgCard" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FreeformImgRemoveBtn" Property="Opacity" Value="1"/>
                                                <Setter TargetName="FreeformImgRemoveBtn" Property="IsHitTestVisible" Value="True"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- NOTES EMPTY STATE -->
                    <StackPanel x:Name="NotesEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="List24" FontSize="28" Foreground="#308B5CF6" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No bullets yet" Opacity="0.35" FontSize="12" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="Click + to add your first note" Opacity="0.2" FontSize="10.5" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ NOTES SEARCH RESULTS (replaces content area during search) ═══ -->
                <Border x:Name="NotesSearchResults" Grid.Column="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="NotesSearchResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Search result card: date sidebar + content -->
                                    <Border CornerRadius="8" Margin="6,0,6,4" Padding="0" Cursor="Hand" ClipToBounds="True"
                                            MouseLeftButtonDown="NotesSearchResult_Click"
                                            BorderThickness="1" BorderBrush="#2A2A45" Background="#222240">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/> <!-- Date column -->
                                                <ColumnDefinition Width="*"/>  <!-- Content -->
                                            </Grid.ColumnDefinitions>
                                            <!-- Date badge -->
                                            <Border Grid.Column="0" Background="#158B5CF6" Padding="4,6">
                                                <TextBlock Text="{Binding DateLabel}" FontSize="9" FontWeight="Bold" 
                                                           Foreground="#C4B5FD" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>
                                            <!-- Content preview -->
                                            <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="11" TextTrimming="CharacterEllipsis" 
                                                       MaxHeight="42" TextWrapping="Wrap" Margin="8,6" 
                                                       Foreground="#E8E8F0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TO-DO LIST PANEL — overlays ShelfListView in Grid.Row=1      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="TodoPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="0"
              RenderTransformOrigin="0.5,0" PreviewMouseDown="TodoPanel_PreviewMouseDown"
              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
              RenderOptions.ClearTypeHint="Enabled" UseLayoutRounding="True" SnapsToDevicePixels="True"
              Validation.ErrorTemplate="{x:Null}"
              Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Todo header -->
                <RowDefinition Height="*"/>     <!-- Content area -->
            </Grid.RowDefinitions>

            <!-- ═══ TODO HEADER BAR ═══ -->
            <Border Grid.Row="0" CornerRadius="0" Padding="10,6" Margin="0,0,0,0"
                    Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}" 
                    BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Back -->
                        <ColumnDefinition Width="Auto"/> <!-- Day label -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Progress pill -->
                        <ColumnDefinition Width="Auto"/> <!-- Sort -->
                        <ColumnDefinition Width="Auto"/> <!-- Migrate -->
                        <ColumnDefinition Width="Auto"/> <!-- Templates -->
                        <ColumnDefinition Width="Auto"/> <!-- Add -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Back to clipboard -->
                        <Border CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="TodoBack_Click" Padding="6,3" Margin="0,0,4,0"
                                Background="{DynamicResource MicaWPF.Brushes.ControlFillColorSecondary}" 
                                BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="1" ToolTip="Back to Clipboard">
                            <ui:SymbolIcon Symbol="ArrowLeft24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="14"/>
                        </Border>

                        <!-- Sidebar Toggle (Calendar) — REMOVED per user request -->
                    </StackPanel>


                    <!-- Title and Current day label -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <ui:SymbolIcon Symbol="CheckboxChecked24" Foreground="{DynamicResource ThemeAccent}" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="To-Do" FontSize="12.5" FontWeight="Bold" 
                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TodoCurrentDayLabel" Text="{Binding DisplayDate, FallbackValue='27, May'}" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Progress pill removed (UI bloat) -->


                    <!-- Sort -->
                    <Border Grid.Column="4" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="TodoSort_Click" Padding="5,3" Margin="0,0,2,0"
                            Background="{DynamicResource MicaWPF.Brushes.ControlFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="1" ToolTip="Sort Tasks">
                        <ui:SymbolIcon Symbol="ArrowSort16" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="12"/>
                    </Border>

                    <!-- Migrate incomplete tasks from yesterday -->
                    <Border Grid.Column="5" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="TodoMigrate_Click" Padding="5,3" Margin="0,0,2,0"
                            Background="{DynamicResource MicaWPF.Brushes.ControlFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="1" ToolTip="Carry forward yesterday's incomplete tasks">
                        <ui:SymbolIcon Symbol="ArrowForward16" Foreground="#F59E0B" FontSize="12"/>
                    </Border>



                    <!-- Templates -->
                    <Border x:Name="TodoTemplatesBtn" Grid.Column="6" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="TodoTemplates_Click" Padding="6,3" Margin="0,0,6,0"
                            Background="{DynamicResource MicaWPF.Brushes.ControlFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="1" ToolTip="To-Do Templates">
                        <ui:SymbolIcon Symbol="DocumentCopy24" Foreground="{DynamicResource ThemeAccent}" FontSize="13"/>
                    </Border>

                    <!-- Add new to-do item -->
                    <Border Grid.Column="7" CornerRadius="7" Cursor="Hand" MouseLeftButtonDown="TodoAddBtn_Click" Padding="7,3"
                            Background="{DynamicResource ThemeAccentBg}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" ToolTip="Add To-Do Item">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add12" Foreground="{DynamicResource ThemeAccentLight}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ CONTENT AREA (Sidebar + List) ═══ -->
            <Grid Grid.Row="1" Background="{DynamicResource MicaWPF.Brushes.SolidBackgroundFillColorBase}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TodoSidebarColumn" Width="42"/>  <!-- Day Sidebar (collapses to 0) -->
                    <ColumnDefinition Width="*"/>   <!-- To-Do List Area -->
                </Grid.ColumnDefinitions>

                <!-- ═══ DAY SIDEBAR (Toggle + Newest-first list of dates) ═══ -->
                <Border x:Name="TodoSidebarBorder" Grid.Column="0" BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="0,0,1,0" Background="{DynamicResource MicaWPF.Brushes.ControlAltFillColorTertiary}">
                    <DockPanel>
                        <!-- Toggle button at top -->
                        <Border DockPanel.Dock="Top" Cursor="Hand" Height="22"
                                Background="Transparent"
                                MouseLeftButtonDown="TodoSidebarToggle_Click" ToolTip="Collapse Sidebar">
                            <TextBlock x:Name="TodoSidebarCollapseIcon" Text="◂" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- Date list -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TodoDaySidebar" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Day badge container -->
                                        <Border x:Name="TodoDayBorder" CornerRadius="8" Width="30" Height="30" Margin="0,0,0,4"
                                                Cursor="Hand" MouseLeftButtonDown="TodoDayItem_Click"
                                                BorderThickness="2" SnapsToDevicePixels="True"
                                                ToolTip="{Binding FullLabel}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#4010B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#30808080"/>
                                                            <Setter Property="BorderBrush" Value="#60808080"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Day number -->
                                                <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Bold" 
                                                           TextAlignment="Center" Margin="0,-2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Abbreviated Month -->
                                                <TextBlock Text="{Binding MonthName}" FontSize="7" FontWeight="SemiBold"
                                                           TextAlignment="Center" Margin="0,-2,0,0" Opacity="0.8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Expand arrow (visible when sidebar collapsed) -->
                <Border x:Name="TodoSidebarExpandBtn" Grid.Column="1" Width="20" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Cursor="Hand" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0"
                        MouseLeftButtonDown="TodoSidebarToggle_Click" ToolTip="Show Sidebar" Panel.ZIndex="5">
                    <TextBlock Text="▸" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- ═══ TO-DO LIST CONTENT AREA ═══ -->
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="TodoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TodoListItemsControl">
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                    <DataTemplate.Resources>
                                        <!-- Named style so hover triggers can show action buttons -->
                                        <Style x:Key="TodoCardStyle" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Setter Property="Margin" Value="6,0,6,5"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="ClipToBounds" Value="True"/>
                                            <Setter Property="MinHeight" Value="32"/>

                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}"/>
                                            <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#40808080"/>
                                                    <Setter Property="Background" Value="#0CFFFFFF"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#50808080"/>
                                                    <Setter Property="Background" Value="#10FFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataTemplate.Resources>
                                    <!-- Todo Card — Enhanced with priority, due date, tags, subtasks, description -->
                                    <Border x:Name="TodoCard" Style="{StaticResource TodoCardStyle}"
                                            AllowDrop="True" 
                                            PreviewMouseLeftButtonDown="TodoItem_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="TodoItem_PreviewMouseMove"
                                            DragOver="TodoItem_DragOver" Drop="TodoItem_Drop">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Set Priority" Icon="{ui:SymbolIcon Symbol=Flag16}">
                                                    <MenuItem Header="🔴 High" Click="TodoItemPriorityHigh_Click"/>
                                                    <MenuItem Header="🟡 Medium" Click="TodoItemPriorityMedium_Click"/>
                                                    <MenuItem Header="🟢 Low" Click="TodoItemPriorityLow_Click"/>
                                                    <MenuItem Header="Clear Priority" Click="TodoItemPriorityNone_Click"/>
                                                </MenuItem>
                                                <MenuItem Header="Due Date" Icon="{ui:SymbolIcon Symbol=CalendarLtr16}" Click="TodoItemDueDate_Click"/>
                                                <MenuItem Header="Tags" Icon="{ui:SymbolIcon Symbol=Edit24}" Click="TodoItemTag_Click"/>
                                                <MenuItem Header="Color" Icon="{ui:SymbolIcon Symbol=Color24}" Click="TodoItemColor_Click"/>
                                                <MenuItem Header="Add Subtask" Icon="{ui:SymbolIcon Symbol=Add12}" Click="TodoItemAddSubtask_Click"/>
                                                <MenuItem Header="Description" Icon="{ui:SymbolIcon Symbol=Document24}" Click="TodoItemDescription_Click"/>
                                                <MenuItem Header="Recurrence" Icon="{ui:SymbolIcon Symbol=ArrowRotateClockwise24}" Click="TodoItemRecurrence_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Delete" Click="TodoItemTrash_Click" Icon="{ui:SymbolIcon Symbol=Delete16}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Border x:Name="TodoColorStrip" Width="4" HorizontalAlignment="Left" CornerRadius="8,0,0,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Color}" Value="#FF4444">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Background" Value="#FF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Color}" Value="#F59E0B">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Background" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Color}" Value="#22C55E">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Background" Value="#22C55E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Color}" Value="#3B82F6">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Background" Value="#3B82F6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Color}" Value="#8B5CF6">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Color}" Value="#EC4899">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Background" Value="#EC4899"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Margin="10,2,10,2">
                                                <!-- ═══ ROW 1: Checkbox + Text + Badges + Actions ═══ -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Priority dot -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Timer+Reminder -->
                                                        <ColumnDefinition Width="*"/>    <!-- Text -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Badges -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Priority indicator dot (click to cycle) -->
                                                    <Border x:Name="TodoPriorityBorder" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" 
                                                            Cursor="Hand" MouseLeftButtonDown="TodoItemPriority_Click" VerticalAlignment="Center"
                                                            ToolTip="{Binding PriorityDisplay}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Setter Property="Background" Value="#666680"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPriority}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                        <Setter Property="Background" Value="#FF4444"/>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                        <Setter Property="Background" Value="#22C55E"/>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!-- Custom Circle Checkbox -->
                                                    <Border x:Name="TodoCheckboxBorder" Grid.Column="1" Width="18" Height="18" CornerRadius="9" Margin="2,0,10,0" 
                                                            Cursor="Hand" MouseLeftButtonDown="TodoItemCheck_Click" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessColor}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}"/>
                                                                    </DataTrigger>
                                                                    <!-- Priority-colored checkbox ring (only when not done) -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Priority}" Value="High"/>
                                                                            <Condition Binding="{Binding IsDone}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="BorderBrush" Value="#FF4444"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Priority}" Value="Medium"/>
                                                                            <Condition Binding="{Binding IsDone}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Priority}" Value="Low"/>
                                                                            <Condition Binding="{Binding IsDone}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="BorderBrush" Value="#22C55E"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ui:SymbolIcon Symbol="Checkmark12" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </Border>

                                                    <!-- Timer & Reminder icons (always visible when set) -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <!-- Timer icon -->
                                                        <Border CornerRadius="3" Cursor="Hand" Padding="2,1" Margin="0,0,2,0"
                                                                Background="#1810B981"
                                                                MouseLeftButtonDown="TodoItemTimer_Click" ToolTip="Start Timer">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasTimer}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <ui:SymbolIcon Symbol="Timer16" Foreground="#10B981" FontSize="9"/>
                                                        </Border>
                                                        <!-- Reminder icon -->
                                                        <Border CornerRadius="3" Cursor="Hand" Padding="2,1"
                                                                Background="#18F59E0B"
                                                                MouseLeftButtonDown="TodoItemReminder_Click" ToolTip="Set Reminder">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasReminder}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <ui:SymbolIcon Symbol="Alert16" Foreground="#F59E0B" FontSize="9"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Todo Text -->
                                                    <TextBox Grid.Column="3" x:Name="TodoItemTextBox"
                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="13" Background="Transparent" BorderThickness="0" Padding="0"
                                                             CaretBrush="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                                                             SelectionBrush="#608B5CF6" VerticalAlignment="Center"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             TextChanged="TodoItemText_TextChanged"
                                                             GotFocus="TodoItemText_GotFocus"
                                                             PreviewKeyDown="TodoItemText_PreviewKeyDown">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <!-- Placeholder text -->
                                                    <TextBlock Grid.Column="3" Text="What needs to be done?" FontSize="13"
                                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                                                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="0" Opacity="0.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Right-side badges & actions -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0,4,0" HorizontalAlignment="Right" MinWidth="56">
                                                        <!-- Created time -->
                                                        <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="9" 
                                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"
                                                                   HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.7"/>

                                                        <!-- More button + Collapse chevron side-by-side -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                            <!-- Dropdown menu button (always visible) -->
                                                            <Border x:Name="TodoDropdownButton" CornerRadius="6" Cursor="Hand" Padding="6,3" Margin="0,0,2,0"
                                                                    MouseLeftButtonDown="TodoItemMore_Click" ToolTip="More options">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#0CFFFFFF"/>
                                                                        <Setter Property="BorderBrush" Value="#18808080"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#20FFFFFF"/>
                                                                                <Setter Property="BorderBrush" Value="#40808080"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <ui:SymbolIcon Symbol="MoreHorizontal24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11"/>
                                                            </Border>

                                                            <!-- Collapse/expand chevron -->
                                                            <Border x:Name="TodoCollapseBtn" CornerRadius="4" Cursor="Hand" Padding="4,3"
                                                                    MouseLeftButtonDown="TodoItemCollapse_Click" Background="Transparent">
                                                                <TextBlock Text="{Binding CollapseIcon}" FontSize="9" FontWeight="Bold" 
                                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Status badges row -->
                                                        <WrapPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                                                            <!-- Due Date badge -->
                                                            <Border x:Name="TodoDueDateBadge" CornerRadius="4" Padding="4,1" Margin="0,0,2,1"
                                                                    Cursor="Hand" MouseLeftButtonDown="TodoItemDueDate_Click" ToolTip="Click to change due date">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#18F59E0B"/>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDueDate}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                                <Setter Property="Background" Value="#18FF4444"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding DueDateDisplay}" FontSize="8" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#FF4444"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Timer badge -->
                                                            <Border x:Name="TodoTimerBadge" CornerRadius="4" Padding="4,1" Margin="0,0,2,1"
                                                                    Background="#1810B981" Cursor="Hand"
                                                                    MouseLeftButtonDown="TodoItemSetTimer_Click" ToolTip="Click to cycle timer preset">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasTimer}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding TimerDisplay}" FontSize="8" FontWeight="SemiBold" Foreground="#10B981"/>
                                                            </Border>

                                                            <!-- Reminder badge -->
                                                            <Border x:Name="TodoReminderBadge" CornerRadius="4" Padding="4,1" Margin="0,0,2,1"
                                                                    Background="#18F59E0B">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasReminder}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ReminderDisplay}" FontSize="8" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                                            </Border>

                                                            <!-- Recurrence badge -->
                                                            <Border x:Name="TodoRecurrenceBadge" CornerRadius="4" Padding="4,1" Margin="0,0,2,1"
                                                                    Background="#188B5CF6" Cursor="Hand" MouseLeftButtonDown="TodoItemRecurrence_Click">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasRecurrence}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding RecurrenceDisplay}" FontSize="7.5" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                                                            </Border>

                                                            <!-- Subtask badge removed (use subtask list itself) -->


                                                            <!-- Description indicator badge -->
                                                            <Border x:Name="TodoDescBadge" CornerRadius="4" Padding="3,1" Margin="0,0,2,1"
                                                                    Background="#1810B981" ToolTip="Has description">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="📝" FontSize="7.5"/>
                                                            </Border>

                                                            <!-- Priority label badge -->
                                                            <Border x:Name="TodoPriorityBadge" CornerRadius="4" Padding="4,1" Margin="0,0,0,1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Setter Property="Background" Value="#20FF4444"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Setter Property="Background" Value="#20F59E0B"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Setter Property="Background" Value="#2022C55E"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding PriorityDisplay}" FontSize="8" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#666680"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                                    <Setter Property="Foreground" Value="#FF4444"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </WrapPanel>


                                                    </StackPanel>
                                                </Grid>

                                                <!-- ═══ ROW 2: Tags chips (visible when tags exist) ═══ -->
                                                <ItemsControl x:Name="TodoTagsRow" ItemsSource="{Binding Tags}" Margin="42,3,0,0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTags}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Background="#188B5CF6" Padding="5,1,5,2" Margin="0,0,3,2">
                                                                <TextBlock Text="{Binding}" FontSize="8.5" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- ═══ ROW 3: Description area (collapsed by default, toggle via click) ═══ -->
                                                <TextBox x:Name="TodoDescriptionBox" Margin="42,4,4,0" Padding="6,4"
                                                         Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="10.5" TextWrapping="Wrap" AcceptsReturn="True"
                                                         Background="{DynamicResource MicaWPF.Brushes.ControlAltFillColorTertiary}"
                                                         Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"
                                                         BorderThickness="1" BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}"
                                                         TextChanged="TodoDescriptionText_TextChanged">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDescriptionVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <!-- ═══ ROW 4: Subtasks list (visible when subtasks exist) ═══ -->
                                                <ItemsControl x:Name="TodoSubtasksList" ItemsSource="{Binding SubTasks}" Margin="42,4,4,0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSubTasks}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Subtask mini checkbox -->
                                                                <Border Grid.Column="0" Width="13" Height="13" CornerRadius="3" Margin="0,0,5,0"
                                                                        Cursor="Hand" MouseLeftButtonDown="TodoSubtaskCheck_Click" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource SuccessColor}"/>
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <ui:SymbolIcon Symbol="Checkmark12" Foreground="White" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <ui:SymbolIcon.Style>
                                                                            <Style TargetType="ui:SymbolIcon">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ui:SymbolIcon.Style>
                                                                    </ui:SymbolIcon>
                                                                </Border>
                                                                <!-- Subtask text -->
                                                                <TextBox Grid.Column="1" x:Name="TodoSubtaskTextBox"
                                                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontSize="13" Background="Transparent" BorderThickness="0" Padding="0,1"
                                                                         CaretBrush="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                                                                         TextWrapping="Wrap" TextChanged="TodoSubtaskText_TextChanged" PreviewKeyDown="TodoSubtask_PreviewKeyDown">

                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="TextBox">
                                                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>

                                        <!-- Show color strip with correct color -->
                                        <DataTrigger Binding="{Binding HasColor}" Value="True">
                                            <Setter TargetName="TodoColorStrip" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Color}" Value="#FF4444">
                                            <Setter TargetName="TodoColorStrip" Property="Background" Value="#FF4444"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Color}" Value="#F59E0B">
                                            <Setter TargetName="TodoColorStrip" Property="Background" Value="#F59E0B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Color}" Value="#22C55E">
                                            <Setter TargetName="TodoColorStrip" Property="Background" Value="#22C55E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Color}" Value="#3B82F6">
                                            <Setter TargetName="TodoColorStrip" Property="Background" Value="#3B82F6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Color}" Value="#8B5CF6">
                                            <Setter TargetName="TodoColorStrip" Property="Background" Value="#8B5CF6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Color}" Value="#EC4899">
                                            <Setter TargetName="TodoColorStrip" Property="Background" Value="#EC4899"/>
                                        </DataTrigger>
                                        <!-- Priority-based card left border tinting -->
                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                            <Setter TargetName="TodoCard" Property="BorderBrush" Value="#40FF4444"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                            <Setter TargetName="TodoCard" Property="BorderBrush" Value="#30F59E0B"/>
                                        </DataTrigger>
                                        <!-- Completed card visual dim -->
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter TargetName="TodoCard" Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- TODO EMPTY STATE -->
                    <StackPanel x:Name="TodoEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=TodoListItemsControl}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Items, ElementName=TodoListItemsControl}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="CheckboxChecked24" FontSize="28" Foreground="{DynamicResource ThemeAccentBg}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No tasks yet" Opacity="0.35" FontSize="12" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="Click Add to list your tasks" Opacity="0.2" FontSize="10.5" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Drag-Over Overlay Zone removed - replaced with elegant mini arrow animation in button header -->

    </Grid>
    </Border>
</controls:MicaWindow>
