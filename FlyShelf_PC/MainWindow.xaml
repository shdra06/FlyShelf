<controls:MicaWindow x:Class="FlyShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:vm="clr-namespace:FlyShelf.ViewModels"
        xmlns:settings="clr-namespace:FlyShelf.Classes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:local="clr-namespace:FlyShelf.Controls"
        Title="FlyShelf" 
        Width="360" 
        Opacity="0"
        MaxHeight="300" SizeToContent="Manual" MinHeight="100" BorderThickness="0"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" SystemBackdropType="Mica"
        ShowInTaskbar="False" Margin="0" Topmost="True" ShowActivated="False"
        AllowDrop="True" PreviewDrop="Window_PreviewDrop" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" PreviewDragOver="Window_PreviewDragOver"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="MicaWindow_Loaded" Deactivated="MicaWindow_Deactivated">

    <controls:MicaWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Resources/Styles/GlobalScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Premium Glassmorphism Style for Header Toolbar Buttons -->
            <Style x:Key="PremiumHeaderButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Background" Value="{DynamicResource ThemeHeaderBtnBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeHeaderBtnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeHeaderBtnFg}"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Focusable" Value="False"/>
                <Style.Resources>
                    <!-- Hardcoded fallback colors (default dark theme) prevent WPF-UI's accent color
                         from flashing during startup before theme dictionaries are merged.
                         The outer DynamicResource Brush setters still update these once themes load. -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ThemeHeaderBtnBgColor}"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource ThemeHeaderBtnBorderColor}"/>

                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ThemeHeaderBtnBgHoverColor}"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ThemeHeaderBtnBorderHoverColor}"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeHeaderBtnFgHoverColor}"/>
                    
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource ThemeHeaderBtnBgPressedColor}"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource ThemeHeaderBtnBorderPressedColor}"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource ThemeHeaderBtnFgPressedColor}"/>
                </Style.Resources>
            </Style>


            <!-- Shared ContextMenu cached at Window level to prevent duplicate MenuItem element allocations -->
            <ContextMenu x:Key="CardContextMenu" x:Shared="False" StaysOpen="False" Opened="CardContextMenu_Opened">
                <ContextMenu.Resources>
                    <Style TargetType="Separator">
                        <Setter Property="Margin" Value="8,4"/>
                        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontSize" Value="12.5"/>
                    </Style>
                </ContextMenu.Resources>

                <!-- ═══ Universal: Pin / Unpin ═══ -->
                <MenuItem Header="{Binding PlacementTarget.DataContext.PinLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                <!-- ═══ Universal: Copy Content ═══ -->
                <MenuItem Header="Copy to Clipboard" 
                          Command="{Binding PlacementTarget.Tag.CopyRawContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                <Separator />

                <!-- ═══ TEXT / CODE Actions ═══ -->
                <MenuItem Click="GoogleSearch_Click" 
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsTextPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0"/><TextBlock Text="Search on Google"/></StackPanel>
                    </MenuItem.Header>
                </MenuItem>



                <!-- 🔒 Mark as Password -->
                <MenuItem Click="MarkAsPassword_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.CanConvertToPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Shield24" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0"/><TextBlock Text="Mark as Password"/></StackPanel>
                    </MenuItem.Header>
                </MenuItem>

                <!-- 🔑 View/Edit Password -->
                <MenuItem Click="ViewEditPassword_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Key24" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0"/><TextBlock Text="View/Edit Password"/></StackPanel>
                    </MenuItem.Header>
                </MenuItem>

                <!-- ✏️ Rename Label -->
                <MenuItem Click="RenamePasswordLabel_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Edit24" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0"/><TextBlock Text="Rename Label"/></StackPanel>
                    </MenuItem.Header>
                </MenuItem>

                <!-- Revert to Normal Text -->
                <MenuItem Header="Revert to Normal Text" Click="RevertToText_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPassword, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ CODE: VS Code + Terminal ═══ -->
                <MenuItem Header="Open in VS Code" 
                          Command="{Binding PlacementTarget.Tag.LaunchSandboxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Run in Terminal" 
                          Command="{Binding PlacementTarget.Tag.LaunchTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Compile C++ &amp; Run" 
                          Command="{Binding PlacementTarget.Tag.CompileNativeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsCPlusPlusPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ SMART ACTIONS ═══ -->
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Rocket24" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0"/><TextBlock Text="Smart Actions"/></StackPanel>
                    </MenuItem.Header>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.HasSmartBadge, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.HasEmail, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsJsonPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                    <MenuItem Header="Pretty Print JSON" Click="PrettyPrintJson_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.DataContext.IsJsonPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <MenuItem Header="Compose Email" Click="ComposeEmail_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.DataContext.HasEmail, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <MenuItem Header="Evaluate Math" Click="EvaluateMath_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.DataContext.IsMathExpression, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <MenuItem Header="Decode Base64" Click="DecodeBase64_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.DataContext.IsBase64Content, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <MenuItem Header="Convert Timestamp" Click="ConvertEpoch_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.DataContext.IsEpochTimestamp, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </MenuItem>

                <!-- ═══ AI ACTIONS (Text items) ═══ -->
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Sparkle24" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0" Foreground="#A78BFA"/><TextBlock Text="AI Actions"/></StackPanel>
                    </MenuItem.Header>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsTextPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                    <MenuItem Header="Summarize" Click="AISummarize_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Fix Grammar" Click="AIFixGrammar_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Rewrite (Formal)" Click="AIRewriteFormal_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Rewrite (Casual)" Click="AIRewriteCasual_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Explain Code" Click="AIExplainCode_Click"
                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </MenuItem>

                <!-- ═══ IMAGE: OCR Extract + Gemini Table ═══ -->
                <MenuItem Header="Extract Text (OCR)" 
                          Command="{Binding PlacementTarget.Tag.ExtractTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Extract Table Data" 
                          Command="{Binding PlacementTarget.Tag.ExtractTableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Foreground="{DynamicResource GeminiAccentColor}"
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Convert Image to PDF" 
                          Command="{Binding PlacementTarget.Tag.ConvertImageToPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Scan QR Code" 
                          Command="{Binding PlacementTarget.Tag.ManualScanQRCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Foreground="{DynamicResource GeminiAccentColor}"
                          Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ PDF: Open + Convert ═══ -->
                <MenuItem Header="Open PDF in Browser" 
                          Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsPdfPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Convert PDF to Word" Click="ConvertPdfToWord_Click" 
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPdfPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="Reorder PDF Pages" Click="ReorderPdfPages_Click" 
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.IsPdfPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ DOCUMENT: Convert to PDF ═══ -->
                <MenuItem Header="Convert to PDF" 
                          Command="{Binding PlacementTarget.Tag.ConvertDocumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsDocPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ URL: Open in Browser ═══ -->
                <MenuItem Header="Open in Browser" 
                          Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          Visibility="{Binding PlacementTarget.DataContext.IsUrlPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Separator />

                <!-- ═══ SEND TO DEVICE — one-way push to connected peers ═══ -->
                <MenuItem x:Name="SendToDeviceMenu">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Send24" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0" Foreground="#10B981"/>
                            <TextBlock Text="Send to Device"/>
                        </StackPanel>
                    </MenuItem.Header>
                    <!-- Sub-items populated dynamically in CardContextMenu_Opened -->
                </MenuItem>

                <!-- ═══ FILE-BACKED: Rename ═══ -->
                <MenuItem Header="Rename" Click="RenameItem_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.CanRename, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ FILE-BACKED: Show in Explorer ═══ -->
                <MenuItem Header="Show in Explorer" 
                          Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.CanShowInExplorer, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ═══ FILE-BACKED: Copy File Path ═══ -->
                <MenuItem Header="Copy Path" Click="CopyFilePath_Click"
                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.DataContext.HasFilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.Name="Copy file path to clipboard"/>

                <!-- ═══ Universal: Delete ═══ -->
                <MenuItem Header="Delete" Click="DeleteContextMenu_Click" Foreground="{DynamicResource DangerColor}"/>
            </ContextMenu>
        </ResourceDictionary>
    </controls:MicaWindow.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CornerRadius="{StaticResource RadiusMD}" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Border CornerRadius="{StaticResource RadiusMD}" ClipToBounds="True">
    <Grid x:Name="RootContent" Margin="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" PreviewMouseDown="RootContent_PreviewMouseDown" Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ WALLPAPER LAYERS (hidden when no wallpaper set) ═══ -->
        <!-- Layer 1: Full background image (center, fills entire window) -->
        <Image x:Name="WallpaperBg" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.42"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <!-- Layer 2: Theme color gradient overlay emanating from center -->
        <Border x:Name="WallpaperThemeOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush x:Name="WallpaperRadialBrush" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#60000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- [FIX XAML-7]: Added BitmapCache to cache software-rendered OpacityMask subtree -->
        <Border x:Name="WallpaperFrostHeader" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                ClipToBounds="True" CornerRadius="12,12,0,0" Height="90" VerticalAlignment="Top"
                CacheMode="BitmapCache">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC000000" Offset="0"/>
                    <GradientStop Color="#66000000" Offset="0.35"/>
                    <GradientStop Color="#22000000" Offset="0.65"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid>
                <Image x:Name="WallpaperFrostImg" Stretch="UniformToFill" Opacity="0.15"
                       RenderOptions.BitmapScalingMode="LowQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- Subtle tinted glass overlay -->
                <Border x:Name="WallpaperFrostTint" Background="#18000000"/>
            </Grid>
        </Border>

        <tray:NotifyIcon
            FocusOnLeftClick="False"
            Icon="pack://application:,,,/Resources/FlyShelfLogo.ico"
            MenuOnRightClick="True"
            LeftClick="nIcon_LeftClick"
            TooltipText="FlyShelf">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Open Clipboard  (Alt+C)" Click="TrayOpenClipboard_Click" />
                    <MenuItem Header="Open FlyShelf Hub" Click="TrayOpenHub_Click" />
                    <Separator />
                    <MenuItem Header="Quit FlyShelf" Click="NotifyIconQuit_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
        
        <StackPanel Grid.Row="0" x:Name="HeaderAndFiltersStack">
            <!-- ═══ UPDATE NOTIFICATION BANNER ═══ -->
            <Border x:Name="UpdateNotificationBanner" Visibility="Collapsed" 
                    Margin="10,8,10,0" CornerRadius="{StaticResource RadiusSM}" Padding="10,6,6,6"
                    Cursor="Hand" MouseLeftButtonDown="UpdateBanner_Click">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A6366F1" Offset="0"/>
                        <GradientStop Color="#1A8B5CF6" Offset="0.5"/>
                        <GradientStop Color="#1AA78BFA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#336366F1" Offset="0"/>
                        <GradientStop Color="#338B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowCircleUp24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource ThemeAccentLight}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="UpdateBannerText" Text="New version available — tap to update" 
                               FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" x:Name="UpdateBannerDismissBtn" Click="UpdateBannerDismiss_Click"
                            Focusable="False" Cursor="Hand" VerticalAlignment="Center" Margin="4,0,0,0"
                            ToolTip="Dismiss" AutomationProperties.Name="Dismiss update notification">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DismissBg" Width="20" Height="20" CornerRadius="{StaticResource RadiusMD}" 
                                                    Background="Transparent">
                                                <ui:SymbolIcon Symbol="Dismiss12" FontSize="{StaticResource TypeCaption}" 
                                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DismissBg" Property="Background" Value="{DynamicResource ThemeOverlayBgHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="TopHeaderGrid" Margin="14,14,14,8" Background="#01000000" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <!-- Inline Search Bar (covers the left area up to the search icon) -->
                <Border x:Name="SearchBarContainer" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Center"
                        Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="{StaticResource RadiusSM}"
                        BorderThickness="1"
                        Padding="4,0,4,0" Margin="0,0,6,0" Height="28" MinWidth="160" HorizontalAlignment="Stretch"
                        Panel.ZIndex="10" PreviewMouseLeftButtonDown="SearchBar_PreviewMouseDown"
                        RenderTransformOrigin="1,0.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderStrong}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Search input with integrated placeholder -->
                        <TextBox x:Name="SearchTextBox" Grid.Column="0" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                                 FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" VerticalContentAlignment="Center" 
                                 CaretBrush="{DynamicResource ThemeAccent}" Padding="0" Margin="0"
                                 HorizontalContentAlignment="Left" MinWidth="100"
                                 TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                                 AutomationProperties.Name="Search clipboard history" TabIndex="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid Background="Transparent">
                                                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="-2,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                    <TextBlock x:Name="PlaceholderText" Text="Search..." 
                                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                                               VerticalAlignment="Center" FontSize="{StaticResource TypeBody}" IsHitTestVisible="False" Margin="0"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- Clear search button -->
                        <ui:Button Grid.Column="1" Focusable="False" Appearance="Transparent" Foreground="{DynamicResource SubtleTextColor}" Click="ClearSearch_Click" ToolTip="Clear Search" 
                                   Margin="2,0,0,0" Padding="3,3" CornerRadius="4" Width="20" Height="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                   Background="Transparent" BorderThickness="0" AutomationProperties.Name="Clear search">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss12" FontSize="{StaticResource TypeMicro}"/></ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>
                
                <Grid Grid.Column="1" HorizontalAlignment="Right">
                    <!-- Layer 1: Toolbar buttons (hidden when search is active) -->
                    <StackPanel x:Name="ToolbarButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    
                        <!-- Search Toggle -->
                        <ui:Button x:Name="SearchToggleBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="SearchToggle_Click" ToolTip="Search Clipboard (Ctrl+F)" Margin="0,0,6,0" AutomationProperties.Name="Search clipboard" TabIndex="2">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Search24" /></ui:Button.Icon>
                        </ui:Button>
 
                         <!-- Bouncy Drag Drop Arrow Indicator — borderless, appears only when dragging -->
                         <Grid Width="28" Height="28" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                             <Grid.Style>
                                 <Style TargetType="Grid">
                                     <Setter Property="Visibility" Value="Collapsed"/>
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding IsDragHovering, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                             <Setter Property="Visibility" Value="Visible"/>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </Grid.Style>
                             <ui:SymbolIcon Symbol="ArrowDown24" Foreground="{DynamicResource SyncIncomingColor}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                 <ui:SymbolIcon.RenderTransform>
                                     <TranslateTransform x:Name="ArrowTranslate" Y="0"/>
                                 </ui:SymbolIcon.RenderTransform>
                                 <ui:SymbolIcon.Style>
                                     <Style TargetType="ui:SymbolIcon">
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsDragHovering, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                 <DataTrigger.EnterActions>
                                                     <BeginStoryboard x:Name="BounceArrowStory">
                                                         <Storyboard RepeatBehavior="Forever" Storyboard.DesiredFrameRate="20">
                                                             <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                              From="-4" To="4" Duration="{StaticResource Motion.Slow}" AutoReverse="True">
                                                                 <DoubleAnimation.EasingFunction>
                                                                     <StaticResource ResourceKey="Motion.EaseInOut" />
                                                                 </DoubleAnimation.EasingFunction>
                                                             </DoubleAnimation>
                                                         </Storyboard>
                                                     </BeginStoryboard>
                                                 </DataTrigger.EnterActions>
                                                 <DataTrigger.ExitActions>
                                                     <StopStoryboard BeginStoryboardName="BounceArrowStory"/>
                                                 </DataTrigger.ExitActions>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </ui:SymbolIcon.Style>
                             </ui:SymbolIcon>
                         </Grid>
 
                         <!-- Quick Notes Toggle -->
                         <ui:Button x:Name="NotesToggleBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="NotesToggle_Click" ToolTip="Quick Notes" Margin="0,0,6,0" AutomationProperties.Name="Quick Notes" TabIndex="3">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.16"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.38"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="List24" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- To-Do List Toggle -->
                         <ui:Button x:Name="TodoToggleBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="TodoToggle_Click" ToolTip="To-Do List" Margin="0,0,6,0" AutomationProperties.Name="To-Do List" TabIndex="4">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.16"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.38"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="TaskListSquareLtr24" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- Networking Mode Toggle -->
                         <ui:Button x:Name="ResearchToggleBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ResearchToggle_Click" ToolTip="Networking — Send files to connected devices" Margin="0,0,6,0" AutomationProperties.Name="Networking panel" TabIndex="5">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.16"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.38"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="Wifi124" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- Sort/Filter by Category -->
                         <ui:Button x:Name="SortFilterBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="SortFilter_Click" ToolTip="Filter by Category" Margin="0,0,6,0" AutomationProperties.Name="Filter by category" TabIndex="6">
                             <ui:Button.Icon><ui:FontIcon Glyph="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- Stopwatch Button (only visible in To-Do list mode) -->
                         <ui:Button x:Name="TodoStopwatchBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="TodoStopwatch_Click" ToolTip="Stopwatch Timer" Margin="0,0,6,0" Visibility="Collapsed" AutomationProperties.Name="Stopwatch timer">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.16"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.38"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:Button.Icon>
                         </ui:Button>

                         <!-- AI Settings Toggle (hidden from toolbar — accessible via Settings) -->
                         <ui:Button x:Name="AiSettingsToggleBtn" Visibility="Collapsed" Style="{StaticResource PremiumHeaderButtonStyle}" Click="AiSettingsToggle_Click" ToolTip="AI Settings" Margin="0,0,6,0" AutomationProperties.Name="AI Settings">
                             <ui:Button.Resources>
                                 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.16"/>
                                 <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ThemeAccentColor}" Opacity="0.38"/>
                                 <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ThemeAccentLightColor}"/>
                             </ui:Button.Resources>
                             <ui:Button.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:Button.Icon>
                         </ui:Button>


                          <!-- ═══ Incognito Mode Badge (small indicator in header) ═══ -->
                          <Border x:Name="IncognitoBadge" Visibility="Collapsed" Cursor="Hand"
                                  CornerRadius="{StaticResource RadiusSM}" Margin="0,0,6,0" Padding="6,4" VerticalAlignment="Center"
                                  MouseLeftButtonDown="IncognitoBadge_Click"
                                  ToolTip="Incognito mode active — clipboard monitoring paused. Click to disable.">
                              <Border.Background>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                      <GradientStop Color="#28F59E0B" Offset="0"/>
                                      <GradientStop Color="#18FBBF24" Offset="1"/>
                                  </LinearGradientBrush>
                              </Border.Background>
                              <Border.BorderBrush>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                      <GradientStop Color="#50F59E0B" Offset="0"/>
                                      <GradientStop Color="#30FBBF24" Offset="1"/>
                                  </LinearGradientBrush>
                              </Border.BorderBrush>
                              <Border.BorderThickness>1</Border.BorderThickness>
                              <StackPanel Orientation="Horizontal">
                                  <ui:SymbolIcon Symbol="EyeOff24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource WarningColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                  <TextBlock x:Name="IncognitoBadgeText" Text="Incognito" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource WarningColor}" VerticalAlignment="Center"/>
                              </StackPanel>
                          </Border>

                          <!-- More Options Button -->
                          <ui:Button x:Name="MoreBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="MoreBtn_Click" ToolTip="More Options" Margin="0,0,6,0" Visibility="Collapsed" AutomationProperties.Name="More options" TabIndex="7">
                              <ui:Button.Icon><ui:SymbolIcon Symbol="MoreHorizontal24" /></ui:Button.Icon>
                          </ui:Button>

                          <!-- ═══ Update Available Badge ═══ -->
                          <Border x:Name="UpdateBadge" Visibility="Collapsed" Cursor="Hand"
                                  CornerRadius="{StaticResource RadiusSM}" Margin="0,0,6,0" Padding="6,4" VerticalAlignment="Center"
                                  MouseLeftButtonDown="UpdateBadge_Click"
                                  ToolTip="Update available — click to open Hub">
                              <Border.Background>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                      <GradientStop Color="#2810B981" Offset="0"/>
                                      <GradientStop Color="#1834D399" Offset="1"/>
                                  </LinearGradientBrush>
                              </Border.Background>
                              <Border.BorderBrush>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                      <GradientStop Color="#5010B981" Offset="0"/>
                                      <GradientStop Color="#3034D399" Offset="1"/>
                                  </LinearGradientBrush>
                              </Border.BorderBrush>
                              <Border.BorderThickness>1</Border.BorderThickness>
                              <StackPanel Orientation="Horizontal">
                                  <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                  <TextBlock x:Name="UpdateBadgeText" Text="Update" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center"/>
                              </StackPanel>
                          </Border>



                          <ui:Button Style="{StaticResource PremiumHeaderButtonStyle}" Click="CloseWindow_Click" ToolTip="Hide (Esc)" AutomationProperties.Name="Hide window" TabIndex="8">
                              <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" Filled="True"/></ui:Button.Icon>
                          </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Dynamic Inline Category Filter Panel — Premium Pill Chips -->
            <Border x:Name="SortFilterInlineBar" Margin="14,0,14,8" Visibility="Collapsed" Opacity="0"
                    CornerRadius="{StaticResource RadiusMD}" Padding="6,5"
                    Background="{DynamicResource MicaWPF.Brushes.SmokeFillColorDefault}"
                    BorderBrush="{DynamicResource ThemeOverlayBorder}" BorderThickness="1"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#000000" Direction="270"/>
                </Border.Effect>
                <ScrollViewer x:Name="CategoryFilterScroller"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              PreviewMouseWheel="CategoryFilterScroller_MouseWheel">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,2,0">

                    <!-- Images Chip -->
                    <Border x:Name="FilterBtn_Images" CornerRadius="{StaticResource RadiusMD}" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="Images"
                            Background="{DynamicResource FilterImageBg}"
                            BorderBrush="{DynamicResource FilterImageBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Image24" Foreground="{DynamicResource TypeImageColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                            <TextBlock Text="Img" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pinned Chip -->
                    <Border x:Name="FilterBtn_Pinned" CornerRadius="{StaticResource RadiusMD}" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="Pinned"
                            Background="{DynamicResource FilterPinnedBg}"
                            BorderBrush="{DynamicResource FilterPinnedBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Pin24" Foreground="{DynamicResource PinActiveColor}" Filled="True" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                            <TextBlock Text="Pin" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF Chip -->
                    <Border x:Name="FilterBtn_Pdf" CornerRadius="{StaticResource RadiusMD}" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="PDF"
                            Background="{DynamicResource FilterPdfBg}"
                            BorderBrush="{DynamicResource FilterPdfBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="{DynamicResource DangerColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                            <TextBlock Text="PDF" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Docs Chip -->
                    <Border x:Name="FilterBtn_Docs" CornerRadius="{StaticResource RadiusMD}" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="Docs"
                            Background="{DynamicResource FilterDocsBg}"
                            BorderBrush="{DynamicResource FilterDocsBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Document24" Foreground="{DynamicResource InfoColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                            <TextBlock Text="Docs" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Password Chip -->
                    <Border x:Name="FilterBtn_Password" CornerRadius="{StaticResource RadiusMD}" Margin="1,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterCategory_Click" Tag="Password"
                            Background="{DynamicResource FilterPasswordBg}"
                            BorderBrush="{DynamicResource FilterPasswordBorder}" BorderThickness="1"
                            Padding="8,5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" Foreground="{DynamicResource TypeArchiveColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                            <TextBlock Text="Keys" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Width="1" Height="20" Margin="3,0" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" VerticalAlignment="Center"/>

                    <!-- Dismiss Chip -->
                    <Border CornerRadius="{StaticResource RadiusMD}" Margin="1,0" Cursor="Hand" MouseLeftButtonDown="FilterClear_Click"
                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                            Padding="6,5" SnapsToDevicePixels="True" ToolTip="Clear Filter">
                        <ui:SymbolIcon Symbol="Dismiss16" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="{StaticResource TypeBody}" HorizontalAlignment="Center"/>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>


            <!-- Sync Direction Control Bar — Inline popup for granular incoming/outgoing toggles -->
            <Border x:Name="SyncDirectionBar" Margin="14,0,14,8" Visibility="Collapsed" Opacity="0"
                    CornerRadius="{StaticResource RadiusMD}" Padding="4"
                    Background="{DynamicResource MicaWPF.Brushes.SmokeFillColorDefault}" 
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <UniformGrid Rows="1" HorizontalAlignment="Center" MaxWidth="420" Width="{Binding ActualWidth, ElementName=TopHeaderGrid}">
                    <!-- Incoming Toggle -->
                    <Border x:Name="SyncBtn_Incoming" CornerRadius="{StaticResource RadiusSM}" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncIncoming_Click" Tag="Incoming"
                            Background="{DynamicResource SyncIncomingBg}" BorderBrush="{DynamicResource SyncIncomingBorder}" BorderThickness="1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource SyncIncomingColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                                <TextBlock Text="In" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse x:Name="SyncDot_Incoming" Grid.Column="1" Width="8" Height="8" Margin="6,0,2,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource ThemeTextMuted}" Opacity="0.5" Stroke="{DynamicResource ThemeOverlayBorder}" StrokeThickness="0.5"/>
                        </Grid>
                    </Border>
                    <!-- Outgoing Toggle -->
                    <Border x:Name="SyncBtn_Outgoing" CornerRadius="{StaticResource RadiusSM}" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncOutgoing_Click" Tag="Outgoing"
                            Background="{DynamicResource SyncOutgoingBg}" BorderBrush="{DynamicResource SyncOutgoingBorder}" BorderThickness="1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowUpload24" Foreground="{DynamicResource InfoColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                                <TextBlock Text="Out" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse x:Name="SyncDot_Outgoing" Grid.Column="1" Width="8" Height="8" Margin="6,0,2,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource ThemeTextMuted}" Opacity="0.5" Stroke="{DynamicResource ThemeOverlayBorder}" StrokeThickness="0.5"/>
                        </Grid>
                    </Border>
                    <!-- Both Master Toggle -->
                    <Border x:Name="SyncBtn_Both" CornerRadius="{StaticResource RadiusSM}" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncBoth_Click" Tag="Both"
                            Background="{DynamicResource SyncBothBg}" BorderBrush="{DynamicResource SyncBothBorder}" BorderThickness="1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource TypeTextColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,4,0"/>
                                <TextBlock Text="Both" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse x:Name="SyncDot_Both" Grid.Column="1" Width="8" Height="8" Margin="6,0,2,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource ThemeTextMuted}" Opacity="0.5" Stroke="{DynamicResource ThemeOverlayBorder}" StrokeThickness="0.5"/>
                        </Grid>
                    </Border>
                    <!-- Dismiss -->
                    <Border CornerRadius="{StaticResource RadiusSM}" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SyncBarDismiss_Click"
                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" Padding="0,5">
                        <ui:SymbolIcon Symbol="Dismiss16" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="{StaticResource TypeBody}" HorizontalAlignment="Center"/>
                    </Border>
                </UniformGrid>
            </Border>


            <!-- Floating Overflow Menu Popup -->
            <Popup x:Name="OverflowPopup" PlacementTarget="{x:Reference MoreBtn}" 
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" 
                   VerticalOffset="8" HorizontalOffset="-72" PopupAnimation="Fade"
                   Closed="OverflowPopup_Closed">
                <!-- Floating Glassmorphism Container with Premium Toolbar Look -->
                <Border CornerRadius="{StaticResource RadiusLG}" Padding="0" BorderThickness="1"
                        Background="{DynamicResource ThemeOverflowBg}"
                        BorderBrush="{DynamicResource ThemeOverflowBorder}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource ThemeOverflowShadowColor}"/>
                    </Border.Effect>
                    <!-- Inner glow border for depth -->
                    <Border CornerRadius="15" Padding="8,6" BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeOverlayBg}" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <!-- Emoji Picker -->
                        <ui:Button x:Name="EmojiBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="EmojiPicker_Click" ToolTip="Emoji Picker" Margin="0,0,4,0" Padding="0" AutomationProperties.Name="Emoji picker">
                            <ui:SymbolIcon Symbol="Emoji24" FontSize="{StaticResource TypeTitle}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Margin="0,-1,0,0"/>
                        </ui:Button>

                        <!-- Merge PDF button — hidden by default, replaces emoji space when PDFs selected -->
                        <ui:Button x:Name="MergePdfToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Visibility="Collapsed" Click="MergeSelectedPdfsBtn_Click" ToolTip="Merge Selected PDFs" Margin="0,0,4,0" AutomationProperties.Name="Merge selected PDFs">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Layer24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="InstantMergePdfToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Visibility="Collapsed" Click="InstantMergeSelectedPdfsBtn_Click" ToolTip="Instant Merge (Direct)" Margin="0,0,4,0" AutomationProperties.Name="Instant merge selected PDFs">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Flash24" Filled="True" Foreground="{DynamicResource ThemeAccentLight}"/></ui:Button.Icon>
                        </ui:Button>
                        
                        <!-- Global Sync Toggle -->
                        <ui:Button x:Name="SyncToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ToggleGlobalSync_Click" ToolTip="Toggle All Sync" Margin="0,0,4,0" AutomationProperties.Name="Toggle sync">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" Filled="True"/></ui:Button.Icon>
                        </ui:Button>

                        <!-- Unpin toolbar button — hidden by default, replaces sync space when pinned items selected -->
                        <ui:Button x:Name="UnpinToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Visibility="Collapsed" Click="UnpinSelectedBtn_Click" ToolTip="Unpin Selected Items" Margin="0,0,4,0" AutomationProperties.Name="Unpin selected items">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="PinOff24"/></ui:Button.Icon>
                        </ui:Button>

                        <!-- Shortcuts Button -->
                        <ui:Button x:Name="ShortcutsToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ShortcutsBtn_Click" ToolTip="Text Shortcuts" Margin="0,0,4,0" AutomationProperties.Name="Text shortcuts">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Rocket24" /></ui:Button.Icon>
                        </ui:Button>

                        <!-- Reminders Button -->
                        <ui:Button x:Name="ReminderToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ReminderBtn_Click" ToolTip="Reminders" Margin="0,0,4,0" AutomationProperties.Name="Reminders">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Alert24" /></ui:Button.Icon>
                        </ui:Button>

                        <!-- Clear Shelf Button -->
                        <ui:Button x:Name="ClearAllToolbarBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="ClearAllToolbar_Click" ToolTip="Clear Shelf (Delete Unpinned)" Margin="0,0,4,0" AutomationProperties.Name="Clear shelf">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24"/></ui:Button.Icon>
                        </ui:Button>

                        <!-- Open Settings Hub -->
                        <ui:Button x:Name="OpenSettingsBtn" Style="{StaticResource PremiumHeaderButtonStyle}" Click="OpenApp_Click" ToolTip="Open Hub (Settings)" AutomationProperties.Name="Open settings hub">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    </Border>
                </Border>
            </Popup>

            <!-- Clear Shelf Confirmation Popup (same style as SortFilterInlineBar) -->
            <Border x:Name="ClearConfirmPanel" Margin="14,0,14,8" Visibility="Collapsed" Opacity="0"
                    CornerRadius="{StaticResource RadiusMD}" Padding="8,6"
                    Background="{DynamicResource MicaWPF.Brushes.SmokeFillColorDefault}" 
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource WarningColor}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Clear all clips?" FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                    <!-- Confirm button (red danger pill) -->
                    <Border CornerRadius="{StaticResource RadiusSM}" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="ClearShelf_Confirm"
                            Background="{DynamicResource DangerBgSubtle}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1" Padding="12,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource DangerColor}" Filled="True" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,5,0"/>
                            <TextBlock Text="Confirm" FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Cancel button (neutral pill) -->
                    <Border CornerRadius="{StaticResource RadiusSM}" Cursor="Hand" MouseLeftButtonDown="ClearShelf_Cancel"
                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" Padding="12,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Dismiss24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="{StaticResource TypeSubtitle}" Margin="0,0,5,0"/>
                            <TextBlock Text="Cancel" FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ Incognito Mode Toggle Strip (popup bar below header) ═══ -->
            <Border x:Name="IncognitoToggleBar" Margin="14,0,14,8" Visibility="Collapsed"
                    CornerRadius="{StaticResource RadiusMD}" Padding="10,6"
                    Background="{DynamicResource MicaWPF.Brushes.SmokeFillColorDefault}"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#50F59E0B" Offset="0"/>
                        <GradientStop Color="#30FBBF24" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: Icon + Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="EyeOff24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource WarningColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="IncognitoToggleBarText" Text="Incognito Mode Active" FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource WarningColor}"/>
                    </StackPanel>
                    <!-- Right: Toggle Switch -->
                    <ToggleButton x:Name="IncognitoToggle" Grid.Column="1" IsChecked="True" Click="IncognitoToggle_Click"
                                  Width="36" Height="18" Cursor="Hand" VerticalAlignment="Center"
                                  ToolTip="Toggle off to resume clipboard monitoring">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid>
                                    <Border x:Name="Track" CornerRadius="9" Width="36" Height="18"
                                            Background="#60F59E0B" BorderBrush="#50F59E0B" BorderThickness="1"/>
                                    <Border x:Name="Knob" Width="14" Height="14" CornerRadius="{StaticResource RadiusSM}"
                                            Background="White" HorizontalAlignment="Right" Margin="0,0,2,0"
                                            VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Left"/>
                                        <Setter TargetName="Knob" Property="Margin" Value="2,0,0,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>

        </StackPanel>

        <!-- ═══ MASCOT THEME OVERLAYS ═══ -->
        <!-- Header Mascot: beside the search icon (top-right of toolbar) -->
        <Canvas Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="42" Height="42" Margin="8,6,0,0" Panel.ZIndex="20" IsHitTestVisible="False">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Hide mascot when search bar is visible -->
                        <DataTrigger Binding="{Binding ElementName=SearchBarContainer, Path=Visibility}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <local:SpriteAnimator x:Name="MascotIdle" 
                                  SpriteWidth="42" SpriteHeight="42"
                                  Width="42" Height="42"/>
        </Canvas>

        <!-- Premium frosted veil — subtly dims the Mica/wallpaper backdrop for crisp content readability -->
        <Border Grid.RowSpan="2" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="#000000" Opacity="0.12" />
            </Border.Background>
        </Border>

        <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="2" VerticalAlignment="Top" 
                     IsIndeterminate="True" Visibility="Collapsed" Panel.ZIndex="100"
                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeAccentLight}"/>

        <ListView Name="ShelfListView" Grid.Row="1" ItemsSource="{Binding DroppedItems}" Background="#01000000" BorderThickness="0" Margin="12,0,2,12" Padding="0,0,0,80"
                  Focusable="True" KeyboardNavigation.DirectionalNavigation="Contained" FocusVisualStyle="{x:Null}"
                  AutomationProperties.Name="Clipboard items list" TabIndex="10"
                  UseLayoutRounding="True" SnapsToDevicePixels="True"
                  TextOptions.TextRenderingMode="ClearType"
                  TextOptions.TextHintingMode="Auto"
                  RenderOptions.ClearTypeHint="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.CacheLength="0.5,0.5"
                  VirtualizingPanel.CacheLengthUnit="Page"
                  SelectionMode="Extended" MouseMove="ShelfListView_MouseMove" PreviewMouseLeftButtonDown="ShelfListView_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="ShelfListView_PreviewMouseLeftButtonUp"
                  MouseDoubleClick="ShelfListView_MouseDoubleClick" SelectionChanged="ShelfListView_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  AlternationCount="10"
                  PreviewKeyDown="ShelfListView_KeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FlyShelfFocusVisual}"/>
                    <Setter Property="Focusable" Value="True"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                        BorderThickness="0" CornerRadius="{StaticResource RadiusMD}" Margin="4,1,14,2">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <ControlTemplate.Triggers>

                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!-- NOTE: Loaded animation REMOVED — virtualization recycling fires Loaded on every scroll, causing severe lag -->
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Name="CardBorder" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="{StaticResource RadiusMD}" Margin="0" Padding="0" RenderTransformOrigin="0.5,0.5" ClipToBounds="True"
                                UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.ClearTypeHint="Enabled">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource MicaWPF.Colors.SubtleFillColorSecondary}" Opacity="0.38" />
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Opacity" Value="1" />
                                <!-- NOTE: Loaded animation REMOVED — virtualization recycling causes lag -->
                                <Style.Triggers>
                                    <!-- STABILITY FIX: Gate hover animation by AllowHover to prevent
                                         dozens of simultaneous enter/exit animations during fast scrolling.
                                         AllowHover is only true when the user physically moves the mouse
                                         and scrolling has stopped. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.AllowHover, ElementName=ShelfListView}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource ThemeOverlayBgHover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderHover}" />
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="-1.5" Duration="{StaticResource Motion.Fast}">
                                                        <DoubleAnimation.EasingFunction>
                                                            <StaticResource ResourceKey="Motion.EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="0" Duration="{StaticResource Motion.Normal}">
                                                        <DoubleAnimation.EasingFunction>
                                                            <StaticResource ResourceKey="Motion.EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform Y="0"/>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>

                        <Grid>

                            <!-- Hover accent border glow — fades in on hover, gated by AllowHover -->
                            <Border x:Name="HoverGlow" BorderThickness="1" CornerRadius="{StaticResource RadiusMD}" Opacity="0"
                                    IsHitTestVisible="False" Panel.ZIndex="2">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{DynamicResource MicaWPF.Colors.SystemAccentColorLight1}" />
                                </Border.BorderBrush>
                            </Border>

                            <!-- Hover brightness overlay — subtle white tint on hover -->
                            <Rectangle x:Name="HoverBrighten" RadiusX="14" RadiusY="14" Opacity="0"
                                       Fill="White" IsHitTestVisible="False" Panel.ZIndex="1">
                            </Rectangle>

                            <!-- Inner highlight border for frosted glass effect -->
                            <Border Name="InnerHighlightBorder" BorderThickness="1" CornerRadius="{StaticResource RadiusMD}" Padding="12">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{DynamicResource MicaWPF.Colors.ControlStrokeColorDefault}" Offset="0.0"/>
                                        <GradientStop Color="Transparent" Offset="0.08"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            <Grid Name="ItemGrid" HorizontalAlignment="Stretch" Background="Transparent" Tag="{Binding DataContext, ElementName=ShelfListView}" ContextMenu="{StaticResource CardContextMenu}">
                                <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>




                            <!-- Inline Action Buttons — compact individual pills (hover reveals) -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Panel.ZIndex="5" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.AllowHover, ElementName=ShelfListView}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><StaticResource ResourceKey="Motion.EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><StaticResource ResourceKey="Motion.EaseIn" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel.Resources>
                                    <Style x:Key="ActionPillStyle" TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Background" Value="{DynamicResource ActionPillBg}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ActionPillBorder}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </StackPanel.Resources>

                                <!-- ═══ Smart Action ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSmartAction}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- V-03: Hide SmartAction when dedicated Run Script button handles it -->
                                                <DataTrigger Binding="{Binding SmartActionType}" Value="CompileAndRun">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorLight1}" PreviewMouseLeftButtonDown="SmartActionSpecific_Click" AutomationProperties.Name="{Binding SmartActionName}">
                                        <ui:Button.ToolTip><ToolTip Content="{Binding SmartActionName}" /></ui:Button.ToolTip>
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="{StaticResource TypeSubtitle}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Flash24"/><Setter Property="Filled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="CompileAndRun"><Setter Property="Symbol" Value="Play24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF"><Setter Property="Symbol" Value="Document24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="ConvertToPdf"><Setter Property="Symbol" Value="DocumentPdf24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="JoinMeeting"><Setter Property="Symbol" Value="Video24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenBrowser"><Setter Property="Symbol" Value="Globe24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="SetTimer"><Setter Property="Symbol" Value="Clock24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenMap"><Setter Property="Symbol" Value="Map24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="CopyQRText"><Setter Property="Symbol" Value="Copy24"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Run Script ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SyncIncomingColor}" PreviewMouseLeftButtonDown="RunTerminalSpecific_Click" ToolTip="Run Script" AutomationProperties.Name="Run script">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Open File ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource DeviceLaptopColor}" PreviewMouseLeftButtonDown="OpenSpecific_Click" ToolTip="Open" AutomationProperties.Name="Open file">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Open24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Show in Explorer ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Group"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource PinActiveColor}" ToolTip="Show in Explorer" AutomationProperties.Name="Show in Explorer"
                                               PreviewMouseLeftButtonDown="OpenExplorer_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Open Folder (Folder only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Folder"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource PinActiveColor}" ToolTip="Open Folder" AutomationProperties.Name="Open folder"
                                               PreviewMouseLeftButtonDown="OpenExplorer_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Convert to .zip (Group/Folder only, no zip yet) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource CyanAccentColor}" ToolTip="Convert to .zip" AutomationProperties.Name="Convert to zip archive"
                                               PreviewMouseLeftButtonDown="ConvertToZip_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderZip24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Ungroup (Group only — revert to individual items) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Group">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource OrangeAccentColor}" ToolTip="Ungroup to individual items" AutomationProperties.Name="Ungroup items"
                                               PreviewMouseLeftButtonDown="UngroupItems_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="GroupDismiss24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Sync via LAN (Group/Folder with zip ready) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                        <Condition Binding="{Binding HasZipArchive}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SuccessColor}" ToolTip="Sync via LAN"
                                               PreviewMouseLeftButtonDown="SyncZipLan_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Send24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Convert Image to PDF ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource DangerColor}"
                                               PreviewMouseLeftButtonDown="ConvertImageToPdfSpecific_Click" ToolTip="Convert Image to PDF">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentPdf24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Quick Look ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsMarkdownPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsDocPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsPdfPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource TypeImageColor}" PreviewMouseLeftButtonDown="QuickLookSpecific_Click" ToolTip="Quick Look">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Search Google ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <!-- Hide search for password items -->
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SyncIncomingColor}" ToolTip="Search on Google" AutomationProperties.Name="Search on Google"
                                               PreviewMouseLeftButtonDown="GoogleSearchSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Search24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Peek Password (Password only — replaces Search) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource WarningColor}" ToolTip="Peek password (5s)" AutomationProperties.Name="Peek password"
                                               PreviewMouseLeftButtonDown="PeekPasswordSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Sanitize URL (Url only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Url">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource SanitizeColor}" ToolTip="Sanitize URL (Remove trackers)" AutomationProperties.Name="Sanitize URL"
                                               PreviewMouseLeftButtonDown="SanitizeUrlSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Shield24" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Protect/Make Password (Text only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanConvertToPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource WarningColor}" ToolTip="Protect as Password" AutomationProperties.Name="Protect as password"
                                               PreviewMouseLeftButtonDown="MakePasswordSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Key24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Pin/Unpin ═══ -->
                                <Border Style="{StaticResource ActionPillStyle}" Margin="0,0,2,0" Padding="0">
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" PreviewMouseLeftButtonDown="PinSpecific_Click" ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="{StaticResource TypeSubtitle}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Pin24"/><Setter Property="Filled" Value="True"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PinActiveColor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Symbol" Value="PinOff24"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource PinInactiveColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Rename Password (Password Card only) ═══ -->
                                <Border Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ActionPillStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource WarningColor}" ToolTip="Rename Password Label" AutomationProperties.Name="Rename password label"
                                               PreviewMouseLeftButtonDown="RenamePasswordSpecific_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Edit24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Delete ═══ -->
                                <Border Style="{StaticResource ActionPillStyle}" Padding="0">
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource DangerColor}" PreviewMouseLeftButtonDown="DeleteSpecific_Click" ToolTip="Delete" AutomationProperties.Name="Delete item">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                            </StackPanel>

                            <!-- Standard File Icon (Images, Zips) -->
                            <Border Name="IconBorder" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                                    CornerRadius="{StaticResource RadiusSM}" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ItemType}" Value="Text"/>
                                                    <Condition Binding="{Binding IsPassword}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Url">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Code">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Name="ItemIcon" Source="{Binding Icon}" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGifPreview}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image Name="GifItemIcon" gif:AnimationBehavior.SourceUri="{Binding GifFilePath, Mode=OneTime}" gif:AnimationBehavior.RepeatBehavior="Forever" gif:AnimationBehavior.AutoStart="True" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" Loaded="GifItemIcon_Loaded" Unloaded="GifItemIcon_Unloaded" Visibility="{Binding IsGifPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                             <!-- Image Placeholder — shown when Icon hasn't loaded yet for image items -->
                             <Border Name="ImagePlaceholderBorder">
                                 <Border.Style>
                                     <Style TargetType="Border">
                                         <Setter Property="Grid.Row" Value="0"/>
                                         <Setter Property="Grid.Column" Value="0"/>
                                         <Setter Property="Width" Value="40"/>
                                         <Setter Property="Height" Value="40"/>
                                         <Setter Property="Margin" Value="0,0,12,0"/>
                                         <Setter Property="CornerRadius" Value="8"/>
                                         <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                         <Setter Property="Visibility" Value="Collapsed"/>
                                         <Style.Triggers>
                                             <!-- Show only when Icon is null AND item is an Image -->
                                             <MultiDataTrigger>
                                                 <MultiDataTrigger.Conditions>
                                                     <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                     <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                 </MultiDataTrigger.Conditions>
                                                 <Setter Property="Visibility" Value="Visible"/>
                                             </MultiDataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Border.Style>
                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                     <ui:SymbolIcon Symbol="Image24" FontSize="22" HorizontalAlignment="Center"/>
                                     <TextBlock Text="Image" FontSize="{StaticResource TypeMicro}" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"
                                                HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                 </StackPanel>
                             </Border>

                            <!-- ═══ Rotate Image — round floating button, bottom-right of icon ═══ -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Margin="0,0,-6,10" Panel.ZIndex="8" Focusable="False"
                                    Tag="RotateImage" PreviewMouseLeftButtonDown="RotateImageSpecific_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="26" Height="26" CornerRadius="13"
                                                            Background="{DynamicResource ThemeOverlayButtonBg}" BorderBrush="{DynamicResource ThemeOverlayBorderStrong}" BorderThickness="1"
                                                            ToolTip="Rotate 90°">
                                                        <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource TypeGroupColor}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                              <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.AllowHover, ElementName=ShelfListView}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="1"/>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Entrance}" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><StaticResource ResourceKey="Motion.EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Normal}" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><StaticResource ResourceKey="Motion.EaseIn" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                             </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- PDF Merge Toggle — top-left of icon, PDF only. Uses Button to avoid ListView CheckBox conflicts -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Margin="-4,-4,0,0" Panel.ZIndex="10" Focusable="False"
                                    Tag="PdfMergeToggle" Click="PdfMergeToggle_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="26" Height="26" Background="Transparent">
                                                        <!-- Unchecked state: dark rounded square with red border -->
                                                        <Border x:Name="UncheckedBg" Width="22" Height="22" CornerRadius="{StaticResource RadiusSM}"
                                                                Background="{DynamicResource ThemeOverlayBg}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1.5"/>
                                                        <!-- Checked state: solid red with checkmark -->
                                                        <Border x:Name="CheckedBg" Width="22" Height="22" CornerRadius="{StaticResource RadiusSM}"
                                                                Background="{DynamicResource DangerColor}" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1.5" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="CheckMark" Text="✓" FontSize="{StaticResource TypeSubtitle}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="0,-1,0,0" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckedForMerge}" Value="True">
                                                            <Setter TargetName="UncheckedBg" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="CheckedBg" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="UncheckedBg" Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
                                                            <Setter TargetName="UncheckedBg" Property="Background" Value="{DynamicResource DangerBgHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Show on hover for PDF -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <!-- Show on hover for Document -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <!-- Show on hover for Image -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                    <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Circular Expand/Collapse Chevron Toggle Button for Long Text / Code cards -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Margin="-4,-4,0,0" Panel.ZIndex="10" Focusable="False"
                                    PreviewMouseLeftButtonDown="ExpandToggleSpecific_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- 26x26 container with interactive circular border -->
                                                    <Grid Width="26" Height="26" Background="Transparent">
                                                        <Border x:Name="CircleBorder" Width="22" Height="22" CornerRadius="11"
                                                                Background="{DynamicResource ChevronBg}" BorderBrush="{DynamicResource ChevronBorder}" BorderThickness="1.5">
                                                            <!-- PERF: DropShadowEffect removed — was per-item software shader -->
                                                            <!-- Toggle Icon: Blue chevron down when collapsed, Red chevron up when expanded -->
                                                            <ui:SymbolIcon x:Name="ChevronIcon" Symbol="ChevronDown24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource InfoColor}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0.5,0,0"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronUp24"/>
                                                            <Setter TargetName="ChevronIcon" Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CircleBorder" Property="Background" Value="{DynamicResource ThemeChevronBgHover}"/>
                                                            <Setter TargetName="CircleBorder" Property="BorderBrush" Value="{DynamicResource ThemeChevronBorderHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLongText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Semantic Icon Fallback — only shown when system Icon is NOT available -->
                            <Border Name="SemanticIconBorder" Grid.Row="0" Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="{StaticResource RadiusMD}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <!-- Only show the generic semantic icon when no system icon is available -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Code"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Archive"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Document"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Presentation"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Video"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Audio"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Pdf"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="File"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            
                                            <!-- Hide generic fallback icon if color is detected -->
                                            <DataTrigger Binding="{Binding HasDetectedColor}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon FontSize="20" Filled="True">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Document24" />
                                            <Setter Property="Foreground" Value="#60A5FA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Code">
                                                    <Setter Property="Symbol" Value="Code24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeCodeColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive">
                                                    <Setter Property="Symbol" Value="FolderZip24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeArchiveColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Group">
                                                    <Setter Property="Symbol" Value="FolderMultiple24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeGroupColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="Document24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeDocColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="DocumentPdf24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypePdfColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUrlPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="Globe24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeUrlColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation">
                                                    <Setter Property="Symbol" Value="Document24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypePresentColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video">
                                                    <Setter Property="Symbol" Value="VideoClip24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeVideoColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio">
                                                    <Setter Property="Symbol" Value="MusicNote124"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeAudioColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Folder">
                                                    <Setter Property="Symbol" Value="Folder24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TypeFolderColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>

                            <!-- Color Swatch Premium Preview — shown when a HEX, RGB, or HSL color is detected -->
                            <Border Name="ColorSwatchBorder" Grid.Row="0" Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                                    Background="{Binding DetectedColorBrush}" CornerRadius="{StaticResource RadiusMD}" 
                                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDetectedColor}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Sender Badge — Top-right corner overlay -->
                            <StackPanel Name="SenderBadge" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Panel.ZIndex="4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SourceDeviceName}" Value="Local">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                    <Border CornerRadius="{StaticResource RadiusSM}" Padding="5,2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="{StaticResource TypeCaption}" Margin="0,0,3,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Laptop24" />
                                                    <Setter Property="Foreground" Value="{StaticResource DeviceLaptopColor}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceDeviceType}" Value="Mobile">
                                                            <Setter Property="Symbol" Value="Phone24"/>
                                                            <Setter Property="Foreground" Value="{StaticResource DeviceMobileColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding SourceAppName, Mode=OneTime}" Foreground="{DynamicResource SubtleTextColor}" FontSize="{StaticResource TypeMicro}" Margin="0,0,2,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSourceApp}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="·" Foreground="{DynamicResource SeparatorDotColor}" FontSize="{StaticResource TypeMicro}" Margin="0,0,2,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSourceApp}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SourceDeviceName, Mode=OneTime}" Foreground="{DynamicResource SubtleTextColor}" FontSize="{StaticResource TypeMicro}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="·" Foreground="{DynamicResource SeparatorDotColor}" FontSize="{StaticResource TypeMicro}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Cloud"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SourceCloudColor}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="Cloudflare">
                                                            <Setter Property="Text" Value="Cloudflare"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SourceCfColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="LAN">
                                                            <Setter Property="Text" Value="LAN"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SourceLanColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="ForceSend">
                                                            <Setter Property="Text" Value="Direct"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SourceDirectColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="Local">
                                                            <Setter Property="Text" Value="Local"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SourceLocalColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- The Text Body -->
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Name="TitleText" 
                                           Text="{Binding DisplayText}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" FontFamily="Segoe UI Emoji, Segoe UI" FontWeight="Medium" FontSize="{StaticResource TypeSubtitle}" LineHeight="19" TextWrapping="Wrap" 
                                           TextTrimming="CharacterEllipsis" MaxHeight="{Binding CollapsedMaxHeight}" />

                                <!-- Markdown Tag — lightweight visual indicator, no inline rendering -->
                                <Border CornerRadius="4" Padding="6,1,6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeOverlayBg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMarkdownPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="MD" FontSize="{StaticResource TypeMicro}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Source App Label — small subtle "Copied from [app]" indicator -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSourceApp}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- Hide for items that already have clear identity -->
                                                <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMarkdownPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- Master toggle from Settings -->
                                                <DataTrigger Binding="{Binding Source={x:Static settings:SettingsManager.Current}, Path=ShowSourceAppLabel}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- App icon: only visible when extracted (current session), gracefully hidden after restart -->
                                    <Image Source="{Binding SourceAppIcon}" Width="14" Height="14" Stretch="Uniform" 
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSourceAppIcon}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="{Binding SourceAppName, Mode=OneTime}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                               VerticalAlignment="Center" FontWeight="Regular" Opacity="0.8"/>
                                </StackPanel>
                                
                                <!-- File Transfer / Download Progress Panel -->
                                <StackPanel Margin="0,4,0,0" Visibility="{Binding IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Height="4" Foreground="{DynamicResource SyncIncomingColor}" Background="{DynamicResource ThemeOverlayBgHover}" BorderThickness="0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding TransferStatusText}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource SyncIncomingColor}" Margin="0,3,0,0" FontWeight="Medium" Opacity="0.9"/>
                                </StackPanel>

                                <!-- Inline Audio Player Panel -->
                                <Grid Margin="0,6,0,2" Visibility="{Binding IsAudioPreview, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Play/Pause Button -->
                                    <ui:Button Grid.Column="0" Focusable="False" Padding="6" CornerRadius="18" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Command="{Binding PlayPauseAudioCommand}" Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}" AutomationProperties.Name="Play or pause audio">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="18">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Play24"/>
                                                        <Setter Property="Filled" Value="True"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TypeAudioColor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAudioPlaying}" Value="True">
                                                                <Setter Property="Symbol" Value="Pause24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <!-- Progress Slider -->
                                    <Slider Grid.Column="1" Value="{Binding AudioPosition, Mode=TwoWay}" Maximum="{Binding AudioDuration}" Minimum="0"
                                            VerticalAlignment="Center" Height="22" Focusable="False" Foreground="{StaticResource TypeAudioColor}" AutomationProperties.Name="Audio playback position"/>

                                    <!-- Time indicator text -->
                                    <TextBlock Grid.Column="2" Text="{Binding AudioPlaybackText}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"
                                               FontSize="{StaticResource TypeSmall}" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                </Grid>
                            </StackPanel>

                        </Grid>
                        </Border>
                        </Grid>
                        </Border>
                        <!-- Selection / focus ring — sits OUTSIDE ClipToBounds so border pixels are never clipped -->
                        <Border Name="SelectionRing" BorderThickness="2" CornerRadius="{StaticResource RadiusMD}"
                                IsHitTestVisible="False" BorderBrush="Transparent"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <!-- Dynamic sizing for Large Images vs Standard Files -->
                        <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                             <Setter TargetName="InnerHighlightBorder" Property="Padding" Value="6" />
                             <Setter TargetName="InnerHighlightBorder" Property="BorderThickness" Value="0" />
                             <Setter TargetName="CardBorder" Property="Margin" Value="0,2,0,2" />
                             <Setter TargetName="ItemIcon" Property="Stretch" Value="Uniform" />
                             <Setter TargetName="ItemIcon" Property="Height" Value="165" />
                             <Setter TargetName="ItemIcon" Property="MaxHeight" Value="165" />
                             <Setter TargetName="ItemIcon" Property="Width" Value="Auto" />
                             <Setter TargetName="ItemIcon" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="ItemIcon" Property="HorizontalAlignment" Value="Center" />
                             <Setter TargetName="ItemIcon" Property="VerticalAlignment" Value="Center" />
                             <Setter TargetName="ItemIcon" Property="Margin" Value="0" />
                             <Setter TargetName="GifItemIcon" Property="Stretch" Value="Uniform" />
                             <Setter TargetName="GifItemIcon" Property="Height" Value="165" />
                             <Setter TargetName="GifItemIcon" Property="MaxHeight" Value="165" />
                             <Setter TargetName="GifItemIcon" Property="Width" Value="Auto" />
                             <Setter TargetName="GifItemIcon" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="GifItemIcon" Property="HorizontalAlignment" Value="Center" />
                             <Setter TargetName="GifItemIcon" Property="VerticalAlignment" Value="Center" />
                             <Setter TargetName="GifItemIcon" Property="Margin" Value="0" />
                             <Setter TargetName="IconBorder" Property="Margin" Value="0" />
                             <Setter TargetName="IconBorder" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="IconBorder" Property="HorizontalAlignment" Value="Stretch" />
                             <Setter TargetName="IconBorder" Property="Background" Value="Transparent" />
                             <Setter TargetName="IconBorder" Property="Padding" Value="0" />
                             <Setter TargetName="IconBorder" Property="CornerRadius" Value="12" />
                             <Setter TargetName="IconBorder" Property="Width" Value="Auto" />
                             <Setter TargetName="IconBorder" Property="Height" Value="165" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Margin" Value="0" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="HorizontalAlignment" Value="Stretch" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Width" Value="Auto" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="Height" Value="165" />
                             <Setter TargetName="ImagePlaceholderBorder" Property="CornerRadius" Value="14" />
                             <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Apply color for Code Types — FontFamily/FontSize changes REMOVED
                             because they cause double InvalidateMeasure per container recycle
                             (different fonts = different glyph widths = full re-measure) -->
                        <DataTrigger Binding="{Binding IsCodePreview}" Value="True">
                             <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource CodeTextColor}" />
                        </DataTrigger>
                        <!-- Markdown items now show plain text via TitleText (no inline rendering) -->
                        
                        <!-- Hover Effect on the Container -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.ControlStrokeColorSecondary}"/>
                        </Trigger>

                        <!-- Focused State Trigger for Highlight Border -->
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True">
                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource ShelfCardFocusBorder}"/>
                        </DataTrigger>

                        <!-- Selected State Trigger for Highlight Border -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True">
                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource ShelfCardSelectionBorder}"/>
                        </DataTrigger>


                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ═══ Floating Multi-Action Bar — pill-shaped, frosted glass, Google-searchbar inspired ═══ -->
        <!-- Priority: Merge PDF is shown first (left), Unpin second (right) -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Panel.ZIndex="50"
                CornerRadius="24" Padding="4" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=MergeSelectedPdfsBtn}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=UnpinSelectedBtn}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <DynamicResource ResourceKey="ThemeFloatingBarBg"/>
            </Border.Background>
            <Border.BorderBrush>
                <DynamicResource ResourceKey="ThemeFloatingBarBorder"/>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <!-- PERF: DropShadowEffect removed — was software-rendered every frame -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Merge PDF action (primary — always left, theme-aware accent pill) -->
                <Button x:Name="MergeSelectedPdfsBtn" Visibility="Collapsed" Click="MergeSelectedPdfsBtn_Click" Cursor="Hand"
                        Focusable="False" OverridesDefaultStyle="True" Content="Merge PDFs" AutomationProperties.Name="Merge selected PDFs">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MergePillBg" CornerRadius="{StaticResource RadiusLG}" Padding="16,9" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource FloatingMergeAccentBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FloatingMergeAccentBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingMergeAccentBgHover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource FloatingMergeAccentBorderHover}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingMergeAccentBgPressed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Layer24" FontSize="{StaticResource TypeSubtitle}"
                                                   Foreground="{DynamicResource FloatingMergeAccentIcon}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" FontSize="{StaticResource TypeSubtitle}"
                                               Foreground="{DynamicResource FloatingMergeAccentText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Instant Merge action -->
                <Button x:Name="InstantMergeSelectedPdfsBtn" Visibility="Collapsed" Click="InstantMergeSelectedPdfsBtn_Click" Cursor="Hand"
                        Focusable="False" OverridesDefaultStyle="True" Content="Instant Merge" AutomationProperties.Name="Instant merge selected PDFs" Margin="8,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="InstantMergePillBg" CornerRadius="{StaticResource RadiusLG}" Padding="14,9" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeOverlayBgHover}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="{StaticResource TypeSubtitle}" 
                                                   Foreground="{DynamicResource ThemeAccentLight}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Separator dot (only visible when both are shown) -->
                <Ellipse Width="4" Height="4" Margin="8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource ThemeOverlayBorderStrong}"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Visibility, ElementName=MergeSelectedPdfsBtn}" Value="Visible"/>
                                        <Condition Binding="{Binding Visibility, ElementName=UnpinSelectedBtn}" Value="Visible"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Unpin action (secondary — right side, theme-aware amber pill) -->
                <Button x:Name="UnpinSelectedBtn" Visibility="Collapsed" Click="UnpinSelectedBtn_Click" Cursor="Hand"
                        Focusable="False" OverridesDefaultStyle="True" Content="Unpin Selected" AutomationProperties.Name="Unpin selected items">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="UnpinPillBg" CornerRadius="{StaticResource RadiusLG}" Padding="14,9" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource FloatingUnpinBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FloatingUnpinBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingUnpinBgHover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource FloatingUnpinBorderHover}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FloatingUnpinBgPressed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PinOff24" FontSize="{StaticResource TypeSubtitle}"
                                                   Foreground="{DynamicResource FloatingUnpinIcon}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="Medium" FontSize="{StaticResource TypeBody}"
                                               Foreground="{DynamicResource FloatingUnpinText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Empty State -->
        <StackPanel Name="EmptyStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DroppedItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="64" Height="64" CornerRadius="{StaticResource RadiusLG}" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border.Background>
                    <DynamicResource ResourceKey="ThemeOverlayBg"/>
                </Border.Background>
                <!-- BUG-1 FIX: TranslateTransform must exist before animation can target it -->
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" Storyboard.DesiredFrameRate="15">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-6" Duration="0:0:1.5" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <StaticResource ResourceKey="Motion.EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="28" Foreground="{DynamicResource ThemeEmptyIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <emoji:TextBlock Text="Your shelf is empty" Opacity="0.45" FontWeight="SemiBold" FontSize="{StaticResource TypeSubtitle}" TextAlignment="Center"/>
            <emoji:TextBlock Opacity="0.28" FontSize="{StaticResource TypeSmall}" Margin="0,10,0,0" TextAlignment="Center" LineHeight="20">
                <Run Text="Press"/><Run Text=" Alt+C " FontWeight="SemiBold"/><Run Text="anywhere to open"/>
                <LineBreak/>
                <Run Text="Shake mouse to summon"/>
                <LineBreak/>
                <Run Text="Drag files here to shelve"/>
                <LineBreak/>
                <Run Text=""/><Run Text="Ctrl+F" FontWeight="SemiBold"/><Run Text=" to search your clips"/>
            </emoji:TextBlock>
        </StackPanel>

        <!-- Alt+C Watermark Hint — visible until clipboard view is filled (controlled from code-behind) -->
        <Border x:Name="AltCWatermarkHint" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Margin="0,0,0,16" Opacity="0.35" IsHitTestVisible="False"
                Background="Transparent" Visibility="Visible">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" 
                        CornerRadius="{StaticResource RadiusSM}" Padding="12,6,12,6">
                    <emoji:TextBlock FontSize="{StaticResource TypeSmall}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" TextAlignment="Center">
                        <Run Text="" FontSize="{StaticResource TypeCaption}"/><Run Text=" Press "/><Run Text="Alt+C" FontWeight="SemiBold"/><Run Text=" anywhere to summon clipboard"/>
                    </emoji:TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- AERO ALTERNATE CLIPBOARD UI — clean minimal design with accent bars   -->
        <!-- Shares the same DroppedItems collection and event handlers              -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="AltClipboardPanel" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="40"
              Background="#01000000">

            <!-- Themed gradient background -->
            <Border CornerRadius="{StaticResource RadiusMD}" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="{DynamicResource SystemAccentColorDark3}" Offset="0.0"/>
                        <GradientStop Color="#FF0D0D14" Offset="0.5"/>
                        <GradientStop Color="#FF080810" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Arctic frost overlay -->
            <Border x:Name="AltArcticOverlay" CornerRadius="{StaticResource RadiusMD}" ClipToBounds="True" Visibility="Visible" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                        <GradientStop Color="#FFF0F7FF" Offset="0.0"/>
                        <GradientStop Color="#FFE8F0FE" Offset="0.3"/>
                        <GradientStop Color="#FFF5F5F5" Offset="0.7"/>
                        <GradientStop Color="#FFFAFAFA" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Subtle inner glow -->
            <Border CornerRadius="{StaticResource RadiusMD}" IsHitTestVisible="False">
                <Border.Background>
                    <DynamicResource ResourceKey="ThemeOverlayBg"/>
                </Border.Background>
            </Border>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Grid Grid.Row="0" Margin="16,14,16,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{DynamicResource ThemeLogoIcon}" Width="22" Height="22" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FlyShelf" FontWeight="Bold" FontSize="{StaticResource TypeSubtitle}"
                                   Foreground="{DynamicResource AltTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Pill -->
                    <Border Grid.Column="1" Margin="12,0,6,0" Height="30" CornerRadius="15" Padding="10,0"
                            Background="{DynamicResource AltSearchBg}" BorderBrush="{DynamicResource AltSearchBorder}" BorderThickness="1"
                            VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="AltSearchToggle_Click"
                            MinWidth="80">
                        <Grid VerticalAlignment="Center">
                            <StackPanel x:Name="AltSearchPlaceholder" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Search24" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltSearchFg}" Margin="0,0,5,0"/>
                                <TextBlock Text="Search" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltSearchFg}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid x:Name="AltSearchContainer" Visibility="Collapsed" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltSearchFg}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="AltSearchTextBox" Grid.Column="1" Padding="0" Margin="0"
                                         FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltTextPrimary}" CaretBrush="{DynamicResource AltTextPrimary}"
                                         TextChanged="AltSearch_TextChanged" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         MinWidth="100" AutomationProperties.Name="Search clipboard history">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                                                      Margin="0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource ThemeOverlayBg}"
                                        Cursor="Hand" MouseLeftButtonDown="AltSearchToggle_Click" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="8" Foreground="{DynamicResource AltTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Settings -->
                    <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="AltSettings_Click" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger>
                        </Style.Triggers></Style></Border.Style>
                        <ui:SymbolIcon Symbol="Settings24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Close -->
                    <Border Grid.Column="3" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="AltClose_Click" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltCloseHoverBg}"/></Trigger>
                        </Style.Triggers></Style></Border.Style>
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- SIDEBAR + CONTENT -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDEBAR -->
                    <StackPanel Grid.Column="0" Width="36" Margin="6,4,0,0" VerticalAlignment="Top">
                        <Border x:Name="AltSidebarAll" Width="30" Height="30" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,0,4" Cursor="Hand" Background="{DynamicResource ThemeAccentBg}" ToolTip="All Items" Tag="All" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeAccentBgHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource ThemeAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarText" Width="30" Height="30" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Text" Tag="Text" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="TextT24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltAccent_Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarImage" Width="30" Height="30" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Images" Tag="Image" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="Image24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltAccent_Image}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarPinned" Width="30" Height="30" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Pinned" Tag="Pinned" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="Pin24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltPinDot}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarPdf" Width="30" Height="30" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="PDFs" Tag="PDF" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltAccent_Pdf}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AltSidebarDocument" Width="30" Height="30" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Documents" Tag="Document" MouseLeftButtonDown="AltCategoryFilter_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="Document24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltAccent_Document}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="20" Height="1" Margin="5,4,5,8" Background="{DynamicResource AltCardBorder}"/>
                        <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,0,4" Cursor="Hand" Background="Transparent" ToolTip="Convert to PDF" MouseLeftButtonDown="AltConvertPdf_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style>
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltAccent_Pdf}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- CARD LIST -->
                    <ListView x:Name="AltShelfListView" Grid.Column="1" ItemsSource="{Binding DroppedItems}"
                              Background="Transparent" BorderThickness="0" Margin="4,4,2,14" Padding="0,0,0,50"
                              Focusable="True" FocusVisualStyle="{x:Null}" UseLayoutRounding="True" SnapsToDevicePixels="True"
                              AutomationProperties.Name="Clipboard items list"
                              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLength="2,2" VirtualizingPanel.CacheLengthUnit="Page" SelectionMode="Extended"
                              MouseMove="AltShelfListView_MouseMove"
                              PreviewMouseLeftButtonDown="AltShelfListView_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="AltShelfListView_PreviewMouseLeftButtonUp"
                              MouseDoubleClick="AltShelfListView_MouseDoubleClick"
                              SelectionChanged="AltShelfListView_SelectionChanged"
                              PreviewKeyDown="AltShelfListView_KeyDown"
                              ScrollViewer.ScrollChanged="AltShelfListView_ScrollChanged"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <Border x:Name="AltItemBorder" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="Transparent" CornerRadius="{StaticResource RadiusMD}" Margin="2,1.5,10,1.5" ClipToBounds="True">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="AltItemBorder" Property="Background" Value="{DynamicResource ShelfCardSelectionBg}"/>
                                                    <Setter TargetName="AltItemBorder" Property="BorderBrush" Value="{DynamicResource ShelfCardSelectionBorder}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="AltItemBorder" Property="BorderBrush" Value="{DynamicResource ShelfCardFocusBorder}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Name="AltCardBorder" CornerRadius="{StaticResource RadiusMD}" Padding="0" ClipToBounds="True" Background="{DynamicResource AltCardBg}" BorderBrush="{DynamicResource AltCardBorder}" BorderThickness="1">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AltCardBgHover}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AltCardBorderHover}"/>
                                        </Trigger>
                                    </Style.Triggers></Style></Border.Style>
                                    <Grid Tag="{Binding DataContext, ElementName=AltShelfListView}" ContextMenu="{StaticResource CardContextMenu}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- HOVER ACTION BUTTONS -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Panel.ZIndex="5" Orientation="Horizontal" Tag="AeroHoverActions">
                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/>
                                                <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.AllowHover, ElementName=AltShelfListView}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsHitTestVisible" Value="True"/><Setter Property="Opacity" Value="1"/>
                                                <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" FillBehavior="Stop"><DoubleAnimation.EasingFunction><StaticResource ResourceKey="Motion.EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" FillBehavior="Stop"><DoubleAnimation.EasingFunction><StaticResource ResourceKey="Motion.EaseIn" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger></Style.Triggers>
                                            </Style></StackPanel.Style>
                                            <StackPanel.Resources><Style x:Key="AeroPill" TargetType="Border"><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="{DynamicResource AltBottomBarBg}"/><Setter Property="BorderBrush" Value="{DynamicResource AltCardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,0,1,0"/><Setter Property="Cursor" Value="Hand"/></Style></StackPanel.Resources>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="QuickLookSpecific_Click"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsMarkdownPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltAccent_Image}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="OpenSpecific_Click"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Open24" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltAccent_Document}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="GoogleSearchSpecific_Click"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Search24" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltAccent_Url}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Margin="0,0,1,0" PreviewMouseLeftButtonDown="PeekPasswordSpecific_Click" ToolTip="Peek password (5s)"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource AeroPill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Eye24" Filled="True" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource AltAccent_Password}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                            <Border Style="{StaticResource AeroPill}" PreviewMouseLeftButtonDown="PinSpecific_Click"><ui:SymbolIcon FontSize="{StaticResource TypeBody}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="Pin24"/><Setter Property="Filled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource AltPinDot}"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Symbol" Value="PinOff24"/><Setter Property="Foreground" Value="{DynamicResource AltTextTertiary}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Border>
                                            <Border Style="{StaticResource AeroPill}" PreviewMouseLeftButtonDown="DeleteSpecific_Click"><ui:SymbolIcon Symbol="Delete24" Filled="True" FontSize="{StaticResource TypeBody}" Foreground="{DynamicResource DangerColor}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/></Border>
                                        </StackPanel>
                                        <!-- PDF MERGE TOGGLE — top-left checkbox for PDF/Document/Image items -->
                                        <Button Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="0,-2,0,0" Panel.ZIndex="10" Focusable="False"
                                                Tag="AltPdfMergeToggle" Click="AltPdfMergeToggle_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid Width="22" Height="22" Background="Transparent">
                                                                    <Border x:Name="UncheckedBg" Width="18" Height="18" CornerRadius="4"
                                                                            Background="{DynamicResource ThemeOverlayBorderStrong}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1.5"/>
                                                                    <Border x:Name="CheckedBg" Width="18" Height="18" CornerRadius="4"
                                                                            Background="{DynamicResource DangerColor}" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1.5" Visibility="Collapsed"/>
                                                                    <TextBlock x:Name="CheckMark" Text="✓" FontSize="{StaticResource TypeSmall}" FontWeight="Bold"
                                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Margin="0,-1,0,0" Visibility="Collapsed"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCheckedForMerge}" Value="True">
                                                                        <Setter TargetName="UncheckedBg" Property="Visibility" Value="Collapsed"/>
                                                                        <Setter TargetName="CheckedBg" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="UncheckedBg" Property="BorderBrush" Value="{DynamicResource DangerColor}"/>
                                                                        <Setter TargetName="UncheckedBg" Property="Background" Value="{DynamicResource DangerBgHover}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                     </Setter>
                                                     <Style.Triggers>
                                                        <!-- Show on hover for PDF -->
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <!-- Show on hover for Document -->
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <!-- Show on hover for Image -->
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                            <Condition Binding="{Binding IsCheckedForMerge}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- ACCENT BAR -->
                                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="1,6,0,6" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AltAccent_Default}"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Background" Value="{DynamicResource AltAccent_Text}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Background" Value="{DynamicResource AltAccent_Code}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Background" Value="{DynamicResource AltAccent_Image}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Background" Value="{DynamicResource AltAccent_Pdf}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Background" Value="{DynamicResource AltAccent_Url}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Background" Value="{DynamicResource AltAccent_Document}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Background" Value="{DynamicResource AltAccent_Archive}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Folder"><Setter Property="Background" Value="{DynamicResource AltAccent_Folder}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Background" Value="{DynamicResource AltAccent_Video}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Background" Value="{DynamicResource AltAccent_Audio}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Password"><Setter Property="Background" Value="{DynamicResource AltAccent_Password}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Background" Value="{DynamicResource AltAccent_Presentation}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Background" Value="{DynamicResource AltAccent_QRCode}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Group"><Setter Property="Background" Value="{DynamicResource AltAccent_Group}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Background" Value="{DynamicResource AltAccent_File}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                                        <!-- ICON -->
                                        <Grid Grid.Column="1" Width="32" Height="32" Margin="8,8,6,8">
                                            <Border CornerRadius="{StaticResource RadiusSM}" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding Icon}" Width="32" Height="32" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                            <!-- Expand/Collapse button for long text -->
                                            <Border CornerRadius="{StaticResource RadiusSM}" Width="32" Height="32" Cursor="Hand" Tag="AeroExpandToggle"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Border.Background><SolidColorBrush Color="{DynamicResource ThemeAccentColor}" Opacity="0.08"/></Border.Background><Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}"/></Border.InputBindings><ui:SymbolIcon FontSize="{StaticResource TypeSubtitle}" HorizontalAlignment="Center" VerticalAlignment="Center"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="ChevronDown24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Symbol" Value="ChevronUp24"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Border>
                                            <!-- Fallback icon for items without a custom icon (text, url, code, etc.) -->
                                            <Border CornerRadius="{StaticResource RadiusSM}" Width="32" Height="32"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Password"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Border.Background><SolidColorBrush Color="#000000" Opacity="0.05"/></Border.Background><ui:SymbolIcon FontSize="{StaticResource TypeSubtitle}" HorizontalAlignment="Center" VerticalAlignment="Center"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="Document24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_File}"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Symbol" Value="TextDescription24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Text}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Symbol" Value="Code24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Code}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Symbol" Value="Image24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Image}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Symbol" Value="DocumentPdf24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Pdf}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Symbol" Value="Globe24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Url}"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Password"><Setter Property="Symbol" Value="ShieldKeyhole24"/><Setter Property="Foreground" Value="{DynamicResource AltAccent_Password}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Border>
                                        </Grid>
                                        <!-- TEXT BODY -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,5,4,5">
                                            <Border CornerRadius="{StaticResource RadiusSM}" ClipToBounds="True" Margin="0,0,8,4" HorizontalAlignment="Stretch"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding Icon}" Height="90" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                            <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TypeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource AltTextPrimary}" TextTrimming="CharacterEllipsis" MaxHeight="18" LineHeight="18"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="{Binding DisplayText}" FontSize="{StaticResource TypeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource AltTextPrimary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="{Binding CollapsedMaxHeight}" LineHeight="18"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock Text="{Binding FormatIdentifier}" FontSize="{StaticResource TypeSmall}" Margin="0,2,0,0" Foreground="{DynamicResource AltSubtitleFg}" TextTrimming="CharacterEllipsis" MaxHeight="15" LineHeight="15" Opacity="0.7"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImagePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ItemType}" Value="Text"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </StackPanel>
                                        <!-- TIMESTAMP + PIN -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,10,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DateCopied, StringFormat='{}{0:h:mm tt}', Mode=OneTime}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource AltTimestampFg}" HorizontalAlignment="Right"/>
                                            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" Margin="0,4,2,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Fill" Value="{DynamicResource AltPinDot}"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DroppedItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Width="56" Height="56" CornerRadius="{StaticResource RadiusMD}" HorizontalAlignment="Center" Margin="0,0,0,14"><Border.Background><SolidColorBrush Color="#000000" Opacity="0.06"/></Border.Background><ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="24" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Your shelf is empty" Opacity="0.5" FontWeight="SemiBold" FontSize="{StaticResource TypeSubtitle}" TextAlignment="Center" Foreground="{DynamicResource AltTextPrimary}"/>
                        <TextBlock Opacity="0.35" FontSize="{StaticResource TypeSmall}" Margin="0,8,0,0" TextAlignment="Center" LineHeight="20" Foreground="{DynamicResource AltTextSecondary}"><Run Text="Copy anything to see it here"/></TextBlock>
                    </StackPanel>
                </Grid>

                <!-- BOTTOM BAR -->
                <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0,8,8" Padding="10,6" CornerRadius="{StaticResource RadiusMD}" Background="{DynamicResource AltBottomBarBg}" BorderBrush="{DynamicResource AltBottomBarBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Background="Transparent" Cursor="Hand" ToolTip="More Options" MouseLeftButtonDown="AltMoreOptions_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border x:Name="AltIncognitoBadge" Visibility="{Binding Visibility, ElementName=IncognitoBadge}" Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="IncognitoBadge_Click" ToolTip="{Binding Text, ElementName=IncognitoBadgeText}">
                                <Border.Background>
                                    <DynamicResource ResourceKey="WarningBgSubtle"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <DynamicResource ResourceKey="WarningBorder"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <ui:SymbolIcon Symbol="EyeOff24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource WarningColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="AltUpdateBadge" Visibility="{Binding Visibility, ElementName=UpdateBadge}" Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="UpdateBadge_Click" ToolTip="Update available — click to open Hub">
                                <Border.Background>
                                    <DynamicResource ResourceKey="SuccessBgSubtle"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <DynamicResource ResourceKey="SuccessBorder"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="AltResearchBtn" Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Background="Transparent" Cursor="Hand" Margin="0,0,2,0" ToolTip="Networking" MouseLeftButtonDown="AltResearch_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Wifi124" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource ThemeAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Background="Transparent" Cursor="Hand" Margin="0,0,2,0" ToolTip="Keyboard Shortcuts" MouseLeftButtonDown="AltShortcuts_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Keyboard24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Background="Transparent" Cursor="Hand" Margin="0,0,2,0" ToolTip="Sync" MouseLeftButtonDown="AltSync_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="ArrowSync24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Background="Transparent" Cursor="Hand" Margin="0,0,2,0" ToolTip="Clear Shelf" MouseLeftButtonDown="AltClear_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerBgHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Delete24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource DangerColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusSM}" Background="Transparent" Cursor="Hand" ToolTip="Reminders" MouseLeftButtonDown="ReminderBtn_Click"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AltSidebarHover}"/></Trigger></Style.Triggers></Style></Border.Style><ui:SymbolIcon Symbol="Alert24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource AltPinDot}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- NETWORKING PANEL — fresh single-column layout               -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="ResearchPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="0"
              RenderTransformOrigin="0.5,0" PreviewMouseDown="ResearchPanel_PreviewMouseDown"
              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
              RenderOptions.ClearTypeHint="Enabled" UseLayoutRounding="True" SnapsToDevicePixels="True"
              Background="{DynamicResource ThemeCodePreviewBg}">
            <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
            <!-- Decomposition Phase 2: Networking panel extracted to Controls/NetworkingPanelControl -->
            <local:NetworkingPanelControl x:Name="NetworkingContent" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- QUICK NOTES PANEL — overlays ShelfListView in Grid.Row=1     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="NotesPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="0"
              RenderTransformOrigin="0.5,0" PreviewMouseDown="NotesPanel_PreviewMouseDown"
              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
              RenderOptions.ClearTypeHint="Enabled" UseLayoutRounding="True" SnapsToDevicePixels="True"
              Validation.ErrorTemplate="{x:Null}"
              Background="{DynamicResource ThemeCodePreviewBg}">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <!-- Decomposition Phase 3: Notes content extracted to Controls/NotesPanelControl -->
            <local:NotesPanelControl x:Name="NotesContent" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TO-DO LIST PANEL — overlays ShelfListView in Grid.Row=1      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="TodoPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="0"
              RenderTransformOrigin="0.5,0" PreviewMouseDown="TodoPanel_PreviewMouseDown"
              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
              RenderOptions.ClearTypeHint="Enabled" UseLayoutRounding="True" SnapsToDevicePixels="True"
              Validation.ErrorTemplate="{x:Null}"
              Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <!-- Decomposition Phase 4: Todo panel extracted to Controls/TodoPanelControl -->
            <local:TodoPanelControl x:Name="TodoContent" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- AI SETTINGS PANEL -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="AiSettingsPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="0"
              Panel.ZIndex="30">
            <!-- Decomposition Phase 1: AI Settings extracted to Controls/AiSettingsControl -->
            <local:AiSettingsControl x:Name="AiSettingsContent" />
        </Grid>

        <!-- Drag-Over Overlay Zone removed - replaced with elegant mini arrow animation in button header -->

    </Grid>
    </Border>
</controls:MicaWindow>
