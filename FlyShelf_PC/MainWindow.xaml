<controls:MicaWindow x:Class="AdvanceClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:vm="clr-namespace:AdvanceClip.ViewModels"
        xmlns:settings="clr-namespace:AdvanceClip.Classes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="FlyShelf" 
        Width="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormWidth}" 
        Opacity="1"
        MaxHeight="300" SizeToContent="Manual" MinHeight="100" BorderThickness="0"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" SystemBackdropType="Acrylic"
        ShowInTaskbar="False" Margin="0" Topmost="True" ShowActivated="False"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" PreviewDragOver="Window_PreviewDragOver"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal"
        Loaded="MicaWindow_Loaded" Deactivated="MicaWindow_Deactivated">

    <controls:MicaWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Named style for Sync Circular Arrows button evaluated at Window level -->
            <Style x:Key="ToolbarSyncButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableGlobalFirebaseSync}" Value="True">
                        <Setter Property="Foreground" Value="#10B981"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </controls:MicaWindow.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CornerRadius="14" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootContent" Margin="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ WALLPAPER LAYERS (hidden when no wallpaper set) ═══ -->
        <!-- Layer 1: Full background image (center, fills entire window) -->
        <Image x:Name="WallpaperBg" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.25"
               RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <!-- Layer 2: Theme color gradient overlay emanating from center -->
        <Border x:Name="WallpaperThemeOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush x:Name="WallpaperRadialBrush" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#60000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Layer 3: Frosted glass header — subtle blur with smooth fade-out -->
        <Border x:Name="WallpaperFrostHeader" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                ClipToBounds="True" CornerRadius="12,12,0,0" Height="54" VerticalAlignment="Top">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#AA000000" Offset="0.5"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid>
                <Image x:Name="WallpaperFrostImg" Stretch="UniformToFill" Opacity="0.2"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.Effect>
                        <BlurEffect Radius="12" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
                <!-- Subtle tinted glass overlay -->
                <Border x:Name="WallpaperFrostTint" Background="#25000000"/>
            </Grid>
        </Border>

        <tray:NotifyIcon
            FocusOnLeftClick="False"
            Icon="pack://application:,,,/Resources/ClipFlowLogo.ico"
            MenuOnRightClick="True"
            LeftClick="nIcon_LeftClick"
            TooltipText="FlyShelf">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Open FlyShelf Hub" Click="OpenApp_Click" />
                    <Separator />
                    <MenuItem Header="Quit FlyShelf" Click="NotifyIconQuit_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
        
        <Grid Grid.Row="0" Margin="14,14,14,8" Background="#01000000" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Bar — expands inline when toggled -->
            <Border x:Name="SearchBarContainer" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                    Background="#18FFFFFF" CornerRadius="8" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="6,2"
                    Panel.ZIndex="10" PreviewMouseLeftButtonDown="SearchBar_PreviewMouseDown"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Background="Transparent">
                        <TextBlock x:Name="SearchPlaceholder" Text="Search (Ctrl+F)" Foreground="#50FFFFFF" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False" Margin="4,0,0,0"/>
                        <TextBox x:Name="SearchTextBox" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                                 FontSize="12" VerticalAlignment="Center" CaretBrush="White" Padding="4,2" Margin="0"
                                 HorizontalContentAlignment="Left"
                                 TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                    <!-- Clear search button -->
                    <ui:Button Grid.Column="1" Focusable="False" Appearance="Secondary" Foreground="#9CA3AF" Click="ClearSearch_Click" ToolTip="Clear Search" Margin="2,0,0,0" Padding="4,2" CornerRadius="6">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss12" FontSize="10"/></ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
            
            <Border Grid.Column="0" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                
                <!-- Search Toggle -->
                <ui:Button x:Name="SearchToggleBtn" Focusable="False" Appearance="Secondary" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Click="SearchToggle_Click" ToolTip="Search Clipboard (Ctrl+F)" Margin="0,0,6,0" Padding="8,6" CornerRadius="8">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Search24" /></ui:Button.Icon>
                </ui:Button>

                <ui:Button Name="ToggleExpandBtn" Focusable="False" Appearance="Secondary" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Click="OpenApp_Click" ToolTip="Open FlyShelf Hub" Margin="0,0,6,0" Padding="8,6" CornerRadius="8">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowMaximize24" /></ui:Button.Icon>
                </ui:Button>

                <!-- Emoji button — swaps to Merge PDF when 2+ PDFs selected -->
                <ui:Button x:Name="EmojiBtn" Focusable="False" Appearance="Secondary" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Click="EmojiPicker_Click" ToolTip="Emoji Picker" Margin="0,0,6,0" Padding="8,6" CornerRadius="8">
                    <ui:Button.Icon>
                        <Grid Width="20" Height="20">
                            <!-- Standard emoji icon -->
                            <ui:SymbolIcon x:Name="EmojiBtnIcon" Symbol="Emoji24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragHovering, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>

                            <Grid x:Name="DropArrowContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragHovering, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ui:SymbolIcon Symbol="ArrowDown24" Foreground="#10B981" RenderTransformOrigin="0.5,0.5">
                                    <ui:SymbolIcon.RenderTransform>
                                        <TranslateTransform x:Name="ArrowTranslate" Y="0"/>
                                    </ui:SymbolIcon.RenderTransform>
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragHovering, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="BounceArrowStory">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                 From="-4" To="4" Duration="0:0:0.6" AutoReverse="True">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <SineEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="BounceArrowStory"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </Grid>
                    </ui:Button.Icon>
                </ui:Button>
                <!-- Merge PDF button — hidden by default, replaces emoji when PDFs selected -->
                <ui:Button x:Name="MergePdfToolbarBtn" Focusable="False" Visibility="Collapsed" Click="MergeSelectedPdfsBtn_Click" ToolTip="Merge Selected PDFs" Margin="0,0,6,0" Padding="8,6" CornerRadius="8" Background="#30EF4444" Foreground="#EF4444" BorderBrush="#50EF4444">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentCopy24" Foreground="#EF4444"/></ui:Button.Icon>
                </ui:Button>
                
                <ui:Button Focusable="False" Appearance="Secondary" Style="{StaticResource ToolbarSyncButtonStyle}" Click="ToggleGlobalSync_Click" ToolTip="Toggle All Sync (LAN + Cloud)" Margin="0,0,6,0" Padding="8,6" CornerRadius="8">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" Filled="True"/></ui:Button.Icon>
                </ui:Button>

                <ui:Button Focusable="False" Appearance="Secondary" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Click="Clear_Click" ToolTip="Clear Shelf (keeps pinned)" Margin="0,0,6,0" Padding="8,6" CornerRadius="8">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
                </ui:Button>
                
                <ui:Button Focusable="False" Appearance="Secondary" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Click="CloseWindow_Click" ToolTip="Hide (Esc)" Padding="8,6" CornerRadius="8">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" Filled="True"/></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ListView Name="ShelfListView" Grid.Row="1" ItemsSource="{Binding DroppedItems}" Background="#01000000" BorderThickness="0" Margin="12,0,12,12"
                  Focusable="True" KeyboardNavigation.DirectionalNavigation="Contained"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  ScrollViewer.CanContentScroll="False"
                  SelectionMode="Extended" MouseMove="ShelfListView_MouseMove" PreviewMouseLeftButtonDown="ShelfListView_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="ShelfListView_PreviewMouseLeftButtonUp"
                  MouseDoubleClick="ShelfListView_MouseDoubleClick" SelectionChanged="ShelfListView_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  AlternationCount="10"
                  PreviewKeyDown="ShelfListView_KeyDown"
                  PreviewMouseWheel="ShelfListView_PreviewMouseWheel">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Focusable" Value="True"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                        BorderThickness="1.5" BorderBrush="Transparent" CornerRadius="14" Margin="2,0">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#60A78BFA"/>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#10A78BFA"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#80A78BFA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!-- NOTE: Loaded animation REMOVED — virtualization recycling fires Loaded on every scroll, causing severe lag -->
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Name="CardBorder" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1,0.5,1,1" CornerRadius="14" Margin="4,1,4,2" Padding="0" RenderTransformOrigin="0.5,0.5"
                            MouseEnter="CardBorder_MouseEnter" MouseLeave="CardBorder_MouseLeave">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource MicaWPF.Colors.SubtleFillColorSecondary}" />
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Opacity" Value="1" />
                                <!-- NOTE: Loaded animation REMOVED — virtualization recycling causes lag -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="-2" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform Y="0"/>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>

                        <!-- Inner highlight border for frosted glass effect -->
                        <Border Name="InnerHighlightBorder" BorderThickness="0,1,0,0" BorderBrush="#0CFFFFFF" CornerRadius="14" Padding="12">
                        <Grid Name="ItemGrid" HorizontalAlignment="Stretch" Background="Transparent" Tag="{Binding DataContext, ElementName=ShelfListView}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <ContextMenu.Resources>
                                        <Style TargetType="Separator">
                                            <Setter Property="Margin" Value="8,4"/>
                                            <Setter Property="Background" Value="#18FFFFFF"/>
                                        </Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="FontSize" Value="12.5"/>
                                        </Style>
                                    </ContextMenu.Resources>

                                    <!-- ═══ Universal: Pin / Unpin ═══ -->
                                    <MenuItem Header="{Binding PinLabel}" 
                                              Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                    <!-- ═══ Universal: Copy Content ═══ -->
                                    <MenuItem Header="Copy to Clipboard" 
                                              Command="{Binding PlacementTarget.Tag.CopyRawContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                    <!-- ═══ Universal: Force Send ═══ -->
                                    <MenuItem Header="⚡ Force Send to Device..." Click="ForceSendItem_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <Separator />

                                    <!-- ═══ TEXT / CODE Actions ═══ -->
                                    <MenuItem Header="🔍 Search on Google" Click="GoogleSearch_Click" 
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsTextPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <MenuItem Header="📄 Convert Text to PDF" Click="ConvertTextToPdf_Click" 
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsTextPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- ═══ CODE: VS Code + Terminal ═══ -->
                                    <MenuItem Header="Open in VS Code" 
                                              Command="{Binding PlacementTarget.Tag.LaunchSandboxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <MenuItem Header="Run in Terminal" 
                                              Command="{Binding PlacementTarget.Tag.LaunchTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsCodePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <MenuItem Header="Compile C++ &amp; Run" 
                                              Command="{Binding PlacementTarget.Tag.CompileNativeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsCPlusPlusPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- ═══ IMAGE: OCR Extract + Gemini Table ═══ -->
                                    <MenuItem Header="Extract Text (OCR)" 
                                              Command="{Binding PlacementTarget.Tag.ExtractTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <MenuItem Header="📊 Extract Table Data (Gemini AI)" 
                                              Command="{Binding PlacementTarget.Tag.ExtractTableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Foreground="#A855F7"
                                              Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <MenuItem Header="Convert Image to PDF" 
                                              Command="{Binding PlacementTarget.Tag.ConvertImageToPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsImagePreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- ═══ PDF: Open + Convert ═══ -->
                                    <MenuItem Header="Open PDF in Browser" 
                                              Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsPdfPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <MenuItem Header="Convert PDF to Word" Click="ConvertPdfToWord_Click" 
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsPdfPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- ═══ DOCUMENT: Convert to PDF ═══ -->
                                    <MenuItem Header="Convert to PDF" 
                                              Command="{Binding PlacementTarget.Tag.ConvertDocumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsDocPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- ═══ URL: Open in Browser ═══ -->
                                    <MenuItem Header="Open in Browser" 
                                              Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              Visibility="{Binding PlacementTarget.DataContext.IsUrlPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Separator />

                                    <!-- ═══ FILE-BACKED: Show in Explorer ═══ -->
                                    <MenuItem Header="Show in Explorer" 
                                              Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.CanShowInExplorer, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Separator />

                                    <!-- ═══ Universal: Delete ═══ -->
                                    <MenuItem Header="Delete" 
                                              Command="{Binding PlacementTarget.Tag.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="#EF4444"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>




                            <!-- Inline Action Buttons — compact individual pills (hover reveals) -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Panel.ZIndex="5" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- ═══ Smart Action ═══ -->
                                <Border CornerRadius="6" Background="#E0181818" Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSmartAction}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SmartActionType}" Value="ConvertToPdf">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorLight1}" PreviewMouseLeftButtonDown="SmartActionSpecific_Click">
                                        <ui:Button.ToolTip><ToolTip Content="{Binding SmartActionName}" /></ui:Button.ToolTip>
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="14">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Flash24"/><Setter Property="Filled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="CompileAndRun"><Setter Property="Symbol" Value="Play24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF"><Setter Property="Symbol" Value="Document24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="ConvertToPdf"><Setter Property="Symbol" Value="DocumentPdf24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="JoinMeeting"><Setter Property="Symbol" Value="Video24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenBrowser"><Setter Property="Symbol" Value="Globe24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="SetTimer"><Setter Property="Symbol" Value="Clock24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenMap"><Setter Property="Symbol" Value="Map24"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="CopyQRText"><Setter Property="Symbol" Value="Copy24"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Run Script ═══ -->
                                <Border CornerRadius="6" Background="#E0181818" Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="#10B981" PreviewMouseLeftButtonDown="RunTerminalSpecific_Click" ToolTip="Run Script">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Open File ═══ -->
                                <Border CornerRadius="6" Background="#E0181818" Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="#60A5FA" PreviewMouseLeftButtonDown="OpenSpecific_Click" ToolTip="Open">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Open24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Show in Explorer ═══ -->
                                <Border CornerRadius="6" Background="#E0181818" Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Folder"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Group"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="#FBBF24" ToolTip="Show in Explorer"
                                               Command="{Binding DataContext.OpenFileLocationCommand, ElementName=ShelfListView}" CommandParameter="{Binding}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Quick Look ═══ -->
                                <Border CornerRadius="6" Background="#E0181818" Margin="0,0,2,0" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="#F472B6" PreviewMouseLeftButtonDown="QuickLookSpecific_Click" ToolTip="Quick Look">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Pin/Unpin ═══ -->
                                <Border CornerRadius="6" Background="#E0181818" Margin="0,0,2,0" Padding="0">
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" PreviewMouseLeftButtonDown="PinSpecific_Click" ToolTip="{Binding PinLabel}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon FontSize="14">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Pin24"/><Setter Property="Filled" Value="True"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Symbol" Value="PinOff24"/>
                                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- ═══ Delete ═══ -->
                                <Border CornerRadius="6" Background="#E0181818" Padding="0">
                                    <ui:Button Focusable="False" Appearance="Secondary" Padding="4,3" Foreground="#EF4444" PreviewMouseLeftButtonDown="DeleteSpecific_Click" ToolTip="Delete">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" Filled="True" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                            </StackPanel>

                            <!-- Standard File Icon (Images, Zips) -->
                            <Border Name="IconBorder" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                                    CornerRadius="8" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Text">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Url">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Code">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Name="ItemIcon" Source="{Binding Icon}" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" CacheMode="BitmapCache">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGifPreview}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image Name="GifItemIcon" gif:AnimationBehavior.SourceUri="{Binding GifFilePath}" gif:AnimationBehavior.RepeatBehavior="Forever" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding IsGifPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <!-- u2550u2550u2550 Rotate Image u2014 round floating button, bottom-right of icon u2550u2550u2550 -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Margin="0,0,-6,10" Panel.ZIndex="8" Focusable="False"
                                    Tag="RotateImage" PreviewMouseLeftButtonDown="RotateImageSpecific_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="26" Height="26" CornerRadius="13"
                                                            Background="#D0181818" BorderBrush="#40FFFFFF" BorderThickness="1"
                                                            ToolTip="Rotate 90u00B0">
                                                        <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="13" Foreground="#A78BFA"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- PDF Merge Toggle — top-left of icon, PDF only. Uses Button to avoid ListView CheckBox conflicts -->
                            <Button Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Margin="-4,-4,0,0" Panel.ZIndex="10" Focusable="False"
                                    Tag="PdfMergeToggle" Click="PdfMergeToggle_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="26" Height="26" Background="Transparent">
                                                        <!-- Unchecked state: dark rounded square with red border -->
                                                        <Border x:Name="UncheckedBg" Width="22" Height="22" CornerRadius="6"
                                                                Background="#80181818" BorderBrush="#60EF4444" BorderThickness="1.5"/>
                                                        <!-- Checked state: solid red with checkmark -->
                                                        <Border x:Name="CheckedBg" Width="22" Height="22" CornerRadius="6"
                                                                Background="#EF4444" BorderBrush="#EF4444" BorderThickness="1.5" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="CheckMark" Text="✓" FontSize="13" FontWeight="Bold"
                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="0,-1,0,0" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckedForMerge}" Value="True">
                                                            <Setter TargetName="UncheckedBg" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="CheckedBg" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="UncheckedBg" Property="BorderBrush" Value="#EF4444"/>
                                                            <Setter TargetName="UncheckedBg" Property="Background" Value="#40EF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Semantic Icon Fallback -->
                            <Border Name="SemanticIconBorder" Grid.Row="0" Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="10" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Code">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Archive">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Document">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Group">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ItemType}" Value="Presentation">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Video">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Audio">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="Pdf">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ItemType}" Value="File">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon FontSize="20" Filled="True">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Document24" />
                                            <Setter Property="Foreground" Value="#60A5FA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Code">
                                                    <Setter Property="Symbol" Value="Code24"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Archive">
                                                    <Setter Property="Symbol" Value="FolderZip24"/>
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Group">
                                                    <Setter Property="Symbol" Value="FolderMultiple24"/>
                                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="Document24"/>
                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="DocumentPdf24"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUrlPreview}" Value="True">
                                                    <Setter Property="Symbol" Value="Globe24"/>
                                                    <Setter Property="Foreground" Value="#0EA5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Presentation">
                                                    <Setter Property="Symbol" Value="Document24"/>
                                                    <Setter Property="Foreground" Value="#F97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Video">
                                                    <Setter Property="Symbol" Value="VideoClip24"/>
                                                    <Setter Property="Foreground" Value="#8B5CF6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="Audio">
                                                    <Setter Property="Symbol" Value="MusicNote124"/>
                                                    <Setter Property="Foreground" Value="#EC4899"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>

                            <!-- Sender Badge — Top-right corner overlay -->
                            <StackPanel Name="SenderBadge" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Panel.ZIndex="4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SourceDeviceName}" Value="Local">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                    <Border CornerRadius="6" Padding="5,2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="10" Margin="0,0,3,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Laptop24" />
                                                    <Setter Property="Foreground" Value="#60A5FA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceDeviceType}" Value="Mobile">
                                                            <Setter Property="Symbol" Value="Phone24"/>
                                                            <Setter Property="Foreground" Value="#A78BFA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding SourceDeviceName}" Foreground="#9CA3AF" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="·" Foreground="#4B5563" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☁️ Cloud"/>
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="Cloudflare">
                                                            <Setter Property="Text" Value="🌐 Cloudflare"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="LAN">
                                                            <Setter Property="Text" Value="📡 LAN"/>
                                                            <Setter Property="Foreground" Value="#6366F1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="ForceSend">
                                                            <Setter Property="Text" Value="🎯 Direct"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TransferMethod}" Value="Local">
                                                            <Setter Property="Text" Value="📋 Local"/>
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- The Text Body -->
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Name="TitleText" 
                                           Text="{Binding FileName}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" FontWeight="SemiBold" FontSize="13" LineHeight="19" TextWrapping="Wrap" 
                                           TextTrimming="CharacterEllipsis" MaxHeight="130" />
                                
                                <!-- File Transfer / Download Progress Panel -->
                                <StackPanel Margin="0,4,0,0" Visibility="{Binding IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Height="4" Foreground="#10B981" Background="#15FFFFFF" BorderThickness="0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding TransferStatusText}" FontSize="10.5" Foreground="#10B981" Margin="0,3,0,0" FontWeight="Medium" Opacity="0.9"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                        </Border>
                    </Border>

                    <DataTemplate.Triggers>
                        <!-- Dynamic sizing for Large Images vs Standard Files -->
                        <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                             <Setter TargetName="InnerHighlightBorder" Property="Padding" Value="3" />
                             <Setter TargetName="ItemIcon" Property="Stretch" Value="UniformToFill" />
                             <Setter TargetName="ItemIcon" Property="Height" Value="100" />
                             <Setter TargetName="ItemIcon" Property="Width" Value="NaN" />
                             <Setter TargetName="ItemIcon" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="ItemIcon" Property="HorizontalAlignment" Value="Center" />
                             <Setter TargetName="ItemIcon" Property="Margin" Value="0" />
                             <Setter TargetName="GifItemIcon" Property="Stretch" Value="UniformToFill" />
                             <Setter TargetName="GifItemIcon" Property="Height" Value="100" />
                             <Setter TargetName="GifItemIcon" Property="Width" Value="NaN" />
                             <Setter TargetName="GifItemIcon" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="GifItemIcon" Property="HorizontalAlignment" Value="Center" />
                             <Setter TargetName="GifItemIcon" Property="Margin" Value="0" />
                             <Setter TargetName="IconBorder" Property="Margin" Value="0" />
                             <Setter TargetName="IconBorder" Property="Grid.ColumnSpan" Value="2" />
                             <Setter TargetName="IconBorder" Property="HorizontalAlignment" Value="Center" />
                             <Setter TargetName="IconBorder" Property="Background" Value="Transparent" />
                             <Setter TargetName="IconBorder" Property="Padding" Value="0" />
                             <Setter TargetName="IconBorder" Property="CornerRadius" Value="11" />
                             <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Apply Font Modifiers for Code Types -->
                        <DataTrigger Binding="{Binding IsCodePreview}" Value="True">
                             <Setter TargetName="TitleText" Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
                             <Setter TargetName="TitleText" Property="Foreground" Value="#6EE7B7" />
                             <Setter TargetName="TitleText" Property="FontSize" Value="11.5" />
                        </DataTrigger>
                        
                        <!-- Hover Effect on the Container -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.ControlStrokeColorSecondary}"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Floating Merge Selected PDFs Button -->
        <ui:Button x:Name="MergeSelectedPdfsBtn" Grid.Row="1" Appearance="Primary" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,10" Panel.ZIndex="50" Visibility="Collapsed" Click="MergeSelectedPdfsBtn_Click">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DocumentCopy24" Margin="0,0,8,0" />
                <TextBlock x:Name="MergeSelectedPdfsText" Text="Merge 2 PDFs" FontWeight="SemiBold" FontSize="14"/>
            </StackPanel>
            <ui:Button.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.4" Direction="270" ShadowDepth="4" />
            </ui:Button.Effect>
        </ui:Button>

        <!-- Floating Unpin Selected Button -->
        <ui:Button x:Name="UnpinSelectedBtn" Grid.Row="1" Appearance="Caution" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,10" Panel.ZIndex="50" Visibility="Collapsed" Click="UnpinSelectedBtn_Click">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PinOff24" Margin="0,0,8,0" />
                <TextBlock x:Name="UnpinSelectedText" Text="Unpin Selected" FontWeight="SemiBold" FontSize="14"/>
            </StackPanel>
            <ui:Button.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.4" Direction="270" ShadowDepth="4" />
            </ui:Button.Effect>
        </ui:Button>

        <!-- Empty State -->
        <StackPanel Name="EmptyStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DroppedItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-6" Duration="0:0:1.5" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="28" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Your shelf is empty" Opacity="0.45" FontWeight="SemiBold" FontSize="14" TextAlignment="Center"/>
            <TextBlock Opacity="0.28" FontSize="11.5" Margin="0,10,0,0" TextAlignment="Center" LineHeight="20">
                <Run Text="⌨️ Press"/><Run Text=" Alt+C " FontWeight="SemiBold"/><Run Text="anywhere to open"/>
                <LineBreak/>
                <Run Text="🖱️ Shake mouse to summon"/>
                <LineBreak/>
                <Run Text="📁 Drag files here to shelve"/>
                <LineBreak/>
                <Run Text="🔍 "/><Run Text="Ctrl+F" FontWeight="SemiBold"/><Run Text=" to search your clips"/>
            </TextBlock>
        </StackPanel>

        <!-- Drag-Over Overlay Zone removed - replaced with elegant mini arrow animation in button header -->

    </Grid>
</controls:MicaWindow>

