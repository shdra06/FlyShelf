<ResourceDictionary x:Class="FlyShelf.Styles.HubClipboardItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:FlyShelf.ViewModels"
                    xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif">

    <!-- Hub Clipboard Item Template — extracted from HubWindow.xaml for modularity -->
    <DataTemplate x:Key="HubClipboardItemTemplate">
                                <Border Margin="0,0,0,8" Padding="0" ClipToBounds="True" CornerRadius="{StaticResource RadiusMD}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="0" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCheckedForMerge}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SyncBothBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SyncBothBorder}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeOverlayBgHover}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderHover}" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.EaseOut}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="{StaticResource Motion.Normal}" EasingFunction="{StaticResource Motion.EaseInOut}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <!-- Universal Actions -->
                                            <ui:MenuItem Header="Copy Content" Icon="{ui:SymbolIcon Copy24}" Command="{Binding PlacementTarget.Tag.CopyRawContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <ui:MenuItem Header="Pin / Unpin" Icon="{ui:SymbolIcon Pin24}" Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <ui:MenuItem Header="Show in Explorer" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <Separator />
                                            
                                            <!-- Image Actions -->
                                            <ui:MenuItem Header="Extract Text from Image (OCR)" Icon="{ui:SymbolIcon TextDescription24}" Foreground="{DynamicResource MenuOcrColor}" Command="{Binding PlacementTarget.Tag.ExtractTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Extract Table Data" Icon="{ui:SymbolIcon Table24}" Foreground="{DynamicResource MenuOcrColor}" Command="{Binding PlacementTarget.Tag.ExtractTableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Convert Image to PDF" Icon="{ui:SymbolIcon Document24}" Foreground="{DynamicResource MenuConvertColor}" Command="{Binding PlacementTarget.Tag.ConvertImageToPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Scan QR Code" Icon="{ui:SymbolIcon QrCode24}" Foreground="{DynamicResource MenuOcrColor}" Command="{Binding PlacementTarget.Tag.ManualScanQRCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <!-- QR Code Actions -->
                                            <ui:MenuItem Header="Extract QR Text &amp; Copy" Icon="{ui:SymbolIcon QrCode24}" Foreground="{DynamicResource TypeTextColor}" Command="{Binding PlacementTarget.Tag.CopyRawContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsQRCodePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <!-- URL Actions -->
                                            <ui:MenuItem Header="Open URL in Browser" Icon="{ui:SymbolIcon Earth24}" Foreground="{DynamicResource MenuUrlActionColor}" Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsUrlPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <!-- PDF Actions -->
                                            <ui:MenuItem Header="Open PDF" Icon="{ui:SymbolIcon Open24}" Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsPdfPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Convert PDF to Word" Icon="{ui:SymbolIcon Document24}" Foreground="{DynamicResource TypeDocColor}" Command="{Binding PlacementTarget.Tag.ConvertPdfToWordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsPdfPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Merge Selected PDFs" Icon="{ui:SymbolIcon DocumentCopy24}" Foreground="{DynamicResource DangerColor}" Command="{Binding PlacementTarget.Tag.MergeSelectedPdfsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Visibility="{Binding IsPdfPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <!-- Document Actions -->
                                            <ui:MenuItem Header="Convert to PDF" Icon="{ui:SymbolIcon Document24}" Foreground="{DynamicResource TypeDocColor}" Command="{Binding PlacementTarget.Tag.ConvertDocumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsDocPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <!-- Code Actions -->
                                            <ui:MenuItem Header="Run in Terminal" Icon="{ui:SymbolIcon Play24}" Foreground="{DynamicResource MenuCodeActionColor}" Command="{Binding PlacementTarget.Tag.LaunchTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsCodePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Open in VS Code" Icon="{ui:SymbolIcon Code24}" Foreground="{DynamicResource DeviceLaptopColor}" Command="{Binding PlacementTarget.Tag.LaunchSandboxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsCodePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Compile C++ &amp; Run" Icon="{ui:SymbolIcon Code24}" Foreground="{DynamicResource MenuCodeActionColor}" Command="{Binding PlacementTarget.Tag.CompileNativeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsCPlusPlusPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Run as Administrator" Icon="{ui:SymbolIcon Shield24}" Foreground="{DynamicResource DangerColor}" Command="{Binding PlacementTarget.Tag.RunAdminTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding IsTerminalPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <Separator />
                                            
                                            <!-- Color Actions -->
                                            <ui:MenuItem Header="Copy as Hex" Icon="{ui:SymbolIcon Color24}" Foreground="{DynamicResource TypeColorColor}" Click="CopyColorHex_Click" Visibility="{Binding HasDetectedColor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Copy as RGB" Icon="{ui:SymbolIcon Color24}" Foreground="{DynamicResource TypeImageColor}" Click="CopyColorRgb_Click" Visibility="{Binding HasDetectedColor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Copy as HSL" Icon="{ui:SymbolIcon Color24}" Foreground="{DynamicResource TypeColorColor}" Click="CopyColorHsl_Click" Visibility="{Binding HasDetectedColor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            
                                            <!-- Group / Archive / Folder Actions -->
                                            <ui:MenuItem Header="Send to Device" Icon="{ui:SymbolIcon Send24}" Foreground="{DynamicResource TypeDefaultColor}" Click="ContextMenu_SendToDevice_Click" Visibility="{Binding IsGroupPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Send to Device" Icon="{ui:SymbolIcon Send24}" Foreground="{DynamicResource TypeDefaultColor}" Click="ContextMenu_SendToDevice_Click" Visibility="{Binding IsArchivePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:MenuItem Header="Send to Device" Icon="{ui:SymbolIcon Send24}" Foreground="{DynamicResource TypeDefaultColor}" Click="ContextMenu_SendToDevice_Click" Visibility="{Binding IsFolderPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <ui:MenuItem Header="Extract Archive" Icon="{ui:SymbolIcon FolderZip24}" Foreground="{DynamicResource MenuConvertColor}" Click="ExtractArchive_Click" Visibility="{Binding IsArchivePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <Separator />
                                            <ui:MenuItem Header="Delete" Icon="{ui:SymbolIcon Delete24}" Foreground="{DynamicResource DangerColor}" Command="{Binding PlacementTarget.Tag.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Sender Badge — Top-right corner overlay -->
                                        <StackPanel Name="SenderBadge" Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Panel.ZIndex="4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceDeviceName}" Value="Local">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border CornerRadius="{StaticResource RadiusSM}" Padding="5,2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon FontSize="{StaticResource TypeCaption}" Margin="0,0,3,0">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Laptop24" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DeviceLaptopColor}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SourceDeviceType}" Value="Mobile">
                                                                        <Setter Property="Symbol" Value="Phone24"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypeGroupColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                    <TextBlock Text="{Binding SourceDeviceName}" Foreground="{DynamicResource SubtleTextColor}" FontSize="{StaticResource TypeMicro}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="·" Foreground="{DynamicResource SeparatorDotColor}" FontSize="{StaticResource TypeMicro}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="☁️ Cloud"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningColor}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TransferMethod}" Value="Cloudflare">
                                                                        <Setter Property="Text" Value="🌐 Cloudflare"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypeCodeColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TransferMethod}" Value="LAN">
                                                                        <Setter Property="Text" Value="📡 LAN"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypeDefaultColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TransferMethod}" Value="ForceSend">
                                                                        <Setter Property="Text" Value="🎯 Direct"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypePdfColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TransferMethod}" Value="Local">
                                                                        <Setter Property="Text" Value="📋 Local"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource SubtleTextColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Left accent bar (outermost) -->
                                        <Border Grid.Column="0" CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource TypeDefaultColor}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCodePreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypeCodeColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUrlPreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypeUrlColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypeImageColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypePdfColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypeDocColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTextPreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypeTextColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsGroupPreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypeGroupColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsArchivePreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFolderPreview}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TypeTextColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- CheckBox (after gap) -->
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsCheckedForMerge, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0" Click="ItemCheckBox_Click" />

                                        <!-- File Type Icon Badge -->
                                        <Border Grid.Column="3" Width="44" Height="44" CornerRadius="{StaticResource RadiusMD}" ClipToBounds="True" Margin="12,10,12,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- Static image thumbnail (non-GIF) -->
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding IsStaticImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <!-- Animated GIF thumbnail -->
                                                <Image gif:AnimationBehavior.SourceUri="{Binding GifFilePath}" gif:AnimationBehavior.RepeatBehavior="Forever" gif:AnimationBehavior.AutoStart="True" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Loaded="HubGifIcon_Loaded" Unloaded="HubGifIcon_Unloaded" Visibility="{Binding IsGifPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!-- Image Placeholder — shown when Icon hasn't loaded yet for image items -->
                                                <Border Name="ImagePlaceholderBorder">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                                        <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                                        <TextBlock Text="🖼" FontSize="{StaticResource TypeHeadline}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Image" FontSize="{StaticResource TypeMicro}" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- System file-association icon (e.g. PDF reader, Word, etc.) — shown when Icon is available for file types -->
                                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Width="36" Height="36">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <!-- Show for file types that have a system icon (PDF, Doc, Video, Group, etc.) -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding IsImagePreview}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding IsImagePreview}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsVideoPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding IsImagePreview}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsGroupPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding IsImagePreview}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolderPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding IsImagePreview}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <!-- Hide when Icon is null (will fall through to gradient fallbacks below) -->
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Text icon -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsTextPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding HasDetectedColor}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                                            <GradientStop Color="#A78BFA" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="TextDescription24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Code icon -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsCodePreview}" Value="True"/>
                                                                        <Condition Binding="{Binding HasDetectedColor}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#059669" Offset="0"/>
                                                            <GradientStop Color="#34D399" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Code24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- URL icon -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsUrlPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding HasDetectedColor}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#0284C7" Offset="0"/>
                                                            <GradientStop Color="#38BDF8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Globe24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Color Swatch Premium Preview — shown when a HEX, RGB, or HSL color is detected -->
                                                <Border Name="ColorSwatchBorder" Background="{Binding DetectedColorBrush}" CornerRadius="{StaticResource RadiusMD}" 
                                                        BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDetectedColor}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- PDF icon FALLBACK (only when no system Icon available) -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsPdfPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#DC2626" Offset="0"/>
                                                            <GradientStop Color="#F87171" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="PDF" FontSize="{StaticResource TypeSubtitle}" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Document icon FALLBACK (only when no system Icon available) -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsDocPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#1D4ED8" Offset="0"/>
                                                            <GradientStop Color="#60A5FA" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Document24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Group icon (no system icon overlap issue) -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsGroupPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                                            <GradientStop Color="#C084FC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="FolderMultiple24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Archive icon FALLBACK (only when no system Icon available) -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsArchivePreview}" Value="True"/>
                                                                        <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#D97706" Offset="0"/>
                                                            <GradientStop Color="#FBBF24" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Video icon FALLBACK (only when no system Icon available) -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsVideoPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#D97706" Offset="0"/>
                                                            <GradientStop Color="#FBBF24" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Video24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Folder icon FALLBACK (only when no system Icon available) -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolderPreview}" Value="True"/>
                                                                        <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#D97706" Offset="0"/>
                                                            <GradientStop Color="#FBBF24" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="18" Foreground="{DynamicResource ThemeTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- ═══ Rotate Image — round floating button, bottom-right of icon ═══ -->
                                        <Button Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                Margin="0,0,4,4" Panel.ZIndex="8" Focusable="False"
                                                Tag="RotateImage" PreviewMouseLeftButtonDown="RotateImageSpecific_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Width="22" Height="22" CornerRadius="11"
                                                                        Background="{DynamicResource ThemeOverlayButtonBg}" BorderBrush="{DynamicResource ThemeOverlayBorderStrong}" BorderThickness="1"
                                                                        ToolTip="Rotate 90°">
                                                                    <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="{StaticResource TypeSmall}" Foreground="{DynamicResource TypeGroupColor}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsImagePreview}" Value="True"/>
                                                                <Condition Binding="{Binding IsRelativeMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Content Block -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,12,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Color detection dot -->
                                                <Border Width="12" Height="12" CornerRadius="{StaticResource RadiusSM}" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding DetectedColorBrush}" Visibility="{Binding HasDetectedColor, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{Binding DetectedColorBrush}" BorderThickness="1.5"/>
                                                <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TypeSubtitle}" FontFamily="Segoe UI Emoji, Segoe UI" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLongText}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCodePreview}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BadgeCodeBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BadgePdfBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BadgeImageBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUrlPreview}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BadgeUrlBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsGroupPreview}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BadgeGroupBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsArchivePreview}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BadgeArchiveBg}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding FormatIdentifier}" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource DeviceLaptopColor}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCodePreview}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypeCodeColor}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypePdfColor}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypeImageColor}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsUrlPreview}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypeUrlColor}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsGroupPreview}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TypeGroupColor}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsArchivePreview}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding FormattedSize, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" />
                                                </Border>
                                                <TextBlock Text="{Binding DateCopied, StringFormat='{}{0:HH:mm}'}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" VerticalAlignment="Center" Opacity="0.6"/>

                                                <!-- Color swatch preview -->
                                                <!-- PERF: DropShadowEffect removed — per-item software shader -->
                                                <Border Width="28" Height="14" CornerRadius="3" Margin="6,0,0,0" Background="{Binding DetectedColorBrush}" Visibility="{Binding HasDetectedColor, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding DetectedColor}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RawContentPreview}" FontSize="{StaticResource TypeBody}" FontFamily="Segoe UI Emoji, Segoe UI" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" MaxHeight="{Binding CollapsedMaxHeight}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            
                                            <!-- Circular Expand/Collapse Chevron Toggle Button for Long Text / Code cards -->
                                            <Button PreviewMouseLeftButtonDown="ExpandToggleSpecific_Click"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4,0,0"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid Width="26" Height="26" Background="Transparent">
                                                                        <!-- PERF: DropShadowEffect removed — per-item software shader -->
                                                                        <Border x:Name="CircleBorder" Width="22" Height="22" CornerRadius="11"
                                                                                Background="{DynamicResource ThemeChevronBg}" BorderBrush="{DynamicResource ThemeChevronBorder}" BorderThickness="1.5">
                                                                            <ui:SymbolIcon x:Name="ChevronIcon" Symbol="ChevronDown24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource InfoColor}"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0.5,0,0"/>
                                                                        </Border>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronUp24"/>
                                                                            <Setter TargetName="ChevronIcon" Property="Foreground" Value="{DynamicResource TypePdfColor}"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CircleBorder" Property="Background" Value="#E62C2C32"/>
                                                                            <Setter TargetName="CircleBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLongText}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            
                                            <!-- File Transfer / Download Progress Panel -->
                                            <StackPanel Margin="0,4,0,0" Visibility="{Binding IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ProgressBar Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Height="4" Foreground="{DynamicResource SyncIncomingColor}" Background="#15FFFFFF" BorderThickness="0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                                                                        </Grid>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding TransferStatusText}" FontSize="10.5" Foreground="{DynamicResource SyncIncomingColor}" Margin="0,3,0,0" FontWeight="Medium" Opacity="0.9"/>
                                            </StackPanel>

                                            <!-- Inline Audio Player Panel -->
                                            <Grid Margin="0,6,0,2" Visibility="{Binding IsAudioPreview, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Play/Pause Button -->
                                                <ui:Button Grid.Column="0" Focusable="False" Padding="6" CornerRadius="18" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Command="{Binding PlayPauseAudioCommand}" Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon FontSize="18">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="Play24"/>
                                                                    <Setter Property="Filled" Value="True"/>
                                                                    <Setter Property="Foreground" Value="#EC4899"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAudioPlaying}" Value="True">
                                                                            <Setter Property="Symbol" Value="Pause24"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </ui:Button.Icon>
                                                </ui:Button>

                                                <!-- Progress Slider -->
                                                <Slider Grid.Column="1" Value="{Binding AudioPosition, Mode=TwoWay}" Maximum="{Binding AudioDuration}" Minimum="0"
                                                        VerticalAlignment="Center" Height="22" Focusable="False" Foreground="#EC4899"/>

                                                <!-- Time indicator text -->
                                                <TextBlock Grid.Column="2" Text="{Binding AudioPlaybackText}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"
                                                           FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                            </Grid>

                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,10,0">

                                            <!-- Smart Action -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorLight1}" PreviewMouseLeftButtonDown="SmartActionSpecific_Click">
                                                <ui:Button.ToolTip><ToolTip Content="{Binding SmartActionName}" /></ui:Button.ToolTip>
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon FontSize="{StaticResource TypeSubtitle}">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Flash24"/><Setter Property="Filled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="CompileAndRun"><Setter Property="Symbol" Value="Play24"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF"><Setter Property="Symbol" Value="Document24"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="ConvertToPdf"><Setter Property="Symbol" Value="DocumentPdf24"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="JoinMeeting"><Setter Property="Symbol" Value="Video24"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="OpenBrowser"><Setter Property="Symbol" Value="Globe24"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="SetTimer"><Setter Property="Symbol" Value="Clock24"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="OpenMap"><Setter Property="Symbol" Value="Map24"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SmartActionType}" Value="CopyQRText"><Setter Property="Symbol" Value="Copy24"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSmartAction}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SmartActionType}" Value="OpenPDF">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Open in Browser -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Open in Browser" Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Globe24" FontSize="{StaticResource TypeSubtitle}" /></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUrlPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Run Script -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource SyncIncomingColor}" ToolTip="Run Script" PreviewMouseLeftButtonDown="RunTerminalSpecific_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Show in Explorer -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource PinActiveColor}" ToolTip="Show in Explorer" PreviewMouseLeftButtonDown="OpenExplorer_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Presentation"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="File"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Group"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Open Folder -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource PinActiveColor}" ToolTip="Open Folder" PreviewMouseLeftButtonDown="OpenExplorer_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Folder"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Convert to .zip -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource CyanAccentColor}" ToolTip="Convert to .zip" PreviewMouseLeftButtonDown="ConvertToZip_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderZip24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                                    <Condition Binding="{Binding HasZipArchive}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                                    <Condition Binding="{Binding HasZipArchive}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Sync via LAN -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource SuccessColor}" ToolTip="Sync via LAN" PreviewMouseLeftButtonDown="SyncZipLan_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Send24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ItemType}" Value="Group"/>
                                                                    <Condition Binding="{Binding HasZipArchive}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ItemType}" Value="Folder"/>
                                                                    <Condition Binding="{Binding HasZipArchive}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Sanitize URL -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource SanitizeColor}" ToolTip="Sanitize URL (Remove trackers)" PreviewMouseLeftButtonDown="SanitizeUrlSpecific_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Shield24" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Url">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Protect as Password -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource WarningColor}" ToolTip="Protect as Password" PreviewMouseLeftButtonDown="MakePasswordSpecific_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Key24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanConvertToPassword}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Rename Password Label -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" Foreground="{DynamicResource WarningColor}" ToolTip="Rename Password Label" PreviewMouseLeftButtonDown="RenamePasswordSpecific_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Edit24" Filled="True" FontSize="{StaticResource TypeSubtitle}"/></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Extract Text (OCR) -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Extract Text (OCR)" Command="{Binding DataContext.ExtractTextCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <TextBlock Text="T" FontSize="{StaticResource TypeSubtitle}" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{DynamicResource MenuOcrColor}" Margin="4,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Extract Table Data -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Extract Table Data" Command="{Binding DataContext.ExtractTableCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Table24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource TypeTextColor}" /></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Convert Image to PDF -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Convert Image to PDF" Command="{Binding DataContext.ConvertImageToPdfCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource DangerColor}" /></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>


                                            <!-- Convert PDF to Word -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Convert PDF to Word" Command="{Binding DataContext.ConvertPdfToWordCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Document24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource TypeDocColor}" /></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Convert to PDF -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Convert to PDF" Command="{Binding DataContext.ConvertDocumentCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource DangerColor}" /></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMarkdownPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Search Google (hidden for Markdown & terminal/batch cards) -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Search on Google" Command="{Binding DataContext.GoogleSearchCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Search24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource MenuCodeActionColor}" /></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTextPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <!-- Hide for markdown text -->
                                                            <DataTrigger Binding="{Binding IsMarkdownPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <!-- Hide for .bat / .cmd / .ps1 files -->
                                                            <DataTrigger Binding="{Binding IsTerminalPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>


                                            <!-- Send to Device (Group/Archive/Folder) -->
                                            <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,3,0" ToolTip="Send to Device" PreviewMouseLeftButtonDown="SendToDevice_Click">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Send24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource TypeDefaultColor}" /></ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGroupPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsArchivePreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFolderPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Quick Look (Image) -->
                                            <ui:Button Focusable="False" Appearance="Secondary" Padding="6,4" Margin="0,0,3,0"
                                                       Foreground="{DynamicResource TypeImageColor}" ToolTip="Quick Look"
                                                       PreviewMouseLeftButtonDown="QuickLookSpecific_Click">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="{StaticResource TypeSubtitle}"/>
                                                </ui:Button.Icon>
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPdfPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMarkdownPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDocPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <ui:Button Appearance="Transparent" Padding="5,4" Margin="0,0,3,0" ToolTip="Pin" PreviewMouseLeftButtonDown="PinSpecific_Click">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon FontSize="{StaticResource TypeSubtitle}">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Pin24"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </ui:Button.Icon>
                                            </ui:Button>

                                            <ui:Button Appearance="Transparent" Padding="5,4" ToolTip="Delete" PreviewMouseLeftButtonDown="DeleteSpecific_Click">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="{StaticResource TypeSubtitle}" Foreground="{DynamicResource DangerColor}" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
    </DataTemplate>

</ResourceDictionary>
