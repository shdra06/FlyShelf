<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ AERO CLIPBOARD UI — ARCTIC THEME RESOURCES ═══ -->
    <!-- All colors designed for the light frosted Arctic background -->

    <!-- Accent Bar Colors per ItemType -->
    <SolidColorBrush x:Key="AltAccent_Text"         Color="#3B82F6"/>
    <SolidColorBrush x:Key="AltAccent_Code"         Color="#059669"/>
    <SolidColorBrush x:Key="AltAccent_Image"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="AltAccent_Pdf"          Color="#DC2626"/>
    <SolidColorBrush x:Key="AltAccent_Url"          Color="#0284C7"/>
    <SolidColorBrush x:Key="AltAccent_Document"     Color="#2563EB"/>
    <SolidColorBrush x:Key="AltAccent_Archive"      Color="#D97706"/>
    <SolidColorBrush x:Key="AltAccent_Folder"       Color="#CA8A04"/>
    <SolidColorBrush x:Key="AltAccent_Video"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="AltAccent_Audio"        Color="#DB2777"/>
    <SolidColorBrush x:Key="AltAccent_Password"     Color="#EA580C"/>
    <SolidColorBrush x:Key="AltAccent_Presentation" Color="#EA580C"/>
    <SolidColorBrush x:Key="AltAccent_QRCode"       Color="#0D9488"/>
    <SolidColorBrush x:Key="AltAccent_Group"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="AltAccent_File"         Color="#6B7280"/>
    <SolidColorBrush x:Key="AltAccent_Default"      Color="#6B7280"/>

    <!-- Aero Card Background — dedicated clipboard tokens for real contrast -->
    <SolidColorBrush x:Key="AltCardBg"              Color="{DynamicResource AltCardBgColor}"/>
    <SolidColorBrush x:Key="AltCardBgHover"         Color="{DynamicResource AltCardBgHoverColor}"/>
    <SolidColorBrush x:Key="AltCardBorder"          Color="{DynamicResource AltCardBorderColor}"/>
    <SolidColorBrush x:Key="AltCardBorderHover"     Color="{DynamicResource AltCardBorderHoverColor}"/>

    <!-- Aero Header -->
    <SolidColorBrush x:Key="AltHeaderBg"            Color="{DynamicResource AltHeaderBgColor}"/>
    <SolidColorBrush x:Key="AltSearchBg"            Color="{DynamicResource AltSearchBgColor}"/>
    <SolidColorBrush x:Key="AltSearchBorder"        Color="{DynamicResource AltSearchBorderColor}"/>
    <SolidColorBrush x:Key="AltSearchFg"            Color="{DynamicResource AltSearchFgColor}"/>

    <!-- Aero Text Colors -->
    <SolidColorBrush x:Key="AltTextPrimary"         Color="{DynamicResource AltTextPrimaryColor}"/>
    <SolidColorBrush x:Key="AltTextSecondary"       Color="{DynamicResource AltTextSecondaryColor}"/>
    <SolidColorBrush x:Key="AltTextTertiary"        Color="{DynamicResource AltTextMutedColor}"/>

    <!-- Aero Misc -->
    <SolidColorBrush x:Key="AltPinDot"              Color="#F59E0B"/>
    <SolidColorBrush x:Key="AltTimestampFg"         Color="{DynamicResource AltTextMutedColor}"/>
    <SolidColorBrush x:Key="AltSubtitleFg"          Color="{DynamicResource AltTextMutedColor}"/>
    <SolidColorBrush x:Key="AltCloseHoverBg"        Color="#20EF4444"/>
    <SolidColorBrush x:Key="AltSidebarHover"        Color="{DynamicResource AltSidebarHoverColor}"/>
    <SolidColorBrush x:Key="AltBottomBarBg"         Color="{DynamicResource AltBottomBarBgColor}"/>
    <SolidColorBrush x:Key="AltBottomBarBorder"     Color="{DynamicResource AltBottomBarBorderColor}"/>
    <SolidColorBrush x:Key="AltIconFallbackBg"      Color="{DynamicResource AltIconFallbackBgColor}"/>

    <!-- Close Button Style -->
    <Style x:Key="AltCloseButtonStyle" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBgSubtle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
