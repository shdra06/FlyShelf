<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ AERO CLIPBOARD UI — ARCTIC THEME RESOURCES ═══ -->
    <!-- All colors designed for the light frosted Arctic background -->

    <!-- Accent Bar Colors per ItemType -->
    <SolidColorBrush x:Key="AltAccent_Text"         Color="#3B82F6"/>
    <SolidColorBrush x:Key="AltAccent_Code"         Color="#059669"/>
    <SolidColorBrush x:Key="AltAccent_Image"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="AltAccent_Pdf"          Color="#DC2626"/>
    <SolidColorBrush x:Key="AltAccent_Url"          Color="#0284C7"/>
    <SolidColorBrush x:Key="AltAccent_Document"     Color="#2563EB"/>
    <SolidColorBrush x:Key="AltAccent_Archive"      Color="#D97706"/>
    <SolidColorBrush x:Key="AltAccent_Folder"       Color="#CA8A04"/>
    <SolidColorBrush x:Key="AltAccent_Video"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="AltAccent_Audio"        Color="#DB2777"/>
    <SolidColorBrush x:Key="AltAccent_Password"     Color="#EA580C"/>
    <SolidColorBrush x:Key="AltAccent_Presentation" Color="#EA580C"/>
    <SolidColorBrush x:Key="AltAccent_QRCode"       Color="#0D9488"/>
    <SolidColorBrush x:Key="AltAccent_Group"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="AltAccent_File"         Color="#6B7280"/>
    <SolidColorBrush x:Key="AltAccent_Default"      Color="#6B7280"/>

    <!-- Aero Card Background (light theme — semi-opaque white) -->
    <SolidColorBrush x:Key="AltCardBg"              Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="AltCardBgHover"         Color="#E0FFFFFF"/>
    <SolidColorBrush x:Key="AltCardBorder"          Color="#18000000"/>
    <SolidColorBrush x:Key="AltCardBorderHover"     Color="#28000000"/>

    <!-- Aero Header (light theme) -->
    <SolidColorBrush x:Key="AltHeaderBg"            Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="AltSearchBg"            Color="#90FFFFFF"/>
    <SolidColorBrush x:Key="AltSearchBorder"        Color="#20000000"/>
    <SolidColorBrush x:Key="AltSearchFg"            Color="#64748B"/>

    <!-- Aero Text Colors (dark text on light background) -->
    <SolidColorBrush x:Key="AltTextPrimary"         Color="#1E293B"/>
    <SolidColorBrush x:Key="AltTextSecondary"       Color="#475569"/>
    <SolidColorBrush x:Key="AltTextTertiary"        Color="#94A3B8"/>

    <!-- Aero Misc -->
    <SolidColorBrush x:Key="AltPinDot"              Color="#F59E0B"/>
    <SolidColorBrush x:Key="AltTimestampFg"         Color="#64748B"/>
    <SolidColorBrush x:Key="AltSubtitleFg"          Color="#64748B"/>
    <SolidColorBrush x:Key="AltCloseHoverBg"        Color="#20EF4444"/>
    <SolidColorBrush x:Key="AltSidebarHover"        Color="#18000000"/>
    <SolidColorBrush x:Key="AltBottomBarBg"         Color="#D8F0F4F8"/>
    <SolidColorBrush x:Key="AltBottomBarBorder"     Color="#20000000"/>
    <SolidColorBrush x:Key="AltIconFallbackBg"      Color="#0A000000"/>

    <!-- Close Button Style -->
    <Style x:Key="AltCloseButtonStyle" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBgSubtle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
