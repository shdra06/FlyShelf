<Application x:Class="FlyShelf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Styles;assembly=MicaWPF"
             xmlns:local="clr-namespace:FlyShelf"
             xmlns:classes="clr-namespace:FlyShelf.Classes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary />
                <mica:ThemeDictionary Theme="Dark"/>
                <mica:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/MotionSystem.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CustomSlider.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/GlobalScrollBar.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/ImagePlaceholder.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/FlyShelfColorPalette.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/Theme.Midnight.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/AltClipboardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/TypeRamp.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/FileTypeIcons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/CategoryIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Default app fallback icon -->
            <BitmapImage x:Key="ThemeLogoIcon" UriSource="pack://application:,,,/Resources/FlyShelfIcon.png" DecodePixelWidth="64" />

            <!-- Premium WPF-UI Accent Overrides -->
            <Color x:Key="SystemAccentColor">#6366F1</Color>
            <Color x:Key="SystemAccentColorLight1">#8184FF</Color>
            <Color x:Key="SystemAccentColorLight2">#9F9FFF</Color>
            <Color x:Key="SystemAccentColorLight3">#BDBDFE</Color>
            <Color x:Key="SystemAccentColorDark1">#4F52DD</Color>
            <Color x:Key="SystemAccentColorDark2">#3C3EAA</Color>
            <Color x:Key="SystemAccentColorDark3">#2A2A77</Color>

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#6366F1"/>
            <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#8184FF"/>
            <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#9F9FFF"/>
            <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#BDBDFE"/>
            <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#4F52DD"/>
            <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#3C3EAA"/>
            <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#2A2A77"/>

            <!-- Premium MicaWPF Accent Overrides -->
            <Color x:Key="MicaWPF.Colors.SystemAccentColor">#6366F1</Color>
            <Color x:Key="MicaWPF.Colors.SystemAccentColorLight1">#8184FF</Color>
            <Color x:Key="MicaWPF.Colors.SystemAccentColorLight2">#9F9FFF</Color>
            <Color x:Key="MicaWPF.Colors.SystemAccentColorDark1">#4F52DD</Color>
            <Color x:Key="MicaWPF.Colors.SystemAccentColorDark2">#3C3EAA</Color>

            <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColor" Color="#6366F1"/>
            <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight1" Color="#8184FF"/>
            <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight2" Color="#9F9FFF"/>
            <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorDark1" Color="#4F52DD"/>

            <!-- Premium UI Gradients — Muted, sophisticated darks -->
            <LinearGradientBrush x:Key="PremiumGradientNetwork" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C2D33" Offset="0" />
                <GradientStop Color="#134E4A" Offset="0.5" />
                <GradientStop Color="#0A2328" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PremiumGradientDocs" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B1320" Offset="0" />
                <GradientStop Color="#5C1D30" Offset="0.5" />
                <GradientStop Color="#2D0F1A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PremiumGradientAI" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1040" Offset="0" />
                <GradientStop Color="#2E1A5E" Offset="0.5" />
                <GradientStop Color="#180D35" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PremiumGradientMemory" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1B3E" Offset="0" />
                <GradientStop Color="#162C5A" Offset="0.5" />
                <GradientStop Color="#0A1530" Offset="1" />
            </LinearGradientBrush>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <local:HotkeyIndexConverter x:Key="HotkeyIndexConverter"/>

            <!-- Accent Solid Colors for borders/glows -->
            <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentRose" Color="#F43F5E" />
            <SolidColorBrush x:Key="AccentTeal" Color="#14B8A6" />
            <SolidColorBrush x:Key="AccentViolet" Color="#8B5CF6" />
            <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
            <SolidColorBrush x:Key="AccentEmerald" Color="#10B981" />

            <!-- ═══ Floating Action Bar — Default Theme Tokens ═══ -->
            <!-- Merge button (blue accent) — overridden per theme via DynamicResource -->
            <SolidColorBrush x:Key="FloatingMergeAccentBg"          Color="#303B82F6"/>
            <SolidColorBrush x:Key="FloatingMergeAccentBgHover"     Color="#503B82F6"/>
            <SolidColorBrush x:Key="FloatingMergeAccentBgPressed"   Color="#253B82F6"/>
            <SolidColorBrush x:Key="FloatingMergeAccentBorder"      Color="#503B82F6"/>
            <SolidColorBrush x:Key="FloatingMergeAccentBorderHover" Color="#703B82F6"/>
            <SolidColorBrush x:Key="FloatingMergeAccentIcon"        Color="#60A5FA"/>
            <SolidColorBrush x:Key="FloatingMergeAccentText"        Color="#E0E7FF"/>
            <!-- Unpin button (amber) — overridden per theme via DynamicResource -->
            <SolidColorBrush x:Key="FloatingUnpinBg"          Color="#25F59E0B"/>
            <SolidColorBrush x:Key="FloatingUnpinBgHover"     Color="#40F59E0B"/>
            <SolidColorBrush x:Key="FloatingUnpinBgPressed"   Color="#20F59E0B"/>
            <SolidColorBrush x:Key="FloatingUnpinBorder"      Color="#40F59E0B"/>
            <SolidColorBrush x:Key="FloatingUnpinBorderHover" Color="#60F59E0B"/>
            <SolidColorBrush x:Key="FloatingUnpinIcon"        Color="#FBBF24"/>
            <SolidColorBrush x:Key="FloatingUnpinText"        Color="#FDE68A"/>

            <!-- ═══ Card & UI Element — Default Theme Tokens ═══ -->
            <!-- Selection highlight (violet default — overridden by wallpaper dominant color at runtime) -->
            <SolidColorBrush x:Key="ShelfCardSelectionBorder"  Color="#60A78BFA"/>
            <SolidColorBrush x:Key="ShelfCardSelectionBg"      Color="#10A78BFA"/>
            <SolidColorBrush x:Key="ShelfCardFocusBorder"      Color="#80A78BFA"/>
            <!-- Action pill backgrounds (dark neutral) -->
            <SolidColorBrush x:Key="ActionPillBg"              Color="#CC1F1F23"/>
            <SolidColorBrush x:Key="ActionPillBorder"          Color="#22FFFFFF"/>
            <!-- Expand/collapse chevron -->
            <SolidColorBrush x:Key="ChevronBg"                 Color="#CC202024"/>
            <SolidColorBrush x:Key="ChevronBorder"             Color="#33FFFFFF"/>

            <!-- Custom keyboard focus visual — rounded accent border -->
            <Style x:Key="FlyShelfFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderBrush="{DynamicResource MicaWPF.Brushes.SystemFillColorAttention}" 
                                    BorderThickness="1.5" CornerRadius="4" Margin="-2" Opacity="0.7"
                                    SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Unified Hover Elevation Card Animation Template -->
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Opacity" Value="0.88" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="{StaticResource Motion.Normal}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="{StaticResource Motion.Normal}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Entrance}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Entrance}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.88" Duration="{StaticResource Motion.Entrance}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Scrollbar styles now in Resources/Styles/GlobalScrollBar.xaml (implicit, auto-applied) -->

            <!-- Native pixel-based scrolling — same as settings tab -->
            <Style TargetType="ScrollViewer">
                <Setter Property="CanContentScroll" Value="False"/>
                <Setter Property="PanningMode" Value="None"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
