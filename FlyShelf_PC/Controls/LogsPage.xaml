<UserControl x:Class="FlyShelf.Controls.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="Logs" FontSize="{DynamicResource TypeDisplay}" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                <TextBlock Text="Real-time execution log, networking events, and diagnostic traces." FontSize="{DynamicResource TypeSubtitle}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Height="2" CornerRadius="1" HorizontalAlignment="Left" Width="60" Margin="0,4,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#06B6D4" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>

        <!-- ═══ TOOLBAR ═══ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <ui:Button x:Name="CopyAllBtn" Padding="14,7" Margin="0,0,8,0" Click="CopyAll_Click" ToolTip="Copy all logs to clipboard">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="{DynamicResource TypeSubtitle}" Margin="0,0,6,0"/>
                        <TextBlock Text="Copy All" FontWeight="SemiBold" FontSize="{DynamicResource TypeBody}"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="ClearBtn" Padding="14,7" Margin="0,0,8,0" Click="Clear_Click" ToolTip="Clear in-memory logs">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="{DynamicResource TypeSubtitle}" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear" FontWeight="SemiBold" FontSize="{DynamicResource TypeBody}"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="OpenLogsFolderBtn" Padding="14,7" Margin="0,0,8,0" Click="OpenLogsFolder_Click" ToolTip="Open disk logs directory in Windows Explorer">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="{DynamicResource TypeSubtitle}" Margin="0,0,6,0"/>
                        <TextBlock Text="Open Logs Folder" FontWeight="SemiBold" FontSize="{DynamicResource TypeBody}"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            <TextBlock x:Name="LogCountText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="{DynamicResource TypeSmall}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"
                       Text="0 entries" />
        </DockPanel>

        <!-- ═══ MONOSPACED SCROLLABLE LOG VIEWER ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusMD}">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     IsUndoEnabled="False"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                     FontSize="12"
                     Background="Transparent"
                     Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                     CaretBrush="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                     BorderThickness="0"
                     Padding="12,10"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
