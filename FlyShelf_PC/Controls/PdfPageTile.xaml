<UserControl x:Class="FlyShelf.Controls.PdfPageTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="130" Height="170" Margin="5"
             Cursor="Hand" Background="Transparent">
    <Grid x:Name="MainGrid">
        <Border x:Name="SelectionBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Padding="2" Background="{DynamicResource ThemeOverlayBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                
                <!-- Thumbnail -->
                <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True" Background="White">
                    <Image x:Name="PageThumbnail" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                
                <!-- Page Number & Source -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PageNumText" Text="1" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SourceLabelText" Text="" FontSize="9" Foreground="{DynamicResource ThemeTextMuted}" Margin="4,0,0,0" Opacity="0.7"/>
                </StackPanel>

                <!-- Hover Actions Overlay -->
                <Border x:Name="ActionsOverlay" Grid.RowSpan="2" Background="#80000000" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:Button x:Name="RotateBtn" Click="RotateBtn_Click" Padding="4" Margin="2" Appearance="Secondary" ToolTip="Rotate 90°">
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="12"/>
                        </ui:Button>
                        <ui:Button x:Name="DeleteBtn" Click="DeleteBtn_Click" Padding="4" Margin="2" Appearance="Danger" ToolTip="Remove Page">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="12"/>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
