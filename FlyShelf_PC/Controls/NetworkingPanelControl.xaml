<UserControl x:Class="FlyShelf.Controls.NetworkingPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- ═══ Networking Panel Content — Extracted from MainWindow.xaml (Decomposition Phase 2) ═══ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header toolbar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>
            
        <!-- ═══ HEADER TOOLBAR ═══ -->
        <Border Grid.Row="0" Padding="10,7" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#10152A" Offset="0"/>
                    <GradientStop Color="#0F1629" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#312E81" Offset="0.5"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Back -->
                    <ColumnDefinition Width="Auto"/>  <!-- Title -->
                    <ColumnDefinition Width="Auto"/>  <!-- Status pill -->
                    <ColumnDefinition Width="*"/>     <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>  <!-- Pair -->
                    <ColumnDefinition Width="Auto"/>  <!-- Scan -->
                    <ColumnDefinition Width="Auto"/>  <!-- Add files -->
                    <ColumnDefinition Width="Auto"/>  <!-- Send -->
                    <ColumnDefinition Width="Auto"/>  <!-- More -->
                </Grid.ColumnDefinitions>
                    
                <!-- Back -->
                <Border Grid.Column="0" CornerRadius="8" Cursor="Hand" Padding="6,3" Margin="0,0,6,0"
                        Background="#14FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ToolTip="Back to Clipboard"
                        MouseLeftButtonDown="ResearchBack_Click">
                    <ui:SymbolIcon Symbol="ArrowLeft24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="14"/>
                </Border>
                    
                    
                <!-- Network Title (compact — just dot + peer count) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#818CF8" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>
                    
                <!-- Status pill -->
                <Border Grid.Column="2" CornerRadius="12" Padding="8,2" Margin="2,0,0,0" VerticalAlignment="Center"
                        Background="#18818CF8" BorderBrush="#30818CF8" BorderThickness="1">
                    <TextBlock x:Name="NetPanelPeerCount" Text="0 devices" FontSize="10" Foreground="#A5B4FC" FontWeight="SemiBold"/>
                </Border>
                    
                <!-- Inline Pairing Code (visible only when pairing is active) -->
                <Border x:Name="NetPanelPairingInfo" Grid.Column="3" CornerRadius="8" Padding="8,3" 
                        VerticalAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Left" Margin="6,0,0,0"
                        Background="#18F59E0B" BorderBrush="#30F59E0B" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Key24" FontSize="10" Foreground="#F59E0B" Margin="0,0,5,0"/>
                        <TextBlock x:Name="NetPanelPairingCodeText" Text="" FontSize="11" Foreground="#FCD34D" FontWeight="Bold"
                                   FontFamily="Consolas" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Cursor="Hand" Padding="3,1" Margin="6,0,0,0"
                                Background="#20FFFFFF" PreviewMouseLeftButtonDown="NetPanel_DismissPairing_Click" ToolTip="Stop pairing">
                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="9" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                </Border>
                    
                <!-- Pair Device -->
                <Border Grid.Column="4" CornerRadius="8" Cursor="Hand" Padding="8,4" Margin="0,0,4,0"
                        Background="#18F59E0B" BorderBrush="#30F59E0B" BorderThickness="1"
                        PreviewMouseLeftButtonDown="NetPanel_Pair_Click" ToolTip="Pair a new device with a code">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30F59E0B"/></Trigger></Style.Triggers></Style></Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="People24" FontSize="12" Foreground="#F59E0B" Margin="0,0,4,0"/>
                        <TextBlock Text="Pair" FontSize="11" Foreground="#FCD34D" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                    
                <!-- Scan Nearby -->
                <Border Grid.Column="5" CornerRadius="8" Cursor="Hand" Padding="8,4" Margin="0,0,4,0"
                        Background="#18818CF8" BorderBrush="#30818CF8" BorderThickness="1"
                        PreviewMouseLeftButtonDown="NetPanel_Scan_Click" ToolTip="Scan for nearby devices">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30818CF8"/></Trigger></Style.Triggers></Style></Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Wifi124" FontSize="12" Foreground="#818CF8" Margin="0,0,4,0"/>
                        <TextBlock Text="Scan" FontSize="11" Foreground="#C4B5FD" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                    
                <!-- Add Files -->
                <Border Grid.Column="6" CornerRadius="8" Cursor="Hand" Padding="8,4" Margin="0,0,4,0"
                        Background="#18818CF8" BorderBrush="#30818CF8" BorderThickness="1"
                        PreviewMouseLeftButtonDown="NetPanel_AddFiles_Click" ToolTip="Add files to send">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30818CF8"/></Trigger></Style.Triggers></Style></Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="12" Foreground="#818CF8" Margin="0,0,4,0"/>
                        <TextBlock Text="+" FontSize="11" Foreground="#C4B5FD" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                    
                <!-- Send All -->
                <Border Grid.Column="7" CornerRadius="8" Cursor="Hand" Padding="8,4" Margin="0,0,4,0"
                        PreviewMouseLeftButtonDown="NetPanel_SendAll_Click" ToolTip="Send all files to all devices">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3010B981"/></Trigger></Style.Triggers></Style></Border.Style>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1810B981" Offset="0"/>
                            <GradientStop Color="#2010B981" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Send24" FontSize="12" Foreground="#10B981" Margin="0,0,4,0"/>
                        <TextBlock Text="Send" FontSize="11" Foreground="#34D399" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                    
                <!-- Menu (Clear / Transfer Mgr / Refresh) -->
                <Border Grid.Column="8" CornerRadius="8" Cursor="Hand" Padding="6,3"
                        Background="#14FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ToolTip="More options"
                        PreviewMouseLeftButtonDown="NetPanel_MoreMenu_Click">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22FFFFFF"/></Trigger></Style.Triggers></Style></Border.Style>
                    <ui:SymbolIcon Symbol="MoreHorizontal24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="14"/>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔄  Refresh Devices" Click="NetPanel_RefreshDevices_MenuClick"/>
                            <MenuItem Header="📋  Transfer Manager" Click="NetPanel_OpenTransferMgr_MenuClick"/>
                            <Separator/>
                            <MenuItem Header="🗑️  Clear Queue" Click="NetPanel_ClearQueue_MenuClick"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                </Border>
            </Grid>
        </Border>
            
        <!-- ═══ CONTENT: Devices strip + File list ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AllowDrop="True" Drop="NetPanel_Drop" DragOver="NetPanel_DragOver">
            <StackPanel Margin="10,8,10,10">
                
                <!-- ─── CONNECTED DEVICES STRIP ─── -->
                <Border CornerRadius="12" Padding="10,8" Margin="0,0,0,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0E1326" Offset="0"/>
                            <GradientStop Color="#12182E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            
                        <!-- Section label -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                            <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="12" Foreground="#64748B" Margin="0,0,6,0"/>
                            <TextBlock Text="CONNECTED DEVICES" FontSize="10" Foreground="#475569" FontWeight="Bold" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                            
                        <!-- Horizontal device chips -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NetPanelDeviceList" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                    
                <!-- ─── NEARBY DEVICES STRIP ─── -->
                <Border CornerRadius="12" Padding="10,8" Margin="0,0,0,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0E1326" Offset="0"/>
                            <GradientStop Color="#12182E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            
                        <!-- Section label -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                            <ui:SymbolIcon Symbol="Wifi124" FontSize="12" Foreground="#F59E0B" Margin="0,0,6,0"/>
                            <TextBlock Text="NEARBY DEVICES" FontSize="10" Foreground="#92400E" FontWeight="Bold" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                            
                        <!-- Horizontal nearby chips -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NetPanelNearbyList" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                    
                <!-- ─── FILE QUEUE SECTION ─── -->
                <StackPanel Margin="2,4,0,6" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="DocumentQueue24" FontSize="12" Foreground="#64748B" Margin="0,0,6,0"/>
                    <TextBlock Text="FILE QUEUE" FontSize="10" Foreground="#475569" FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="NetPanelQueueStatus" Text="" FontSize="10" Foreground="#64748B" 
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                    
                <!-- File cards -->
                <StackPanel x:Name="NetPanelFileList"/>
                    
                <!-- ─── ACTIVE TRANSFERS ─── -->
                <StackPanel x:Name="NetPanelActiveTransfers" Margin="0,4,0,0"/>
                    
                <!-- ─── RECENT TRANSFERS (completed + failed with retry) ─── -->
                <StackPanel x:Name="NetPanelRecentTransfers" Margin="0,4,0,0"/>
                    
                <!-- ─── EMPTY STATE (replaces file list when empty) ─── -->
                <Border x:Name="NetPanelEmptyState" CornerRadius="12" Padding="20,40" Margin="0,4,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0A0F1E" Offset="0"/>
                            <GradientStop Color="#0D1225" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E293B" Offset="0"/>
                            <GradientStop Color="#1A1F3D" Offset="0.5"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A1F3D" Offset="0"/>
                                    <GradientStop Color="#1E2750" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="22" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Drop files here to send" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" TextAlignment="Center"/>
                        <TextBlock Text="or copy a file — it auto-stages" FontSize="11" Foreground="#475569" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                    
            </StackPanel>
        </ScrollViewer>
            
    </Grid>
</UserControl>
