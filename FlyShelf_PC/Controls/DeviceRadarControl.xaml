<UserControl x:Class="FlyShelf.Controls.DeviceRadarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- ═══ Device Radar — Animated sweep with peer blips ═══ -->
    <Grid MinHeight="240">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A0F1E" Offset="0"/>
                <GradientStop Color="#0D1225" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Radar Canvas — drawn programmatically -->
        <Canvas x:Name="RadarCanvas" Grid.Row="0" Width="200" Height="200"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True"/>

        <!-- Device count label -->
        <TextBlock x:Name="DeviceCountText" Grid.Row="1" 
                   Text="0 devices in range" FontSize="11" FontWeight="SemiBold"
                   Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,8"/>
    </Grid>
</UserControl>
