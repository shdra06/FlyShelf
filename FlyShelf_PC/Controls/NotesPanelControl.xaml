<UserControl x:Class="FlyShelf.Controls.NotesPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Decomposition Phase 3: Notes panel inner content extracted from MainWindow.xaml -->
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Notes header -->
                <RowDefinition Height="*"/>     <!-- Content area -->
            </Grid.RowDefinitions>

            <!-- ═══ NOTES HEADER BAR ═══ -->
            <Border Grid.Row="0" CornerRadius="0" Padding="10,6" Margin="0,0,0,0"
                    Background="#16162A" 
                    BorderBrush="#2A2A45" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Back -->
                        <ColumnDefinition Width="Auto"/> <!-- Day label -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Mode toggle -->
                        <ColumnDefinition Width="Auto"/> <!-- Add -->
                        <ColumnDefinition Width="Auto"/> <!-- Undo -->
                        <ColumnDefinition Width="Auto"/> <!-- Templates -->
                        <ColumnDefinition Width="Auto"/> <!-- Dropdown menu -->
                    </Grid.ColumnDefinitions>

                    <!-- Back to clipboard -->
                    <Border Grid.Column="0" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="NotesBack_Click" Padding="6,3" Margin="0,0,4,0"
                            Background="#14FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ToolTip="Back to Clipboard">
                        <ui:SymbolIcon Symbol="ArrowLeft24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="14"/>
                    </Border>

                    <!-- Current day label (clickable for month navigation) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                                Cursor="Hand" MouseLeftButtonDown="CurrentDayLabel_Click" ToolTip="Toggle Day / Month View">
                        <ui:SymbolIcon Symbol="List24" Foreground="#8B5CF6" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock x:Name="NotesCurrentDayLabel" Text="27, May" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sync status indicator -->
                    <StackPanel x:Name="NotesSyncStatusIndicator" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" 
                                HorizontalAlignment="Left" Margin="10,0,0,0" Opacity="0.7">
                        <Ellipse x:Name="NotesSyncDot" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="NotesSyncText" Text="Synced" FontSize="9" Foreground="#10B981" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Mode toggle: Bullets ↔ Freeform -->
                    <Border Grid.Column="3" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="NotesModeToggle_Click" Padding="8,3" Margin="0,0,4,0"
                            Background="#188B5CF6" BorderBrush="#308B5CF6" BorderThickness="1" ToolTip="Toggle Bullets / Freeform">
                        <TextBlock x:Name="NotesModeToggleText" Text="📄 Freeform" FontSize="10" FontWeight="SemiBold" 
                                   Foreground="#C4B5FD" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Add card (bullet or freeform depending on mode) -->
                    <Border Grid.Column="4" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="NotesAddBullet_Click" Padding="6,3" Margin="0,0,4,0"
                            Background="#208B5CF6" BorderBrush="#408B5CF6" BorderThickness="1" ToolTip="Add Card">
                        <ui:SymbolIcon Symbol="Add24" Foreground="#8B5CF6" FontSize="13"/>
                    </Border>

                    <!-- Undo -->
                    <Border x:Name="NotesUndoBtn" Grid.Column="5" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="NotesUndo_Click" Padding="6,3" Margin="0,0,4,0"
                            ToolTip="Undo last change" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#18F59E0B"/>
                                <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#30F59E0B"/>
                                        <Setter Property="BorderBrush" Value="#60F59E0B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="ArrowUndo24" Foreground="#F59E0B" FontSize="13"/>
                    </Border>

                    <!-- Templates -->
                    <Border x:Name="NotesTemplatesBtn" Grid.Column="6" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="NotesTemplates_Click" Padding="6,3" Margin="0,0,4,0"
                            Background="{DynamicResource MicaWPF.Brushes.ControlFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="1" 
                            ToolTip="Note Templates">
                        <ui:SymbolIcon Symbol="DocumentCopy24" Foreground="{DynamicResource ThemeAccent}" FontSize="13"/>
                    </Border>

                    <!-- Dropdown menu (Sort, Trash, Export, Templates) -->
                    <Border Grid.Column="7" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="NotesHeaderMenu_Click" Padding="6,3"
                            ToolTip="More options">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0C8B5CF6"/>
                                <Setter Property="BorderBrush" Value="#188B5CF6"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#208B5CF6"/>
                                        <Setter Property="BorderBrush" Value="#408B5CF6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="ChevronDown24" Foreground="#A78BFA" FontSize="12"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ═══ MAIN CONTENT: SIDEBAR + NOTEPAD ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NotesSidebarColumn" Width="42"/>  <!-- Day Sidebar (collapses to 0) -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>

                <!-- ═══ DAY SIDEBAR (Toggle + Newest-first list of dates) ═══ -->
                <Border x:Name="NotesSidebarBorder" Grid.Column="0" BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}" BorderThickness="0,0,1,0" Background="{DynamicResource MicaWPF.Brushes.ControlAltFillColorTertiary}">
                    <DockPanel>
                        <!-- Toggle button at top -->
                        <Border DockPanel.Dock="Top" Cursor="Hand" Height="22"
                                Background="Transparent"
                                MouseLeftButtonDown="NotesSidebarToggle_Click" ToolTip="Collapse Sidebar">
                            <TextBlock x:Name="NotesSidebarCollapseIcon" Text="◂" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- Date list -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NotesDaySidebar" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Day badge container -->
                                        <Border x:Name="NotesDayBorder" CornerRadius="8" Width="30" Height="30" Margin="0,0,0,4"
                                                Cursor="Hand" MouseLeftButtonDown="NotesDayItem_Click"
                                                BorderThickness="1" SnapsToDevicePixels="True"
                                                Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}"
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.CardStrokeColorDefault}"
                                                ToolTip="{Binding FullLabel}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Day number -->
                                                <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Bold" 
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextAlignment="Center" Margin="0,-2,0,0"/>
                                                <!-- Abbreviated Month -->
                                                <TextBlock Text="{Binding MonthName}" FontSize="7" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" TextAlignment="Center" Margin="0,-2,0,0" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Expand arrow (visible when sidebar collapsed) -->
                <Border x:Name="NotesSidebarExpandBtn" Grid.Column="1" Width="20" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Cursor="Hand" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0"
                        MouseLeftButtonDown="NotesSidebarToggle_Click" ToolTip="Show Sidebar" Panel.ZIndex="5">
                    <TextBlock Text="▸" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Month Picker Popup -->
                <Popup x:Name="NotesMonthPopup" Placement="Right" PlacementTarget="{Binding ElementName=NotesSidebarBorder}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border CornerRadius="12" Padding="6,6" Background="#1E1E38" BorderBrush="#3A3A5C" BorderThickness="1"
                            MinWidth="120" MaxHeight="300">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NotesMonthList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="8,6" Margin="1,1" Cursor="Hand"
                                                MouseLeftButtonDown="NotesMonthItem_Click"
                                                Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2A2A50"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MonthName}" FontSize="12" FontWeight="SemiBold" 
                                                           Foreground="#D0D0E0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding YearText}" FontSize="10" FontWeight="Medium" 
                                                           Foreground="#7878A0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding DayCount}" FontSize="9" FontWeight="Medium" 
                                                           Foreground="#5858A0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!-- ═══ NOTES CONTENT AREA ═══ -->
                <Grid x:Name="NotesContentArea" Grid.Column="1">
                    <!-- BULLET MODE: Scrollable list of bullet cards -->
                    <ListBox x:Name="NotesBulletList"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <!-- BUG-2 FIX: VirtualizingStackPanel as items host so large lists don't instantiate all items at once -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Bullet Card -->
                                    <Border x:Name="BulletCard" CornerRadius="8" Margin="6,0,6,4" Padding="0" ClipToBounds="True"
                                            BorderThickness="1" BorderBrush="#2A2A45"
                                            PreviewMouseLeftButtonDown="BulletCard_PreviewMouseDown">
                                        <Border.Background>
                                            <SolidColorBrush Color="#222240"/>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Color strip -->
                                                <ColumnDefinition Width="*"/>    <!-- Main content -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Color accent strip (left edge) -->
                                            <Border x:Name="BulletColorStrip" Grid.Column="0" Width="3" CornerRadius="8,0,0,8"
                                                    Background="{Binding Color}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Header row -->
                                                <RowDefinition Height="Auto"/> <!-- Header separator -->
                                                <RowDefinition Height="Auto"/> <!-- Content row (collapsible) -->
                                                <RowDefinition Height="Auto"/> <!-- Sub-bullets row (collapsible) -->
                                                <RowDefinition Height="Auto"/> <!-- Tags row -->
                                                <RowDefinition Height="Auto"/> <!-- Image row (optional) -->
                                            </Grid.RowDefinitions>


                                            <!-- Bullet header: dot + collapse toggle + delete -->
                                            <Grid Grid.Row="0" Margin="8,5,6,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Bullet dot -->
                                                    <ColumnDefinition Width="*"/>    <!-- Header Box + Spacer -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Last Edited Time -->
                                                    <ColumnDefinition Width="Auto"/> <!-- More menu -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Right panel: Collapse + Pin + Reminder -->
                                                </Grid.ColumnDefinitions>
                                                <!-- Device origin dot (color = deterministic hash of device name) -->
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding DeviceDotColor}"/>
                                                    </Ellipse.Fill>
                                                    <Ellipse.ToolTip>
                                                        <TextBlock Text="{Binding DeviceTooltip}"/>
                                                    </Ellipse.ToolTip>
                                                </Ellipse>
                                                
                                                <!-- Bullet Header (Topic) -->
                                                <Grid Grid.Column="1" Margin="4,0,8,0">
                                                    <TextBox x:Name="NoteBulletHeaderBox"
                                                             Text="{Binding Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                             FontSize="13" FontWeight="SemiBold"
                                                             Background="Transparent" BorderThickness="0" Padding="0"
                                                             Foreground="#F3F4F6" CaretBrush="#F3F4F6"
                                                             SelectionBrush="#608B5CF6"
                                                             TextChanged="NoteBulletHeader_TextChanged"
                                                             PreviewKeyDown="NoteBulletHeader_PreviewKeyDown"
                                                             AutomationProperties.Name="Note bullet header">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBlock Text="Add header..." FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#6B7280" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Header}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Header}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Last Edited Timestamp (always visible) -->
                                                <TextBlock Grid.Column="2" Text="{Binding LastEditedDisplay}" FontSize="10.5" 
                                                           Foreground="#8B8BA8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           IsHitTestVisible="False" Opacity="0.8"/>
                                                
                                                <!-- Right panel: AI + More in a compact horizontal row -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <!-- AI button -->
                                                    <Border x:Name="BulletAIBtn" CornerRadius="4" Cursor="Hand" 
                                                            Padding="6,2" Margin="0,0,2,0" Opacity="0" IsHitTestVisible="False"
                                                            MouseLeftButtonDown="NoteBulletAI_Click" ToolTip="AI Assistant">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#188B5CF6"/>
                                                                <Setter Property="BorderBrush" Value="#308B5CF6"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#308B5CF6"/>
                                                                        <Setter Property="BorderBrush" Value="#608B5CF6"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="11" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <TextBlock Text="AI" FontSize="9.5" FontWeight="SemiBold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- More options dropdown button -->
                                                    <Border x:Name="BulletMoreBtn" CornerRadius="4" Cursor="Hand" 
                                                            Padding="3,2" Margin="0,0,1,0" Opacity="0" IsHitTestVisible="False"
                                                            MouseLeftButtonDown="NoteBulletMore_Click" ToolTip="More options">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0CFFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="#18808080"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#20FFFFFF"/>
                                                                        <Setter Property="BorderBrush" Value="#40808080"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ui:SymbolIcon Symbol="MoreHorizontal24" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <!-- Collapse toggle (always visible, separate column) -->
                                                <Border x:Name="BulletCollapseBtn" Grid.Column="4" CornerRadius="4" Cursor="Hand" Padding="4,1"
                                                        MouseLeftButtonDown="NoteBulletCollapse_Click" Background="Transparent"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CollapseIcon}" FontSize="11" FontWeight="Bold" 
                                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Header separator line -->
                                            <Border x:Name="BulletHeaderSeparator" Grid.Row="1" Height="1" Margin="22,0,8,2" Background="#25FFFFFF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Bullet text content (collapsible) -->
                                            <Border x:Name="BulletContent" Grid.Row="2" Margin="22,0,8,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBox x:Name="NoteBulletContentBox"
                                                         Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"

                                                         FontSize="12" Background="Transparent" BorderThickness="0" Padding="0,2"
                                                         Foreground="#E8E8F0"
                                                         CaretBrush="#E8E8F0"
                                                         SelectionBrush="#608B5CF6"
                                                         TextChanged="NoteBulletText_TextChanged"
                                                         PreviewKeyDown="NoteBulletText_PreviewKeyDown"
                                                         GotFocus="NoteBulletText_GotFocus"
                                                         DataObject.Pasting="NoteBulletText_Paste"
                                                         AutomationProperties.Name="Note bullet content">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>

                                            <!-- ── Sub-bullets (nested items, Shift+Enter) ── -->
                                            <Border Grid.Row="3" Margin="26,0,8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSubBullets}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2"/>  <!-- accent bar -->
                                                        <ColumnDefinition Width="*"/>  <!-- sub-bullet list -->
                                                    </Grid.ColumnDefinitions>
                                                    <!-- left accent bar -->
                                                    <Border Grid.Column="0" Background="#40A78BFA" CornerRadius="1" Margin="0,2,6,2"/>
                                                    <!-- sub-bullet rows -->
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SubBullets}" Margin="4,0,0,0"
                                                                  x:Name="SubBulletsItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1,0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- sub-bullet dot -->
                                                                    <TextBlock Grid.Column="0" Text="◦" FontSize="11"
                                                                               Foreground="#80A78BFA" VerticalAlignment="Top"
                                                                               Margin="0,3,5,0"/>
                                                                    <!-- sub-bullet text -->
                                                                    <TextBox Grid.Column="1"
                                                                             x:Name="SubBulletTextBox"
                                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                                             TextWrapping="Wrap" AcceptsReturn="False" AcceptsTab="False"
                                                                             FontSize="11.5" Background="Transparent" BorderThickness="0"
                                                                             Padding="0,1" Foreground="#C8C8E0"
                                                                             CaretBrush="#C8C8E0" SelectionBrush="#608B5CF6"
                                                                             PreviewKeyDown="SubBulletText_PreviewKeyDown"
                                                                             Tag="{Binding}"
                                                                             AutomationProperties.Name="Sub-bullet text">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="TextBox">
                                                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>

                                            <!-- Embedded image (optional, resizable via mouse wheel, up to 2 images) -->
                                            <Border x:Name="BulletImageArea" Grid.Row="5" Margin="22,0,8,6">

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasImage2}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Image 1 -->
                                                    <Grid x:Name="Image1Grid" Margin="0,0,8,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border CornerRadius="8" ClipToBounds="True" 
                                                                BorderBrush="#308B5CF6" BorderThickness="1" 
                                                                HorizontalAlignment="Left" Cursor="Hand"
                                                                MouseLeftButtonDown="NoteImage_Click"
                                                                ToolTip="Click to open">
                                                            <Image Source="{Binding ImagePath}" 
                                                                   Width="{Binding ImageDisplayWidth}" 
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <!-- Remove image button -->
                                                        <Border CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                                Margin="4,4,0,0" Padding="3,1" Cursor="Hand" Background="#80000000"
                                                                MouseLeftButtonDown="NoteImageRemove_Click" ToolTip="Remove image">
                                                            <ui:SymbolIcon Symbol="Dismiss12" Foreground="#CCFFFFFF" FontSize="9"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Image 2 -->
                                                    <Grid x:Name="Image2Grid" Margin="0,0,8,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasImage2}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border CornerRadius="8" ClipToBounds="True" 
                                                                BorderBrush="#308B5CF6" BorderThickness="1" 
                                                                HorizontalAlignment="Left" Cursor="Hand"
                                                                MouseLeftButtonDown="NoteImage2_Click"
                                                                ToolTip="Click to open">
                                                            <Image Source="{Binding ImagePath2}" 
                                                                   Width="{Binding ImageDisplayWidth2}" 
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <!-- Remove image button -->
                                                        <Border CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                                Margin="4,4,0,0" Padding="3,1" Cursor="Hand" Background="#80000000"
                                                                MouseLeftButtonDown="NoteImageRemove2_Click" ToolTip="Remove image">
                                                            <ui:SymbolIcon Symbol="Dismiss12" Foreground="#CCFFFFFF" FontSize="9"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- ═══ Tags chips row (visible when tags exist) ═══ -->
                                            <ItemsControl x:Name="NoteTagsRow" Grid.Row="4" ItemsSource="{Binding Tags}" Margin="22,0,8,4">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTags}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="5,1,5,1" Margin="0,0,3,2"
                                                                Background="#208B5CF6" BorderBrush="#308B5CF6" BorderThickness="1">
                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#C4B5FD"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            </Grid> <!-- close inner Grid -->
                                        </Grid> <!-- close outer Grid with color strip -->
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Show action buttons on card hover (Opacity-based to prevent layout shift) -->
                                        <Trigger SourceName="BulletCard" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BulletAIBtn" Property="Opacity" Value="1"/>
                                            <Setter TargetName="BulletAIBtn" Property="IsHitTestVisible" Value="True"/>
                                            <Setter TargetName="BulletMoreBtn" Property="Opacity" Value="1"/>
                                            <Setter TargetName="BulletMoreBtn" Property="IsHitTestVisible" Value="True"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- FREEFORM MODE: Text area + images strip -->
                    <ScrollViewer x:Name="NotesFreeformArea" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- FREEFORM SECTIONS: Multiple text cards -->
                            <ItemsControl x:Name="NotesFreeformSectionsList" AlternationCount="2"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="FreeformSectionCard" CornerRadius="8" Margin="4,2,4,3" Padding="0" ClipToBounds="True"
                                                BorderThickness="1" BorderBrush="#2A2A45">
                                            <Grid>
                                                <StackPanel>
                                                    <!-- Note Title -->
                                                    <TextBox x:Name="FreeformSectionTitleBox" 
                                                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                             FontSize="13.5" FontWeight="SemiBold"
                                                             Background="Transparent" BorderThickness="0" 
                                                             Foreground="#CDD6F4" CaretBrush="#CDD6F4"
                                                             SelectionBrush="#608B5CF6"
                                                             Padding="10,8,100,2" 
                                                             TextChanged="NotesFreeformBox_TextChanged"
                                                             AutomationProperties.Name="Note title">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <!-- Header separator line (matches bullet mode) -->
                                                    <Border Height="1" Margin="10,0,10,2" Background="#25FFFFFF"/>
                                                    <!-- Embedded images (up to 5 for Pro, 1 for Free) -->
                                                    <ItemsControl ItemsSource="{Binding Images}" Margin="6,6,6,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="SectionImgCard" CornerRadius="8" Margin="2" Padding="3" ClipToBounds="True"
                                                                        Background="#18000000" BorderBrush="#308B5CF6" BorderThickness="1"
                                                                        MouseWheel="FreeformImageResize_MouseWheel">
                                                                    <Grid>
                                                                        <Border CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left" Cursor="Hand"
                                                                                MouseLeftButtonDown="FreeformImage_Click" ToolTip="Click to open">
                                                                            <Image Source="{Binding ImagePath}" Width="{Binding DisplayWidth}"
                                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        </Border>
                                                                        <!-- Remove button -->
                                                                        <Border x:Name="SectionImgRemoveBtn" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                Margin="2,2,0,0" Padding="3,1" Cursor="Hand" Background="#80000000" Opacity="0" IsHitTestVisible="False"
                                                                                MouseLeftButtonDown="FreeformImageRemove_Click" ToolTip="Remove image">
                                                                            <ui:SymbolIcon Symbol="Dismiss12" Foreground="#CCFFFFFF" FontSize="9"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="SectionImgCard" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SectionImgRemoveBtn" Property="Opacity" Value="1"/>
                                                                        <Setter TargetName="SectionImgRemoveBtn" Property="IsHitTestVisible" Value="True"/>
                                                                    </Trigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Freeform text area -->
                                                    <TextBox x:Name="FreeformSectionTextBox" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                                             FontSize="12.5" Background="Transparent" BorderThickness="0" Padding="10,6,10,8" MinHeight="80"
                                                             Foreground="#E8E8F0"
                                                             CaretBrush="#E8E8F0"
                                                             SelectionBrush="#608B5CF6"
                                                             Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                             TextChanged="NotesFreeformBox_TextChanged"
                                                             GotFocus="NotesFreeformBox_GotFocus"
                                                             PreviewKeyDown="NotesFreeformBox_PreviewKeyDown"
                                                             DataObject.Pasting="NotesFreeformBox_Paste"
                                                             AutomationProperties.Name="Freeform note content">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </StackPanel>

                                                <!-- Remove section button (top-right, always visible) -->
                                                <Border x:Name="FreeformSectionRemoveBtn" CornerRadius="8" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,30,0" Panel.ZIndex="10"
                                                        Background="#18FF4444" BorderBrush="#30FF4444" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="FreeformSectionRemove_Click" ToolTip="Remove this section">
                                                    <ui:SymbolIcon Symbol="Delete24" Foreground="#FF6666" FontSize="12" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- AI Button (top-right, always visible) -->
                                                <Border x:Name="FreeformSectionAIBtn" CornerRadius="8" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,56,0" Panel.ZIndex="10"
                                                        Background="#188B5CF6" BorderBrush="#308B5CF6" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="NotesFreeformAI_Click" ToolTip="AI Assistant">
                                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="12" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Reminder Button (top-right floating, always visible) -->
                                                <Border x:Name="FreeformSectionReminderBtn" CornerRadius="8" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,4,0" Panel.ZIndex="10"
                                                        Background="#18F59E0B" BorderBrush="#30F59E0B" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="NotesFreeformReminder_Click" ToolTip="Set Reminder from Notes">
                                                    <ui:SymbolIcon Symbol="Alert24" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Expand Button (top-right floating, opens NoteExpandWindow) -->
                                                <Border x:Name="FreeformSectionExpandBtn" CornerRadius="8" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="5,4" Margin="0,4,82,0" Panel.ZIndex="10"
                                                        Background="#1822D3EE" BorderBrush="#3022D3EE" BorderThickness="1"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        MouseLeftButtonDown="NotesFreeformExpand_Click" ToolTip="Expand Note">
                                                    <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="12" Foreground="#22D3EE" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- AI Improve Button removed — merged into AI dropdown menu -->
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Alternating backgrounds: even = darker, odd = subtly lighter -->
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter TargetName="FreeformSectionCard" Property="Background" Value="#222240"/>
                                            </Trigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter TargetName="FreeformSectionCard" Property="Background" Value="#282850"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- NOTES EMPTY STATE -->
                    <StackPanel x:Name="NotesEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="List24" FontSize="28" Foreground="#308B5CF6" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No bullets yet" Opacity="0.35" FontSize="12" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="Click + to add your first note" Opacity="0.2" FontSize="10.5" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ NOTES SEARCH RESULTS (replaces content area during search) ═══ -->
                <Border x:Name="NotesSearchResults" Grid.Column="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="NotesSearchResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Search result card: date sidebar + content -->
                                    <Border CornerRadius="8" Margin="6,0,6,4" Padding="0" Cursor="Hand" ClipToBounds="True"
                                            MouseLeftButtonDown="NotesSearchResult_Click"
                                            BorderThickness="1" BorderBrush="#2A2A45" Background="#222240">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/> <!-- Date column -->
                                                <ColumnDefinition Width="*"/>  <!-- Content -->
                                            </Grid.ColumnDefinitions>
                                            <!-- Date badge -->
                                            <Border Grid.Column="0" Background="#158B5CF6" Padding="4,6">
                                                <TextBlock Text="{Binding DateLabel}" FontSize="9" FontWeight="Bold" 
                                                           Foreground="#C4B5FD" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>
                                            <!-- Content preview -->
                                            <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="11" TextTrimming="CharacterEllipsis" 
                                                       MaxHeight="42" TextWrapping="Wrap" Margin="8,6" 
                                                       Foreground="#E8E8F0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
    </Grid>
</UserControl>
