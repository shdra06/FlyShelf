<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Lavender Theme — Rich Purple -->

    <!-- Accent colors -->
    <SolidColorBrush x:Key="ThemeAccent"          Color="#7C3AED"/>
    <SolidColorBrush x:Key="ThemeAccentLight"     Color="#A78BFA"/>
    <SolidColorBrush x:Key="ThemeAccentDark"      Color="#6D28D9"/>
    <SolidColorBrush x:Key="ThemeAccentBg"        Color="#207C3AED"/>
    <SolidColorBrush x:Key="ThemeAccentBgHover"   Color="#407C3AED"/>
    <SolidColorBrush x:Key="ThemeAccentBorder"    Color="#507C3AED"/>
    <Color x:Key="ThemeAccentColor">#7C3AED</Color>
    <Color x:Key="ThemeAccentLightColor">#A78BFA</Color>
    <Color x:Key="ThemeAccentDarkColor">#6D28D9</Color>

    <!-- Header button chrome -->
    <SolidColorBrush x:Key="ThemeHeaderBtnBg"             Color="#FF6B3FA0"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorder"         Color="#FF8850C0"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFg"             Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgHover"        Color="#FF7D4CB8"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderHover"    Color="#FFA060D8"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgHover"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgPressed"      Color="#FF9058D0"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderPressed"  Color="#FFA060D8"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgPressed"      Color="#E0FFFFFF"/>
    <Color x:Key="ThemeHeaderBtnBgColor">#FF6B3FA0</Color>
    <Color x:Key="ThemeHeaderBtnBorderColor">#FF8850C0</Color>
    <Color x:Key="ThemeHeaderBtnBgHoverColor">#FF7D4CB8</Color>
    <Color x:Key="ThemeHeaderBtnBorderHoverColor">#FFA060D8</Color>
    <Color x:Key="ThemeHeaderBtnFgHoverColor">#FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBgPressedColor">#FF9058D0</Color>
    <Color x:Key="ThemeHeaderBtnBorderPressedColor">#FFA060D8</Color>
    <Color x:Key="ThemeHeaderBtnFgPressedColor">#E0FFFFFF</Color>

    <!-- Overlay chrome -->
    <SolidColorBrush x:Key="ThemeOverlayBg"           Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgHover"      Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgSelected"   Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgPressed"    Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorder"       Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderHover"  Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderStrong" Color="#40FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ThemeTextPrimary"     Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ThemeTextSecondary"   Color="#94A3B8"/>
    <SolidColorBrush x:Key="ThemeTextMuted"       Color="#64748B"/>
    <SolidColorBrush x:Key="ThemeTextOnAccent"    Color="#FFFFFF"/>

    <!-- Separator / Shadow / Window -->
    <SolidColorBrush x:Key="ThemeSeparator"       Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="ThemeShadow"          Color="#000000"/>
    <SolidColorBrush x:Key="ThemeWindowFallback"  Color="#1A1028"/>
    <SolidColorBrush x:Key="ThemeCodePreviewBg"   Color="#FF1E1E1E"/>

    <!-- Chevron -->
    <SolidColorBrush x:Key="ThemeChevronBg"          Color="#EE4E2E80"/>
    <SolidColorBrush x:Key="ThemeChevronBorder"      Color="#FF6E42A8"/>
    <SolidColorBrush x:Key="ThemeChevronBgHover"     Color="#F55C3890"/>
    <SolidColorBrush x:Key="ThemeChevronBorderHover" Color="#FF8050B8"/>

    <!-- Overlay buttons -->
    <SolidColorBrush x:Key="ThemeOverlayButtonBg"     Color="#F04E2E80"/>
    <SolidColorBrush x:Key="ThemeOverlayButtonBorder" Color="#FF6E42A8"/>

    <!-- Floating bar -->
    <SolidColorBrush x:Key="ThemeFloatingBarBg"       Color="#F04A2B78"/>
    <SolidColorBrush x:Key="ThemeFloatingBarBorder"   Color="#FF6840A0"/>

    <!-- Overflow popup -->
    <SolidColorBrush x:Key="ThemeOverflowBg"           Color="#F04A2B78"/>
    <SolidColorBrush x:Key="ThemeOverflowBorder"       Color="#606840A0"/>
    <Color x:Key="ThemeOverflowShadowColor">#3E2468</Color>

    <!-- Toast -->
    <SolidColorBrush x:Key="ThemeToastBg"          Color="#F53E2468"/>
    <SolidColorBrush x:Key="ThemeToastBorder"      Color="#FF5E38A0"/>
    <SolidColorBrush x:Key="ThemeToastInnerGlow"   Color="#20A78BFA"/>

    <!-- Empty state icon -->
    <SolidColorBrush x:Key="ThemeEmptyIcon"        Color="#40FFFFFF"/>

    <!-- Transfer / progress -->
    <SolidColorBrush x:Key="ThemeTransferProgress" Color="#A78BFA"/>
    <SolidColorBrush x:Key="ThemeTransferText"     Color="#C4B5FD"/>

    <!-- System accent overrides -->
    <Color x:Key="SystemAccentColor">#7C3AED</Color>
    <Color x:Key="SystemAccentColorLight1">#A78BFA</Color>
    <Color x:Key="SystemAccentColorLight2">#C4B5FD</Color>
    <Color x:Key="SystemAccentColorLight3">#DDD6FE</Color>
    <Color x:Key="SystemAccentColorDark1">#6D28D9</Color>
    <Color x:Key="SystemAccentColorDark2">#5B21B6</Color>
    <Color x:Key="SystemAccentColorDark3">#4C1D95</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush"       Color="#7C3AED"/>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#DDD6FE"/>
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush"  Color="#6D28D9"/>
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush"  Color="#5B21B6"/>
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush"  Color="#4C1D95"/>

    <!-- MicaWPF accent overrides -->
    <Color x:Key="MicaWPF.Colors.SystemAccentColor">#7C3AED</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight1">#A78BFA</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight2">#C4B5FD</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark1">#6D28D9</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark2">#5B21B6</Color>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColor"       Color="#7C3AED"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight1" Color="#A78BFA"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight2" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorDark1"  Color="#6D28D9"/>

    <!-- Theme marker -->
    <SolidColorBrush x:Key="FlyShelf.ColorThemeMarker" Color="#7C3AED"/>

    <!-- Theme-specific logo icon -->
    <BitmapImage x:Key="ThemeLogoIcon" UriSource="pack://application:,,,/Resources/FlyShelfIcon_RoyalOrchid.png" />
</ResourceDictionary>
