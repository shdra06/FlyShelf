<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">
    <!-- Lavender Theme — Rich Purple -->

    <!-- Accent colors -->
    <SolidColorBrush x:Key="ThemeAccent"          Color="#7C3AED" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentLight"     Color="#A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentDark"      Color="#6D28D9" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBg"        Color="#207C3AED" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBgHover"   Color="#407C3AED" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBorder"    Color="#507C3AED" options:Freeze="True"/>
    <Color x:Key="ThemeAccentColor">#7C3AED</Color>
    <Color x:Key="ThemeAccentLightColor">#A78BFA</Color>
    <Color x:Key="ThemeAccentDarkColor">#6D28D9</Color>

    <!-- Header button chrome -->
    <SolidColorBrush x:Key="ThemeHeaderBtnBg"             Color="#FF6B3FA0" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorder"         Color="#FF8850C0" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFg"             Color="#F0FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgHover"        Color="#FF7D4CB8" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderHover"    Color="#FFA060D8" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgHover"        Color="#FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgPressed"      Color="#FF9058D0" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderPressed"  Color="#FFA060D8" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgPressed"      Color="#E0FFFFFF" options:Freeze="True"/>
    <Color x:Key="ThemeHeaderBtnBgColor">#FF6B3FA0</Color>
    <Color x:Key="ThemeHeaderBtnBorderColor">#FF8850C0</Color>
    <Color x:Key="ThemeHeaderBtnBgHoverColor">#FF7D4CB8</Color>
    <Color x:Key="ThemeHeaderBtnBorderHoverColor">#FFA060D8</Color>
    <Color x:Key="ThemeHeaderBtnFgHoverColor">#FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBgPressedColor">#FF9058D0</Color>
    <Color x:Key="ThemeHeaderBtnBorderPressedColor">#FFA060D8</Color>
    <Color x:Key="ThemeHeaderBtnFgPressedColor">#E0FFFFFF</Color>

    <!-- Overlay chrome -->
    <SolidColorBrush x:Key="ThemeOverlayBg"           Color="#12FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgHover"      Color="#22FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgSelected"   Color="#15FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgPressed"    Color="#0AFFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorder"       Color="#18FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderHover"  Color="#30FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderStrong" Color="#40FFFFFF" options:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ThemeTextPrimary"     Color="#F1F5F9" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextSecondary"   Color="#94A3B8" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextMuted"       Color="#64748B" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextOnAccent"    Color="#FFFFFF" options:Freeze="True"/>
    <Color x:Key="ThemeTextPrimaryColor" options:Freeze="True">#F1F5F9</Color>
    <Color x:Key="ThemeTextSecondaryColor" options:Freeze="True">#94A3B8</Color>
    <Color x:Key="ThemeTextMutedColor" options:Freeze="True">#64748B</Color>
    <Color x:Key="ThemeOverlayBgColor" options:Freeze="True">#12FFFFFF</Color>
    <Color x:Key="ThemeOverlayBorderColor" options:Freeze="True">#18FFFFFF</Color>
    <Color x:Key="ThemeOverlayHoverColor" options:Freeze="True">#22FFFFFF</Color>

    <!-- ── Clipboard Popup ── -->
    <Color x:Key="AltCardBgColor" options:Freeze="True">#18FFFFFF</Color>
    <Color x:Key="AltCardBgHoverColor" options:Freeze="True">#28FFFFFF</Color>
    <Color x:Key="AltCardBorderColor" options:Freeze="True">#22FFFFFF</Color>
    <Color x:Key="AltCardBorderHoverColor" options:Freeze="True">#35FFFFFF</Color>
    <Color x:Key="AltHeaderBgColor" options:Freeze="True">#16FFFFFF</Color>
    <Color x:Key="AltSearchBgColor" options:Freeze="True">#12FFFFFF</Color>
    <Color x:Key="AltSearchBorderColor" options:Freeze="True">#20FFFFFF</Color>
    <Color x:Key="AltSearchFgColor" options:Freeze="True">#64748B</Color>
    <Color x:Key="AltTextPrimaryColor" options:Freeze="True">#F1F5F9</Color>
    <Color x:Key="AltTextSecondaryColor" options:Freeze="True">#94A3B8</Color>
    <Color x:Key="AltTextMutedColor" options:Freeze="True">#64748B</Color>
    <Color x:Key="AltSidebarHoverColor" options:Freeze="True">#15FFFFFF</Color>
    <Color x:Key="AltBottomBarBgColor" options:Freeze="True">#16FFFFFF</Color>
    <Color x:Key="AltBottomBarBorderColor" options:Freeze="True">#20FFFFFF</Color>
    <Color x:Key="AltIconFallbackBgColor" options:Freeze="True">#0AFFFFFF</Color>

    <!-- Separator / Shadow / Window -->
    <SolidColorBrush x:Key="ThemeSeparator"       Color="#20FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeShadow"          Color="#000000" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeWindowFallback"  Color="#1A1028" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeCodePreviewBg"   Color="#FF1E1E1E" options:Freeze="True"/>

    <!-- Chevron -->
    <SolidColorBrush x:Key="ThemeChevronBg"          Color="#EE4E2E80" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBorder"      Color="#FF6E42A8" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBgHover"     Color="#F55C3890" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBorderHover" Color="#FF8050B8" options:Freeze="True"/>

    <!-- Overlay buttons -->
    <SolidColorBrush x:Key="ThemeOverlayButtonBg"     Color="#F04E2E80" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayButtonBorder" Color="#FF6E42A8" options:Freeze="True"/>

    <!-- Floating bar -->
    <SolidColorBrush x:Key="ThemeFloatingBarBg"       Color="#F04A2B78" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeFloatingBarBorder"   Color="#FF6840A0" options:Freeze="True"/>

    <!-- Overflow popup -->
    <SolidColorBrush x:Key="ThemeOverflowBg"           Color="#F04A2B78" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverflowBorder"       Color="#606840A0" options:Freeze="True"/>
    <Color x:Key="ThemeOverflowShadowColor">#3E2468</Color>

    <!-- Toast -->
    <SolidColorBrush x:Key="ThemeToastBg"          Color="#F53E2468" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeToastBorder"      Color="#FF5E38A0" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeToastInnerGlow"   Color="#20A78BFA" options:Freeze="True"/>

    <!-- Empty state icon -->
    <SolidColorBrush x:Key="ThemeEmptyIcon"        Color="#40FFFFFF" options:Freeze="True"/>

    <!-- Transfer / progress -->
    <SolidColorBrush x:Key="ThemeTransferProgress" Color="#A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTransferText"     Color="#C4B5FD" options:Freeze="True"/>

    <!-- System accent overrides -->
    <Color x:Key="SystemAccentColor">#7C3AED</Color>
    <Color x:Key="SystemAccentColorLight1">#A78BFA</Color>
    <Color x:Key="SystemAccentColorLight2">#C4B5FD</Color>
    <Color x:Key="SystemAccentColorLight3">#DDD6FE</Color>
    <Color x:Key="SystemAccentColorDark1">#6D28D9</Color>
    <Color x:Key="SystemAccentColorDark2">#5B21B6</Color>
    <Color x:Key="SystemAccentColorDark3">#4C1D95</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush"       Color="#7C3AED" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#C4B5FD" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#DDD6FE" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush"  Color="#6D28D9" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush"  Color="#5B21B6" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush"  Color="#4C1D95" options:Freeze="True"/>

    <!-- MicaWPF accent overrides -->
    <Color x:Key="MicaWPF.Colors.SystemAccentColor">#7C3AED</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight1">#A78BFA</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight2">#C4B5FD</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark1">#6D28D9</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark2">#5B21B6</Color>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColor"       Color="#7C3AED" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight1" Color="#A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight2" Color="#C4B5FD" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorDark1"  Color="#6D28D9" options:Freeze="True"/>

    <!-- Theme marker -->
    <SolidColorBrush x:Key="FlyShelf.ColorThemeMarker" Color="#7C3AED" options:Freeze="True"/>

    <!-- Theme-specific logo icon -->
    <BitmapImage x:Key="ThemeLogoIcon" UriSource="pack://application:,,,/Resources/FlyShelfIcon_RoyalOrchid.png" DecodePixelWidth="64" />
</ResourceDictionary>
