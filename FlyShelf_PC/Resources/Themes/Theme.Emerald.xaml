<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">
    <!-- Emerald Theme — Rich Green -->

    <!-- Accent colors -->
    <SolidColorBrush x:Key="ThemeAccent"          Color="#059669" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentLight"     Color="#34D399" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentDark"      Color="#047857" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBg"        Color="#20059669" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBgHover"   Color="#40059669" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBorder"    Color="#50059669" options:Freeze="True"/>
    <Color x:Key="ThemeAccentColor">#059669</Color>
    <Color x:Key="ThemeAccentLightColor">#34D399</Color>
    <Color x:Key="ThemeAccentDarkColor">#047857</Color>

    <!-- Header button chrome -->
    <SolidColorBrush x:Key="ThemeHeaderBtnBg"             Color="#FF0E6B4A" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorder"         Color="#FF149E65" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFg"             Color="#F0FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgHover"        Color="#FF108858" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderHover"    Color="#FF18B878" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgHover"        Color="#FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgPressed"      Color="#FF12A068" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderPressed"  Color="#FF18B878" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgPressed"      Color="#E0FFFFFF" options:Freeze="True"/>
    <Color x:Key="ThemeHeaderBtnBgColor">#FF0E6B4A</Color>
    <Color x:Key="ThemeHeaderBtnBorderColor">#FF149E65</Color>
    <Color x:Key="ThemeHeaderBtnBgHoverColor">#FF108858</Color>
    <Color x:Key="ThemeHeaderBtnBorderHoverColor">#FF18B878</Color>
    <Color x:Key="ThemeHeaderBtnFgHoverColor">#FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBgPressedColor">#FF12A068</Color>
    <Color x:Key="ThemeHeaderBtnBorderPressedColor">#FF18B878</Color>
    <Color x:Key="ThemeHeaderBtnFgPressedColor">#E0FFFFFF</Color>

    <!-- Overlay chrome -->
    <SolidColorBrush x:Key="ThemeOverlayBg"           Color="#12FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgHover"      Color="#22FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgSelected"   Color="#15FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgPressed"    Color="#0AFFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorder"       Color="#18FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderHover"  Color="#30FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderStrong" Color="#40FFFFFF" options:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ThemeTextPrimary"     Color="#F1F5F9" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextSecondary"   Color="#94A3B8" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextMuted"       Color="#64748B" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextOnAccent"    Color="#FFFFFF" options:Freeze="True"/>

    <!-- Separator / Shadow / Window -->
    <SolidColorBrush x:Key="ThemeSeparator"       Color="#20FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeShadow"          Color="#000000" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeWindowFallback"  Color="#081E15" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeCodePreviewBg"   Color="#FF1E1E1E" options:Freeze="True"/>

    <!-- Chevron -->
    <SolidColorBrush x:Key="ThemeChevronBg"          Color="#EE0C5238" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBorder"      Color="#FF0E7854" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBgHover"     Color="#F5106245" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBorderHover" Color="#FF129060" options:Freeze="True"/>

    <!-- Overlay buttons -->
    <SolidColorBrush x:Key="ThemeOverlayButtonBg"     Color="#F00C5238" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayButtonBorder" Color="#FF0E7854" options:Freeze="True"/>

    <!-- Floating bar -->
    <SolidColorBrush x:Key="ThemeFloatingBarBg"       Color="#F00B4E35" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeFloatingBarBorder"   Color="#FF0D7050" options:Freeze="True"/>

    <!-- Overflow popup -->
    <SolidColorBrush x:Key="ThemeOverflowBg"           Color="#F00B4E35" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverflowBorder"       Color="#600D7050" options:Freeze="True"/>
    <Color x:Key="ThemeOverflowShadowColor">#0A3828</Color>

    <!-- Toast -->
    <SolidColorBrush x:Key="ThemeToastBg"          Color="#F50A3828" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeToastBorder"      Color="#FF0D6045" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeToastInnerGlow"   Color="#2034D399" options:Freeze="True"/>

    <!-- Empty state icon -->
    <SolidColorBrush x:Key="ThemeEmptyIcon"        Color="#40FFFFFF" options:Freeze="True"/>

    <!-- Transfer / progress -->
    <SolidColorBrush x:Key="ThemeTransferProgress" Color="#34D399" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTransferText"     Color="#6EE7B7" options:Freeze="True"/>

    <!-- System accent overrides -->
    <Color x:Key="SystemAccentColor">#059669</Color>
    <Color x:Key="SystemAccentColorLight1">#34D399</Color>
    <Color x:Key="SystemAccentColorLight2">#6EE7B7</Color>
    <Color x:Key="SystemAccentColorLight3">#A7F3D0</Color>
    <Color x:Key="SystemAccentColorDark1">#047857</Color>
    <Color x:Key="SystemAccentColorDark2">#065F46</Color>
    <Color x:Key="SystemAccentColorDark3">#064E3B</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush"       Color="#059669" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#34D399" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#6EE7B7" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#A7F3D0" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush"  Color="#047857" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush"  Color="#065F46" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush"  Color="#064E3B" options:Freeze="True"/>

    <!-- MicaWPF accent overrides -->
    <Color x:Key="MicaWPF.Colors.SystemAccentColor">#059669</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight1">#34D399</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight2">#6EE7B7</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark1">#047857</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark2">#065F46</Color>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColor"       Color="#059669" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight1" Color="#34D399" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight2" Color="#6EE7B7" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorDark1"  Color="#047857" options:Freeze="True"/>

    <!-- Theme marker -->
    <SolidColorBrush x:Key="FlyShelf.ColorThemeMarker" Color="#0D9488" options:Freeze="True"/>

    <!-- Theme-specific logo icon -->
    <BitmapImage x:Key="ThemeLogoIcon" UriSource="pack://application:,,,/Resources/FlyShelfIcon_EmeraldTeal.png" />
</ResourceDictionary>
