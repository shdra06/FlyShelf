<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">
    <!-- Ocean Theme — Deep Cyan/Teal -->

    <!-- Accent colors -->
    <SolidColorBrush x:Key="ThemeAccent"          Color="#0891B2" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentLight"     Color="#22D3EE" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentDark"      Color="#0E7490" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBg"        Color="#200891B2" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBgHover"   Color="#400891B2" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeAccentBorder"    Color="#500891B2" options:Freeze="True"/>
    <Color x:Key="ThemeAccentColor">#0891B2</Color>
    <Color x:Key="ThemeAccentLightColor">#22D3EE</Color>
    <Color x:Key="ThemeAccentDarkColor">#0E7490</Color>

    <!-- Header button chrome -->
    <SolidColorBrush x:Key="ThemeHeaderBtnBg"             Color="#FF0E5C6E" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorder"         Color="#FF1490A5" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFg"             Color="#F0FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgHover"        Color="#FF107888" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderHover"    Color="#FF18AAC0" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgHover"        Color="#FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgPressed"      Color="#FF128EA0" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderPressed"  Color="#FF18AAC0" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgPressed"      Color="#E0FFFFFF" options:Freeze="True"/>
    <Color x:Key="ThemeHeaderBtnBgColor">#FF0E5C6E</Color>
    <Color x:Key="ThemeHeaderBtnBorderColor">#FF1490A5</Color>
    <Color x:Key="ThemeHeaderBtnBgHoverColor">#FF107888</Color>
    <Color x:Key="ThemeHeaderBtnBorderHoverColor">#FF18AAC0</Color>
    <Color x:Key="ThemeHeaderBtnFgHoverColor">#FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBgPressedColor">#FF128EA0</Color>
    <Color x:Key="ThemeHeaderBtnBorderPressedColor">#FF18AAC0</Color>
    <Color x:Key="ThemeHeaderBtnFgPressedColor">#E0FFFFFF</Color>

    <!-- Overlay chrome -->
    <SolidColorBrush x:Key="ThemeOverlayBg"           Color="#12FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgHover"      Color="#22FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgSelected"   Color="#15FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBgPressed"    Color="#0AFFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorder"       Color="#18FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderHover"  Color="#30FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderStrong" Color="#40FFFFFF" options:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ThemeTextPrimary"     Color="#F1F5F9" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextSecondary"   Color="#94A3B8" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextMuted"       Color="#64748B" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTextOnAccent"    Color="#FFFFFF" options:Freeze="True"/>
    <Color x:Key="ThemeTextPrimaryColor" options:Freeze="True">#F1F5F9</Color>
    <Color x:Key="ThemeTextSecondaryColor" options:Freeze="True">#94A3B8</Color>
    <Color x:Key="ThemeTextMutedColor" options:Freeze="True">#64748B</Color>
    <Color x:Key="ThemeOverlayBgColor" options:Freeze="True">#12FFFFFF</Color>
    <Color x:Key="ThemeOverlayBorderColor" options:Freeze="True">#18FFFFFF</Color>
    <Color x:Key="ThemeOverlayHoverColor" options:Freeze="True">#22FFFFFF</Color>

    <!-- ── Clipboard Popup ── -->
    <Color x:Key="AltCardBgColor" options:Freeze="True">#18FFFFFF</Color>
    <Color x:Key="AltCardBgHoverColor" options:Freeze="True">#28FFFFFF</Color>
    <Color x:Key="AltCardBorderColor" options:Freeze="True">#22FFFFFF</Color>
    <Color x:Key="AltCardBorderHoverColor" options:Freeze="True">#35FFFFFF</Color>
    <Color x:Key="AltHeaderBgColor" options:Freeze="True">#16FFFFFF</Color>
    <Color x:Key="AltSearchBgColor" options:Freeze="True">#12FFFFFF</Color>
    <Color x:Key="AltSearchBorderColor" options:Freeze="True">#20FFFFFF</Color>
    <Color x:Key="AltSearchFgColor" options:Freeze="True">#64748B</Color>
    <Color x:Key="AltTextPrimaryColor" options:Freeze="True">#F1F5F9</Color>
    <Color x:Key="AltTextSecondaryColor" options:Freeze="True">#94A3B8</Color>
    <Color x:Key="AltTextMutedColor" options:Freeze="True">#64748B</Color>
    <Color x:Key="AltSidebarHoverColor" options:Freeze="True">#15FFFFFF</Color>
    <Color x:Key="AltBottomBarBgColor" options:Freeze="True">#16FFFFFF</Color>
    <Color x:Key="AltBottomBarBorderColor" options:Freeze="True">#20FFFFFF</Color>
    <Color x:Key="AltIconFallbackBgColor" options:Freeze="True">#0AFFFFFF</Color>

    <!-- Separator / Shadow / Window -->
    <SolidColorBrush x:Key="ThemeSeparator"       Color="#20FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeShadow"          Color="#000000" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeWindowFallback"  Color="#0A2830" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeCodePreviewBg"   Color="#FF1E1E1E" options:Freeze="True"/>

    <!-- Chevron -->
    <SolidColorBrush x:Key="ThemeChevronBg"          Color="#EE0A4A5A" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBorder"      Color="#FF109098" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBgHover"     Color="#F50E5868" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeChevronBorderHover" Color="#FF14A0B0" options:Freeze="True"/>

    <!-- Overlay buttons -->
    <SolidColorBrush x:Key="ThemeOverlayButtonBg"     Color="#F00A4A5A" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverlayButtonBorder" Color="#FF109098" options:Freeze="True"/>

    <!-- Floating bar -->
    <SolidColorBrush x:Key="ThemeFloatingBarBg"       Color="#F00C4858" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeFloatingBarBorder"   Color="#FF0E7888" options:Freeze="True"/>

    <!-- Overflow popup -->
    <SolidColorBrush x:Key="ThemeOverflowBg"           Color="#F00C4858" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeOverflowBorder"       Color="#600E7888" options:Freeze="True"/>
    <Color x:Key="ThemeOverflowShadowColor">#0E4A5A</Color>

    <!-- Toast -->
    <SolidColorBrush x:Key="ThemeToastBg"          Color="#F50A3842" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeToastBorder"      Color="#FF0E6878" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeToastInnerGlow"   Color="#2022D3EE" options:Freeze="True"/>

    <!-- Empty state icon -->
    <SolidColorBrush x:Key="ThemeEmptyIcon"        Color="#40FFFFFF" options:Freeze="True"/>

    <!-- Transfer / progress -->
    <SolidColorBrush x:Key="ThemeTransferProgress" Color="#22D3EE" options:Freeze="True"/>
    <SolidColorBrush x:Key="ThemeTransferText"     Color="#67E8F9" options:Freeze="True"/>

    <!-- System accent overrides -->
    <Color x:Key="SystemAccentColor">#0891B2</Color>
    <Color x:Key="SystemAccentColorLight1">#22D3EE</Color>
    <Color x:Key="SystemAccentColorLight2">#67E8F9</Color>
    <Color x:Key="SystemAccentColorLight3">#A5F3FC</Color>
    <Color x:Key="SystemAccentColorDark1">#0E7490</Color>
    <Color x:Key="SystemAccentColorDark2">#155E75</Color>
    <Color x:Key="SystemAccentColorDark3">#164E63</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush"       Color="#0891B2" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#22D3EE" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#67E8F9" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#A5F3FC" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush"  Color="#0E7490" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush"  Color="#155E75" options:Freeze="True"/>
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush"  Color="#164E63" options:Freeze="True"/>

    <!-- MicaWPF accent overrides -->
    <Color x:Key="MicaWPF.Colors.SystemAccentColor">#0891B2</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight1">#22D3EE</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight2">#67E8F9</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark1">#0E7490</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark2">#155E75</Color>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColor"       Color="#0891B2" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight1" Color="#22D3EE" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight2" Color="#67E8F9" options:Freeze="True"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorDark1"  Color="#0E7490" options:Freeze="True"/>

    <!-- Theme marker -->
    <SolidColorBrush x:Key="FlyShelf.ColorThemeMarker" Color="#0891B2" options:Freeze="True"/>

    <!-- Theme-specific logo icon -->
    <BitmapImage x:Key="ThemeLogoIcon" UriSource="pack://application:,,,/Resources/FlyShelfIcon_NordicFrost.png" DecodePixelWidth="64" />
</ResourceDictionary>
