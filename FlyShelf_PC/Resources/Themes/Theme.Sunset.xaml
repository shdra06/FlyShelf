<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sunset Theme — Warm Orange -->

    <!-- Accent colors -->
    <SolidColorBrush x:Key="ThemeAccent"          Color="#EA580C"/>
    <SolidColorBrush x:Key="ThemeAccentLight"     Color="#FB923C"/>
    <SolidColorBrush x:Key="ThemeAccentDark"      Color="#C2410C"/>
    <SolidColorBrush x:Key="ThemeAccentBg"        Color="#20EA580C"/>
    <SolidColorBrush x:Key="ThemeAccentBgHover"   Color="#40EA580C"/>
    <SolidColorBrush x:Key="ThemeAccentBorder"    Color="#50EA580C"/>
    <Color x:Key="ThemeAccentColor">#EA580C</Color>
    <Color x:Key="ThemeAccentLightColor">#FB923C</Color>
    <Color x:Key="ThemeAccentDarkColor">#C2410C</Color>

    <!-- Header button chrome -->
    <SolidColorBrush x:Key="ThemeHeaderBtnBg"             Color="#FF8B5A1B"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorder"         Color="#FFB07525"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFg"             Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgHover"        Color="#FFA06A20"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderHover"    Color="#FFCC8830"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgHover"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgPressed"      Color="#FFB87A28"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderPressed"  Color="#FFCC8830"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgPressed"      Color="#E0FFFFFF"/>
    <Color x:Key="ThemeHeaderBtnBgColor">#FF8B5A1B</Color>
    <Color x:Key="ThemeHeaderBtnBorderColor">#FFB07525</Color>
    <Color x:Key="ThemeHeaderBtnBgHoverColor">#FFA06A20</Color>
    <Color x:Key="ThemeHeaderBtnBorderHoverColor">#FFCC8830</Color>
    <Color x:Key="ThemeHeaderBtnFgHoverColor">#FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBgPressedColor">#FFB87A28</Color>
    <Color x:Key="ThemeHeaderBtnBorderPressedColor">#FFCC8830</Color>
    <Color x:Key="ThemeHeaderBtnFgPressedColor">#E0FFFFFF</Color>

    <!-- Overlay chrome -->
    <SolidColorBrush x:Key="ThemeOverlayBg"           Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgHover"      Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgSelected"   Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgPressed"    Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorder"       Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderHover"  Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderStrong" Color="#40FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ThemeTextPrimary"     Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ThemeTextSecondary"   Color="#94A3B8"/>
    <SolidColorBrush x:Key="ThemeTextMuted"       Color="#64748B"/>
    <SolidColorBrush x:Key="ThemeTextOnAccent"    Color="#FFFFFF"/>

    <!-- Separator / Shadow / Window -->
    <SolidColorBrush x:Key="ThemeSeparator"       Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="ThemeShadow"          Color="#000000"/>
    <SolidColorBrush x:Key="ThemeWindowFallback"  Color="#2A1A08"/>
    <SolidColorBrush x:Key="ThemeCodePreviewBg"   Color="#FF1E1E1E"/>

    <!-- Chevron -->
    <SolidColorBrush x:Key="ThemeChevronBg"          Color="#EE6E4818"/>
    <SolidColorBrush x:Key="ThemeChevronBorder"      Color="#FF9A6820"/>
    <SolidColorBrush x:Key="ThemeChevronBgHover"     Color="#F5805520"/>
    <SolidColorBrush x:Key="ThemeChevronBorderHover" Color="#FFB07828"/>

    <!-- Overlay buttons -->
    <SolidColorBrush x:Key="ThemeOverlayButtonBg"     Color="#F06E4818"/>
    <SolidColorBrush x:Key="ThemeOverlayButtonBorder" Color="#FF9A6820"/>

    <!-- Floating bar -->
    <SolidColorBrush x:Key="ThemeFloatingBarBg"       Color="#F06A4515"/>
    <SolidColorBrush x:Key="ThemeFloatingBarBorder"   Color="#FF8A5E1C"/>

    <!-- Overflow popup -->
    <SolidColorBrush x:Key="ThemeOverflowBg"           Color="#F06A4515"/>
    <SolidColorBrush x:Key="ThemeOverflowBorder"       Color="#608A5E1C"/>
    <Color x:Key="ThemeOverflowShadowColor">#5A3810</Color>

    <!-- Toast -->
    <SolidColorBrush x:Key="ThemeToastBg"          Color="#F55A3810"/>
    <SolidColorBrush x:Key="ThemeToastBorder"      Color="#FF8A5E1C"/>
    <SolidColorBrush x:Key="ThemeToastInnerGlow"   Color="#20FB923C"/>

    <!-- Empty state icon -->
    <SolidColorBrush x:Key="ThemeEmptyIcon"        Color="#40FFFFFF"/>

    <!-- Transfer / progress -->
    <SolidColorBrush x:Key="ThemeTransferProgress" Color="#FB923C"/>
    <SolidColorBrush x:Key="ThemeTransferText"     Color="#FDBA74"/>

    <!-- System accent overrides -->
    <Color x:Key="SystemAccentColor">#EA580C</Color>
    <Color x:Key="SystemAccentColorLight1">#FB923C</Color>
    <Color x:Key="SystemAccentColorLight2">#FDBA74</Color>
    <Color x:Key="SystemAccentColorLight3">#FED7AA</Color>
    <Color x:Key="SystemAccentColorDark1">#C2410C</Color>
    <Color x:Key="SystemAccentColorDark2">#9A3412</Color>
    <Color x:Key="SystemAccentColorDark3">#7C2D12</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush"       Color="#EA580C"/>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#FB923C"/>
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#FDBA74"/>
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#FED7AA"/>
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush"  Color="#C2410C"/>
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush"  Color="#9A3412"/>
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush"  Color="#7C2D12"/>

    <!-- MicaWPF accent overrides -->
    <Color x:Key="MicaWPF.Colors.SystemAccentColor">#EA580C</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight1">#FB923C</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight2">#FDBA74</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark1">#C2410C</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark2">#9A3412</Color>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColor"       Color="#EA580C"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight1" Color="#FB923C"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight2" Color="#FDBA74"/>
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorDark1"  Color="#C2410C"/>

    <!-- Theme marker -->
    <SolidColorBrush x:Key="FlyShelf.ColorThemeMarker" Color="#EA580C"/>

    <!-- Theme-specific logo icon -->
    <BitmapImage x:Key="ThemeLogoIcon" UriSource="pack://application:,,,/Resources/FlyShelfIcon_SunsetFire.png" />
</ResourceDictionary>
