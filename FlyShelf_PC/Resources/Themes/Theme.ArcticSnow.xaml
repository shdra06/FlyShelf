<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         FlyShelf  –  ARCTIC SNOW  Theme  (Indigo Accent #4F46E5)
         Light grey background inspired by Windows native clipboard.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Theme Marker ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="FlyShelf.ColorThemeMarker" Color="#4F46E5"/>

    <!-- ── Accent ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeAccent"      Color="#4F46E5" />
    <SolidColorBrush x:Key="ThemeAccentLight"  Color="#818CF8" />
    <SolidColorBrush x:Key="ThemeAccentDark"   Color="#3730A3" />
    <SolidColorBrush x:Key="ThemeAccentBg"       Color="#204F46E5" />
    <SolidColorBrush x:Key="ThemeAccentBgHover"  Color="#404F46E5" />
    <SolidColorBrush x:Key="ThemeAccentBorder"   Color="#504F46E5" />

    <Color x:Key="ThemeAccentColor">#4F46E5</Color>
    <Color x:Key="ThemeAccentLightColor">#818CF8</Color>
    <Color x:Key="ThemeAccentDarkColor">#3730A3</Color>

    <!-- ── Header Buttons ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeHeaderBtnBg"            Color="#88FFFFFF" />
    <SolidColorBrush x:Key="ThemeHeaderBtnBorder"        Color="#30000000" />
    <SolidColorBrush x:Key="ThemeHeaderBtnFg"            Color="#1E293B" />
    <SolidColorBrush x:Key="ThemeHeaderBtnBgHover"       Color="#AAFFFFFF" />
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderHover"   Color="#45000000" />
    <SolidColorBrush x:Key="ThemeHeaderBtnFgHover"       Color="#0F172A" />
    <SolidColorBrush x:Key="ThemeHeaderBtnBgPressed"     Color="#70FFFFFF" />
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderPressed" Color="#35000000" />
    <SolidColorBrush x:Key="ThemeHeaderBtnFgPressed"     Color="#334155" />
    <!-- Color keys for WPF-UI Button internal template state bindings -->
    <Color x:Key="ThemeHeaderBtnBgColor">#88FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBorderColor">#30000000</Color>
    <Color x:Key="ThemeHeaderBtnBgHoverColor">#AAFFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBorderHoverColor">#45000000</Color>
    <Color x:Key="ThemeHeaderBtnFgHoverColor">#0F172A</Color>
    <Color x:Key="ThemeHeaderBtnBgPressedColor">#70FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBorderPressedColor">#35000000</Color>
    <Color x:Key="ThemeHeaderBtnFgPressedColor">#334155</Color>

    <!-- ── Overlay ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeOverlayBg"          Color="#08000000" />
    <SolidColorBrush x:Key="ThemeOverlayBgHover"     Color="#12000000" />
    <SolidColorBrush x:Key="ThemeOverlayBgSelected"  Color="#0A000000" />
    <SolidColorBrush x:Key="ThemeOverlayBgPressed"   Color="#06000000" />
    <SolidColorBrush x:Key="ThemeOverlayBorder"       Color="#14000000" />
    <SolidColorBrush x:Key="ThemeOverlayBorderHover"  Color="#22000000" />
    <SolidColorBrush x:Key="ThemeOverlayBorderStrong" Color="#30000000" />

    <!-- ── Text ──────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeTextPrimary"    Color="#1E293B" />
    <SolidColorBrush x:Key="ThemeTextSecondary"  Color="#475569" />
    <SolidColorBrush x:Key="ThemeTextMuted"      Color="#94A3B8" />
    <SolidColorBrush x:Key="ThemeTextOnAccent"   Color="#FFFFFF" />

    <!-- ── Chrome / Surface ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeSeparator"      Color="#20000000" />
    <SolidColorBrush x:Key="ThemeShadow"         Color="#20000000" />
    <SolidColorBrush x:Key="ThemeWindowFallback" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ThemeCodePreviewBg"  Color="#EBEDF0" />

    <!-- ── Chevron ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeChevronBg"          Color="#F1F5F9" />
    <SolidColorBrush x:Key="ThemeChevronBorder"      Color="#22000000" />
    <SolidColorBrush x:Key="ThemeChevronBgHover"     Color="#E2E8F0" />
    <SolidColorBrush x:Key="ThemeChevronBorderHover" Color="#40000000" />

    <!-- ── Overlay Button ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeOverlayButtonBg"     Color="#E8F1F5F9" />
    <SolidColorBrush x:Key="ThemeOverlayButtonBorder" Color="#30000000" />

    <!-- ── Floating Bar ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeFloatingBarBg"     Color="#E8F1F5F9" />
    <SolidColorBrush x:Key="ThemeFloatingBarBorder" Color="#22000000" />

    <!-- ── Overflow Popup (three-dot menu) ───────────────────────────── -->
    <SolidColorBrush x:Key="ThemeOverflowBg"          Color="#F0F8FAFC" />
    <SolidColorBrush x:Key="ThemeOverflowBorder"      Color="#30000000" />
    <Color           x:Key="ThemeOverflowShadowColor">#40000000</Color>

    <!-- ── Button Accent Overrides (light-friendly) ─────────────────── -->
    <SolidColorBrush x:Key="EmojiButtonBg"     Color="#18D97706" />
    <SolidColorBrush x:Key="EmojiButtonBorder" Color="#30D97706" />
    <SolidColorBrush x:Key="DangerBgHover"     Color="#18EF4444" />
    <SolidColorBrush x:Key="DangerBorder"      Color="#30EF4444" />

    <!-- ── Toast ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeToastBg"        Color="#F0F8FAFC" />
    <SolidColorBrush x:Key="ThemeToastBorder"    Color="#18000000" />
    <SolidColorBrush x:Key="ThemeToastInnerGlow" Color="#06000000" />

    <!-- ── Transfer ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeTransferProgress" Color="#6366F1" />
    <SolidColorBrush x:Key="ThemeTransferText"     Color="#4F46E5" />

    <!-- ── Empty Icon ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ThemeEmptyIcon" Color="#30000000" />

    <!-- ═══════════════════════════════════════════════════════════════
         System Accent  –  Color keys
         ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="SystemAccentColor">#4F46E5</Color>
    <Color x:Key="SystemAccentColorLight1">#6366F1</Color>
    <Color x:Key="SystemAccentColorLight2">#818CF8</Color>
    <Color x:Key="SystemAccentColorLight3">#A5B4FC</Color>
    <Color x:Key="SystemAccentColorDark1">#4338CA</Color>
    <Color x:Key="SystemAccentColorDark2">#3730A3</Color>
    <Color x:Key="SystemAccentColorDark3">#312E81</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         System Accent  –  Brush keys
         ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SystemAccentColorBrush"       Color="#4F46E5" />
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#6366F1" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#818CF8" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#A5B4FC" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush"  Color="#4338CA" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush"  Color="#3730A3" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush"  Color="#312E81" />

    <!-- ═══════════════════════════════════════════════════════════════
         MicaWPF Accent  –  Color keys
         ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="MicaWPF.Colors.SystemAccentColor">#4F46E5</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight1">#6366F1</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorLight2">#818CF8</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark1">#4338CA</Color>
    <Color x:Key="MicaWPF.Colors.SystemAccentColorDark2">#3730A3</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         MicaWPF Accent  –  Brush keys
         ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColor"       Color="#4F46E5" />
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight1" Color="#6366F1" />
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorLight2" Color="#818CF8" />
    <SolidColorBrush x:Key="MicaWPF.Brushes.SystemAccentColorDark1"  Color="#4338CA" />

    <!-- Theme-specific logo icon -->
    <BitmapImage x:Key="ThemeLogoIcon" UriSource="pack://application:,,,/Resources/FlyShelfIcon_MinimalSilver.png" />
</ResourceDictionary>
