<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         GlobalScrollBar.xaml — Windows 11-style ultra-slim scrollbar
         Applied as IMPLICIT styles (no x:Key) so they auto-apply everywhere.
         4px idle → 6px hover, auto-fade thumb, no arrows, rounded.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══ Scrollbar Thumb ═══ -->
    <Style x:Key="Win11ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}"
                            CornerRadius="2"
                            Margin="0,2"
                            Opacity="0.6">
                        <Border.CacheMode>
                            <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                        </Border.CacheMode>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="3"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Vertical Scrollbar — Implicit (auto-applies) ═══ -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="ScrollTrack" Width="6" Background="Transparent" Margin="0,4,4,4">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Win11ScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Expand on hover for easier grab targeting -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScrollTrack" Property="Width" Value="8"/>
                        </Trigger>
                        <!-- Horizontal orientation override -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Horizontal scrollbar: swap dimensions -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="ScrollTrack" Height="4" Background="Transparent" Margin="4,0,4,2">
                                <Track Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Win11ScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ScrollTrack" Property="Height" Value="6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
