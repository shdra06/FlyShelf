<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         ImagePlaceholder.xaml — Placeholder shown when image thumbnails
         have not yet loaded. Displayed inside the icon Border when
         Icon == null AND the item type has a visual thumbnail.
         Auto-hides once RenderVisibleThumbnails sets the Icon property.
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ImagePlaceholderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
