<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    mc:Ignorable="options">

    <!-- ═══════════════════════════════════════════════════════════════════
         GlassTheme.xaml — Glassmorphism UI Theme for FlyShelf
         Loaded dynamically by ThemeManager when ThemeDisplayMode = "glass"
         All brushes are Frozen for zero GC pressure.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══ Glass Color Tokens ═══ -->
    <SolidColorBrush x:Key="GlassBg"          Color="#15FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBgHover"     Color="#25FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBgPressed"   Color="#10FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorder"      Color="#30FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderHover" Color="#50FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderFocus" Color="#60A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassTextPrimary" Color="#F0FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassTextMuted"   Color="#99FFFFFF" options:Freeze="True"/>

    <!-- Accent variants for primary / destructive actions -->
    <SolidColorBrush x:Key="GlassAccentBg"          Color="#303B82F6" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassAccentBgHover"     Color="#503B82F6" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassAccentBorder"      Color="#603B82F6" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDestructiveBg"     Color="#30EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDestructiveBgHover" Color="#50EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDestructiveBorder"  Color="#60EF4444" options:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassButtonStyle — Round-edge square button with frosted glass
         CornerRadius=10 (rounded square, not pill)
         Semi-transparent with subtle inner glow on hover
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{StaticResource GlassBg}"/>
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="GlassBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.CacheMode>
                            <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                        </Border.CacheMode>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlassBorder" Property="Background" Value="{StaticResource GlassBgHover}"/>
                            <Setter TargetName="GlassBorder" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                            <Setter TargetName="GlassBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.2" ShadowDepth="1" Direction="270"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GlassBorder" Property="Background" Value="{StaticResource GlassBgPressed}"/>
                            <Setter TargetName="GlassBorder" Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                            <Setter TargetName="GlassBorder" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GlassBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassAccentButtonStyle — Primary action (blue accent glass)
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GlassAccentBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassAccentBorder}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="GlassBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.CacheMode>
                            <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                        </Border.CacheMode>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlassBorder" Property="Background" Value="{StaticResource GlassAccentBgHover}"/>
                            <Setter TargetName="GlassBorder" Property="BorderBrush" Value="{StaticResource GlassAccentBorder}"/>
                            <Setter TargetName="GlassBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" Color="#3B82F6" Opacity="0.3" ShadowDepth="1" Direction="270"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GlassBorder" Property="Background" Value="{StaticResource GlassAccentBg}"/>
                            <Setter TargetName="GlassBorder" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GlassBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassDestructiveButtonStyle — Danger action (red accent glass)
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GlassDestructiveBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassDestructiveBorder}"/>
        <Setter Property="Foreground" Value="#EF4444"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="GlassBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.CacheMode>
                            <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                        </Border.CacheMode>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlassBorder" Property="Background" Value="{StaticResource GlassDestructiveBgHover}"/>
                            <Setter TargetName="GlassBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" Color="#EF4444" Opacity="0.25" ShadowDepth="1" Direction="270"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GlassBorder" Property="Background" Value="{StaticResource GlassDestructiveBg}"/>
                            <Setter TargetName="GlassBorder" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GlassBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassCardStyle — Container panels with glass effect
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CacheMode">
            <Setter.Value>
                <BitmapCache EnableClearType="True" RenderAtScale="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassBgHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassPopupButtonStyle — For popup dialog buttons
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassPopupButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="MinWidth" Value="80"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassPopupAccentButtonStyle — Primary popup button
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassPopupAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassAccentButtonStyle}">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="90"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassPanelStyle — Frosted panel background for sections
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#0CFFFFFF"/>
        <Setter Property="BorderBrush" Value="#20FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         CRITICAL FIX: Implicit ui:Button Override
         
         This template properly renders BOTH the Icon property AND Content.
         WPF-UI's Button has an Icon dependency property (type IconElement)
         that the default template renders via a special internal layout.
         Our glass template must replicate this by including a ContentControl
         bound to the Icon property alongside the ContentPresenter.
         
         Without this, icon-only buttons (which is the majority in FlyShelf)
         render as empty dots since ContentPresenter has nothing to show.
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ui:Button}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="Background" Value="{StaticResource GlassBg}"/>
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <Border x:Name="GlassRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.CacheMode>
                            <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                        </Border.CacheMode>
                        <!-- Layout: Icon (left) + Content (right), centered -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- Icon element — renders the ui:Button.Icon property -->
                            <ContentControl x:Name="IconHost"
                                            Content="{TemplateBinding Icon}"
                                            Focusable="False"
                                            IsTabStop="False"
                                            Foreground="{TemplateBinding Foreground}"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"/>
                            <!-- Content element — renders text or child content -->
                            <ContentPresenter x:Name="ContentHost"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hide IconHost when no Icon is set -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Add spacing between icon and content when both exist -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasContent" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentHost" Property="Margin" Value="6,0,0,0"/>
                        </MultiTrigger>
                        <!-- Hide content host when no content -->
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- ═══ Appearance Variants ═══ -->
                        <Trigger Property="Appearance" Value="Primary">
                            <Setter TargetName="GlassRoot" Property="Background" Value="{StaticResource GlassAccentBg}"/>
                            <Setter TargetName="GlassRoot" Property="BorderBrush" Value="{StaticResource GlassAccentBorder}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="Appearance" Value="Danger">
                            <Setter TargetName="GlassRoot" Property="Background" Value="{StaticResource GlassDestructiveBg}"/>
                            <Setter TargetName="GlassRoot" Property="BorderBrush" Value="{StaticResource GlassDestructiveBorder}"/>
                            <Setter Property="Foreground" Value="#EF4444"/>
                        </Trigger>
                        <Trigger Property="Appearance" Value="Transparent">
                            <Setter TargetName="GlassRoot" Property="Background" Value="Transparent"/>
                            <Setter TargetName="GlassRoot" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>

                        <!-- ═══ Hover States ═══ -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Appearance" Value="Primary"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="GlassRoot" Property="Background" Value="{StaticResource GlassAccentBgHover}"/>
                            <Setter TargetName="GlassRoot" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" Color="#3B82F6" Opacity="0.25" ShadowDepth="1" Direction="270"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Appearance" Value="Secondary"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="GlassRoot" Property="Background" Value="{StaticResource GlassBgHover}"/>
                            <Setter TargetName="GlassRoot" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                            <Setter TargetName="GlassRoot" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.15" ShadowDepth="1" Direction="270"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Appearance" Value="Transparent"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="GlassRoot" Property="Background" Value="{StaticResource GlassBgHover}"/>
                            <Setter TargetName="GlassRoot" Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                        </MultiTrigger>
                        <!-- Default hover (when Appearance not specified — treats as Secondary) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Appearance" Value="Info"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="GlassRoot" Property="Background" Value="{StaticResource GlassBgHover}"/>
                            <Setter TargetName="GlassRoot" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                        </MultiTrigger>

                        <!-- Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GlassRoot" Property="Background" Value="{StaticResource GlassBgPressed}"/>
                            <Setter TargetName="GlassRoot" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GlassRoot" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Glass CheckBox — Frosted translucent check indicator
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}"/>
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="BorderBrush" Value="#35FFFFFF"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="CheckBorder"
                                Width="18" Height="18"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                            </Border.CacheMode>
                            <!-- Checkmark glyph -->
                            <TextBlock x:Name="CheckGlyph" Text="✓" FontSize="12" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" Margin="0,-1,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="#60A78BFA"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#80A78BFA"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#60FFFFFF"/>
                            <Setter TargetName="CheckBorder" Property="Background" Value="#20FFFFFF"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckBorder" Property="Background" Value="#70A78BFA"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#90A78BFA"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Glass ToolTip — Frosted translucent tooltip popup
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#E0181818" BorderBrush="#40FFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.4" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Glass ContextMenu — Frosted translucent popup menu
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#E8181818" BorderBrush="#35FFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="4,6" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.5" ShadowDepth="4" Direction="270"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass MenuItem — Frosted hover effect for menu items -->
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuBg" Background="Transparent" CornerRadius="6" Margin="2,1"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuBg" Property="Background" Value="#25FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#50FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Glass ScrollBar — Thin frosted translucent scrollbar
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="MinHeight" Value="80"/>
        <Setter Property="MaxHeight" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="#30FFFFFF" CornerRadius="3"
                            SnapsToDevicePixels="True" Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#50FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#60A78BFA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassScrollBarThumbHorizontalStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="MaxWidth" Value="60"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="#30FFFFFF" CornerRadius="3"
                            SnapsToDevicePixels="True" Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#50FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#60A78BFA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" CornerRadius="4">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource GlassScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" CornerRadius="4">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource GlassScrollBarThumbHorizontalStyle}"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         Card & UI Element — Glass Theme Overrides
         Semi-transparent frosted cards, violet selection highlights
         ═══════════════════════════════════════════════════════════════ -->
    <!-- Selection highlight (violet, slightly more visible on glass) -->
    <SolidColorBrush x:Key="ShelfCardSelectionBorder"  Color="#60A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="ShelfCardSelectionBg"      Color="#18A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="ShelfCardFocusBorder"      Color="#90A78BFA" options:Freeze="True"/>
    <!-- Action pill backgrounds (frosted translucent) -->
    <SolidColorBrush x:Key="ActionPillBg"              Color="#20FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ActionPillBorder"          Color="#30FFFFFF" options:Freeze="True"/>
    <!-- Expand/collapse chevron (frosted translucent) -->
    <SolidColorBrush x:Key="ChevronBg"                 Color="#25FFFFFF" options:Freeze="True"/>
    <SolidColorBrush x:Key="ChevronBorder"             Color="#40FFFFFF" options:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         Floating Action Bar — Glass Theme Overrides
         ═══════════════════════════════════════════════════════════════ -->
    <!-- Merge button — frosted violet glass -->
    <SolidColorBrush x:Key="FloatingMergeAccentBg"          Color="#30A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingMergeAccentBgHover"     Color="#50A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingMergeAccentBgPressed"   Color="#20A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingMergeAccentBorder"      Color="#50A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingMergeAccentBorderHover" Color="#70A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingMergeAccentIcon"        Color="#C4B5FD" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingMergeAccentText"        Color="#EDE9FE" options:Freeze="True"/>
    <!-- Unpin button — frosted amber glass -->
    <SolidColorBrush x:Key="FloatingUnpinBg"          Color="#25FBBF24" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingUnpinBgHover"     Color="#40FBBF24" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingUnpinBgPressed"   Color="#18FBBF24" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingUnpinBorder"      Color="#40FBBF24" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingUnpinBorderHover" Color="#60FBBF24" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingUnpinIcon"        Color="#FDE68A" options:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingUnpinText"        Color="#FFFBEB" options:Freeze="True"/>

    <!-- ═══ Glass theme marker (used for detection in code) ═══ -->
    <SolidColorBrush x:Key="FlyShelf.GlassThemeActive" Color="Transparent" options:Freeze="True"/>

</ResourceDictionary>
