    <!-- ═══════════════════════════════════════════ -->
    <!-- 🟠 PPT ICON — Orange file + screen/chart   -->
    <!-- ═══════════════════════════════════════════ -->
    <DrawingImage x:Key="PptIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- File body -->
                <GeometryDrawing Geometry="M3,1.5 C3,0.672 3.672,0 4.5,0 L12.5,0 L17,4.5 L17,18.5 C17,19.328 16.328,20 15.5,20 L4.5,20 C3.672,20 3,19.328 3,18.5 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF59E0B" Offset="0"/>
                            <GradientStop Color="#FFD97706" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Folded corner -->
                <GeometryDrawing Geometry="M12.5,0 L17,4.5 L14,4.5 C13.172,4.5 12.5,3.828 12.5,3 Z"
                                 Brush="#4DFFFFFF"/>
                <!-- Presentation screen -->
                <GeometryDrawing Geometry="M6,7.5 L14,7.5 L14,13 C14,13.44 13.64,13.8 13.2,13.8 L6.8,13.8 C6.36,13.8 6,13.44 6,13 Z"
                                 Brush="#D9FFFFFF"/>
