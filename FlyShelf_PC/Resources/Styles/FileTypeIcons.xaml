<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  VectorMaker — Taskbar Widget File Type Icons               ║
    ║  4 icons: PDF, DOC, PPT, Image                              ║
    ║  Designed for 16-20px taskbar display with cute animations  ║
    ║  Usage: <Image Source="{StaticResource PdfIcon}" Width="18"/>║
    ╚══════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════ -->
    <!-- 🔴 PDF ICON — Red gradient file + "P"      -->
    <!-- ═══════════════════════════════════════════ -->
    <DrawingImage x:Key="PdfIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- File body -->
                <GeometryDrawing Geometry="M3,1.5 C3,0.672 3.672,0 4.5,0 L12.5,0 L17,4.5 L17,18.5 C17,19.328 16.328,20 15.5,20 L4.5,20 C3.672,20 3,19.328 3,18.5 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFF4D4D" Offset="0"/>
                            <GradientStop Color="#FFE63946" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Folded corner -->
                <GeometryDrawing Geometry="M12.5,0 L17,4.5 L14,4.5 C13.172,4.5 12.5,3.828 12.5,3 Z"
                                 Brush="#4DFFFFFF"/>
                <!-- "P" letter stroke -->
                <GeometryDrawing Geometry="M7,10 L7,15.5 M7,10 L9.2,10 C10.1,10 10.8,10.6 10.8,11.4 C10.8,12.2 10.1,12.8 9.2,12.8 L7,12.8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#CCFFFFFF" Thickness="1.1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Side lines -->
                <GeometryDrawing Geometry="M12,11.5 L14,11.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#99FFFFFF" Thickness="1" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M12,13.5 L14,13.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#66FFFFFF" Thickness="1" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════ -->
    <!-- 🔵 DOC ICON — Blue gradient file + lines   -->
    <!-- ═══════════════════════════════════════════ -->
    <DrawingImage x:Key="DocIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- File body -->
                <GeometryDrawing Geometry="M3,1.5 C3,0.672 3.672,0 4.5,0 L12.5,0 L17,4.5 L17,18.5 C17,19.328 16.328,20 15.5,20 L4.5,20 C3.672,20 3,19.328 3,18.5 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF4A90E2" Offset="0"/>
                            <GradientStop Color="#FF2B6CB0" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Folded corner -->
                <GeometryDrawing Geometry="M12.5,0 L17,4.5 L14,4.5 C13.172,4.5 12.5,3.828 12.5,3 Z"
                                 Brush="#4DFFFFFF"/>
                <!-- Document lines -->
                <GeometryDrawing Geometry="M6,8.5 L14,8.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#CCFFFFFF" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M6,11.5 L14,11.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#99FFFFFF" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M6,14.5 L11,14.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#66FFFFFF" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
