    <!-- ═══════════════════════════════════════════ -->
    <!-- 🟢 IMAGE ICON — Teal file + mountain/sun   -->
    <!-- ═══════════════════════════════════════════ -->
    <DrawingImage x:Key="ImageIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- File body -->
                <GeometryDrawing Geometry="M3,1.5 C3,0.672 3.672,0 4.5,0 L12.5,0 L17,4.5 L17,18.5 C17,19.328 16.328,20 15.5,20 L4.5,20 C3.672,20 3,19.328 3,18.5 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF10B981" Offset="0"/>
                            <GradientStop Color="#FF059669" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Folded corner -->
                <GeometryDrawing Geometry="M12.5,0 L17,4.5 L14,4.5 C13.172,4.5 12.5,3.828 12.5,3 Z"
                                 Brush="#4DFFFFFF"/>
                <!-- Sun -->
                <GeometryDrawing Geometry="M8,9.5 C8,8.5 8.8,7.7 9.8,7.7 C10.8,7.7 11.6,8.5 11.6,9.5 C11.6,10.5 10.8,11.3 9.8,11.3 C8.8,11.3 8,10.5 8,9.5 Z"
                                 Brush="#D9FFFFFF"/>
                <!-- Background mountain -->
                <GeometryDrawing Geometry="M5.5,16 L8.5,11 L10.5,13.5 L13,10 L14.5,16 Z"
                                 Brush="#B3FFFFFF"/>
