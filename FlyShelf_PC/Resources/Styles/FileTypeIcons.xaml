                <GeometryDrawing Geometry="M10,13.8 L10,15.8 M7.5,15.8 L12.5,15.8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#B3FFFFFF" Thickness="0.9" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Chart bars -->
                <GeometryDrawing Geometry="M7.5,11 L7.5,13 L8.5,13 L8.5,11 Z" Brush="#FFD97706"/>
                <GeometryDrawing Geometry="M9.5,9.5 L9.5,13 L10.5,13 L10.5,9.5 Z" Brush="#FFD97706"/>
