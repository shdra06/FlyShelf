<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">

    <!-- ═══════════════════════════════════════════════════════════════════
         FlyShelfColorPalette.xaml — Central Color Token System
         
         ALL semantic colors for the entire app live here.
         Theme variant files (Theme.Ocean.xaml, Theme.ArcticSnow.xaml, etc.)
         override the "Theme*" tokens to change the app's accent/chrome.
         Content-type colors are FIXED across all themes.
         
         IMPORTANT: Theme-variable brushes must NOT be Frozen,
         otherwise DynamicResource won't re-resolve them when themes swap.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══ THEME-VARIABLE: Accent Colors (overridden per theme) ═══ -->
    <!-- Default: Neutral Slate — clean system look. Themes override. -->
    <SolidColorBrush x:Key="ThemeAccent"          Color="#7C8DB5"/>
    <SolidColorBrush x:Key="ThemeAccentLight"     Color="#9DADC8"/>
    <SolidColorBrush x:Key="ThemeAccentDark"      Color="#5C6F94"/>
    <SolidColorBrush x:Key="ThemeAccentBg"        Color="#207C8DB5"/>
    <SolidColorBrush x:Key="ThemeAccentBgHover"   Color="#407C8DB5"/>
    <SolidColorBrush x:Key="ThemeAccentBorder"    Color="#507C8DB5"/>
    <Color x:Key="ThemeAccentColor">#7C8DB5</Color>
    <Color x:Key="ThemeAccentLightColor">#9DADC8</Color>
    <Color x:Key="ThemeAccentDarkColor">#5C6F94</Color>

    <!-- ═══ THEME-VARIABLE: UI Chrome (overridden per theme + light) ═══ -->
    <!-- Default (Dark/Mica): frosted translucent buttons — clearly visible on dark Mica. Themes override. -->
    <SolidColorBrush x:Key="ThemeHeaderBtnBg"         Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorder"      Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFg"          Color="#E5FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgHover"     Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderHover" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgHover"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBgPressed"   Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnBorderPressed" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="ThemeHeaderBtnFgPressed"   Color="#DDFFFFFF"/>
    <!-- Color keys for WPF-UI Button internal template state bindings -->
    <Color x:Key="ThemeHeaderBtnBgColor">#16FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBorderColor">#20FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBgHoverColor">#2AFFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBorderHoverColor">#40FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnFgHoverColor">#FFFFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBgPressedColor">#12FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnBorderPressedColor">#30FFFFFF</Color>
    <Color x:Key="ThemeHeaderBtnFgPressedColor">#DDFFFFFF</Color>

    <SolidColorBrush x:Key="ThemeOverlayBg"       Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgHover"  Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgSelected" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBgPressed" Color="#06FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorder"    Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderHover" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="ThemeOverlayBorderStrong" Color="#40FFFFFF"/>

    <SolidColorBrush x:Key="ThemeTextPrimary"     Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ThemeTextSecondary"   Color="#94A3B8"/>
    <SolidColorBrush x:Key="ThemeTextMuted"       Color="#64748B"/>
    <SolidColorBrush x:Key="ThemeTextOnAccent"    Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ThemeSeparator"       Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="ThemeShadow"          Color="#000000"/>
    <SolidColorBrush x:Key="ThemeWindowFallback"   Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ThemeCodePreviewBg"   Color="#FF1E1E1E"/>

    <!-- Chevron button (expand/collapse on cards) -->
    <SolidColorBrush x:Key="ThemeChevronBg"       Color="#CC202024"/>
    <SolidColorBrush x:Key="ThemeChevronBorder"   Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ThemeChevronBgHover"  Color="#E62C2C32"/>
    <SolidColorBrush x:Key="ThemeChevronBorderHover" Color="#66FFFFFF"/>

    <!-- Overlay buttons (Rotate, QuickLook on images) -->
    <SolidColorBrush x:Key="ThemeOverlayButtonBg"     Color="#D0181818"/>
    <SolidColorBrush x:Key="ThemeOverlayButtonBorder" Color="#40FFFFFF"/>

    <!-- Floating action bar -->
    <SolidColorBrush x:Key="ThemeFloatingBarBg"       Color="#D0181818"/>
    <SolidColorBrush x:Key="ThemeFloatingBarBorder"   Color="#30FFFFFF"/>

    <!-- Overflow popup (three-dot menu) -->
    <SolidColorBrush x:Key="ThemeOverflowBg"           Color="#CC1E1E26"/>
    <SolidColorBrush x:Key="ThemeOverflowBorder"       Color="#40FFFFFF"/>
    <Color           x:Key="ThemeOverflowShadowColor">#000000</Color>

    <!-- Reminder feature -->
    <SolidColorBrush x:Key="ReminderAccent"         Color="#F59E0B"/>
    <SolidColorBrush x:Key="ReminderAccentBg"       Color="#18F59E0B"/>
    <SolidColorBrush x:Key="ReminderAccentBorder"   Color="#30F59E0B"/>

    <!-- Toast notification -->
    <SolidColorBrush x:Key="ThemeToastBg"          Color="#E8101018"/>
    <SolidColorBrush x:Key="ThemeToastBorder"      Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="ThemeToastInnerGlow"   Color="#08FFFFFF"/>

    <!-- P2P Transfer -->
    <SolidColorBrush x:Key="ThemeTransferProgress" Color="#7C7CFF"/>
    <SolidColorBrush x:Key="ThemeTransferText"     Color="#9C9CFF"/>

    <!-- Empty state -->
    <SolidColorBrush x:Key="ThemeEmptyIcon"        Color="#40FFFFFF"/>

    <!-- ═══ FIXED: Content Type Colors (same across all themes) ═══ -->
    <SolidColorBrush x:Key="TypeDefaultColor"  Color="#6366F1" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeTextColor"     Color="#8B5CF6" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCodeColor"     Color="#10B981" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeUrlColor"      Color="#0EA5E9" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeImageColor"    Color="#F472B6" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypePdfColor"      Color="#EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDocColor"      Color="#3B82F6" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeGroupColor"    Color="#A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeArchiveColor"  Color="#F59E0B" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeFolderColor"   Color="#EAB308" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeVideoColor"    Color="#8B5CF6" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeAudioColor"    Color="#EC4899" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypePresentColor"  Color="#F97316" options:Freeze="True"/>
    <SolidColorBrush x:Key="TypeColorColor"    Color="#EAB308" options:Freeze="True"/>

    <!-- ═══ FIXED: Filter Pill Backgrounds (per content type) ═══ -->
    <SolidColorBrush x:Key="FilterImageBg"     Color="#18F472B6" options:Freeze="True"/>
    <SolidColorBrush x:Key="FilterImageBorder" Color="#30F472B6" options:Freeze="True"/>
    <SolidColorBrush x:Key="FilterPinnedBg"    Color="#18FBBF24" options:Freeze="True"/>
    <SolidColorBrush x:Key="FilterPinnedBorder" Color="#30FBBF24" options:Freeze="True"/>
    <SolidColorBrush x:Key="FilterPdfBg"       Color="#18EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="FilterPdfBorder"   Color="#30EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="FilterDocsBg"      Color="#1860A5FA" options:Freeze="True"/>
    <SolidColorBrush x:Key="FilterDocsBorder"  Color="#3060A5FA" options:Freeze="True"/>

    <!-- ═══ FIXED: Content Type Badge Backgrounds ═══ -->
    <SolidColorBrush x:Key="BadgeCodeBg"       Color="#1A10B981" options:Freeze="True"/>
    <SolidColorBrush x:Key="BadgePdfBg"        Color="#1AEF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="BadgeImageBg"      Color="#1AF472B6" options:Freeze="True"/>
    <SolidColorBrush x:Key="BadgeUrlBg"        Color="#1A0EA5E9" options:Freeze="True"/>
    <SolidColorBrush x:Key="BadgeGroupBg"      Color="#1AA78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="BadgeArchiveBg"    Color="#1AF59E0B" options:Freeze="True"/>

    <!-- ═══ FIXED: Semantic Action Colors ═══ -->
    <SolidColorBrush x:Key="DangerColor"       Color="#EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBgSubtle"    Color="#20EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBgHover"     Color="#30EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBorder"      Color="#50EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessColor"      Color="#22C55E" options:Freeze="True"/>
    <SolidColorBrush x:Key="WarningColor"      Color="#F59E0B" options:Freeze="True"/>
    <SolidColorBrush x:Key="InfoColor"         Color="#3B82F6" options:Freeze="True"/>

    <!-- ═══ FIXED: Pin / Delete / Common ═══ -->
    <SolidColorBrush x:Key="PinActiveColor"    Color="#F59E0B" options:Freeze="True"/>
    <SolidColorBrush x:Key="PinInactiveColor"  Color="#9CA3AF" options:Freeze="True"/>
    <SolidColorBrush x:Key="SubtleTextColor"   Color="#9CA3AF" options:Freeze="True"/>
    <SolidColorBrush x:Key="SeparatorDotColor" Color="#4B5563" options:Freeze="True"/>

    <!-- ═══ FIXED: Sync Direction Colors ═══ -->
    <SolidColorBrush x:Key="SyncIncomingColor"  Color="#10B981" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncIncomingBg"     Color="#1810B981" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncIncomingBorder" Color="#3010B981" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncOutgoingColor"  Color="#3B82F6" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncOutgoingBg"     Color="#183B82F6" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncOutgoingBorder" Color="#303B82F6" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncBothColor"      Color="#8B5CF6" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncBothBg"         Color="#188B5CF6" options:Freeze="True"/>
    <SolidColorBrush x:Key="SyncBothBorder"     Color="#308B5CF6" options:Freeze="True"/>

    <!-- ═══ FIXED: Device / Source Colors ═══ -->
    <SolidColorBrush x:Key="DeviceLaptopColor"  Color="#60A5FA" options:Freeze="True"/>
    <SolidColorBrush x:Key="DeviceMobileColor"  Color="#A78BFA" options:Freeze="True"/>
    <SolidColorBrush x:Key="SourceCloudColor"   Color="#F59E0B" options:Freeze="True"/>
    <SolidColorBrush x:Key="SourceCfColor"      Color="#10B981" options:Freeze="True"/>
    <SolidColorBrush x:Key="SourceLanColor"     Color="#6366F1" options:Freeze="True"/>
    <SolidColorBrush x:Key="SourceDirectColor"  Color="#EF4444" options:Freeze="True"/>
    <SolidColorBrush x:Key="SourceLocalColor"   Color="#9CA3AF" options:Freeze="True"/>

    <!-- ═══ FIXED: Context Menu Action Colors ═══ -->
    <SolidColorBrush x:Key="MenuOcrColor"      Color="#A855F7" options:Freeze="True"/>
    <SolidColorBrush x:Key="MenuConvertColor"  Color="#F59E0B" options:Freeze="True"/>
    <SolidColorBrush x:Key="MenuUrlActionColor" Color="#0EA5E9" options:Freeze="True"/>
    <SolidColorBrush x:Key="MenuCodeActionColor" Color="#10B981" options:Freeze="True"/>

    <!-- ═══ FIXED: Overflow Popup Button Colors ═══ -->
    <SolidColorBrush x:Key="EmojiButtonBg"     Color="#22EAB308" options:Freeze="True"/>
    <SolidColorBrush x:Key="EmojiButtonBorder" Color="#35EAB308" options:Freeze="True"/>

    <!-- ═══ FIXED: Misc Icon Colors ═══ -->
    <SolidColorBrush x:Key="DragIndicatorColor" Color="#10B981" options:Freeze="True"/>
    <SolidColorBrush x:Key="GeminiAccentColor"  Color="#A855F7" options:Freeze="True"/>
    <SolidColorBrush x:Key="CyanAccentColor"    Color="#06B6D4" options:Freeze="True"/>
    <SolidColorBrush x:Key="SanitizeColor"      Color="#0EA5E9" options:Freeze="True"/>
    <SolidColorBrush x:Key="CodeTextColor"      Color="#6EE7B7" options:Freeze="True"/>

</ResourceDictionary>
