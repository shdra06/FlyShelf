<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Premium Apple-style Thumb Template -->
    <Style x:Key="AppleSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <!-- Thumb Outer Border with Dropshadow -->
                        <Border x:Name="ThumbBorder" Width="16" Height="16" CornerRadius="8"
                                Background="#FFFFFF" BorderBrush="#C5C7CD" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Color="#000000" Opacity="0.22" ShadowDepth="1" Direction="270"/>
                            </Border.Effect>
                        </Border>
                        <!-- Subtle inner ring for silver gradient feel -->
                        <Border Width="12" Height="12" CornerRadius="6" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#F4F5F7" />
                            <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#A0A2AA" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#EBECEF" />
                            <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#787C87" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal Slider ControlTemplate -->
    <ControlTemplate x:Key="AppleHorizontalSlider" TargetType="{x:Type Slider}">
        <Grid Margin="0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Background Track (unfilled part) -->
            <Border x:Name="TrackBackground" Grid.Row="1" Height="4"
                    Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}"
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}"
                    BorderThickness="1" CornerRadius="2" VerticalAlignment="Center" />

            <Track x:Name="PART_Track" Grid.Row="1">
                <!-- Filled Part (Decrease button) -->
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge">
                        <RepeatButton.Style>
                            <Style TargetType="{x:Type RepeatButton}">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <!-- Nice active accent colored track -->
                                            <Border CornerRadius="2" Height="4" Background="{DynamicResource MicaWPF.Brushes.SystemAccentColor}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RepeatButton.Style>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>

                <!-- Thumb -->
                <Track.Thumb>
                    <Thumb Style="{StaticResource AppleSliderThumbStyle}" VerticalAlignment="Center" />
                </Track.Thumb>

                <!-- Unfilled Part (Increase button) -->
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge">
                        <RepeatButton.Style>
                            <Style TargetType="{x:Type RepeatButton}">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border CornerRadius="2" Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RepeatButton.Style>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource MicaWPF.Brushes.ControlFillColorSecondary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Global Slider Style targeting both Horizontal and Vertical (fallback) -->
    <Style TargetType="{x:Type Slider}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinHeight" Value="20" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource AppleHorizontalSlider}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>