<Window x:Class="FlyShelf.Windows.AiSetupPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Setup AI"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Card style for provider selection -->
        <Style x:Key="ProviderCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#0F1D32"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="136"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="4,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162640"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Base button style -->
        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text input style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1D32"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="CaretBrush" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close X button style -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBg" Background="Transparent" CornerRadius="8">
                            <TextBlock Text="✕" FontSize="14" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBg" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink-style button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="linkText" Text="{TemplateBinding Content}"
                                   Foreground="#8B5CF6" FontSize="11.5" Padding="0"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="linkText" Property="Foreground" Value="#A78BFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow layer -->
    <Border Background="Transparent" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <!-- Main card -->
        <Border x:Name="MainCard" CornerRadius="16" Background="#0D1B2A"
                BorderBrush="#1E293B" BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="28,24,28,20">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="⚡ Setup AI" FontSize="20" FontWeight="Bold"
                                       Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource CloseButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Click="CloseButton_Click" AutomationProperties.Name="Close AI setup"/>
                        </Grid>

                        <!-- Subtitle -->
                        <TextBlock Text="Connect your AI provider to unlock smart features"
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,18"/>

                        <!-- Provider cards row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <!-- Gemini -->
                            <Border x:Name="geminiCard" Style="{StaticResource ProviderCardBorder}"
                                    MouseLeftButtonDown="GeminiCard_Click" Tag="gemini"
                                    AutomationProperties.Name="Select Gemini AI provider">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="💎" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Gemini" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock Text="15 req/min free" FontSize="10" Foreground="#64748B"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- OpenAI -->
                            <Border x:Name="openaiCard" Style="{StaticResource ProviderCardBorder}"
                                    MouseLeftButtonDown="OpenAICard_Click" Tag="openai"
                                    AutomationProperties.Name="Select OpenAI provider">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🤖" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="OpenAI" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock Text="Pay-per-use" FontSize="10" Foreground="#64748B"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Claude -->
                            <Border x:Name="claudeCard" Style="{StaticResource ProviderCardBorder}"
                                    MouseLeftButtonDown="ClaudeCard_Click" Tag="claude"
                                    AutomationProperties.Name="Select Claude AI provider">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🧠" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Claude" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock Text="Pay-per-use" FontSize="10" Foreground="#64748B"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- API Key input area -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- API Key TextBox (shown text) -->
                            <TextBox x:Name="apiKeyBox" Grid.Column="0"
                                     Style="{StaticResource DarkTextBox}"
                                     FontFamily="Consolas"
                                     Visibility="Collapsed"
                                     AutomationProperties.Name="API key">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12,0,0,12"
                                                Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <!-- API Key masked (PasswordBox-style) -->
                            <TextBox x:Name="apiKeyMaskedBox" Grid.Column="0"
                                     Style="{StaticResource DarkTextBox}"
                                     FontFamily="Consolas"
                                     TextChanged="ApiKeyMaskedBox_TextChanged"
                                     AutomationProperties.Name="API key (masked)">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12,0,0,12"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Placeholder"
                                                           Text="Paste your API key here..."
                                                           Foreground="#475569" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="Visible"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="0">
                                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <!-- Eye toggle button -->
                            <Button x:Name="toggleVisibilityBtn" Grid.Column="1"
                                    Content="👁" FontSize="14"
                                    Width="42" Background="#0F1D32"
                                    Click="ToggleVisibility_Click"
                                    ToolTip="Show/hide API key"
                                    AutomationProperties.Name="Toggle API key visibility">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="eyeBorder" Background="#0F1D32"
                                                BorderBrush="#1E293B" BorderThickness="1.5,1.5,1.5,1.5"
                                                CornerRadius="0,12,12,0" Cursor="Hand">
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="eyeBorder" Property="Background" Value="#162640"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Get free key link -->
                        <Button x:Name="getFreeKeyLink" Style="{StaticResource LinkButton}"
                                Content="Get free key →" HorizontalAlignment="Left"
                                Margin="2,2,0,14" Click="GetFreeKey_Click" AutomationProperties.Name="Get free API key"/>

                        <!-- Advanced toggle -->
                        <Button x:Name="advancedToggle" Style="{StaticResource LinkButton}"
                                Content="Advanced ▾" HorizontalAlignment="Left"
                                Margin="2,0,0,6" Click="AdvancedToggle_Click" AutomationProperties.Name="Toggle advanced settings"/>

                        <!-- Model override (collapsed by default) -->
                        <TextBox x:Name="modelOverrideBox"
                                 Style="{StaticResource DarkTextBox}"
                                 Visibility="Collapsed" Margin="0,0,0,14"
                                 AutomationProperties.Name="Model override">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ModelPlaceholder"
                                                       Text="Model override (optional)"
                                                       Foreground="#475569" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="0">
                                            <Setter TargetName="ModelPlaceholder" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <!-- Test Connection button -->
                        <Button x:Name="testConnectionBtn" Style="{StaticResource PopupButton}"
                                Background="#10B981" Margin="0,0,0,10"
                                Click="TestConnection_Click"
                                AutomationProperties.Name="Test AI connection">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="testBtnIcon" Text="🔌 " FontSize="13"/>
                                <TextBlock x:Name="testBtnText" Text="Test Connection" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Test result text -->
                        <TextBlock x:Name="testResultText" FontSize="12" Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <!-- Save button -->
                        <Button x:Name="saveBtn" Style="{StaticResource PopupButton}"
                                Margin="0,0,0,14" Click="SaveButton_Click"
                                AutomationProperties.Name="Save and activate AI">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="Save &amp; Activate" FontSize="14" FontWeight="SemiBold"/>
                        </Button>

                        <!-- Privacy note -->
                        <TextBlock Text="🔒 Your key is encrypted locally and never leaves your device"
                                   FontSize="10" Foreground="#475569" HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</Window>
