<controls:MicaWindow x:Class="FlyShelf.Windows.PdfMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PDF Merge" Height="580" Width="720"
        WindowStartupLocation="CenterScreen"
        SystemBackdropType="Mica" Background="Transparent">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid Margin="24,8,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header: Title + Summary ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,16" WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border CornerRadius="12" Width="40" Height="40" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#DC2626" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Merge Files" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                    <TextBlock Text="Combine, reorder &amp; select pages" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>

            <!-- Summary pill -->
            <Border Grid.Column="2" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0AEF4444" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock x:Name="SummaryText" Text="" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
            </Border>
        </Grid>

        <!-- ═══ Output Filename ═══ -->
        <Border Grid.Row="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,12"
                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Save as" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                <TextBox x:Name="OutputFileName" Grid.Column="1" FontSize="12.5" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" Padding="4,2"
                         Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                         CaretBrush="{DynamicResource MicaWPF.Brushes.SystemAccentColor}"/>
                <TextBlock Grid.Column="2" Text=".pdf" FontSize="12" VerticalAlignment="Center" Margin="2,0,4,0" Opacity="0.3"
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
            </Grid>
        </Border>

        <!-- ═══ PDF List ═══ -->
        <Border Grid.Row="2" CornerRadius="12" Padding="6"
                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                    <TextBlock Text="Drop PDFs here or click Add Files" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <ListBox x:Name="PdfItemsList" Background="Transparent" BorderThickness="0" Margin="2"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" AllowDrop="True"
                         PreviewMouseLeftButtonDown="PdfList_PreviewMouseDown"
                         PreviewMouseMove="PdfList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="PdfList_PreviewMouseUp"
                         Drop="PdfList_Drop" DragOver="PdfList_DragOver" DragLeave="PdfList_DragLeave">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="10" Padding="0">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#15FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <!-- Move arrows -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- PDF icon + badge -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- File info -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Actions -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Move up/down mini column -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Border Background="Transparent" Cursor="Hand" ToolTip="Move up"
                                            MouseLeftButtonDown="MoveUp_Click" Tag="{Binding}"
                                            Padding="3,2" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon Symbol="ChevronUp24" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                    </Border>
                                    <Border Background="Transparent" Cursor="Hand" ToolTip="Move down"
                                            MouseLeftButtonDown="MoveDown_Click" Tag="{Binding}"
                                            Padding="3,2" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                    </Border>
                                </StackPanel>

                                <!-- PDF Icon with page count badge -->
                                <Grid Grid.Column="1" Width="38" Height="38" Margin="0,0,12,0">
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#15EF4444" Offset="0"/>
                                                <GradientStop Color="#08EF4444" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="{DynamicResource DangerColor}" FontSize="17" />
                                    </Border>
                                    <!-- Page count badge -->
                                    <Border CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                            Margin="0,0,-2,-2" Padding="4,1" MinWidth="17">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                <GradientStop Color="#3B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding TotalPages}" FontSize="9" FontWeight="Bold" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- File Info -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium" 
                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding FileSize}" FontSize="10.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Opacity="0.4" VerticalAlignment="Center" Margin="7,0"/>
                                        <TextBlock Text="{Binding PageInfo}" FontSize="10.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions: compact inline -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Page range input -->
                                    <Border CornerRadius="8" Margin="0,0,4,0" Padding="0" VerticalAlignment="Center"
                                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"
                                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock x:Name="RangePlaceholder" Text="e.g. 1-5, 8" FontSize="10.5" Padding="8,4"
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Opacity="0.5"
                                                       IsHitTestVisible="False" VerticalAlignment="Center"/>
                                            <TextBox Tag="{Binding}" FontSize="10.5" MinWidth="80" MaxWidth="100" Padding="7,4"
                                                     ToolTip="Page range (e.g. 1-5, 8). Leave empty for all."
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                                                     CaretBrush="{DynamicResource MicaWPF.Brushes.SystemAccentColor}"
                                                     KeyDown="RangeInput_KeyDown"
                                                     LostFocus="RangeInput_LostFocus"
                                                     TextChanged="RangeInput_TextChanged"
                                                     Loaded="RangeInput_Loaded"/>
                                        </Grid>
                                    </Border>

                                    <!-- Reorder Pages -->
                                    <ui:Button Appearance="Transparent" Tag="{Binding}" Click="ReorderPages_Click" 
                                               ToolTip="Visual page reorder" Padding="5,4" Margin="0,0,2,0"
                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>

                                    <!-- Save single -->
                                    <ui:Button Appearance="Transparent" Tag="{Binding}" Click="SaveSinglePdf_Click" 
                                               ToolTip="Save selected pages" Foreground="{DynamicResource SuccessColor}" Padding="5,4" Margin="0,0,2,0">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>

                                    <!-- Delete -->
                                    <ui:Button Appearance="Transparent" Tag="{Binding}" Click="Remove_Click" 
                                               ToolTip="Remove from list" Foreground="{DynamicResource DangerColor}" Padding="5,4">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ═══ Bottom Action Bar ═══ -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Add + Reverse -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="AddFilesBtn" Appearance="Secondary" Padding="12,7" Click="AddPdf_Click" FontSize="12" CornerRadius="8" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Add Files" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Transparent" Padding="10,7" Click="ReverseAll_Click" ToolTip="Reverse file order" FontSize="12" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSort24" FontSize="13" Margin="0,0,5,0"/>
                        <TextBlock Text="Reverse" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <!-- Right: Cancel + Save As + Merge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Cancel" Appearance="Transparent" Margin="0,0,6,0" Padding="14,7" Click="Cancel_Click" FontSize="12" CornerRadius="8"/>
                <ui:Button x:Name="SaveAsBtn" Appearance="Secondary" Margin="0,0,6,0" Padding="12,7" Click="SaveAs_Click" FontSize="12" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Save As" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="MergeBtn" Appearance="Primary" Padding="16,7" Click="Merge_Click" FontSize="12" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Merge Files" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</controls:MicaWindow>
