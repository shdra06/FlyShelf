<controls:MicaWindow x:Class="FlyShelf.Windows.PdfMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PDF Merge" Height="550" Width="700"
        WindowStartupLocation="CenterScreen"
        SystemBackdropType="Mica" Background="Transparent">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid Margin="20,8,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header Row: Title + Compact Summary Badge ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,14" WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border CornerRadius="10" Background="#18EF4444" Width="36" Height="36" Margin="0,0,10,0">
                    <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="#EF4444" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Merge Files" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                    <TextBlock Text="Drag to reorder • Range for page selection" FontSize="11" Opacity="0.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Compact summary pill (right-aligned) -->
            <Border Grid.Column="2" CornerRadius="14" Background="#14FFFFFF" Padding="12,5" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Text="" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
            </Border>
        </Grid>

        <!-- ═══ Output Filename (compact inline) ═══ -->
        <Border Grid.Row="1" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Save as:" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                <TextBox x:Name="OutputFileName" Grid.Column="1" FontSize="12" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" Padding="6,3"
                         Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                <TextBlock Grid.Column="2" Text=".pdf" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.35"
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
            </Grid>
        </Border>

        <!-- ═══ PDF List ═══ -->
        <Border Grid.Row="3" Background="#06FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="4">
            <ListBox x:Name="PdfItemsList" Background="Transparent" BorderThickness="0" Margin="4"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AllowDrop="True"
                     PreviewMouseLeftButtonDown="PdfList_PreviewMouseDown"
                     PreviewMouseMove="PdfList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="PdfList_PreviewMouseUp"
                     Drop="PdfList_Drop" DragOver="PdfList_DragOver" DragLeave="PdfList_DragLeave">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="10" Padding="10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- PDF Icon with page count badge -->
                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                                <Border CornerRadius="8" Background="#10EF4444">
                                    <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="#EF4444" FontSize="18" />
                                </Border>
                                <!-- Page count badge -->
                                <Border CornerRadius="8" Background="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                        Margin="0,0,-3,-3" Padding="4,1" MinWidth="18">
                                    <TextBlock Text="{Binding TotalPages}" FontSize="9" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- File Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium" 
                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding FileSize}" FontSize="10.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                    <TextBlock Text="  •  " Opacity="0.35" FontSize="10.5"/>
                                    <TextBlock Text="{Binding PageInfo}" FontSize="10.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions Row: compact inline controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Reorder Pages -->
                                <Border CornerRadius="8" Background="#0AFFFFFF" Margin="0,0,3,0">
                                    <ui:Button Appearance="Transparent" Tag="{Binding}" Click="ReorderPages_Click" 
                                               ToolTip="Visual page reorder" Padding="6,3" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowSort24" FontSize="13" Margin="0,0,3,0"/>
                                            <TextBlock Text="Reorder" FontSize="11"/>
                                        </StackPanel>
                                    </ui:Button>
                                </Border>

                                <!-- Page range input -->
                                <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#15FFFFFF" 
                                        BorderThickness="1" Margin="0,0,3,0" Padding="0" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="RangePlaceholder" Text="e.g. 1-5, 8" FontSize="10.5" Padding="7,4"
                                                   Foreground="#30FFFFFF" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        <TextBox Tag="{Binding}" FontSize="10.5" MinWidth="80" MaxWidth="100" Padding="6,3"
                                                 ToolTip="Page range (e.g. 1-5, 8). Leave empty for all."
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"
                                                 KeyDown="RangeInput_KeyDown"
                                                 LostFocus="RangeInput_LostFocus"
                                                 TextChanged="RangeInput_TextChanged"
                                                 Loaded="RangeInput_Loaded"/>
                                    </Grid>
                                </Border>

                                <!-- Save single -->
                                <Border CornerRadius="8" Margin="0,0,2,0">
                                    <ui:Button Appearance="Transparent" Tag="{Binding}" Click="SaveSinglePdf_Click" 
                                               ToolTip="Save with selected pages" Foreground="#22C55E" Padding="5,3">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- Delete -->
                                <Border CornerRadius="8" Margin="0,0,4,0">
                                    <ui:Button Appearance="Transparent" Tag="{Binding}" Click="Remove_Click" 
                                               ToolTip="Remove" Foreground="#EF4444" Padding="5,3">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" FontSize="14"/></ui:Button.Icon>
                                    </ui:Button>
                                </Border>

                                <!-- Drag grip -->
                                <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder" Padding="4,6" VerticalAlignment="Center">
                                    <StackPanel Opacity="0.3">
                                        <Border Height="2" Width="14" Background="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" CornerRadius="1" Margin="0,0,0,2"/>
                                        <Border Height="2" Width="14" Background="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" CornerRadius="1" Margin="0,0,0,2"/>
                                        <Border Height="2" Width="14" Background="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" CornerRadius="1"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ═══ Bottom Action Bar — rounded pill bar ═══ -->
        <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="14" Background="#0AFFFFFF" Padding="6,5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ui:Button x:Name="AddFilesBtn" Content="Add Files" Appearance="Transparent" Padding="10,6" Click="AddPdf_Click" FontSize="12">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" FontSize="14"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="Reverse All" Appearance="Transparent" Padding="10,6" Click="ReverseAll_Click" ToolTip="Reverse order" FontSize="12">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSort24" FontSize="14"/></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,6,0" Padding="14,6" Click="Cancel_Click" FontSize="12"/>
                    <ui:Button x:Name="SaveAsBtn" Content="Save As" Appearance="Secondary" Margin="0,0,6,0" Padding="12,6" Click="SaveAs_Click" FontSize="12">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" FontSize="14"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="MergeBtn" Content="Merge Files" Appearance="Primary" Padding="16,6" Click="Merge_Click" FontSize="12">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentCopy24" FontSize="14"/></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:MicaWindow>
