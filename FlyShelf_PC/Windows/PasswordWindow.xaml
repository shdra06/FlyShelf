<controls:MicaWindow x:Class="FlyShelf.Windows.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Security Lock Manager" Height="340" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        SystemBackdropType="Mica" Topmost="True"
        Background="Transparent" ResizeMode="NoResize"
        AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Title bar -->
        <Border Height="40" VerticalAlignment="Top" Background="Transparent" 
                MouseLeftButtonDown="TitleBar_MouseDown" Panel.ZIndex="10">
            <Grid>
                <TextBlock Text="🔑  Security Lock Manager" FontSize="12.5" FontWeight="SemiBold" Opacity="0.75" 
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="10,6" 
                        Background="Transparent" BorderBrush="Transparent" 
                        Click="Close_Click" Cursor="Hand" ToolTip="Close Manager"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="✕" FontSize="13" Opacity="0.5" 
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <StackPanel Margin="24,44,24,20" VerticalAlignment="Stretch">
            <!-- Sleek Icon & Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EAB308" Offset="0"/>
                            <GradientStop Color="#CA8A04" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="LockClosed24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Safe Lock Manager" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                    <TextBlock Text="Password/API Key details are kept strictly local" FontSize="10.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>

            <!-- Card Label Input -->
            <TextBlock Text="Display Name (Label)" FontSize="11" FontWeight="Medium" Margin="2,0,0,5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
            <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,12"
                    Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                <TextBox x:Name="LabelInput" FontSize="12.5" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                         CaretBrush="{DynamicResource MicaWPF.Brushes.SystemAccentColor}"/>
            </Border>

            <!-- Actual Password Input with Show/Hide and Copy -->
            <TextBlock Text="Password / Secret Key" FontSize="11" FontWeight="Medium" Margin="2,0,0,5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
            <Border CornerRadius="8" Padding="8,4" Margin="0,0,0,20"
                    Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- PasswordBox (Masked) -->
                    <PasswordBox x:Name="PasswordMaskedBox" Grid.Column="0" FontSize="12.5" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Padding="4,2"
                                 Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                                 CaretBrush="{DynamicResource MicaWPF.Brushes.SystemAccentColor}"/>
                    
                    <!-- TextBox (Revealed) -->
                    <TextBox x:Name="PasswordPlainTextBox" Grid.Column="0" FontSize="12.5" VerticalContentAlignment="Center"
                             Background="Transparent" BorderThickness="0" Padding="4,2" Visibility="Collapsed"
                             Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                             CaretBrush="{DynamicResource MicaWPF.Brushes.SystemAccentColor}"/>
                    
                    <!-- Eye Toggle Button -->
                    <Button Grid.Column="1" Click="TogglePasswordVisibility_Click" Background="Transparent" BorderBrush="Transparent" Padding="6,2" Cursor="Hand" Margin="2,0">
                        <ui:SymbolIcon x:Name="EyeIcon" Symbol="Eye24" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                    </Button>
                    
                    <!-- Copy Button -->
                    <Button Grid.Column="2" Click="CopyPassword_Click" Background="Transparent" BorderBrush="Transparent" Padding="6,2" Cursor="Hand">
                        <ui:SymbolIcon x:Name="CopyIcon" Symbol="Copy24" FontSize="14" Foreground="#10B981"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Bottom Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Click="Cancel_Click" Appearance="Transparent" Width="80" Height="32" CornerRadius="8" Margin="0,0,8,0"/>
                <ui:Button Content="Apply" Click="Apply_Click" Appearance="Primary" Width="90" Height="32" CornerRadius="8">
                    <ui:Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EAB308" Offset="0"/>
                            <GradientStop Color="#CA8A04" Offset="1"/>
                        </LinearGradientBrush>
                    </ui:Button.Background>
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</controls:MicaWindow>
