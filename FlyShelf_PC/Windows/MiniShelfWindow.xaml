<controls:MicaWindow x:Class="FlyShelf.Windows.MiniShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FlyShelf.ViewModels"
        xmlns:settings="clr-namespace:FlyShelf.Classes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:local="clr-namespace:FlyShelf.Controls"
        Title="MiniShelf"
        Width="360"
        Opacity="0"
        MaxHeight="500" SizeToContent="Height" MinHeight="60"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" SystemBackdropType="Mica"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        AllowDrop="True"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <controls:MicaWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <Style x:Key="PremiumHeaderButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Background" Value="#14FFFFFF"/>
                <Setter Property="BorderBrush" Value="#18FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#CCFFFFFF"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Focusable" Value="False"/>
                <Style.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#35FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F0FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0CFFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#25FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#BBFFFFFF"/>
                </Style.Resources>
            </Style>
        </ResourceDictionary>
    </controls:MicaWindow.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CornerRadius="14" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14" ClipToBounds="True">
        <Grid x:Name="RootContent" Background="#01000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ WALLPAPER LAYER ═══ -->
            <Image x:Name="WallpaperBg" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.55"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ═══ HEADER ═══ -->
            <Grid Grid.Row="0" Margin="14,12,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Spacer (left side is empty for minimal look) -->
                <Border Grid.Column="0" Background="Transparent"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Open Hub / Expand button -->
                    <ui:Button Style="{StaticResource PremiumHeaderButtonStyle}" Click="OpenHub_Click" ToolTip="Expand to Full Clipboard" Margin="0,0,6,0">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowMaximize24"/></ui:Button.Icon>
                    </ui:Button>

                    <!-- Dismiss button -->
                    <ui:Button Style="{StaticResource PremiumHeaderButtonStyle}" Click="CloseWindow_Click" ToolTip="Dismiss">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" Filled="True"/></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- ═══ CLIPBOARD LIST ═══ -->
            <ListView Name="ShelfListView" Grid.Row="1" ItemsSource="{Binding DroppedItems}"
                      Background="#01000000" BorderThickness="0" Margin="12,0,2,12" Padding="0,0,0,40"
                      Focusable="True" KeyboardNavigation.DirectionalNavigation="Contained"
                      UseLayoutRounding="True" SnapsToDevicePixels="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      SelectionMode="Single"
                      PreviewMouseLeftButtonUp="ShelfListView_PreviewMouseLeftButtonUp"
                      MouseDoubleClick="ShelfListView_MouseDoubleClick">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Name="CardBorder" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" 
                                BorderThickness="1,0.5,1,1" CornerRadius="14" Padding="0" ClipToBounds="True">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource MicaWPF.Colors.SubtleFillColorSecondary}" Opacity="0.25"/>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="-2" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform Y="0"/>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            
                            <Border Padding="12" BorderThickness="1" CornerRadius="14">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{DynamicResource MicaWPF.Colors.ControlStrokeColorDefault}" Offset="0.0"/>
                                        <GradientStop Color="Transparent" Offset="0.08"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="8" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
                                    </Border>
                                    
                                    <!-- Semantic Icon Fallback -->
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" 
                                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                            CornerRadius="10" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                            <Condition Binding="{Binding HasDetectedColor}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon FontSize="20" Filled="True">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="ClipboardText24"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Image"><Setter Property="Symbol" Value="Image24"/><Setter Property="Foreground" Value="#F472B6"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Pdf"><Setter Property="Symbol" Value="DocumentPdf24"/><Setter Property="Foreground" Value="#EF4444"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Document"><Setter Property="Symbol" Value="Document24"/><Setter Property="Foreground" Value="#60A5FA"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Code"><Setter Property="Symbol" Value="Code24"/><Setter Property="Foreground" Value="#10B981"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Url"><Setter Property="Symbol" Value="Globe24"/><Setter Property="Foreground" Value="#0EA5E9"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Folder"><Setter Property="Symbol" Value="Folder24"/><Setter Property="Foreground" Value="#FBBF24"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Archive"><Setter Property="Symbol" Value="FolderZip24"/><Setter Property="Foreground" Value="#06B6D4"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Video"><Setter Property="Symbol" Value="Video24"/><Setter Property="Foreground" Value="#A78BFA"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="Audio"><Setter Property="Symbol" Value="MusicNote224"/><Setter Property="Foreground" Value="#F59E0B"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemType}" Value="QRCode"><Setter Property="Symbol" Value="QrCode24"/><Setter Property="Foreground" Value="#8B5CF6"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Border>
                                    
                                    <!-- Color Swatch (for detected colors) -->
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="8"
                                            Background="{Binding DetectedColorBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasDetectedColor}" Value="True"/>
                                                            <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    
                                    <!-- Text Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <!-- Pin indicator -->
                                    <ui:SymbolIcon Grid.Column="2" Symbol="Pin24" Filled="True" Foreground="#F59E0B" FontSize="14"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</controls:MicaWindow>
