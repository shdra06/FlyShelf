<controls:MicaWindow x:Class="FlyShelf.Windows.NotesAIWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI Notes Assistant" Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        SystemBackdropType="Mica"
        Background="Transparent" ResizeMode="NoResize"
        AllowsTransparency="False"
        Icon="/Resources/FlyShelfLogo.ico"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Title bar -->
        <Border Height="40" VerticalAlignment="Top" Background="Transparent" 
                MouseLeftButtonDown="TitleBar_MouseDown" Panel.ZIndex="10">
            <Grid>
                <TextBlock Text="AI Notes Assistant" FontSize="12.5" FontWeight="SemiBold" Opacity="0.85" 
                            VerticalAlignment="Center" Margin="16,0,0,0"
                            Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="10,6" 
                        Background="Transparent" BorderBrush="Transparent" 
                        Click="Close_Click" Cursor="Hand" ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close AI assistant">
                    <TextBlock Text="✕" FontSize="13" Opacity="0.5" 
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Grid Container -->
        <Grid Margin="20,44,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Header & Model info -->
                <RowDefinition Height="*"/>      <!-- Content / Loading area -->
                <RowDefinition Height="Auto"/>   <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border CornerRadius="12" Width="36" Height="36" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B5CF6" Offset="0"/>
                            <GradientStop Color="#6D28D9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="Sparkle24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="AI Suggestion" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                    <TextBlock x:Name="SubtitleText" Text="Powered by AI" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>

            <!-- Loading View -->
            <Grid x:Name="LoadingView" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="LoadingText" Text="Thinking..." FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#8B5CF6" Background="#20FFFFFF" BorderThickness="0"/>
                </StackPanel>
            </Grid>

            <!-- Result View -->
            <Grid x:Name="ResultView" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" CornerRadius="8" Padding="10,6"
                        Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                        BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                    <TextBox x:Name="ResultTextBox" FontSize="13" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"
                             CaretBrush="{DynamicResource MicaWPF.Brushes.SystemAccentColor}"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             AcceptsTab="True" AutomationProperties.Name="AI suggestion result"/>
                </Border>
                
                <!-- Quick stats / Info -->
                <TextBlock Grid.Row="1" Text="Feel free to edit the text above before applying it." FontSize="10.5" 
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="2,6,0,0"/>
            </Grid>

            <!-- Bottom Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Copy output button (Left aligned) -->
                <ui:Button x:Name="CopyBtn" Grid.Column="0" Content="Copy Result" Click="Copy_Click" 
                           Appearance="Secondary" Width="120" Height="32" CornerRadius="8" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Copy AI result"/>

                <!-- Action buttons (Right aligned) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Cancel" Click="Cancel_Click" Appearance="Transparent" Width="80" Height="32" CornerRadius="8" Margin="0,0,8,0" AutomationProperties.Name="Cancel"/>
                    <ui:Button x:Name="ApplyBtn" Content="Apply" Click="Apply_Click" Appearance="Primary" Width="90" Height="32" CornerRadius="8" IsEnabled="False" AutomationProperties.Name="Apply AI suggestion">
                        <ui:Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="#6D28D9" Offset="1"/>
                            </LinearGradientBrush>
                        </ui:Button.Background>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</controls:MicaWindow>
