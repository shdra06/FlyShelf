<mica:MicaWindow x:Class="FlyShelf.Windows.TableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Table Extractor" Height="700" Width="1200" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        SystemBackdropType="Mica" Background="Transparent"
        KeyDown="Window_KeyDown">
    <Grid TextElement.Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}">
        <!-- Main layout: Header + Content + Footer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER AREA ═══ -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Table Extractor" FontSize="24" FontWeight="SemiBold" 
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                <TextBlock x:Name="SubtitleText" 
                           Text="Extracted table data. Edit cells, then export in your preferred format." 
                           FontSize="13" Opacity="0.7" 
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <!-- Extraction method badge -->
            <Border x:Name="MethodBadge" Grid.Column="1" CornerRadius="12" Padding="12,6" 
                    VerticalAlignment="Center" Background="#1A8B5CF6" Visibility="Collapsed">
                <TextBlock x:Name="MethodBadgeText" FontSize="11" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TypeGroupColor}"/>
            </Border>
        </Grid>

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="1" Margin="24,16,24,0" Padding="8,6" CornerRadius="8" 
                Background="{DynamicResource ThemeOverlayBgPressed}" BorderBrush="{DynamicResource ThemeOverlayBorder}" BorderThickness="1">
            <Border.Resources>
                <!-- Premium Glass Button Style for Toolbar Buttons -->
                <Style TargetType="{x:Type ui:Button}">
                    <Setter Property="Background" Value="#12FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ui:Button}">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Icon -->
                                        <ContentControl x:Name="IconHost"
                                                        Content="{TemplateBinding Icon}"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        Focusable="False"
                                                        IsTabStop="False"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,4,0"/>
                                        <!-- Content -->
                                        <ContentPresenter x:Name="ContentHost"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Icon" Value="{x:Null}">
                                        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="HasContent" Value="False">
                                        <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="IconHost" Property="Margin" Value="0"/>
                                    </Trigger>
                                    <!-- Hover -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#22FFFFFF"/>
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#35FFFFFF"/>
                                    </Trigger>
                                    <!-- Pressed -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#0EFFFFFF"/>
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#15FFFFFF"/>
                                    </Trigger>
                                    <!-- Disabled -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                    
                                    <!-- Appearance Variants -->
                                    <!-- Primary (e.g. Word Table) -->
                                    <Trigger Property="Appearance" Value="Primary">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#253B82F6"/>
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#503B82F6"/>
                                        <Setter Property="Foreground" Value="#E0F2FE"/>
                                    </Trigger>
                                    <!-- Hover Primary -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Appearance" Value="Primary"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#403B82F6"/>
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#703B82F6"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Export Group -->
                    <TextBlock Text="EXPORT" FontSize="10" FontWeight="Bold" Opacity="0.4" 
                               VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <ui:Button Content="Word Table" Appearance="Primary" Padding="12,6" FontSize="12"
                               Click="ExportHtml_Click" Margin="0,2,4,2" ToolTip="Copy as rich HTML table for Word/Excel (Ctrl+Shift+W)">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Table24" FontSize="14"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="CSV" Appearance="Secondary" Padding="12,6" FontSize="12"
                               Click="ExportCsv_Click" Margin="0,2,4,2" ToolTip="Copy as comma-separated values"/>
                    <ui:Button Content="TSV" Appearance="Transparent" Padding="10,6" FontSize="12"
                               Click="ExportTsv_Click" Margin="0,2,4,2" ToolTip="Copy as tab-separated values"/>
                    <ui:Button Content="Markdown" Appearance="Transparent" Padding="10,6" FontSize="12"
                               Click="ExportMarkdown_Click" Margin="0,2,4,2" ToolTip="Copy as markdown table"/>
                    <ui:Button Content="💾 Save" Appearance="Transparent" Padding="10,6" FontSize="12"
                               Click="SaveToFile_Click" Margin="0,2,8,2" ToolTip="Save to file (Ctrl+S)"/>

                    <Border Width="1" Height="20" Background="{DynamicResource ThemeOverlayBorder}" Margin="4,0,8,0"/>

                    <!-- Edit Group -->
                    <TextBlock Text="EDIT" FontSize="10" FontWeight="Bold" Opacity="0.4" 
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ui:Button Content="+ Row" Appearance="Transparent" Padding="8,5" FontSize="11"
                               Click="AddRow_Click" Margin="0,2,2,2" ToolTip="Add row at end"/>
                    <ui:Button Content="+ Col" Appearance="Transparent" Padding="8,5" FontSize="11"
                               Click="AddCol_Click" Margin="0,2,2,2" ToolTip="Add column at end"/>
                    <ui:Button x:Name="InsertRowAboveBtn" Content="↑ Insert Row" Appearance="Transparent" 
                               Padding="8,5" FontSize="11" Click="InsertRowAbove_Click" 
                               Margin="0,2,2,2" ToolTip="Insert row above selected cell"/>
                    <ui:Button x:Name="InsertColLeftBtn" Content="← Insert Col" Appearance="Transparent" 
                               Padding="8,5" FontSize="11" Click="InsertColLeft_Click" 
                               Margin="0,2,4,2" ToolTip="Insert column left of selected cell"/>
                    <ui:Button Content="✕ Row" Appearance="Transparent" Padding="8,5" FontSize="11"
                               Click="DelRow_Click" Foreground="{DynamicResource DangerColor}" Margin="0,2,2,2" 
                               ToolTip="Delete selected row (or last row)"/>
                    <ui:Button Content="✕ Col" Appearance="Transparent" Padding="8,5" FontSize="11"
                               Click="DelCol_Click" Foreground="{DynamicResource DangerColor}" Margin="0,2,2,2" 
                               ToolTip="Delete selected column (or last column)"/>
                    
                    <Border Width="1" Height="20" Background="{DynamicResource ThemeOverlayBorder}" Margin="4,0,8,0"/>
                    
                    <ui:Button Content="↩ Undo" Appearance="Transparent" Padding="8,5" FontSize="11"
                               Click="Undo_Click" Margin="0,2,2,2" ToolTip="Undo last change (Ctrl+Z)"/>
                </WrapPanel>
                
                <!-- Image toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="ToggleImageBtn" Content="🖼 Source" Appearance="Transparent" 
                               Padding="10,6" FontSize="11" Click="ToggleImagePanel_Click" 
                               Margin="4,2" ToolTip="Toggle source image preview"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT: Image panel + Table ═══ -->
        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ImageColumnDef" Width="0"/>
                <ColumnDefinition x:Name="SplitterColumnDef" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Source Image Panel (hidden by default, shown when image path provided) -->
            <Border x:Name="ImagePanel" Grid.Column="0" CornerRadius="8" 
                    Background="{DynamicResource ThemeOverlayBgPressed}" BorderBrush="{DynamicResource ThemeOverlayBorder}" BorderThickness="1" 
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SOURCE IMAGE" FontSize="10" FontWeight="Bold" Opacity="0.4" 
                               Margin="12,10,12,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                        <Image x:Name="SourceImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="8,0,8,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="0" 
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                          Background="Transparent" Visibility="Collapsed"
                          ShowsPreview="True"/>

            <!-- Right: Table Grid -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeOverlayBgPressed}" BorderBrush="{DynamicResource ThemeOverlayBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="TableGrid">
                        <!-- Dynamically built -->
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ FOOTER: Status bar + Confidence legend ═══ -->
        <Grid Grid.Row="3" Margin="24,10,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Status info -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="InfoText" Text="" FontSize="12" Opacity="0.6" 
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                <TextBlock Text="  ·  " Opacity="0.3" FontSize="12"/>
                <TextBlock x:Name="SelectionInfo" Text="Tab to navigate · Ctrl+Z undo" FontSize="11" 
                           Opacity="0.4" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
            </StackPanel>
            
            <!-- Confidence legend -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#3310B981" Stroke="#10B981" StrokeThickness="1" Margin="0,0,4,0"/>
                <TextBlock Text="High" Margin="0,0,10,0" Opacity="0.5" FontSize="10"/>
                <Ellipse Width="8" Height="8" Fill="#33EAB308" Stroke="#EAB308" StrokeThickness="1" Margin="0,0,4,0"/>
                <TextBlock Text="Medium" Margin="0,0,10,0" Opacity="0.5" FontSize="10"/>
                <Ellipse Width="8" Height="8" Fill="#33EF4444" Stroke="#EF4444" StrokeThickness="1" Margin="0,0,4,0"/>
                <TextBlock Text="Low" Opacity="0.5" FontSize="10"/>
            </StackPanel>
        </Grid>
    </Grid>
</mica:MicaWindow>
