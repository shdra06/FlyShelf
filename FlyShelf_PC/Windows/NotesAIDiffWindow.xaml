<mica:MicaWindow x:Class="FlyShelf.Windows.NotesAIDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI Improve Note" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="400" MinHeight="350">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#15FFFFFF" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="SparkleCircle24" FontSize="18" Foreground="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="AI Improved Note" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Text="" FontSize="11" Foreground="#80FFFFFF" Margin="26,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Change Summary -->
        <Border Grid.Row="1" Background="#10B98120" Padding="12,8" Margin="12,8,12,0" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="ChangeSummaryText" Text="Analyzing changes..." FontSize="12" Foreground="#10B981" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Loading Indicator -->
        <StackPanel x:Name="LoadingView" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,12"/>
            <TextBlock x:Name="LoadingText" Text="AI is improving your note..." Foreground="#80FFFFFF" FontSize="13"/>
        </StackPanel>

        <!-- Content Area (hidden until AI finishes) -->
        <Grid x:Name="ContentView" Grid.Row="2" Margin="12,8,12,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Original -->
            <Border Grid.Row="0" CornerRadius="8" Background="#1A1A2E" Padding="0" BorderBrush="#30FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Original" FontSize="11" FontWeight="SemiBold" Foreground="#60FFFFFF" Padding="10,6,10,4"/>
                    <TextBox Grid.Row="1" x:Name="OriginalTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="Transparent" BorderThickness="0" Foreground="#A0A0B0" Padding="10,4,10,8"
                             FontSize="12.5" VerticalScrollBarVisibility="Auto" CaretBrush="Transparent"/>
                </Grid>
            </Border>

            <!-- Improved -->
            <Border Grid.Row="2" CornerRadius="8" Background="#1E2A1E" Padding="0" BorderBrush="#3010B981" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="✨ AI Improved" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Padding="10,6,10,4"/>
                    <TextBox Grid.Row="1" x:Name="ImprovedTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="Transparent" BorderThickness="0" Foreground="#E8E8F0" Padding="10,4,10,8"
                             FontSize="12.5" VerticalScrollBarVisibility="Auto" CaretBrush="#E8E8F0"
                             SelectionBrush="#608B5CF6"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,12">
            <ui:Button x:Name="DiscardBtn" Content="❌ Discard" Appearance="Danger" Click="Discard_Click" Margin="0,0,8,0" Padding="16,8"/>
            <ui:Button x:Name="KeepBtn" Content="✅ Keep Changes" Appearance="Success" Click="Keep_Click" Padding="16,8" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</mica:MicaWindow>
