<controls:MicaWindow x:Class="AdvanceClip.Windows.PageReorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Reorder Pages" Height="650" Width="780"
        WindowStartupLocation="CenterOwner"
        SystemBackdropType="Mica" Background="Transparent">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="False">
            <ui:SymbolIcon Symbol="ArrowSort24" Foreground="#8B5CF6" FontSize="22" Margin="0,0,10,0" />
            <TextBlock x:Name="HeaderText" Text="Reorder Pages" FontSize="17" FontWeight="SemiBold" 
                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Info bar -->
        <Border Grid.Row="1" Background="#10FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PageCountInfo" Text="" FontSize="13" 
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                <TextBlock Text="  •  " Opacity="0.4" VerticalAlignment="Center"/>
                <TextBlock Text="Drag pages to reorder • Ctrl+Click for multi-select" FontSize="11" 
                           Opacity="0.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Toolbar: Select All, Move Up/Down -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button Content="Select All" Appearance="Transparent" FontSize="12" Padding="10,4" Margin="0,0,6,0" Click="SelectAll_Click"/>
            <ui:Button Content="Deselect" Appearance="Transparent" FontSize="12" Padding="10,4" Margin="0,0,6,0" Click="DeselectAll_Click"/>
            <TextBlock Text="│" Opacity="0.2" VerticalAlignment="Center" Margin="4,0"/>
            <ui:Button x:Name="MoveUpBtn" Appearance="Transparent" FontSize="12" Padding="8,4" Margin="0,0,4,0" Click="MoveUp_Click" ToolTip="Move selected pages up">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Move Up" FontSize="12"/>
                </StackPanel>
            </ui:Button>
            <ui:Button x:Name="MoveDownBtn" Appearance="Transparent" FontSize="12" Padding="8,4" Margin="0,0,4,0" Click="MoveDown_Click" ToolTip="Move selected pages down">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Move Down" FontSize="12"/>
                </StackPanel>
            </ui:Button>
            <TextBlock Text="│" Opacity="0.2" VerticalAlignment="Center" Margin="4,0"/>
            <ui:Button Appearance="Transparent" FontSize="12" Padding="8,4" Margin="0,0,4,0" Click="Reverse_Click" ToolTip="Reverse page order">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Reverse" FontSize="12"/>
                </StackPanel>
            </ui:Button>
        </StackPanel>

        <!-- Page grid -->
        <Border Grid.Row="3" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PageItemsControl" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer buttons -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedCountText" Text="0 selected" FontSize="12" Opacity="0.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,12,0" Padding="20,8" Click="Cancel_Click" />
                <ui:Button x:Name="ConfirmBtn" Content="Apply Order" Appearance="Primary" Padding="20,8" Click="Confirm_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Checkmark24" /></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</controls:MicaWindow>
