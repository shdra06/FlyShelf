<controls:MicaWindow x:Class="FlyShelf.Windows.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FlyShelf.ViewModels"
        xmlns:settings="clr-namespace:FlyShelf.Classes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:styles="clr-namespace:FlyShelf.Styles"
        Title="FlyShelf Ecosystem" 
        Height="650" 
        Width="900"
        MinWidth="300" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        SystemBackdropType="Mica"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True" PreviewDrop="Window_PreviewDrop" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" PreviewDragOver="Window_PreviewDragOver"
        Icon="/Resources/FlyShelfLogo.ico">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/HubWindowStyles.xaml"/>
                <styles:HubClipboardItemTemplate />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" TextElement.Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- PREMIUM HEADER — Brand Identity + Navigation            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Brand Identity Bar -->
            <Grid Grid.Row="0" Margin="20,12,20,0" WindowChrome.IsHitTestVisibleInChrome="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Icon with subtle glow border -->
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A1A2E" Offset="0"/>
                                <GradientStop Color="#16213E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="{DynamicResource ThemeLogoIcon}" Width="20" Height="20" 
                               RenderOptions.BitmapScalingMode="HighQuality" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Brand text with weight hierarchy -->
                    <TextBlock Text="FlyShelf" FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Hub" FontSize="16" FontWeight="Light" 
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" 
                               VerticalAlignment="Center" Margin="5,0,0,0" Opacity="0.7"/>

                    <!-- PRO Badge (gradient pill — only for Pro users) -->
                    <Border x:Name="ProBadgeTitleBar" Visibility="Collapsed" 
                            CornerRadius="6" Padding="8,3,8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#F97316" Offset="0.5"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="PRO" FontSize="10" FontWeight="Black" Foreground="White" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- FREE badge (subtle muted pill) -->
                    <Border x:Name="FreeBadgeTitleBar" CornerRadius="6" Padding="8,3,8,3" 
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                        <TextBlock Text="FREE" FontSize="10" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                   VerticalAlignment="Center" Opacity="0.65"/>
                    </Border>
                </StackPanel>

                <!-- Right: Version pill + status dot -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" 
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Subtle status dot (green = online) -->
                    <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#10B981"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border Background="#0AFFFFFF" CornerRadius="6" Padding="10,4,10,4" 
                            BorderBrush="#10FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="VersionBadgeText" Text="v—" FontSize="11" 
                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                   Opacity="0.6"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ROW 1: Accent separator line -->
            <Grid Grid.Row="1" Margin="20,10,20,0" Height="1">
                <Border Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Opacity="0.4"/>
                <!-- Subtle gradient accent in center -->
                <Border HorizontalAlignment="Left" Width="60" CornerRadius="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- ═══ UPDATE NOTIFICATION BANNER ═══ -->
            <Border x:Name="HubUpdateBanner" Grid.Row="1" Visibility="Collapsed" 
                    Margin="20,10,20,0" CornerRadius="8" Padding="12,7,8,7"
                    Cursor="Hand" MouseLeftButtonDown="HubUpdateBanner_Click">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A6366F1" Offset="0"/>
                        <GradientStop Color="#1A8B5CF6" Offset="0.5"/>
                        <GradientStop Color="#1AA78BFA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#336366F1" Offset="0"/>
                        <GradientStop Color="#338B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowCircleUp24" FontSize="15" Foreground="#8B5CF6" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="HubUpdateBannerText" 
                               Text="🚀 A new version of FlyShelf is available — update now!" 
                               FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Click="HubUpdateBannerDismiss_Click"
                            Focusable="False" Cursor="Hand" VerticalAlignment="Center" Margin="6,0,0,0"
                            ToolTip="Dismiss">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DismissBg" Width="22" Height="22" CornerRadius="11" 
                                                    Background="Transparent">
                                                <ui:SymbolIcon Symbol="Dismiss12" FontSize="10" 
                                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DismissBg" Property="Background" Value="#18FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ROW 2: Navigation Tabs -->
            <ui:NavigationView x:Name="RootNavigation" Grid.Row="2" PaneDisplayMode="Top" 
                               IsBackButtonVisible="Collapsed" 
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Margin="4,2,4,0">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Clipboard" Tag="History" IsActive="True" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Clipboard24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Dashboard" Tag="Dashboard" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ChartMultiple24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Network" Tag="Network" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Globe24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Settings" Tag="Settings" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem x:Name="LogsNavItem" Content="Logs" Tag="Logs" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Document24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Tutorial" Tag="Tutorial" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="BookOpen24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="About" Tag="About" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>
        </Grid>

            <!-- Embedded Content Grid (Hosts selected frames natively) -->
            <Grid Grid.Row="1" Margin="16,8,16,16">
                
                <!-- 0. DASHBOARD TAB -->
                <Grid x:Name="DashboardGrid" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <StackPanel Margin="0,8,0,0">

                            <!-- TOP ROW: 3 Stat Cards  -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Clipboard Items Stat -->
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="14" Padding="20,18" Cursor="Hand" Tag="History" MouseLeftButtonDown="DashboardCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1D4ED8" Offset="0"/>
                                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Database24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Clipboard" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding DroppedItems.Count}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Grid.Row="2" Text="items saved" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                    </Grid>
                                </Border>

                                <!-- Network Status Stat -->
                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="14" Padding="20,18" Cursor="Hand" Tag="Network" MouseLeftButtonDown="DashboardCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0D9488" Offset="0"/>
                                                        <GradientStop Color="#14B8A6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Wifi124" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Network" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Active" FontSize="36" FontWeight="Bold" Foreground="#14B8A6" Margin="0,0,0,2" />
                                        <TextBlock Grid.Row="2" Text="{Binding LocalServer.DisplayUrl}" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- BOTTOM ROW: 2 Feature Cards  -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Smart Suggestions Card -->
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" CornerRadius="14" Padding="0" Cursor="Hand" Tag="History" MouseLeftButtonDown="DashboardCard_Click" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#408B5CF6" BorderThickness="1">
                                    <Grid>
                                        <!-- Subtle gradient glow in background -->
                                        <Border CornerRadius="14" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Height="120" Margin="-20,-20,0,0">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Margin="24,22,24,22">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                                            <GradientStop Color="#8B5CF6" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Lightbulb24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Smart Suggestions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                                    <TextBlock Text="AI-powered" FontSize="11" Foreground="#8B5CF6" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Automatically recommends clipboard items based on your currently active application context." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Quick Actions Card -->
                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" CornerRadius="14" Padding="0" Cursor="Hand" Tag="Settings" MouseLeftButtonDown="DashboardCard_Click" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#40F59E0B" BorderThickness="1">
                                    <Grid>
                                        <Border CornerRadius="14" Opacity="0.12" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Height="120" Margin="-20,-20,0,0">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Margin="24,22,24,22">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#D97706" Offset="0"/>
                                                            <GradientStop Color="#F59E0B" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Rocket24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                                    <TextBlock Text="Shortcuts" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Compile code, convert documents, merge PDFs, and launch tools directly from your clipboard items." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Clipboard Maintenance Header -->
                            <TextBlock Text="Clipboard Maintenance" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" Margin="0,28,0,16"/>

                            <!-- MAINTENANCE ROW: 2 Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card A: Duplicate Sweeper -->
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" CornerRadius="14" Padding="0" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#40F43F5E" BorderThickness="1">
                                    <Grid>
                                        <!-- Subtle gradient glow in background (AccentRose Color: #F43F5E) -->
                                        <Border CornerRadius="14" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Height="120" Margin="-20,-20,0,0">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#F43F5E" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Margin="24,22,24,22">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#E11D48" Offset="0"/>
                                                            <GradientStop Color="#F43F5E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="SquareMultiple24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Duplicate Sweeper" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                                    <TextBlock Text="Clean Duplicates" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Scans for duplicate texts, URLs, and file references. Keeps the single most recent item and purges older copies." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" LineHeight="18" Height="54"/>
                                            
                                            <!-- Action Button -->
                                            <ui:Button x:Name="SweepDuplicatesBtn" Appearance="Secondary" Content="Scan &amp; Sweep Duplicates" Padding="14,8" CornerRadius="8" HorizontalAlignment="Stretch" Click="SweepDuplicates_Click" Margin="0,16,0,0">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card B: Smart History Cleanup -->
                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" CornerRadius="14" Padding="0" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#4010B981" BorderThickness="1">
                                    <Grid>
                                        <!-- Subtle gradient glow in background (AccentEmerald Color: #10B981) -->
                                        <Border CornerRadius="14" Opacity="0.12" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Height="120" Margin="-20,-20,0,0">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Margin="24,22,24,22">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#059669" Offset="0"/>
                                                            <GradientStop Color="#10B981" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="History24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Smart History Cleanup" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                                        <Border Background="#10B981" CornerRadius="4" Margin="6,0,0,0" Padding="5,1,5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="PRO" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Timeframe Purge" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- Timeframe selector ComboBox and description -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Select a timeframe to purge unpinned clipboard history (just like Chrome cleanup)." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="0" Height="54"/>
                                                <ComboBox x:Name="CleanupTimeframeCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="110" SelectedIndex="0">
                                                    <ComboBoxItem Content="Last 1 Hour" Tag="1h"/>
                                                    <ComboBoxItem Content="Last 6 Hours" Tag="6h"/>
                                                    <ComboBoxItem Content="Last 9 Hours" Tag="9h"/>
                                                    <ComboBoxItem Content="Last 24 Hours" Tag="24h"/>
                                                    <ComboBoxItem Content="Last 2 Days" Tag="2d"/>
                                                </ComboBox>
                                            </Grid>
                                            
                                            <!-- Action Button -->
                                            <ui:Button x:Name="CleanHistoryBtn" Appearance="Secondary" Content="Clean Clipboard History" Padding="14,8" CornerRadius="8" HorizontalAlignment="Stretch" Click="CleanHistory_Click" Margin="0,16,0,0">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="#EF4444"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                        <Grid Background="Transparent" MouseDown="SizingLockedCard_MouseDown" Visibility="Collapsed" x:Name="SmartHistoryCleanupLockedOverlay"/>
                                    </Grid>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 1. CLIPBOARD TAB -->
                <Grid x:Name="HistoryGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        
                        <!-- Search Box (compact — no header above) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="12" Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderStrong}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"
                                                x:Name="SearchPlaceholderPanel">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Search clips..." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12.5"/>
                                    </StackPanel>
                                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                             Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                                             FontSize="12.5" Padding="14,10" CaretBrush="{DynamicResource ThemeAccent}"
                                             TextChanged="SearchBox_TextChanged">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                                              Margin="0" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border CornerRadius="8" Padding="8,4" Margin="0,0,6,0" Background="#0A6366F1">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8B92A0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}">
                                                <Binding Path="DroppedItems.Count" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <ui:Button Appearance="Secondary" Padding="8,6" CornerRadius="10" ToolTip="Select All" Click="SelectAll_Click" Margin="0,0,6,0">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" />
                                </ui:Button>
                                <ui:Button Padding="8,6" CornerRadius="10" ToolTip="Delete All Items" Click="DeleteAll_Click" Foreground="#EF4444">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Background" Value="#15EF4444"/>
                                            <Setter Property="BorderBrush" Value="#30EF4444"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#25EF4444"/>
                                                    <Setter Property="BorderBrush" Value="#50EF4444"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#EF4444" Margin="0,0,5,0"/>
                                        <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                                        <!-- Filter Chips — Compact horizontal icon pills -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel.Resources>
                            <!-- Clean neutral brushes — white-based glass tints for dark theme harmony -->
                            <SolidColorBrush x:Key="CheckedBackgroundBrush" Color="#24FFFFFF"/>
                            <SolidColorBrush x:Key="CheckedHoverBackgroundBrush" Color="#30FFFFFF"/>
                            <SolidColorBrush x:Key="CheckedBorderBrush" Color="#38FFFFFF"/>
                            <SolidColorBrush x:Key="CheckedHoverBorderBrush" Color="#48FFFFFF"/>

                            <!-- Inner TextBlock style: text brightens on selection for clear hierarchy -->
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsChecked}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Inner SymbolIcon style: muted when unchecked, vivid when active -->
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                                <Setter Property="Opacity" Value="0.5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsChecked}" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="FilterChipStyle" TargetType="RadioButton">
                                <Setter Property="Margin" Value="0,0,4,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="ChipBorder" CornerRadius="8" Padding="10,6" 
                                                    Background="Transparent" 
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <ContentPresenter x:Name="ChipContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Hover state for unchecked chip — gentle glass lift -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="#10FFFFFF"/>
                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#14FFFFFF"/>
                                                </MultiTrigger>
                                                
                                                <!-- Checked state — frosted glass pill -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource CheckedBackgroundBrush}"/>
                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource CheckedBorderBrush}"/>
                                                </MultiTrigger>

                                                <!-- Checked & Hovered — brighter glass -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource CheckedHoverBackgroundBrush}"/>
                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource CheckedHoverBorderBrush}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <RadioButton IsChecked="True" Checked="Filter_Checked" Tag="All" Style="{StaticResource FilterChipStyle}">
                            <TextBlock Text="All"/>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Text" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextDescription24" Foreground="#8B5CF6"/>
                                <TextBlock Text="Text"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Code" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Code24" Foreground="#10B981"/>
                                <TextBlock Text="Code"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Image" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Image24" Foreground="#F472B6"/>
                                <TextBlock Text="Images"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Pdf" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="#EF4444"/>
                                <TextBlock Text="PDFs"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Document" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Document24" Foreground="#60A5FA"/>
                                <TextBlock Text="Docs"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Url" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Link24" Foreground="#0EA5E9"/>
                                <TextBlock Text="Links"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Video" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Video24" Foreground="#F59E0B"/>
                                <TextBlock Text="Videos"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    
                    <ListView x:Name="HubListView" Grid.Row="2" ItemsSource="{Binding DroppedItems}" Background="Transparent" BorderThickness="0"
                              Margin="0,0,2,0"
                              UseLayoutRounding="True" SnapsToDevicePixels="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              HorizontalContentAlignment="Stretch" 
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="3,3" VirtualizingPanel.CacheLengthUnit="Page"
                              SelectionMode="Extended" SelectionChanged="HubListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <StaticResource ResourceKey="HubClipboardItemTemplate"/>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Floating Merge PDFs bar — appears when 2+ PDFs are checked -->
                    <Border x:Name="MergePdfFloatingBar" Grid.Row="2" Visibility="Collapsed"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                            CornerRadius="12" Padding="16,10,16,10"
                            IsHitTestVisible="True">
                        <Border.Background>
                            <SolidColorBrush Color="#1E1E2E" Opacity="0.95"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#EF4444" Opacity="0.5"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <Thickness>1</Thickness>
                        </Border.BorderThickness>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="#EF4444" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock x:Name="MergeBarText" Text="2 PDFs selected" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ui:Button x:Name="MergeBarBtn" Content="Merge PDFs" Padding="16,6" FontSize="12" Click="MergeSelectedPdfsBtn_Click">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentCopy24"/></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border Grid.Row="2" x:Name="EmptyStatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0C6366F1" Offset="0"/>
                                        <GradientStop Color="#068B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No clipboard items yet" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Copy text, images, files, or links to see them here." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>

                </Grid>



                <!-- 3. NETWORK SYNC TAB -->
                <Grid x:Name="NetworkGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- TOP SECTION: Network Status Dashboard (always visible)              -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <Border Grid.Row="0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" 
                            CornerRadius="12" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Status indicators row -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- LAN status -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Border x:Name="NetStatusLanDot" Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="LAN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetStatusLanIp" Text="—" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Width="1" Height="16" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,0,18,0"/>

                                <!-- Cloudflare status -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Border x:Name="NetStatusCfDot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cloudflare" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetStatusCfUrl" Text="Off" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Width="1" Height="16" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,0,18,0"/>

                                <!-- Transfer engine -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Border x:Name="NetStatusEngineDot" Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Port 8998" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Width="1" Height="16" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,0,18,0"/>

                                <!-- Peer count -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1510B981" CornerRadius="4" Padding="8,3">
                                        <TextBlock x:Name="NetStatusPeerCount" Text="0 peers" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action buttons row -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button x:Name="NetActionForceSync" Content="📡 Force Sync" Padding="10,5" FontSize="11" 
                                           Click="ForcePeerSync_Click" Margin="0,0,8,0"
                                           ToolTip="Re-fetch all peer URLs from Firebase and reconnect"/>
                                <ui:Button x:Name="NetActionTransferMgr" Content="📂 Transfer Manager" Padding="10,5" FontSize="11" 
                                           Margin="0,0,8,0" ToolTip="Open file transfer manager" Click="NetworkOpenTransferManager_Click"/>
                                <ui:Button x:Name="NetActionLiveLogs" Content="📋 Live Logs" Padding="10,5" FontSize="11" 
                                           Click="OpenNetworkLogs_Click" ToolTip="View live network logs"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- INNER TAB NAVIGATION (pill-style RadioButtons)                     -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <Border Grid.Row="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" 
                            CornerRadius="10" Padding="4" Margin="0,0,0,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style x:Key="NetworkInnerTabStyle" TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="TabBorder" CornerRadius="8" Padding="14,7" Cursor="Hand" Background="Transparent">
                                                    <ContentPresenter x:Name="TabContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsChecked" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#186366F1"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="GroupName" Value="NetworkInnerTabs"/>
                                </Style>
                            </StackPanel.Resources>

                            <RadioButton x:Name="NetworkTabDevices" Style="{StaticResource NetworkInnerTabStyle}" Content="📡 Devices" IsChecked="True" Checked="NetworkInnerTab_Checked"/>
                            <RadioButton x:Name="NetworkTabFileQueue" Style="{StaticResource NetworkInnerTabStyle}" Content="📂 File Queue" Checked="NetworkInnerTab_Checked"/>
                            <RadioButton x:Name="NetworkTabHistory" Style="{StaticResource NetworkInnerTabStyle}" Content="📜 History" Checked="NetworkInnerTab_Checked"/>
                            <RadioButton x:Name="NetworkTabNearby" Style="{StaticResource NetworkInnerTabStyle}" Content="📶 Nearby" Checked="NetworkInnerTab_Checked"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- INNER TAB CONTENT PANELS                                           -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <Grid Grid.Row="2">

                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <!-- TAB 1: DEVICES (default visible — all existing Network content) -->
                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <Grid x:Name="NetworkDevicesTab" Visibility="Visible">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Wi-Fi Sync Server" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                        <TextBlock Text="Seamlessly connect your phone to your PC's clipboard." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="Wifi124" FontSize="18" Foreground="#10B981" Margin="0,0,8,0"/>
                                        <TextBlock Text="Local Network Broadcasting" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PremiumSettingStyle}">
                                        <StackPanel>
                                            <!-- LAN Toggle -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Local Network" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                        <Border Background="#220EA5E9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                            <TextBlock Text="LAN" FontSize="10" FontWeight="Bold" Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Sync clipboard with devices on the same Wi-Fi network via direct IP connection." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" LineHeight="18"/>
                                                </StackPanel>
                                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableLocalLAN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            
                                            <Border x:Name="CloudflareSeparator" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,16" />
                                            
                                            <!-- Cloudflare Toggle -->
                                            <Grid x:Name="CloudflareToggleSection">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Global Internet Tunnel" FontWeight="SemiBold" FontSize="14" Foreground="#10B981"/>
                                                        <Border Background="#2210B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                            <TextBlock Text="CLOUDFLARE" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Securely broadcast your clipboard worldwide via a TryCloudflare reverse proxy inside FlyShelf." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" LineHeight="18"/>
                                                </StackPanel>
                                                <!-- Regular toggle (visible in non-Store builds) -->
                                                <ui:ToggleSwitch x:Name="CloudflareToggleSwitch" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableGlobalCloudflare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            
                                            <!-- Store-only: Locked overlay with download message (hidden by default, shown in Store builds via code-behind) -->
                                            <Border x:Name="CloudflareStoreLockBanner" Visibility="Collapsed"
                                                    Background="#18F59E0B" BorderBrush="#44F59E0B" BorderThickness="1" CornerRadius="8" 
                                                    Padding="14,10" Margin="0,6,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔒" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="This feature is not available in the Microsoft Store version." 
                                                                   FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" TextWrapping="Wrap"/>
                                                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" 
                                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}">
                                                            <Run Text="To unlock Cloudflare tunneling, download FlyShelf directly from "/>
                                                            <Hyperlink x:Name="CloudflareWebsiteLink" Foreground="#10B981" 
                                                                       NavigateUri="https://github.com/shdra06/FlyShelf" 
                                                                       RequestNavigate="CloudflareWebsiteLink_Navigate">
                                                                <Run Text="our website"/>
                                                            </Hyperlink>
                                                            <Run Text="."/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- AUTHENTICATION DETAILS -->
                                    <Border Style="{StaticResource PremiumSettingStyle}" Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableLocalNetworkSync, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="7" Background="#1AEAB308" Margin="0,0,10,0">
                                                    <ui:SymbolIcon Symbol="Shield24" FontSize="14" Foreground="#EAB308" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Security PIN Code" FontWeight="Bold" FontSize="18" Foreground="#EAB308" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Enter this PIN when accessing your clipboard from any browser or device." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                            
                                            <Border Background="#11EAB308" BorderBrush="#22EAB308" BorderThickness="1.5" CornerRadius="14" Padding="28,12" HorizontalAlignment="Center" Margin="0,0,0,20">
                                                <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=WebClientPinToken}" FontSize="36" FontWeight="Bold" Foreground="#EAB308" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                            <TextBlock Text="Your Connection URLs" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,12" HorizontalAlignment="Center" />
                                            
                                            <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Wi-Fi:" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LocalServer.DisplayUrl}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="Copy" Margin="12,0,0,0" Padding="8,2" FontSize="11" Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDisabled}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Cursor="Hand" Click="CopyUrl_Click" Tag="{Binding LocalServer.DisplayUrl}" MinWidth="55" />
                                            </Grid>
                                            
                                            <Grid x:Name="CloudflareStatusGrid" HorizontalAlignment="Center" Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableGlobalCloudflare, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Global:" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LocalServer.GlobalUrl}" FontSize="15" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="Copy" Margin="12,0,0,0" Padding="8,2" FontSize="11" Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDisabled}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Cursor="Hand" Click="CopyUrl_Click" Tag="{Binding LocalServer.GlobalUrl}" MinWidth="55"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- QUICK PAIR QR CODE -->
                                    <Border Style="{StaticResource PremiumSettingStyle}" Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableLocalNetworkSync, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#6366F1" Offset="0"/>
                                                            <GradientStop Color="#A78BFA" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="QrCode24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Quick Pair" FontWeight="Bold" FontSize="18" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Scan this QR code with FlyShelf Mobile or enter the pairing code below." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                                            <!-- QR Code Display -->
                                            <Border Background="White" CornerRadius="14" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <Image x:Name="PairingQRImage" Width="160" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>

                                            <!-- Action Buttons -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <ui:Button Content="🔄 Regenerate QR" Padding="14,8" Click="RegenerateQR_Click" Margin="0,0,8,0" FontSize="11"/>
                                                <ui:Button Content="📋 Copy Pairing Info" Padding="14,8" Click="CopyPairingInfo_Click" FontSize="11"/>
                                            </StackPanel>

                                            <!-- PAIRING CODE DISPLAY -->
                                            <Border Background="#08A78BFA" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" HorizontalAlignment="Center" MinWidth="260">
                                                <StackPanel>
                                                    <TextBlock Text="Your Pairing Code" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="PairingCodeDisplay" Text="------" FontSize="32" FontWeight="Black"
                                                               FontFamily="Consolas" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Share this code with any device to connect" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                                                    <ui:Button Content="🔑 Generate New Code" Padding="12,6" 
                                                               Click="GeneratePairingCode_Click" FontSize="11" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ENTER CODE FROM ANOTHER DEVICE -->
                                            <Border Background="#1A10B981" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" HorizontalAlignment="Center" MinWidth="260"
                                                    BorderBrush="#4010B981" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Connect to Another Device" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:TextBox x:Name="RemoteCodeInput" PlaceholderText="Enter 6-char code" Width="180" FontSize="16"
                                                                    FontFamily="Consolas" HorizontalContentAlignment="Center" MaxLength="6"
                                                                    VerticalAlignment="Center"/>
                                                        <ui:Button Content="Connect" Margin="8,0,0,0" Padding="14,8"
                                                                   Click="ConnectByCode_Click" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Enter the code shown on the other PC or phone" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ═ ═ ═ LIVE P2P PEER STATUS ═ ═ ═ -->
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,4,0,14" />

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Paired Devices" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                                <Border Background="#1510B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock x:Name="PeerCountBadge" Text="0 online" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                                </Border>
                                                <ui:Button x:Name="NetworkLiveLogsBtn" Content="📡 Live Logs" Padding="8,3"
                                                           Click="OpenNetworkLogs_Click" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="View live logs from this device and all paired devices"/>
                                            </StackPanel>

                                            <!-- Live P2P status from PeerManager (5s heartbeat) -->
                                            <ItemsControl x:Name="PeerStatusPanel">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,5">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlive}" Value="True">
                                                                            <Setter Property="Background" Value="#0810B981"/>
                                                                            <Setter Property="BorderBrush" Value="#2010B981"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="📤 Send File..." Tag="{Binding DeviceId}"/>
                                                                    <MenuItem Header="📋 Copy IP" Tag="{Binding ActiveUrl}" Click="CopyUrl_Click"/>
                                                                    <MenuItem Header="📊 Transfer History" Tag="{Binding DeviceId}"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="❌ Disconnect" Tag="{Binding DeviceId}" Click="RemovePairedDevice_Click"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Device icon -->
                                                                <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>

                                                                <!-- Name + transport info -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DeviceName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,1,0,0"/>
                                                                </StackPanel>

                                                                <!-- Active transfer count badge -->
                                                                <Border Grid.Column="2" Background="#226366F1" CornerRadius="4" Padding="6,2" Margin="4,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasActiveTransfers, FallbackValue=Collapsed}">
                                                                    <TextBlock Text="{Binding ActiveTransferCount, FallbackValue=0}" FontSize="9" FontWeight="Bold" Foreground="#A5B4FC"/>
                                                                </Border>

                                                                <!-- LAN status dot -->
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                                    <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLanActive}" Value="True">
                                                                                        <Setter Property="Background" Value="#10B981"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <TextBlock Text="LAN" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLanActive}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <!-- Cloud status dot -->
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                                    <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCloudActive}" Value="True">
                                                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <TextBlock Text="Cloud" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCloudActive}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <!-- Copy Logs button -->
                                                                <Button Grid.Column="5" Tag="{Binding ActiveUrl}" Click="CopyDeviceLogs_Click"
                                                                        Padding="6,3" FontSize="9" FontWeight="SemiBold" Cursor="Hand"
                                                                        Background="#206366F1" Foreground="#A5B4FC" BorderThickness="0"
                                                                        ToolTip="Copy this device's logs to clipboard" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="📋" FontSize="10" Margin="0,0,3,0"/>
                                                                        <TextBlock Text="Copy Logs" FontSize="9"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Remove button -->
                                                                <Button Grid.Column="6" Content="✕" Tag="{Binding DeviceId}" Click="RemovePairedDevice_Click" 
                                                                        Padding="4,2" FontSize="10" Background="Transparent" BorderThickness="0" 
                                                                        Foreground="#EF4444" Cursor="Hand" ToolTip="Remove device" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="NoPairedDevicesText" Text="No devices paired yet — scan the QR code above" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>


                                    <!-- ACTIVE DEVICES SECTION -->
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                                        <ui:SymbolIcon Symbol="People24" FontSize="18" Foreground="#8B5CF6" Margin="0,0,8,0"/>
                                        <TextBlock Text="Connected Devices" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PremiumSettingStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Live Mesh Topology" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                    <TextBlock Text="All devices registered in the Firebase active_devices node." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Padding="12,8" Click="RefreshDevices_Click" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Refresh" FontWeight="SemiBold" FontSize="12"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </Grid>

                                            <!--  2-COLUMN DEVICE TOPOLOGY -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LAN Column -->
                                                <Border Grid.Column="0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="10,10">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="LAN" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Same network" FontSize="9" Foreground="#10B98188" Margin="0,-6,0,8"/>
                                                        <ItemsControl x:Name="LanDevicesPanel">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" MouseRightButtonDown="DeviceInfo_RightClick" ToolTip="Right-click for connection info">
                                                                        <StackPanel>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon FontSize="14" Foreground="#10B981" Margin="0,0,8,0">
                                                                                    <ui:SymbolIcon.Style>
                                                                                        <Style TargetType="ui:SymbolIcon">
                                                                                            <Setter Property="Symbol" Value="Phone24"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding DeviceType}" Value="PC">
                                                                                                    <Setter Property="Symbol" Value="Desktop24"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </ui:SymbolIcon.Style>
                                                                                </ui:SymbolIcon>
                                                                                <TextBlock Text="{Binding DeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding ConnectionInfo}" FontSize="9" Foreground="#10B98188" Margin="22,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock x:Name="LanEmptyText" Text="No other LAN peers" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Cloud Column -->
                                                <Border Grid.Column="2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="10,10">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Cloud" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Global sync active" FontSize="9" Foreground="#F59E0B88" Margin="0,-6,0,8"/>
                                                        <ItemsControl x:Name="CloudDevicesPanel">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" MouseRightButtonDown="DeviceInfo_RightClick" ToolTip="Right-click for connection info">
                                                                        <StackPanel>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon FontSize="14" Foreground="#F59E0B" Margin="0,0,8,0">
                                                                                    <ui:SymbolIcon.Style>
                                                                                        <Style TargetType="ui:SymbolIcon">
                                                                                            <Setter Property="Symbol" Value="Phone24"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding DeviceType}" Value="PC">
                                                                                                    <Setter Property="Symbol" Value="Desktop24"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </ui:SymbolIcon.Style>
                                                                                </ui:SymbolIcon>
                                                                                <TextBlock Text="{Binding DeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding ConnectionInfo}" FontSize="9" Foreground="#F59E0B88" Margin="22,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock x:Name="CloudEmptyText" Text="No cloud devices" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>


                                            <!-- Empty State -->
                                            <StackPanel x:Name="NoDevicesPanel" HorizontalAlignment="Center" Margin="0,12,0,12" Visibility="Collapsed">
                                                <ui:SymbolIcon Symbol="PeopleSearch24" FontSize="32" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock Text="No devices found - hit Refresh" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- DEVICE GROUPS -->
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Device Groups" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" />
                                        <Button x:Name="CreateGroupBtn" Content="+ New Group" Margin="12,0,0,0" Padding="10,4" FontSize="10" FontWeight="Bold" Click="CreateGroupBtn_Click"
                                                Background="#F59E0B" Foreground="#000" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <ItemsControl x:Name="GroupsPanel">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                            <TextBlock Text="{Binding DeviceList}" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Edit" Tag="{Binding Id}" Click="EditGroupBtn_Click" Padding="6,4" Margin="0,0,4,0" Cursor="Hand" Background="Transparent" Foreground="#F59E0B" BorderThickness="0" FontSize="12"/>
                                                            <Button Content="Del" Tag="{Binding Id}" Click="DeleteGroupBtn_Click" Padding="6,4" Cursor="Hand" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoGroupsText" Text="No groups - create one to sync across devices" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <!-- TAB 2: FILE QUEUE                                              -->
                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <Grid x:Name="NetworkFileQueueTab" Visibility="Collapsed">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="File Queue" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                        <TextBlock Text="Stage files to send to connected peers." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Drag-drop zone -->
                                    <Border x:Name="FileQueueDropZone" CornerRadius="14" Padding="28,24" Margin="0,0,0,16" 
                                            BorderThickness="2" HorizontalAlignment="Stretch" AllowDrop="True"
                                            Background="#086366F1" BorderBrush="#406366F1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="32" Foreground="#6366F1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Drop files here to stage for sending" FontSize="14" FontWeight="SemiBold" Foreground="#A5B4FC" HorizontalAlignment="Center"/>
                                            <TextBlock Text="or use the Add Files button below" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Toolbar -->
                                    <Border Style="{StaticResource PremiumSettingStyle}" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:Button x:Name="FileQueueAddBtn" Grid.Column="0" Padding="10,6" FontSize="11" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁" FontSize="12" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Add Files" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button x:Name="FileQueueSendAllBtn" Grid.Column="1" Padding="10,6" FontSize="11" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📤" FontSize="12" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Send All to All Peers" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button x:Name="FileQueueClearBtn" Grid.Column="2" Padding="10,6" FontSize="11">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️" FontSize="12" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Clear Queue" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <Border Grid.Column="4" Background="#226366F1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock x:Name="FileQueueCountBadge" Text="0 files" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Staged files list -->
                                    <ItemsControl x:Name="FileQueueItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                                                        Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                                                        BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="📤 Send to All Peers" Tag="{Binding FilePath}"/>
                                                            <Separator/>
                                                            <MenuItem Header="❌ Remove" Tag="{Binding FilePath}"/>
                                                            <MenuItem Header="📂 Open File" Tag="{Binding FilePath}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="18" Foreground="#6366F1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                    <TextBlock Text=" → " FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                    <TextBlock Text="{Binding TargetDevice, FallbackValue='All Peers'}" FontSize="10" Foreground="#A5B4FC"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <!-- Status badge -->
                                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="8,0" VerticalAlignment="Center"
                                                                    Background="{Binding StatusBackground, FallbackValue='#226366F1'}">
                                                                <TextBlock Text="{Binding StatusText, FallbackValue='Queued'}" FontSize="9" FontWeight="Bold" 
                                                                           Foreground="{Binding StatusForeground, FallbackValue='#A5B4FC'}"/>
                                                            </Border>
                                                            <Button Grid.Column="3" Content="✕" Padding="4,2" FontSize="10" Background="Transparent" 
                                                                    BorderThickness="0" Foreground="#EF4444" Cursor="Hand" ToolTip="Remove" 
                                                                    VerticalAlignment="Center" Tag="{Binding FilePath}"/>
                                                        </Grid>
                                                        <!-- Progress bar (visible when sending) -->
                                                        <ProgressBar Grid.Row="1" Value="{Binding Progress, FallbackValue=0}" Maximum="100" Height="3" 
                                                                     Margin="0,6,0,0" Background="#106366F1" Foreground="#6366F1"
                                                                     Visibility="{Binding IsTransferring, FallbackValue=Collapsed}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <StackPanel x:Name="FileQueueEmptyState" HorizontalAlignment="Center" Margin="0,30,0,30">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="40" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <TextBlock Text="📂 No files staged — copy a file or drag files here" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <!-- TAB 3: HISTORY                                                 -->
                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <Grid x:Name="NetworkHistoryTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Transfer History" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                        <TextBlock Text="View all file transfers between your devices." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Filter bar -->
                                    <Border Style="{StaticResource PremiumSettingStyle}" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Filter RadioButtons -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Resources>
                                                    <Style x:Key="HistoryFilterStyle" TargetType="RadioButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="RadioButton">
                                                                    <Border x:Name="FilterBorder" CornerRadius="6" Padding="10,5" Cursor="Hand" Background="Transparent" Margin="0,0,4,0">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="FilterBorder" Property="Background" Value="#286366F1"/>
                                                                            <Setter Property="Foreground" Value="#A5B4FC"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                        </Trigger>
                                                                        <MultiTrigger>
                                                                            <MultiTrigger.Conditions>
                                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                                <Condition Property="IsChecked" Value="False"/>
                                                                            </MultiTrigger.Conditions>
                                                                            <Setter TargetName="FilterBorder" Property="Background" Value="#106366F1"/>
                                                                        </MultiTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="GroupName" Value="HistoryFilter"/>
                                                    </Style>
                                                </StackPanel.Resources>
                                                <RadioButton x:Name="HistoryFilterAll" Style="{StaticResource HistoryFilterStyle}" Content="All" IsChecked="True"/>
                                                <RadioButton x:Name="HistoryFilterSent" Style="{StaticResource HistoryFilterStyle}" Content="📤 Sent"/>
                                                <RadioButton x:Name="HistoryFilterReceived" Style="{StaticResource HistoryFilterStyle}" Content="📥 Received"/>
                                                <RadioButton x:Name="HistoryFilterFailed" Style="{StaticResource HistoryFilterStyle}" Content="❌ Failed"/>
                                            </StackPanel>

                                            <!-- Search -->
                                            <ui:TextBox x:Name="HistorySearchBox" Grid.Column="1" PlaceholderText="Search transfers..." Margin="12,0,12,0" FontSize="12"/>

                                            <!-- Export CSV -->
                                            <ui:Button x:Name="HistoryExportCsvBtn" Grid.Column="2" Padding="10,6" FontSize="11" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📊" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Export CSV" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <!-- Clear -->
                                            <ui:Button x:Name="HistoryClearBtn" Grid.Column="3" Padding="10,6" FontSize="11">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </Border>

                                    <!-- History entries list -->
                                    <ItemsControl x:Name="HistoryItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                                                        Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                                                        BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Direction icon -->
                                                        <TextBlock Grid.Column="0" Text="{Binding DirectionIcon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                        <!-- File info + peer -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" 
                                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10" 
                                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding PeerName}" FontSize="10" Foreground="#A5B4FC"/>
                                                                <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                <TextBlock Text="{Binding Duration}" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                <TextBlock Text="{Binding AverageSpeed}" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                            </StackPanel>
                                                            <!-- Error message for failed transfers -->
                                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="10" Foreground="#EF4444" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasError, FallbackValue=Collapsed}"/>
                                                        </StackPanel>

                                                        <!-- Status badge -->
                                                        <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="8,0" VerticalAlignment="Center"
                                                                Background="{Binding StatusBackground, FallbackValue='#2210B981'}">
                                                            <TextBlock Text="{Binding StatusDisplay, FallbackValue='✅ Completed'}" FontSize="9" FontWeight="Bold"
                                                                       Foreground="{Binding StatusForeground, FallbackValue='#10B981'}"/>
                                                        </Border>

                                                        <!-- Timestamp + retry -->
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding RelativeTime}" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Right"/>
                                                            <ui:Button Content="🔄 Retry" Padding="6,3" FontSize="9" Margin="0,4,0,0"
                                                                       Visibility="{Binding HasError, FallbackValue=Collapsed}"
                                                                       Tag="{Binding TransferId}" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <StackPanel x:Name="HistoryEmptyState" HorizontalAlignment="Center" Margin="0,30,0,30">
                                        <ui:SymbolIcon Symbol="History24" FontSize="40" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <TextBlock Text="📜 No transfer history yet" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Stats bar at bottom -->
                            <Border Grid.Row="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="0,1,0,0"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📤 Sent: " FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                    <TextBlock x:Name="HistoryStatsSent" Text="0 files (0 B)" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                    <TextBlock Text="  |  " FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}"/>
                                    <TextBlock Text="📥 Received: " FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                    <TextBlock x:Name="HistoryStatsReceived" Text="0 files (0 B)" FontSize="11" FontWeight="SemiBold" Foreground="#6366F1"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <!-- TAB 4: NEARBY                                                  -->
                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <Grid x:Name="NetworkNearbyTab" Visibility="Collapsed">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Nearby Devices" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                        <TextBlock Text="Discover FlyShelf instances on nearby networks." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Scanning animation area -->
                                    <Border Style="{StaticResource PremiumSettingStyle}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <!-- Pulsing radar icon -->
                                            <Border Width="64" Height="64" CornerRadius="32" Margin="0,8,0,16" HorizontalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#186366F1" Offset="0"/>
                                                        <GradientStop Color="#188B5CF6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon x:Name="NearbyRadarIcon" Symbol="Wifi124" FontSize="28" Foreground="#6366F1" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="Discover FlyShelf instances on nearby networks" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Scans for devices broadcasting on your local subnet" FontSize="11" 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                            <ui:Button x:Name="NearbyScanBtn" Padding="16,8" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Scan for Nearby Devices" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <TextBlock x:Name="NearbyScanStatus" Text="" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" 
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Discovered devices list (empty for now) -->
                                    <ItemsControl x:Name="NearbyDevicesPanel"/>

                                    <!-- Manual IP entry -->
                                    <Border Style="{StaticResource PremiumSettingStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <ui:SymbolIcon Symbol="Globe24" FontSize="16" Foreground="#8B5CF6" Margin="0,0,8,0"/>
                                                <TextBlock Text="Manual Connection" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Enter the IP address and port of a FlyShelf instance to connect directly." 
                                                       FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBox x:Name="NearbyManualIpInput" PlaceholderText="e.g. 192.168.1.100:8998" Width="260" FontSize="13" 
                                                            FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <ui:Button x:Name="NearbyManualConnectBtn" Content="Connect" Margin="10,0,0,0" Padding="16,8" 
                                                           FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Grid>

                <!-- 4. CORE SETTINGS TAB -->
                <Grid x:Name="SettingsGrid" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <StackPanel>
                            <!-- Settings Meta -->
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Core Settings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                <TextBlock Text="Personalize the behavior and look of FlyShelf." FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Height="2" CornerRadius="1" HorizontalAlignment="Left" Width="60" Margin="0,8,0,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- ═══ SECTION 1: GENERAL ═══ -->
                            <StackPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="General" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,8,0,12"/>
                            </StackPanel>

                            <!-- ── Section 1: General ── Device Identity + License Key (2-col grid) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COL 0: Device Identity -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Person24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Device Identity" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Identifies your computer across the cloud clipboard feed." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="16"/>
                                        <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Master PC or Work Laptop" />
                                    </StackPanel>
                                </Border>

                                <!-- COL 2: License Key Activation -->
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                                        <GradientStop Color="#EF4444" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Key24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="License Key" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                            <!-- Inline Pro/Free badge -->
                                            <Border x:Name="SettingsProBadge" Visibility="Collapsed" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                                        <GradientStop Color="#EF4444" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="PRO" FontSize="9" FontWeight="Black" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="SettingsLicenseDesc" Text="Activate Pro to unlock unlimited features." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="SettingsLicenseKeyInput" Grid.Column="0" PlaceholderText="FS-PRO-XXXX-XXXX-XXXX-XXXX" FontFamily="Consolas" CharacterCasing="Upper" Margin="0,0,6,0"/>
                                            <ui:Button x:Name="SettingsActivateBtn" Grid.Column="1" Appearance="Primary" Content="Activate" Padding="12,6" FontWeight="Bold" Click="SettingsActivateLicense_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="SettingsLicenseError" Text="" FontSize="10" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                                        <!-- Buy Premium Button (visible for Free users only) -->
                                        <Border x:Name="SettingsBuyPremiumBtn" CornerRadius="10" Margin="0,12,0,0" Cursor="Hand" MouseLeftButtonUp="BuyPremium_Click">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                    <GradientStop Color="#6366F1" Offset="0.5"/>
                                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,10">
                                                <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Buy FlyShelf Pro — ₹299" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="  (Lifetime)" FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ═══ Summon Hotkey Customization ═══ -->
                            <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="24" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="⌨️ Summon Hotkey" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" Margin="0,0,0,10"/>
                                            <StackPanel x:Name="HotkeyDisplay" Orientation="Horizontal">
                                                <!-- Keycaps built dynamically in code-behind -->
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border x:Name="HotkeyRecorderBorder" Visibility="Collapsed"
                                                    Background="#20FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                                                    MinWidth="120">
                                                <TextBlock x:Name="HotkeyRecorderText" Text="Press keys..."
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"
                                                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ui:Button x:Name="ChangeHotkeyBtn" Content="Change" Click="ChangeHotkey_Click"
                                                       Appearance="Secondary" Padding="12,6" CornerRadius="8" Margin="0,0,6,0"
                                                       FontSize="13" Cursor="Hand"/>
                                            <ui:Button x:Name="ResetHotkeyBtn" Content="Reset" Click="ResetHotkey_Click"
                                                       Appearance="Secondary" Padding="12,6" CornerRadius="8" Visibility="Collapsed"
                                                       FontSize="13" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Warning bar -->
                                    <Border x:Name="HotkeyWarningBar" Visibility="Collapsed"
                                            Background="#30EF4444" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                                        <TextBlock x:Name="HotkeyWarningText"
                                                   Text="⚠️ This hotkey may conflict with another application"
                                                   Foreground="#EF4444" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- General Toggles (2-col grid) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 0, COL 0: Run at Startup -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#10B981" Offset="0"/>
                                                            <GradientStop Color="#34D399" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Run at Startup" FontWeight="Bold" FontSize="14" Foreground="#34D399" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Launch FlyShelf automatically when you log into Windows." 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=AutoStartEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- ROW 0, COL 2: Notifications -->
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                                            <GradientStop Color="#FBBF24" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Alert24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Notifications" FontWeight="Bold" FontSize="14" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Show toast notifications for clipboard events, sync status, and other app activity." 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableNotifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- ROW 2, COL 0: Drag Behavior -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#10B981" Offset="0"/>
                                                            <GradientStop Color="#34D399" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="HandDraw24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Drag Behavior" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Keep items in history after dragging out of FlyShelf." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="38,0,12,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=KeepItemOnDragOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- ROW 2, COL 2: Save Configuration -->
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:Button Appearance="Primary" Click="SaveSettings_Click" HorizontalAlignment="Stretch" Content="Save Configuration" Padding="10,8" CornerRadius="8" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>


                            <!-- ═══ SECTION 2: CLIPBOARD & BEHAVIOR ═══ -->
                            <StackPanel Margin="0,24,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clipboard &amp; Behavior" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,8,0,12"/>
                            </StackPanel>

                            <!-- Clipboard Toggles (2-col grid) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COL 0: Shake to Open -->
                                <Border Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                                            <GradientStop Color="#A78BFA" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="CursorClick24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Shake to Open" FontWeight="Bold" FontSize="14" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Rapidly shake your mouse while holding left-click to summon FlyShelf at your cursor position." 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableShakeToOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- COL 2: Auto Cleanup -->
                                <Border Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                                            <GradientStop Color="#FBBF24" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Auto Cleanup" FontWeight="Bold" FontSize="14" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Automatically delete unpinned entries older than the retention period. Pinned items are never deleted." 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                        <ComboBox x:Name="RetentionCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="120" SelectionChanged="RetentionCombo_SelectionChanged">
                                            <ComboBoxItem Content="7 days" Tag="7"/>
                                            <ComboBoxItem Content="14 days" Tag="14"/>
                                            <ComboBoxItem Content="30 days" Tag="30"/>
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ═══ INCOGNITO MODE ═══ -->
                            <Border Margin="0,12,0,12" Style="{StaticResource PremiumSettingStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                                        <GradientStop Color="#FBBF24" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="EyeOff24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Incognito Mode" FontWeight="Bold" FontSize="14" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Temporarily pause clipboard monitoring. Nothing copied during this period will be captured or stored. Perfect for handling sensitive data." 
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                        <TextBlock x:Name="IncognitoStatusText" Text="" FontSize="11" Foreground="#F59E0B" Margin="38,6,0,0" Visibility="Collapsed" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ComboBox x:Name="IncognitoDurationCombo" MinWidth="110" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <ComboBoxItem Content="1 hour" Tag="1"/>
                                            <ComboBoxItem Content="3 hours" Tag="3"/>
                                            <ComboBoxItem Content="6 hours ✦" Tag="6"/>
                                            <ComboBoxItem Content="8 hours ✦" Tag="8"/>
                                        </ComboBox>
                                        <ui:Button x:Name="IncognitoToggleBtn" Appearance="Caution" Content="Enable" Padding="12,6" FontWeight="Bold" Click="IncognitoToggle_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>


                            <!-- ═══ SECTION 3: SIZE & LAYOUT ═══ -->
                            <StackPanel Margin="0,24,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Size &amp; Layout" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,8,0,12"/>
                            </StackPanel>

                            <!-- Clipboard Size + FlyShelf Size (2-col grid) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COL 0: Clipboard Size -->
                                <Border Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#6366F1" Offset="0"/>
                                                                <GradientStop Color="#818CF8" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <ui:SymbolIcon Symbol="ResizeLarge24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Clipboard Size" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                            <Border Background="#6366F1" CornerRadius="4" Margin="6,0,0,0" Padding="5,1,5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="PRO" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock x:Name="SummonHotkeyLabel" Text="Alt+C / Widget popup" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Appearance="Secondary" Click="PreviewClipboardSize_Click" ToolTip="Preview" Padding="6,4" CornerRadius="8" Margin="0,0,4,0">
                                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" FontSize="12" /></ui:Button.Icon>
                                                    </ui:Button>
                                                    <ui:Button Appearance="Secondary" Click="ResetClipboardSize_Click" ToolTip="Reset" Padding="6,4" CornerRadius="8">
                                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="12" /></ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Width" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormWidth, StringFormat='{}{0}px'}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipW_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                        <Slider Grid.Column="1" Minimum="200" Maximum="500" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormWidth}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ClipboardSizeSlider_ValueChanged"/>
                                                        <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipW_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Height" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormHeight, StringFormat='{}{0}px'}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipH_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                        <Slider Grid.Column="1" Minimum="300" Maximum="700" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormHeight}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ClipboardSizeSlider_ValueChanged"/>
                                                        <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipH_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <Grid Background="Transparent" MouseDown="SizingLockedCard_MouseDown" Visibility="Collapsed" x:Name="ClipboardSizeLockedOverlay"/>
                                    </Grid>
                                </Border>

                                <!-- COL 2: FlyShelf Size -->
                                <Border Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#A855F7" Offset="0"/>
                                                                <GradientStop Color="#C084FC" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <ui:SymbolIcon Symbol="SquareMultiple24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="FlyShelf Size" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                            <Border Background="#A855F7" CornerRadius="4" Margin="6,0,0,0" Padding="5,1,5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="PRO" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="Mouse Shake mini" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Appearance="Secondary" Click="PreviewFlyShelfSize_Click" ToolTip="Preview" Padding="6,4" CornerRadius="8" Margin="0,0,4,0">
                                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" FontSize="12" /></ui:Button.Icon>
                                                    </ui:Button>
                                                    <ui:Button Appearance="Secondary" Click="ResetFlyShelfSize_Click" ToolTip="Reset" Padding="6,4" CornerRadius="8">
                                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="12" /></ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Width" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormWidth, StringFormat='{}{0}px'}" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropW_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                        <Slider Grid.Column="1" Minimum="180" Maximum="400" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormWidth}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="FlyShelfSizeSlider_ValueChanged"/>
                                                        <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropW_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Height" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormHeight, StringFormat='{}{0}px'}" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropH_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                        <Slider Grid.Column="1" Minimum="100" Maximum="350" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormHeight}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="FlyShelfSizeSlider_ValueChanged"/>
                                                        <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropH_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <Grid Background="Transparent" MouseDown="SizingLockedCard_MouseDown" Visibility="Collapsed" x:Name="FlyShelfSizeLockedOverlay"/>
                                    </Grid>
                                </Border>
                            </Grid>


                            <!-- ═══ SECTION 4: WIDGET ═══ -->
                            <StackPanel Margin="0,24,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧩" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Widget" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,8,0,12"/>
                            </StackPanel>

                            <!-- Widget Toggles (2-col grid) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COL 0: Taskbar Widget -->
                                <Border Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#0EA5E9" Offset="0"/>
                                                            <GradientStop Color="#38BDF8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Pin24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Taskbar Widget" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Show the FlyShelf quick-access widget embedded in your taskbar. System tray icon stays visible regardless." 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="TaskbarWidgetToggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableTaskbarWidget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="TaskbarWidgetToggle_Changed" Unchecked="TaskbarWidgetToggle_Changed" />
                                    </Grid>
                                </Border>

                                <!-- COL 2: Desktop Mascot -->
                                <Border Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#A855F7" Offset="0"/>
                                                            <GradientStop Color="#C084FC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Emoji24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Desktop Mascot" FontWeight="Bold" FontSize="14" Foreground="#C084FC" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Show your pet mascot companion on the desktop. The mascot reacts to clipboard events, idles when inactive, and can be dragged around freely." 
                                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="DesktopMascotToggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableDesktopMascot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Widget Positioning -->
                            <Border x:Name="WidgetPositioningSection" Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,12"
                                    Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableTaskbarWidget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                    <GradientStop Color="#818CF8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="ArrowMove24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Widget Positioning" FontWeight="Bold" FontSize="14" Foreground="#818CF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Select how the widget is positioned on your taskbar. Choose an alignment preset or select Custom to place it anywhere." 
                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,8" TextWrapping="Wrap" LineHeight="17"/>
                                    
                                    <!-- Preset Button Row -->
                                    <UniformGrid Rows="1" Margin="38,4,16,12" HorizontalAlignment="Stretch">
                                        <ui:Button x:Name="AlignAutoBtn" Content="Auto" Click="AlignAuto_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <ui:Button x:Name="AlignLeftBtn" Content="Far Left" Click="AlignLeft_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <ui:Button x:Name="AlignStartBtn" Content="After Start" Click="AlignStart_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <ui:Button x:Name="AlignTrayBtn" Content="Before Tray" Click="AlignTray_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <ui:Button x:Name="AlignCustomBtn" Content="Custom" Click="AlignCustom_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    </UniformGrid>

                                    <!-- Pixels fine-tune offset slider (for modes -1, 0, 1, 2) -->
                                    <StackPanel x:Name="PixelOffsetContainer">
                                        <TextBlock Text="Fine-tune Offset (Pixels)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="38,4,16,4"/>
                                        <Grid Margin="38,0,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="-200" Maximum="200" 
                                                    Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=WidgetHorizontalOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" MinWidth="50" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}">
                                                <TextBlock.Text>
                                                    <Binding Source="{x:Static settings:SettingsManager.Current}" Path="WidgetHorizontalOffset" StringFormat="{}{0}px"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Percentage position slider (for custom mode 3) -->
                                    <StackPanel x:Name="PercentagePositionContainer" Visibility="Collapsed">
                                        <TextBlock Text="Custom Position (Percentage of Taskbar)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="38,4,16,4"/>
                                        <Grid Margin="38,0,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="0" Maximum="100" 
                                                    Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=WidgetHorizontalOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" MinWidth="50" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}">
                                                <TextBlock.Text>
                                                    <Binding Source="{x:Static settings:SettingsManager.Current}" Path="WidgetHorizontalOffset" StringFormat="{}{0}%"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                </StackPanel>
                            </Border>


                            <!-- ═══ SECTION 5: THEME & APPEARANCE ═══ -->
                            <StackPanel Margin="0,24,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎨" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Theme &amp; Appearance" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,8,0,12"/>
                            </StackPanel>

                            <!-- Aero Clipboard UI -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                                        <GradientStop Color="#38BDF8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="DesignIdeas24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Aero Clipboard UI" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Switch to a clean minimal clipboard design with compact accent-bar cards and themed gradient backgrounds." 
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=UseAlternateClipboardUI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <!-- Theme & Appearance: Wallpaper + Blur -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#E11D48" Offset="0"/>
                                                    <GradientStop Color="#F472B6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="PaintBrush24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Theme &amp; Appearance" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            <TextBlock Text="Personalize the look of your clipboard" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Wallpaper -->
                                        <Border Grid.Column="0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Wallpaper" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,10"/>
                                                <Border x:Name="WallpaperPreview" Height="60" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Image x:Name="WallpaperPreviewImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="No wallpaper" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   x:Name="NoWallpaperText"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Content="Choose" Appearance="Primary" Padding="10,5" CornerRadius="8" Click="ChooseWallpaper_Click" Margin="0,0,6,0" FontSize="11"/>
                                                    <ui:Button Content="Remove" Appearance="Secondary" Padding="10,5" CornerRadius="8" Click="RemoveWallpaper_Click" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Blur / Transparency -->
                                        <Border Grid.Column="2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Blur Effect" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,10"/>
                                                <Border Height="60" CornerRadius="8" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" Margin="0,0,0,10">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Drop24" FontSize="22" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Mica Blur" FontSize="10" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Enable Blur" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableBlurBehind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="BlurToggle_Changed" Unchecked="BlurToggle_Changed"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Color Scheme (hidden — always Dark Mode) -->
                                        <Border Grid.Column="4" Visibility="Collapsed" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Color Scheme" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,10"/>
                                                <Border Height="60" CornerRadius="8" Margin="0,0,0,10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1a1a2e" Offset="0"/>
                                                            <GradientStop Color="#f0f0f5" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="DarkTheme24" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Theme" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0" IsEnabled="False">
                                                    <ComboBoxItem Content="Dark Mode" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ═ ═ ═ COLOR THEME ═ ═ ═ -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,12,0,20">
                                <StackPanel>
                                    <!-- Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                    <GradientStop Color="#EC4899" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Color24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Color Theme" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            <TextBlock Text="Switch between color palettes for the entire app" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ── Background Style ── -->
                                    <TextBlock Text="Background Style" FontWeight="SemiBold" FontSize="11" 
                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,8"/>
                                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                                        <!-- Mica Blur -->
                                        <Border x:Name="DisplayBtn_Mica" Margin="0,0,6,0" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="DisplayMode_Click" Tag="__mica__">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#9CA3AF" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#6B7280" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#374151"/>
                                                </StackPanel>
                                                <TextBlock Text="Mica Blur" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Acrylic Blur (Pro) -->
                                        <Border x:Name="DisplayBtn_Glass" Margin="0,0,6,0" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="DisplayMode_Click" Tag="__glass__">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#60A5FA" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#3B82F6" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#1E3A5F"/>
                                                </StackPanel>
                                                <TextBlock x:Name="DisplayBtn_Glass_Label" Text="🔒 Acrylic Blur" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- FlyShelf (Desktop Wallpaper) -->
                                        <Border x:Name="DisplayBtn_Desktop" Margin="0,0,0,0" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="DisplayMode_Click" Tag="__desktop__">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#D97706" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#F59E0B" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#1C1917"/>
                                                </StackPanel>
                                                <TextBlock Text="FlyShelf" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- ── Color Palette ── -->
                                    <TextBlock Text="Color Palette" FontWeight="SemiBold" FontSize="11" 
                                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,8"/>

                                    <!-- Theme Grid: 3 columns × 3 rows -->
                                    <UniformGrid Rows="3" Columns="3" x:Name="ColorThemeGrid">
                                        <!-- Midnight -->
                                        <Border x:Name="ThemeBtn_Midnight" Margin="0,0,6,6" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorTheme_Click" Tag="Midnight">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#6366F1" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#818CF8" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#1E1B4B"/>
                                                </StackPanel>
                                                <TextBlock Text="Midnight" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ocean -->
                                        <Border x:Name="ThemeBtn_Ocean" Margin="0,0,6,6" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorTheme_Click" Tag="Ocean">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#0891B2" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#22D3EE" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#0C2D48"/>
                                                </StackPanel>
                                                <TextBlock Text="Ocean" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Sunset -->
                                        <Border x:Name="ThemeBtn_Sunset" Margin="0,0,0,6" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorTheme_Click" Tag="Sunset">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#EA580C" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#FB923C" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#431407"/>
                                                </StackPanel>
                                                <TextBlock Text="Sunset" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Emerald -->
                                        <Border x:Name="ThemeBtn_Emerald" Margin="0,0,6,0" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorTheme_Click" Tag="Emerald">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#059669" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#34D399" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#052E16"/>
                                                </StackPanel>
                                                <TextBlock Text="Emerald" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Lavender -->
                                        <Border x:Name="ThemeBtn_Lavender" Margin="0,0,6,0" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorTheme_Click" Tag="Lavender">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#7C3AED" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#A78BFA" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#2E1065"/>
                                                </StackPanel>
                                                <TextBlock Text="Lavender" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Arctic Snow -->
                                        <Border x:Name="ThemeBtn_ArcticSnow" Margin="0,0,0,0" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorTheme_Click" Tag="ArcticSnow">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#4F46E5" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#CBD5E1" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#F3F3F3"/>
                                                </StackPanel>
                                                <TextBlock Text="Arctic Snow" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Default (Reset) -->
                                        <Border x:Name="ThemeBtn_Default" Margin="0,0,6,0" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorTheme_Click" Tag="Default">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Ellipse Width="14" Height="14" Fill="#9CA3AF" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#6B7280" Margin="0,0,4,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#374151"/>
                                                </StackPanel>
                                                <TextBlock Text="Default" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- ═ ═ ═ MASCOT THEMES ═ ═ ═ -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                    <GradientStop Color="#D946EF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Wand24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Mascot Themes" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            <TextBlock Text="Community-powered animated companions" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Mascot Preview -->
                                    <Border CornerRadius="14" Padding="20,16" Margin="0,0,0,14" HorizontalAlignment="Stretch"
                                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                        <Grid HorizontalAlignment="Center">
                                            <!-- Glow behind mascot -->
                                            <Border Width="110" Height="110" CornerRadius="55" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                                        <GradientStop Color="#D946EF" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- Mascot image -->
                                            <Image Source="/Resources/FlyShelfMascot.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Enable/Disable Toggle -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Enable Mascot Animations" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                <TextBlock Text="Show animated characters on your clipboard that react to your actions" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=ThemeAnimationsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <!-- Summon Animations Toggle -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Enable Summon Animations" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                <TextBlock Text="Play smooth fade-in and scale animations when opening and closing the clipboard (uncheck for instant 0ms response)" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableSummonAnimations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <!-- Active Theme Selector -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Active Theme" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                <TextBlock Text="Select from installed theme packs" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="160" SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="FlyShelf (Classic)" Tag=""/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>



                 <!-- 5. SYSTEM LOGS TAB -->
                <Grid x:Name="LogsGrid" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="System Logs" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                            <TextBlock Text="Unified execution log — clipboard events, network sync, server diagnostics, and fault traces." FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="2" CornerRadius="1" HorizontalAlignment="Left" Width="60" Margin="0,8,0,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button x:Name="SendAllLogsBtn" Padding="14,7" Margin="0,0,8,0" Click="SendAllLogs_Click" ToolTip="Copy all system, network, and server logs to clipboard as text">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Send24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Send All Logs" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Content="Refresh" Padding="14,7" Margin="0,0,8,0" Click="RefreshLogs_Click">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" /></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="📂 Open Logs Folder" Padding="14,7" Click="OpenLogsFolder_Click" />
                            <ui:Button Padding="14,7" Margin="8,0,0,0" Click="OpenNetworkLogs_Click" ToolTip="Open live network log viewer — shows logs from this PC and all paired devices in real-time">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Live Network Logs" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Padding="14,7" Margin="8,0,0,0" Click="OpenTransferManager_Click" ToolTip="Open LAN Transfer Manager — dedicated TCP file transfer dashboard with pause/resume">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Transfer Manager" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <!-- 2-Column Diagnostics & Live Network Monitor Dashboard -->
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Live Network Monitor -->
                            <Border Grid.Column="0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#15F472B6" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="#1AF472B6" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="12" Foreground="#F472B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Live Network Monitor" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Live Stats Row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- HTTP Requests Counter -->
                                        <Border Grid.Column="0" Background="#0A60A5FA" BorderBrush="#1560A5FA" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=HttpRequestCount}" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                                <TextBlock Text="HTTP Reqs" FontSize="8" Foreground="#60A5FA" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Downloads Counter -->
                                        <Border Grid.Column="2" Background="#0A34D399" BorderBrush="#1534D399" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=DownloadCount}" FontSize="14" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Downloads" FontSize="8" Foreground="#34D399" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Errors Counter -->
                                        <Border Grid.Column="4" Background="#0AEF4444" BorderBrush="#15EF4444" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=ErrorCount}" FontSize="14" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Errors" FontSize="8" Foreground="#EF4444" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Server Status -->
                                        <Border Grid.Column="6" Background="#0A8B5CF6" BorderBrush="#158B5CF6" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=ServerStatus}" FontSize="10" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Server" FontSize="8" Foreground="#8B5CF6" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Last Activity Status Bar -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="10" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=LastActivity}" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:Button x:Name="SendLogsToDashboardBtn" Padding="8,4" Click="SendLogsToDashboard_Click" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Send Logs" FontWeight="SemiBold" FontSize="10"/>
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Padding="8,4" Click="CopyNetworkLogs_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Copy Logs" FontWeight="SemiBold" FontSize="10"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>

                                    <!-- Live Event Feed -->
                                    <Border Background="#06000000" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Height="150" ClipToBounds="True">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                            <ItemsControl ItemsSource="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="10" 
                                                                   Foreground="{Binding ColorBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Padding="6,2" ToolTip="{Binding Message}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

