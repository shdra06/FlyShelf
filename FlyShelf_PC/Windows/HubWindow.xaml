<controls:MicaWindow x:Class="FlyShelf.Windows.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FlyShelf.ViewModels"
        xmlns:settings="clr-namespace:FlyShelf.Classes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:styles="clr-namespace:FlyShelf.Styles"
        Title="FlyShelf Ecosystem" 
        Height="650" 
        Width="900"
        MinWidth="300" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        SystemBackdropType="Mica"
        Background="Transparent"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" PreviewDragOver="Window_PreviewDragOver">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/HubWindowStyles.xaml"/>
                <styles:HubClipboardItemTemplate />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Application Native TitleBar -->
        <Grid Grid.Row="0" Margin="16,10,16,0" WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="/Resources/FlyShelfIcon.png" Width="22" Height="22" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="FlyShelf" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="Desktop Hub" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="6" Padding="8,3" Margin="0,0,4,0">
                    <TextBlock x:Name="VersionBadgeText" Text="v1.0.0" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Opacity="0.7"/>
                </Border>
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="16,0"/>

        <!-- Core Split Layout -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Dynamic Navigation Framework -->
            <ui:NavigationView x:Name="RootNavigation" Grid.Row="0" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Clipboard" Tag="History" IsActive="True" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Clipboard24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Dashboard" Tag="Dashboard" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ChartMultiple24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Network" Tag="Network" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Globe24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Settings" Tag="Settings" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="System Logs" Tag="Logs" PreviewMouseLeftButtonDown="Nav_Click">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Document24"/></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <!-- Embedded Content Grid (Hosts selected frames natively) -->
            <Grid Grid.Row="1" Margin="16,8,16,16">
                
                <!-- 0. DASHBOARD TAB -->
                <Grid x:Name="DashboardGrid" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="False" SnapsToDevicePixels="False" TextOptions.TextFormattingMode="Ideal">
                        <StackPanel Margin="0,8,0,0">

                            <!-- TOP ROW: 3 Stat Cards  -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Clipboard Items Stat -->
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="14" Padding="20,18" Cursor="Hand" Tag="History" MouseLeftButtonDown="DashboardCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1D4ED8" Offset="0"/>
                                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Database24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Clipboard" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding DroppedItems.Count}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Grid.Row="2" Text="items saved" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                    </Grid>
                                </Border>

                                <!-- Network Status Stat -->
                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="14" Padding="20,18" Cursor="Hand" Tag="Network" MouseLeftButtonDown="DashboardCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0D9488" Offset="0"/>
                                                        <GradientStop Color="#14B8A6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Wifi124" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Network" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Active" FontSize="36" FontWeight="Bold" Foreground="#14B8A6" Margin="0,0,0,2" />
                                        <TextBlock Grid.Row="2" Text="{Binding LocalServer.DisplayUrl}" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- BOTTOM ROW: 2 Feature Cards  -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Smart Suggestions Card -->
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" CornerRadius="14" Padding="0" Cursor="Hand" Tag="History" MouseLeftButtonDown="DashboardCard_Click" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#408B5CF6" BorderThickness="1">
                                    <Grid>
                                        <!-- Subtle gradient glow in background -->
                                        <Border CornerRadius="14" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Height="120" Margin="-20,-20,0,0">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Margin="24,22,24,22">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                                            <GradientStop Color="#8B5CF6" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Lightbulb24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Smart Suggestions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                                    <TextBlock Text="AI-powered" FontSize="11" Foreground="#8B5CF6" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Automatically recommends clipboard items based on your currently active application context." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Quick Actions Card -->
                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" CornerRadius="14" Padding="0" Cursor="Hand" Tag="Settings" MouseLeftButtonDown="DashboardCard_Click" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#40F59E0B" BorderThickness="1">
                                    <Grid>
                                        <Border CornerRadius="14" Opacity="0.12" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Height="120" Margin="-20,-20,0,0">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Margin="24,22,24,22">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#D97706" Offset="0"/>
                                                            <GradientStop Color="#F59E0B" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="Rocket24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                                    <TextBlock Text="Shortcuts" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Compile code, convert documents, merge PDFs, and launch tools directly from your clipboard items." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 1. CLIPBOARD TAB -->
                <Grid x:Name="HistoryGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        
                        <!-- Search Box (compact — no header above) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="12" Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.SystemAccentColor}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"
                                                x:Name="SearchPlaceholderPanel">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Search clips..." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12.5"/>
                                    </StackPanel>
                                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                             Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" 
                                             FontSize="12.5" Padding="14,10" CaretBrush="#6366F1"
                                             TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border CornerRadius="8" Padding="8,4" Margin="0,0,6,0" Background="#0A6366F1">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8B92A0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}">
                                                <Binding Path="DroppedItems.Count" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <ui:Button Appearance="Secondary" Padding="8,6" CornerRadius="10" ToolTip="Select All" Click="SelectAll_Click" Margin="0,0,6,0">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" />
                                </ui:Button>
                                <ui:Button Padding="8,6" CornerRadius="10" ToolTip="Delete All Items" Click="DeleteAll_Click" Foreground="#EF4444">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Background" Value="#15EF4444"/>
                                            <Setter Property="BorderBrush" Value="#30EF4444"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#25EF4444"/>
                                                    <Setter Property="BorderBrush" Value="#50EF4444"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#EF4444" Margin="0,0,5,0"/>
                                        <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                                        <!-- Filter Chips — Compact horizontal icon pills -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel.Resources>
                            <Style x:Key="FilterChipStyle" TargetType="RadioButton">
                                <Setter Property="Margin" Value="0,0,4,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="ChipBorder" CornerRadius="8" Padding="10,6" 
                                                    Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                                <ContentPresenter x:Name="ChipContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <RadioButton IsChecked="True" Checked="Filter_Checked" Tag="All" Style="{StaticResource FilterChipStyle}">
                            <TextBlock Text="All" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Text" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextDescription24" Foreground="#8B5CF6" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Text" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Code" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Code24" Foreground="#10B981" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Code" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Image" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Image24" Foreground="#F472B6" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Images" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Pdf" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="#EF4444" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="PDFs" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Document" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Document24" Foreground="#60A5FA" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Docs" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Url" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Link24" Foreground="#0EA5E9" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Links" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Checked="Filter_Checked" Tag="Video" Style="{StaticResource FilterChipStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Video24" Foreground="#F59E0B" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Videos" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    
                    <ListView x:Name="HubListView" Grid.Row="2" ItemsSource="{Binding DroppedItems}" Background="Transparent" BorderThickness="0"
                              Margin="0,0,2,0"
                              UseLayoutRounding="False" SnapsToDevicePixels="False"
                              TextOptions.TextFormattingMode="Ideal"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              HorizontalContentAlignment="Stretch" 
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="3,3" VirtualizingPanel.CacheLengthUnit="Page"
                              SelectionMode="Extended" SelectionChanged="HubListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <StaticResource ResourceKey="HubClipboardItemTemplate"/>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Floating Merge PDFs bar — appears when 2+ PDFs are checked -->
                    <Border x:Name="MergePdfFloatingBar" Grid.Row="2" Visibility="Collapsed"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                            CornerRadius="12" Padding="16,10,16,10"
                            IsHitTestVisible="True">
                        <Border.Background>
                            <SolidColorBrush Color="#1E1E2E" Opacity="0.95"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#EF4444" Opacity="0.5"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <Thickness>1</Thickness>
                        </Border.BorderThickness>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="#EF4444" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock x:Name="MergeBarText" Text="2 PDFs selected" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ui:Button x:Name="MergeBarBtn" Content="Merge PDFs" Padding="16,6" FontSize="12" Click="MergeSelectedPdfsBtn_Click">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentCopy24"/></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border Grid.Row="2" x:Name="EmptyStatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0C6366F1" Offset="0"/>
                                        <GradientStop Color="#068B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No clipboard items yet" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Copy text, images, files, or links to see them here." FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>

                </Grid>



                <!-- 3. NETWORK SYNC TAB -->
                <Grid x:Name="NetworkGrid" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="False" SnapsToDevicePixels="False" TextOptions.TextFormattingMode="Ideal">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Wi-Fi Sync Server" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                <TextBlock Text="Seamlessly connect your phone to your PC's clipboard." FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Height="2" CornerRadius="1" HorizontalAlignment="Left" Width="60" Margin="0,8,0,28">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Wifi124" FontSize="18" Foreground="#10B981" Margin="0,0,8,0"/>
                                <TextBlock Text="Local Network Broadcasting" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource PremiumSettingStyle}">
                                <StackPanel>
                                    <!-- LAN Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Local Network" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                <Border Background="#220EA5E9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="LAN" FontSize="10" FontWeight="Bold" Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Sync clipboard with devices on the same Wi-Fi network via direct IP connection." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableLocalLAN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,16" />
                                    
                                    <!-- Cloudflare Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Global Internet Tunnel" FontWeight="SemiBold" FontSize="14" Foreground="#10B981"/>
                                                <Border Background="#2210B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="CLOUDFLARE" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Securely broadcast your clipboard worldwide via a TryCloudflare reverse proxy inside FlyShelf." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableGlobalCloudflare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- AUTHENTICATION DETAILS -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableLocalNetworkSync, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#1AEAB308" Margin="0,0,10,0">
                                            <ui:SymbolIcon Symbol="Shield24" FontSize="14" Foreground="#EAB308" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Security PIN Code" FontWeight="Bold" FontSize="18" Foreground="#EAB308" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Enter this PIN when accessing your clipboard from any browser or device." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                    
                                    <Border Background="#11EAB308" BorderBrush="#22EAB308" BorderThickness="1.5" CornerRadius="14" Padding="32,14" HorizontalAlignment="Center" Margin="0,0,0,24">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#EAB308" BlurRadius="30" Opacity="0.15" Direction="0" ShadowDepth="0" />
                                        </Border.Effect>
                                        <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=WebClientPinToken}" FontSize="36" FontWeight="Bold" Foreground="#EAB308" FontFamily="Consolas" HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#EAB308" BlurRadius="15" Opacity="0.3" Direction="0" ShadowDepth="0" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                    
                                    <TextBlock Text="Your Connection URLs" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,12" HorizontalAlignment="Center" />
                                    
                                    <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Wi-Fi:" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LocalServer.DisplayUrl}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Copy" Margin="12,0,0,0" Padding="8,2" FontSize="11" Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDisabled}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Cursor="Hand" Click="CopyUrl_Click" Tag="{Binding LocalServer.DisplayUrl}" MinWidth="55" />
                                    </Grid>
                                    
                                    <Grid HorizontalAlignment="Center" Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableGlobalCloudflare, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Global:" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LocalServer.GlobalUrl}" FontSize="15" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Copy" Margin="12,0,0,0" Padding="8,2" FontSize="11" Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDisabled}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Cursor="Hand" Click="CopyUrl_Click" Tag="{Binding LocalServer.GlobalUrl}" MinWidth="55"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- QUICK PAIR QR CODE -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableLocalNetworkSync, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="QrCode24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Quick Pair" FontWeight="Bold" FontSize="18" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Scan this QR code with FlyShelf Mobile or enter the pairing code below." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- QR Code Display -->
                                    <Border Background="White" CornerRadius="16" Padding="12" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#6366F1" BlurRadius="30" Opacity="0.2" Direction="0" ShadowDepth="0" />
                                        </Border.Effect>
                                        <Image x:Name="PairingQRImage" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <ui:Button Content="🔄 Regenerate QR" Padding="14,8" Click="RegenerateQR_Click" Margin="0,0,8,0" FontSize="11"/>
                                        <ui:Button Content="📋 Copy Pairing Info" Padding="14,8" Click="CopyPairingInfo_Click" FontSize="11"/>
                                    </StackPanel>

                                    <!-- PAIRING CODE DISPLAY -->
                                    <Border Background="#08A78BFA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" HorizontalAlignment="Center" MinWidth="280">
                                        <StackPanel>
                                            <TextBlock Text="Your Pairing Code" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="PairingCodeDisplay" Text="------" FontSize="32" FontWeight="Black"
                                                       FontFamily="Consolas" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Share this code with any device to connect" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                                            <ui:Button Content="🔑 Generate New Code" Padding="12,6" 
                                                       Click="GeneratePairingCode_Click" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ENTER CODE FROM ANOTHER DEVICE -->
                                    <Border Background="#1A10B981" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" HorizontalAlignment="Center" MinWidth="280"
                                            BorderBrush="#4010B981" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Connect to Another Device" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:TextBox x:Name="RemoteCodeInput" PlaceholderText="Enter 6-char code" Width="180" FontSize="16"
                                                            FontFamily="Consolas" HorizontalContentAlignment="Center" MaxLength="6"
                                                            VerticalAlignment="Center"/>
                                                <ui:Button Content="Connect" Margin="8,0,0,0" Padding="14,8"
                                                           Click="ConnectByCode_Click" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Enter the code shown on the other PC or phone" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═ ═ ═ LIVE P2P PEER STATUS ═ ═ ═ -->
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" Margin="0,4,0,14" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Paired Devices" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                        <Border Background="#1510B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="PeerCountBadge" Text="0 online" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <ui:Button Content="🔄 Force Sync" Padding="8,3" 
                                                   Click="ForcePeerSync_Click" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="Re-fetch all peer URLs from Firebase and reconnect"/>
                                        <ui:Button Content="📡 Live Logs" Padding="8,3"
                                                   Click="OpenNetworkLogs_Click" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="View live logs from this device and all paired devices"/>
                                    </StackPanel>

                                    <!-- Live P2P status from PeerManager (5s heartbeat) -->
                                    <ItemsControl x:Name="PeerStatusPanel">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                                                                    <Setter Property="Background" Value="#0810B981"/>
                                                                    <Setter Property="BorderBrush" Value="#2010B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Device icon -->
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlive}" Value="True">
                                                                            <Setter Property="Foreground" Value="#A78BFA"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>

                                                        <!-- Name + transport info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DeviceName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- LAN status dot -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                            <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLanActive}" Value="True">
                                                                                <Setter Property="Background" Value="#10B981"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <TextBlock Text="LAN" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLanActive}" Value="True">
                                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Cloud status dot -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                            <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCloudActive}" Value="True">
                                                                                <Setter Property="Background" Value="#F59E0B"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <TextBlock Text="Cloud" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCloudActive}" Value="True">
                                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Copy Logs button -->
                                                        <Button Grid.Column="4" Tag="{Binding ActiveUrl}" Click="CopyDeviceLogs_Click"
                                                                Padding="6,3" FontSize="9" FontWeight="SemiBold" Cursor="Hand"
                                                                Background="#206366F1" Foreground="#A5B4FC" BorderThickness="0"
                                                                ToolTip="Copy this device's logs to clipboard" VerticalAlignment="Center" Margin="6,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📋" FontSize="10" Margin="0,0,3,0"/>
                                                                <TextBlock Text="Copy Logs" FontSize="9"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Remove button -->
                                                        <Button Grid.Column="5" Content="✕" Tag="{Binding DeviceId}" Click="RemovePairedDevice_Click" 
                                                                Padding="4,2" FontSize="10" Background="Transparent" BorderThickness="0" 
                                                                Foreground="#EF4444" Cursor="Hand" ToolTip="Remove device" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoPairedDevicesText" Text="No devices paired yet — scan the QR code above" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>


                            <!-- ACTIVE DEVICES SECTION -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
                                <ui:SymbolIcon Symbol="People24" FontSize="18" Foreground="#8B5CF6" Margin="0,0,8,0"/>
                                <TextBlock Text="Connected Devices" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource PremiumSettingStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Live Mesh Topology" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            <TextBlock Text="All devices registered in the Firebase active_devices node." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Padding="12,8" Click="RefreshDevices_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Refresh" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>

                                    <!--  2-COLUMN DEVICE TOPOLOGY -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LAN Column -->
                                        <Border Grid.Column="0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="10,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="LAN" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                                </StackPanel>
                                                <TextBlock Text="Same network" FontSize="9" Foreground="#10B98188" Margin="0,-6,0,8"/>
                                                <ItemsControl x:Name="LanDevicesPanel">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" MouseRightButtonDown="DeviceInfo_RightClick" ToolTip="Right-click for connection info">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon FontSize="14" Foreground="#10B981" Margin="0,0,8,0">
                                                                            <ui:SymbolIcon.Style>
                                                                                <Style TargetType="ui:SymbolIcon">
                                                                                    <Setter Property="Symbol" Value="Phone24"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DeviceType}" Value="PC">
                                                                                            <Setter Property="Symbol" Value="Desktop24"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ui:SymbolIcon.Style>
                                                                        </ui:SymbolIcon>
                                                                        <TextBlock Text="{Binding DeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding ConnectionInfo}" FontSize="9" Foreground="#10B98188" Margin="22,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="LanEmptyText" Text="No other LAN peers" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cloud Column -->
                                        <Border Grid.Column="2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="10,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Cloud" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
                                                </StackPanel>
                                                <TextBlock Text="Global sync active" FontSize="9" Foreground="#F59E0B88" Margin="0,-6,0,8"/>
                                                <ItemsControl x:Name="CloudDevicesPanel">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource MicaWPF.Brushes.ControlFillColorDefault}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" MouseRightButtonDown="DeviceInfo_RightClick" ToolTip="Right-click for connection info">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon FontSize="14" Foreground="#F59E0B" Margin="0,0,8,0">
                                                                            <ui:SymbolIcon.Style>
                                                                                <Style TargetType="ui:SymbolIcon">
                                                                                    <Setter Property="Symbol" Value="Phone24"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DeviceType}" Value="PC">
                                                                                            <Setter Property="Symbol" Value="Desktop24"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ui:SymbolIcon.Style>
                                                                        </ui:SymbolIcon>
                                                                        <TextBlock Text="{Binding DeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding ConnectionInfo}" FontSize="9" Foreground="#F59E0B88" Margin="22,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="CloudEmptyText" Text="No cloud devices" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>


                                    <!-- Empty State -->
                                    <StackPanel x:Name="NoDevicesPanel" HorizontalAlignment="Center" Margin="0,12,0,12" Visibility="Collapsed">
                                        <ui:SymbolIcon Symbol="PeopleSearch24" FontSize="32" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="No devices found - hit Refresh" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- DEVICE GROUPS -->
                            <StackPanel Orientation="Horizontal" Margin="0,24,0,14">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Device Groups" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" />
                                <Button x:Name="CreateGroupBtn" Content="+ New Group" Margin="12,0,0,0" Padding="10,4" FontSize="10" FontWeight="Bold" Click="CreateGroupBtn_Click"
                                        Background="#F59E0B" Foreground="#000" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <ItemsControl x:Name="GroupsPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                    <TextBlock Text="{Binding DeviceList}" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Edit" Tag="{Binding Id}" Click="EditGroupBtn_Click" Padding="6,4" Margin="0,0,4,0" Cursor="Hand" Background="Transparent" Foreground="#F59E0B" BorderThickness="0" FontSize="12"/>
                                                    <Button Content="Del" Tag="{Binding Id}" Click="DeleteGroupBtn_Click" Padding="6,4" Cursor="Hand" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoGroupsText" Text="No groups - create one to sync across devices" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                            <!-- LIVE NETWORK MONITOR -->
                            <StackPanel Orientation="Horizontal" Margin="0,24,0,14">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="18" Foreground="#F472B6" Margin="0,0,8,0"/>
                                <TextBlock Text="Live Network Monitor" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Style="{StaticResource PremiumSettingStyle}">
                                <StackPanel>
                                    <!-- Live Stats Row -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- HTTP Requests Counter -->
                                        <Border Grid.Column="0" Background="#0A60A5FA" BorderBrush="#1560A5FA" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=HttpRequestCount}" FontSize="22" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                                <TextBlock Text="HTTP Reqs" FontSize="10" Foreground="#60A5FA" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Downloads Counter -->
                                        <Border Grid.Column="2" Background="#0A34D399" BorderBrush="#1534D399" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=DownloadCount}" FontSize="22" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Downloads" FontSize="10" Foreground="#34D399" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Errors Counter -->
                                        <Border Grid.Column="4" Background="#0AEF4444" BorderBrush="#15EF4444" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=ErrorCount}" FontSize="22" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Errors" FontSize="10" Foreground="#EF4444" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Server Status -->
                                        <Border Grid.Column="6" Background="#0A8B5CF6" BorderBrush="#158B5CF6" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=ServerStatus}" FontSize="14" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Server" FontSize="10" Foreground="#8B5CF6" Opacity="0.7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Last Activity -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="#10B981" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=LastActivity}" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons: Send & Copy -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <ui:Button x:Name="SendLogsToDashboardBtn" Padding="14,8" Click="SendLogsToDashboard_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Send Logs to Dashboard" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Padding="14,8" Click="CopyNetworkLogs_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Copy Logs" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>

                                    <!-- Live Event Feed -->
                                    <TextBlock Text="Event Feed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,0,0,8"/>
                                    <Border Background="#06000000" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="10" Height="280" ClipToBounds="True">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                            <ItemsControl ItemsSource="{Binding Source={x:Static settings:NetworkActivityLog.Instance}, Path=Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11.5" 
                                                                   Foreground="{Binding ColorBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Padding="8,3" ToolTip="{Binding Message}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 4. CORE SETTINGS TAB -->
                <Grid x:Name="SettingsGrid" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" CanContentScroll="False" PanningMode="None" UseLayoutRounding="False" SnapsToDevicePixels="False" TextOptions.TextFormattingMode="Ideal">
                        <StackPanel>
                            <!-- Settings Meta -->
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Core Settings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                                <TextBlock Text="Personalize the behavior and look of FlyShelf." FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Height="2" CornerRadius="1" HorizontalAlignment="Left" Width="60" Margin="0,8,0,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!--  2-COLUMN CARD GRID -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 0, COL 0: Device Identity -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Person24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Device Identity" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Identifies your computer across the cloud clipboard feed." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="16"/>
                                        <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Master PC or Work Laptop" />
                                    </StackPanel>
                                </Border>

                                <!-- ROW 0, COL 2: AI Engine Key -->
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                                        <GradientStop Color="#FBBF24" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Brain24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="AI Extraction Key" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Required for Smart Text Extraction from images." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="16"/>
                                        <ui:PasswordBox PasswordChar="*" HorizontalAlignment="Stretch" Password="{Binding Source={x:Static settings:SettingsManager.Current}, Path=GeminiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="AIzaSyA..." BorderThickness="1"/>
                                    </StackPanel>
                                </Border>

                                <!-- ROW 1, COL 0: Drag Behavior -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#10B981" Offset="0"/>
                                                            <GradientStop Color="#34D399" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="HandDraw24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Drag Behavior" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Keep items in history after dragging out of FlyShelf." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,12,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=KeepItemOnDragOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- ROW 1, COL 2: Bar Position -->
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                                        <GradientStop Color="#38BDF8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="ResizeLarge24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Bar Position" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Where the hover drop target appears." Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="16"/>
                                        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Source={x:Static settings:SettingsManager.Current}, Path=WidgetTaskbarAlignment}">
                                            <ComboBoxItem Content="Corner Left Anchor" />
                                            <ComboBoxItem Content="Centered Floating" />
                                            <ComboBoxItem Content="Corner Right Clock" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- ROW 2: Full-width Clipboard Size card -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#6366F1" Offset="0"/>
                                                            <GradientStop Color="#818CF8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="ResizeLarge24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Clipboard Size" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                    <TextBlock Text="Alt+C / Widget popup" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Appearance="Secondary" Click="PreviewClipboardSize_Click" ToolTip="Preview" Padding="6,4" CornerRadius="8" Margin="0,0,4,0">
                                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" FontSize="12" /></ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary" Click="ResetClipboardSize_Click" ToolTip="Reset" Padding="6,4" CornerRadius="8">
                                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="12" /></ui:Button.Icon>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Width" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormWidth, StringFormat='{}{0}px'}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipW_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                    <Slider Grid.Column="1" Minimum="200" Maximum="500" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormWidth}" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                    <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipW_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Height" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormHeight, StringFormat='{}{0}px'}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipH_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                    <Slider Grid.Column="1" Minimum="300" Maximum="700" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MediumFormHeight}" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                    <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="ClipH_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ROW 2, COL 2: FlyShelf Size -->
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PremiumSettingStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#A855F7" Offset="0"/>
                                                            <GradientStop Color="#C084FC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:SymbolIcon Symbol="SquareMultiple24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="FlyShelf Size" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                    <TextBlock Text="Mouse Shake mini" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Appearance="Secondary" Click="PreviewFlyShelfSize_Click" ToolTip="Preview" Padding="6,4" CornerRadius="8" Margin="0,0,4,0">
                                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" FontSize="12" /></ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary" Click="ResetFlyShelfSize_Click" ToolTip="Reset" Padding="6,4" CornerRadius="8">
                                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="12" /></ui:Button.Icon>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Width" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormWidth, StringFormat='{}{0}px'}" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropW_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                    <Slider Grid.Column="1" Minimum="180" Maximum="400" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormWidth}" TickFrequency="20" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                    <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropW_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Height" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormHeight, StringFormat='{}{0}px'}" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="-" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropH_Minus" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                                    <Slider Grid.Column="1" Minimum="100" Maximum="350" Value="{Binding Source={x:Static settings:SettingsManager.Current}, Path=MiniFormHeight}" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                    <ui:Button Grid.Column="2" Content="+" Padding="4,1" CornerRadius="4" Appearance="Secondary" Click="DropH_Plus" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ROW 3: Full-width Save + Update -->
                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource PremiumSettingStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Save Config -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <ui:Button Appearance="Primary" Click="SaveSettings_Click" HorizontalAlignment="Stretch" Content="Save Configuration" Padding="10,8" CornerRadius="8" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <!-- Update Section -->
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,8,0">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#059669" Offset="0"/>
                                                                    <GradientStop Color="#34D399" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="App Updates" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="CurrentVersionText" Text="v1.0.0" FontSize="10" Foreground="#A78BFA" FontWeight="SemiBold"/>
                                                                <TextBlock x:Name="LatestVersionText" Text="" FontSize="10" Foreground="#34D399" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button x:Name="RedownloadBtn" Appearance="Secondary" Padding="8,5" CornerRadius="8" Click="RedownloadBtn_Click" Margin="0,0,6,0" ToolTip="Re-download current version from GitHub (repair install)">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Repair" FontSize="11" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </ui:Button>
                                                    <ui:Button x:Name="UpdateBtn" Appearance="Primary" Content="Check for Updates" Padding="10,5" CornerRadius="8" FontWeight="SemiBold" Click="UpdateBtn_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border x:Name="UpdateProgressPanel" Visibility="Collapsed" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="UpdateStatusText" Text="Checking..." FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="UpdatePctText" Text="" Grid.Column="1" FontSize="11" Foreground="#34D399" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <Border Background="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" CornerRadius="2" Height="4">
                                                        <Border x:Name="UpdateProgressBar" CornerRadius="2" HorizontalAlignment="Left" Width="0">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#34D399" Offset="0"/>
                                                                    <GradientStop Color="#6EE7B7" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="ChangelogPanel" Visibility="Collapsed" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="What's new" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="ChangelogText" Text="" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" LineHeight="16"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Run at Startup -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,12,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#10B981" Offset="0"/>
                                                        <GradientStop Color="#34D399" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Play24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Run at Startup" FontWeight="Bold" FontSize="14" Foreground="#34D399" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Launch FlyShelf automatically when you log into Windows." 
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=AutoStartEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <!-- Shake to Open -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="CursorClick24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Shake to Open" FontWeight="Bold" FontSize="14" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Rapidly shake your mouse while holding left-click to summon FlyShelf at your cursor position." 
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableShakeToOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <!-- Theme & Appearance -->
                            <!-- Taskbar Widget Toggle -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                                        <GradientStop Color="#38BDF8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Pin24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Taskbar Widget" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Show the FlyShelf quick-access widget embedded in your taskbar. System tray icon stays visible regardless." 
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableTaskbarWidget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <!-- Auto Cleanup -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                                        <GradientStop Color="#FBBF24" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Auto Cleanup" FontWeight="Bold" FontSize="14" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Automatically delete unpinned clipboard entries older than the retention period. Pinned items are never deleted." 
                                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" FontSize="12" Margin="38,0,16,0" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                    <ComboBox x:Name="RetentionCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="120" SelectionChanged="RetentionCombo_SelectionChanged">
                                        <ComboBoxItem Content="7 days" Tag="7"/>
                                        <ComboBoxItem Content="14 days" Tag="14"/>
                                        <ComboBoxItem Content="30 days" Tag="30"/>
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Theme & Appearance -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,12,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#E11D48" Offset="0"/>
                                                    <GradientStop Color="#F472B6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="PaintBrush24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Theme &amp; Appearance" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            <TextBlock Text="Personalize the look of your clipboard" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Wallpaper -->
                                        <Border Grid.Column="0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Wallpaper" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,10"/>
                                                <Border x:Name="WallpaperPreview" Height="60" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Image x:Name="WallpaperPreviewImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="No wallpaper" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   x:Name="NoWallpaperText"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Content="Choose" Appearance="Primary" Padding="10,5" CornerRadius="8" Click="ChooseWallpaper_Click" Margin="0,0,6,0" FontSize="11"/>
                                                    <ui:Button Content="Remove" Appearance="Secondary" Padding="10,5" CornerRadius="8" Click="RemoveWallpaper_Click" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Blur / Transparency -->
                                        <Border Grid.Column="2" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Blur Effect" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,10"/>
                                                <Border Height="60" CornerRadius="8" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" Margin="0,0,0,10">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Drop24" FontSize="22" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Mica Blur" FontSize="10" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Enable Blur" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" VerticalAlignment="Center"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableBlurBehind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="BlurToggle_Changed" Unchecked="BlurToggle_Changed"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Color Scheme -->
                                        <Border Grid.Column="4" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Color Scheme" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Margin="0,0,0,10"/>
                                                <Border Height="60" CornerRadius="8" Margin="0,0,0,10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1a1a2e" Offset="0"/>
                                                            <GradientStop Color="#f0f0f5" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="DarkTheme24" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Theme" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0" IsEnabled="False">
                                                    <ComboBoxItem Content="Dark Mode" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ═ ═ ═ MASCOT THEMES ═ ═ ═ -->
                            <Border Style="{StaticResource PremiumSettingStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                    <GradientStop Color="#D946EF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Wand24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Mascot Themes" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                            <TextBlock Text="Community-powered animated companions" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Mascot Preview -->
                                    <Border CornerRadius="14" Padding="20,16" Margin="0,0,0,14" HorizontalAlignment="Stretch"
                                            Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" 
                                            BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                                        <Grid HorizontalAlignment="Center">
                                            <!-- Glow behind mascot -->
                                            <Border Width="110" Height="110" CornerRadius="55" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                                        <GradientStop Color="#D946EF" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- Mascot image -->
                                            <Image Source="/Resources/FlyShelfMascot.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Enable/Disable Toggle -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Enable Mascot Animations" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                <TextBlock Text="Show animated characters on your clipboard that react to your actions" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=ThemeAnimationsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <!-- Summon Animations Toggle -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Enable Summon Animations" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                <TextBlock Text="Play smooth fade-in and scale animations when opening and closing the clipboard (uncheck for instant 0ms response)" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=EnableSummonAnimations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <!-- Active Theme Selector -->
                                    <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Active Theme" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                                                <TextBlock Text="Select from installed theme packs" FontSize="10" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="160" SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="FlyShelf (Classic)" Tag=""/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>



                 <!-- 5. SYSTEM LOGS TAB -->
                <Grid x:Name="LogsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="System Logs" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" />
                            <TextBlock Text="Unified execution log — clipboard events, network sync, server diagnostics, and fault traces." FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="2" CornerRadius="1" HorizontalAlignment="Left" Width="60" Margin="0,8,0,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button x:Name="SendAllLogsBtn" Padding="14,7" Margin="0,0,8,0" Click="SendAllLogs_Click" ToolTip="Copy all system, network, and server logs to clipboard as text">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Send24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Send All Logs" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Content="Refresh" Padding="14,7" Margin="0,0,8,0" Click="RefreshLogs_Click">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" /></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="📂 Open Logs Folder" Padding="14,7" Click="OpenLogsFolder_Click" />
                            <ui:Button Padding="14,7" Margin="8,0,0,0" Click="OpenNetworkLogs_Click" ToolTip="Open live network log viewer — shows logs from this PC and all paired devices in real-time">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Live Network Logs" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <!-- Server Troubleshooting (moved from Network tab) -->
                        <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="#15EF4444" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,6,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="#1AEF4444" Margin="0,0,8,0">
                                        <ui:SymbolIcon Symbol="WrenchScrewdriver24" FontSize="12" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Server Troubleshooting" FontWeight="Bold" FontSize="13" Foreground="#EF4444" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="🔄 Restart Server" Padding="10,5" Click="RestartServer_Click" Margin="0,0,6,0" FontSize="11"/>
                                    <ui:Button Content="📋 Copy Diagnostics" Padding="10,5" Click="CopyServerDiagnostics_Click" FontSize="11"/>
                                </StackPanel>
                                <Border Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="10" MaxHeight="150">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Name="ServerDiagnosticsLog" FontFamily="Consolas" FontSize="10" Foreground="#10B981" TextWrapping="Wrap" Text="Click 'Restart Server' to see diagnostics..." />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Danger Zone — Uninstall ═══ -->
                        <Border Background="#12EF4444" BorderBrush="#30EF4444" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,6,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="#25EF4444" Margin="0,0,8,0">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="12" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Danger Zone" FontWeight="Bold" FontSize="13" Foreground="#EF4444" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Permanently remove all FlyShelf data from this computer — clipboard history, images, synced files, settings, paired devices, logs, and certificates. This action cannot be undone." FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ui:Button x:Name="UninstallBtn" Appearance="Danger" Padding="14,7" Click="UninstallFlyShelf_Click" ToolTip="Delete all FlyShelf data from %AppData% and close the app">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Uninstall FlyShelf &amp; Remove All Data" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    <!-- Unified log viewer -->
                    <Border Grid.Row="1" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}" BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="14" Padding="0" Margin="0,0,0,8" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorTertiary}" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                                    <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,12,0"/>
                                    <TextBlock Text="flyshelf_unified.log" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                            <TextBox Grid.Row="1" x:Name="LogsTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="13" Foreground="#10B981" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" SelectionBrush="#3310B981" Padding="16,12" />
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</controls:MicaWindow>

