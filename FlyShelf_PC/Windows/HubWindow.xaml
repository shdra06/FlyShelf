                            </Border>

                            <!-- Tutorial Cards 2-Column Grid -->
                            <UniformGrid Columns="2" Margin="0,0,0,20">

                                <!-- Card 1: Summon & Dismiss -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="0,0,8,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#A78BFA" Offset="0"/>
                                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Summon &amp; Dismiss" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Press Alt+C to open your clipboard from anywhere. Press again or Esc to hide." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Drag & Drop -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="8,0,0,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#22D3EE" Offset="0"/>
                                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="CursorClick24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Drag &amp; Drop" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Drag files, images, or text into FlyShelf. Drag items out to paste them anywhere." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Cross-Device Sync -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="0,0,8,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Cross-Device Sync" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Pair your phone to sync clipboard between devices in real-time." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Quick Notes & To-Do -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="8,0,0,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FBBF24" Offset="0"/>
                                                    <GradientStop Color="#F59E0B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Notepad24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Quick Notes &amp; To-Do" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Click the notes icon to jot quick notes. Toggle the to-do list for tasks." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 5: Themes & Wallpapers -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="0,0,8,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F472B6" Offset="0"/>
                                                    <GradientStop Color="#EC4899" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Color24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Themes &amp; Wallpapers" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Open Settings to pick color themes and custom wallpapers for your shelf." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 6: Quick Paste -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="8,0,0,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Clipboard24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Quick Paste" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18">
                                            <Run FontWeight="Bold" Foreground="#A78BFA">Alt+1</Run><Run Text=" → Paste 1st item" /><LineBreak/>
                                            <Run FontWeight="Bold" Foreground="#A78BFA">Alt+2</Run><Run Text=" → Paste 2nd item" /><LineBreak/>
                                            <Run FontWeight="Bold" Foreground="#A78BFA">Alt+3</Run><Run Text=" → Paste 3rd item" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Card 7: Timer Shortcut -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="0,0,8,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F97316" Offset="0"/>
                                                    <GradientStop Color="#EA580C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="Timer24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Quick Timer" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18">
                                            <Run Text="Type " /><Run FontWeight="Bold" FontFamily="Consolas" Foreground="#F97316">/10</Run><Run Text=" to start a 10-min timer." /><LineBreak/>
                                            <Run Text="Works with any number — " /><Run FontFamily="Consolas" Foreground="#F97316">/5</Run><Run Text=", " /><Run FontFamily="Consolas" Foreground="#F97316">/30</Run><Run Text=", " /><Run FontFamily="Consolas" Foreground="#F97316">/60</Run><Run Text="..." />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Card 8: Text Shortcuts -->
                                <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20" Margin="8,0,0,16" Cursor="Hand">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#34D399" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="PersonTag24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Text Shortcuts" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18">
                                            <Run FontWeight="Bold" FontFamily="Consolas" Foreground="#34D399">/name=John</Run><Run Text=" → Save your name" /><LineBreak/>
                                            <Run FontWeight="Bold" FontFamily="Consolas" Foreground="#34D399">/email=you@mail.com</Run><LineBreak/>
                                            <Run Text="Paste them anytime with one click." />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>

                            <!-- Keyboard Shortcuts Card -->
                            <Border CornerRadius="16" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="24" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="⌨️ Keyboard Shortcuts" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ShortcutsHotkeyLabel" Grid.Column="0" Text="Alt+C" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Summon / Dismiss Clipboard" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Alt+1 to Alt+0" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Quick Paste Items 1–10" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ctrl+F" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Search Clipboard" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Esc" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Hide Clipboard" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Drag In" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Add items to shelf" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Drag Out" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Paste items anywhere" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Alt+1 / Alt+2 / Alt+3" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Quick paste 1st, 2nd, 3rd item" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="/10" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Start a 10-minute countdown timer" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="/name=YourName" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Save your name for instant paste" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="/email=you@mail.com" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Save your email for instant paste" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Replay Onboarding Button -->
                            <ui:Button x:Name="ReplayOnboardingBtn" Appearance="Secondary" Padding="16,10" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,24" Click="ReplayOnboarding_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Replay Welcome Tour" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>


            </Grid>


    </Grid>
</controls:MicaWindow>

