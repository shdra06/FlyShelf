<Window x:Class="FlyShelf.Windows.ReminderCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ═══ Dark TextBox Template ═══ -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="SelectionBrush" Value="#50F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#50F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Dark Calendar Style ═══ -->
        <Style x:Key="DarkCalendarDayButton" TargetType="CalendarDayButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40F59E0B"/>
                                <Setter Property="Foreground" Value="#FDE68A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#60F59E0B"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarButton" TargetType="CalendarButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30F59E0B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButton}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButton}"/>
        </Style>
    </Window.Resources>

    <!-- Outer container -->
    <Border CornerRadius="16"
            Background="{DynamicResource ThemeOverflowBg}"
            BorderBrush="{DynamicResource ThemeOverflowBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <!-- Inner glass border -->
        <Border CornerRadius="15" Padding="20" BorderThickness="1" BorderBrush="#0AFFFFFF">
            <StackPanel>

                <!-- ═══ HEADER ═══ -->
                <DockPanel Margin="0,0,0,0" MouseLeftButtonDown="Header_MouseDown">
                    <!-- Close button -->
                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="4" Cursor="Hand"
                            VerticalAlignment="Center" MouseLeftButtonDown="Close_Click" ToolTip="Close">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#18FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource ThemeTextMuted}"/>
                    </Border>

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Add24" FontSize="18" Foreground="#F59E0B" Margin="0,0,8,0"/>
                        <TextBlock Text="New Reminder" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </StackPanel>
                </DockPanel>

                <!-- ═══ TITLE INPUT ═══ -->
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Title" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleInput" Style="{StaticResource DarkTextBoxStyle}"
                             Padding="10,8" FontSize="14"/>
                </StackPanel>

                <!-- ═══ NOTES INPUT ═══ -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Notes (optional)" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="NotesInput" Style="{StaticResource DarkTextBoxStyle}"
                             Padding="10,8" FontSize="13"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="36" MaxHeight="80"/>
                </StackPanel>

                <!-- ═══ DATE / TIME ROW ═══ -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- DATE PICKER -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                        <Border x:Name="DatePickerBtn" CornerRadius="8" Padding="10,8" Cursor="Hand"
                                Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                MouseLeftButtonDown="DatePicker_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="📅" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock x:Name="DateDisplay" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Calendar Popup -->
                        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=DatePickerBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               VerticalOffset="4" PopupAnimation="Fade">
                            <Border CornerRadius="12" Padding="8" BorderThickness="1"
                                    Background="{DynamicResource ThemeOverflowBg}"
                                    BorderBrush="{DynamicResource ThemeOverflowBorder}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                <Calendar x:Name="CalendarControl" Style="{StaticResource DarkCalendarStyle}"
                                          SelectedDatesChanged="Calendar_SelectedDatesChanged"
                                          DisplayDateStart="{x:Static System:DateTime.Today}"
                                          xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- TIME PICKER -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                        <Border x:Name="TimePickerBtn" CornerRadius="8" Padding="10,8" Cursor="Hand"
                                Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                MouseLeftButtonDown="TimePicker_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="⏰" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock x:Name="TimeDisplay" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Time Popup -->
                        <Popup x:Name="TimePopup" PlacementTarget="{Binding ElementName=TimePickerBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               VerticalOffset="4" PopupAnimation="Fade">
                            <Border CornerRadius="12" Padding="4" BorderThickness="1"
                                    Background="{DynamicResource ThemeOverflowBg}"
                                    BorderBrush="{DynamicResource ThemeOverflowBorder}"
                                    MaxHeight="260" Width="150">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimeSlotPanel"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>

                <!-- ═══ REPEAT ROW ═══ -->
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Repeat" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6"/>
                    <StackPanel x:Name="RepeatPanel" Orientation="Horizontal">
                        <Border x:Name="RepeatNone" CornerRadius="6" Padding="10,5" Margin="0,0,6,0"
                                Background="#30F59E0B" BorderBrush="#50F59E0B" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Repeat_Click" Tag="None">
                            <TextBlock Text="None" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        </Border>
                        <Border x:Name="RepeatDaily" CornerRadius="6" Padding="10,5" Margin="0,0,6,0"
                                Background="#10FFFFFF" BorderBrush="Transparent" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Repeat_Click" Tag="Daily">
                            <TextBlock Text="Daily" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        </Border>
                        <Border x:Name="RepeatWeekly" CornerRadius="6" Padding="10,5" Margin="0,0,6,0"
                                Background="#10FFFFFF" BorderBrush="Transparent" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Repeat_Click" Tag="Weekly">
                            <TextBlock Text="Weekly" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        </Border>
                        <Border x:Name="RepeatMonthly" CornerRadius="6" Padding="10,5"
                                Background="#10FFFFFF" BorderBrush="Transparent" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Repeat_Click" Tag="Monthly">
                            <TextBlock Text="Monthly" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ QUICK SET ═══ -->
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Quick Set" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Border CornerRadius="10" Padding="10,5" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="QuickSet_Click" Tag="15">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#10FFFFFF"/>
                                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20FFFFFF"/></Trigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="15 min" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </Border>
                        <Border CornerRadius="10" Padding="10,5" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="QuickSet_Click" Tag="30">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#10FFFFFF"/>
                                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20FFFFFF"/></Trigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="30 min" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </Border>
                        <Border CornerRadius="10" Padding="10,5" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="QuickSet_Click" Tag="60">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#10FFFFFF"/>
                                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20FFFFFF"/></Trigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="1 hour" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </Border>
                        <Border CornerRadius="10" Padding="10,5" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="QuickSet_Click" Tag="180">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#10FFFFFF"/>
                                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20FFFFFF"/></Trigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="3 hours" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </Border>
                        <Border CornerRadius="10" Padding="10,5" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="QuickSet_Click" Tag="tomorrow9">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#10FFFFFF"/>
                                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20FFFFFF"/></Trigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="Tomorrow 9 AM" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- ═══ SEPARATOR ═══ -->
                <Border Height="1" Background="#15FFFFFF" Margin="0,14,0,12"/>

                <!-- ═══ SUBMIT BUTTON ═══ -->
                <Border x:Name="SubmitButton" CornerRadius="10" Padding="0,11" Cursor="Hand"
                        HorizontalAlignment="Stretch" MouseLeftButtonDown="Submit_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F59E0B"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D97706"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Set Reminder 🔔" HorizontalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Border>

            </StackPanel>
        </Border>
    </Border>
</Window>
