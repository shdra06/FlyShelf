<controls:MicaWindow x:Class="FlyShelf.Windows.NetworkLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        Title="FlyShelf — Network Logs" 
        Height="700" Width="1050"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        SystemBackdropType="Mica"
        Background="Transparent"
        Closing="Window_Closing"
        Icon="/Resources/FlyShelfLogo.ico"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>   <!-- Title bar -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Log content -->
            <RowDefinition Height="24"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Title Bar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeOverlayBg}">
            <DockPanel Margin="14,0">
                <TextBlock Text="📡 Network Logs" Foreground="{DynamicResource ThemeAccentLight}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleDeviceInfo" Text="" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>
        </Border>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeOverlayBgPressed}" Padding="10,6">
            <DockPanel>
                <!-- Device filter tabs -->
                <StackPanel x:Name="DeviceTabPanel" Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton x:Name="FilterAll" Content="All Devices" IsChecked="True" GroupName="DeviceFilter"
                                 Style="{StaticResource FilterTab}" Click="FilterChanged" Tag="*" Margin="0,0,4,0"/>
                </StackPanel>

                <!-- Right side controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- Category filter -->
                    <ComboBox x:Name="CategoryFilter" Width="130" SelectionChanged="CategoryFilterChanged" ToolTip="Filter by log category">
                        <ComboBoxItem Content="All Categories" IsSelected="True" Tag="" />
                        <ComboBoxItem Content="🔗 Peer" Tag="PEER" />
                        <ComboBoxItem Content="📋 Clipboard" Tag="CLIPBOARD" />
                        <ComboBoxItem Content="🌐 HTTP" Tag="HTTP" />
                        <ComboBoxItem Content="☁ Cloudflare" Tag="CLOUDFLARE" />
                        <ComboBoxItem Content="🔥 Firebase" Tag="FIREBASE" />
                        <ComboBoxItem Content="📤 Push" Tag="PUSH" />
                        <ComboBoxItem Content="⬇ Download" Tag="DOWNLOAD" />
                        <ComboBoxItem Content="❌ Errors" Tag="ERROR" />
                    </ComboBox>

                    <Rectangle Width="1" Fill="{DynamicResource ThemeSeparator}" Margin="8,2" />

                    <!-- Auto-scroll toggle -->
                    <CheckBox x:Name="AutoScrollToggle" Content="Auto-Scroll" IsChecked="True" Foreground="{DynamicResource SubtleTextColor}" VerticalAlignment="Center" Margin="4,0" />

                    <Rectangle Width="1" Fill="{DynamicResource ThemeSeparator}" Margin="8,2" />

                    <!-- Refresh rate -->
                    <TextBlock Text="Refresh:" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" FontSize="11" Margin="4,0"/>
                    <ComboBox x:Name="RefreshRate" Width="70" SelectionChanged="RefreshRateChanged" ToolTip="Log poll interval">
                        <ComboBoxItem Content="1s" Tag="1000" />
                        <ComboBoxItem Content="2s" Tag="2000" IsSelected="True" />
                        <ComboBoxItem Content="5s" Tag="5000" />
                    </ComboBox>

                    <Rectangle Width="1" Fill="{DynamicResource ThemeSeparator}" Margin="8,2" />

                    <Button x:Name="ClearBtn" Content="🗑 Clear" Click="ClearLogs_Click" 
                            Background="{DynamicResource DangerBgSubtle}" Foreground="{DynamicResource DangerColor}" BorderThickness="0" Padding="10,3" Cursor="Hand" />
                    <Button x:Name="CopyBtn" Content="📋 Copy All" Click="CopyLogs_Click" Margin="4,0,0,0"
                            Background="{DynamicResource ThemeAccentBg}" Foreground="{DynamicResource ThemeAccentLight}" BorderThickness="0" Padding="10,3" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Log Content ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeCodePreviewBg}" Margin="4,2,4,0" CornerRadius="8">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="6,4" ScrollChanged="LogScroller_ScrollChanged">
                <ItemsControl x:Name="LogItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,1" Margin="0,0,0,1" CornerRadius="2"
                                    Background="{Binding RowBackground}">
                                <DockPanel>
                                    <!-- Device badge -->
                                    <Border DockPanel.Dock="Left" Background="{Binding DeviceBadgeColor}" 
                                            CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceName}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{Binding DeviceTextColor}" />
                                    </Border>
                                    <!-- Log text -->
                                    <TextBlock Text="{Binding LogText}" Foreground="{Binding LogColor}" 
                                               FontFamily="Cascadia Code,Consolas,Courier New" FontSize="11.5"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeOverlayBgPressed}" Padding="10,2">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Initializing..." Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusRight" Text="" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" VerticalAlignment="Center" 
                           HorizontalAlignment="Right" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource ThemeOverlayBg}" CornerRadius="4" Padding="10,4" Cursor="Hand"
                                BorderBrush="{DynamicResource ThemeOverlayBorder}" BorderThickness="1">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentBg}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBorder}" />
                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource ThemeAccentLight}" />
                                <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</controls:MicaWindow>
