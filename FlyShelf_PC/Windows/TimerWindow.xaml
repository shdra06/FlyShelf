<Window x:Class="FlyShelf.Windows.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        Title="Timer" Height="220" Width="180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        Topmost="True"
        Background="Transparent" ResizeMode="NoResize"
        AllowsTransparency="True">

    <Grid>
        <!-- The Floating Table Timer Container (Dome Shape) -->
        <Border x:Name="TimerContainer" Width="140" Height="170" 
                CornerRadius="70,70,16,16" 
                Background="#EE1A1A1E" 
                BorderBrush="#25FFFFFF" BorderThickness="1.5"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.6" ShadowDepth="4"/>
            </Border.Effect>
            
            <Grid>
                <!-- Tiny Close Button in top right curve -->
                <Button Margin="0,12,20,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="18" Height="18" Padding="0"
                        Background="Transparent" BorderBrush="Transparent" 
                        Click="Close_Click" Cursor="Hand" ToolTip="Close Timer">
                    <TextBlock Text="✕" FontSize="10" Opacity="0.5" 
                               Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                </Button>

                <!-- MAIN STACKPANEL -->
                <StackPanel VerticalAlignment="Top" Margin="0,22,0,0">
                    <!-- Circular progress ring -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <!-- Background track -->
                        <Ellipse Width="96" Height="96" StrokeThickness="4" Stroke="#15FFFFFF" Fill="Transparent"/>
                        
                        <!-- Glow effect behind arc -->
                        <Ellipse Name="GlowRing" Width="88" Height="88" StrokeThickness="0" Fill="Transparent" Opacity="0.15">
                            <Ellipse.Effect>
                                <BlurEffect Radius="12"/>
                            </Ellipse.Effect>
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- Progress arc (drawn in code-behind) -->
                        <Canvas Name="ArcCanvas" Width="96" Height="96" ClipToBounds="False"/>
                        
                        <!-- Center content -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Main time display -->
                            <TextBlock Name="TimeDisplay" Text="05:00" FontSize="20" FontWeight="Bold" 
                                       FontFamily="Segoe UI Variable, Segoe UI" TextAlignment="Center"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                            
                            <!-- Percentage -->
                            <TextBlock Name="PercentText" Text="100%" FontSize="8" FontWeight="Medium" 
                                       TextAlignment="Center" Opacity="0.4" Margin="0,-2,0,0"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                            
                            <!-- Status label -->
                            <TextBlock Name="StatusText" Text="READY" FontSize="6" FontWeight="SemiBold" 
                                       TextAlignment="Center" Opacity="0.3" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Control Buttons inside flat base -->
                    <Grid Margin="0,14,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary action (Start/Pause/Resume/Dismiss) -->
                        <Border Name="PrimaryBtnBorder" Grid.Column="0" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Action_Click"
                                MinWidth="64" Padding="10,4" Height="26">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Name="ActionText" Text="Start" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="White" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Reset button -->
                        <Border Name="ResetBtnBorder" Grid.Column="2" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Reset_Click"
                                MinWidth="40" Padding="8,4" Background="#15FFFFFF" Opacity="0.6" Height="26">
                            <TextBlock Text="Reset" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
