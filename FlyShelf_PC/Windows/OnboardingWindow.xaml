<Window x:Class="FlyShelf.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Welcome to FlyShelf" Width="720" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="20">
        <!-- ═══ Outer Shell with DropShadow ═══ -->
        <Border CornerRadius="20" BorderThickness="1" BorderBrush="#2A2B3F">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A1B2E" Offset="0"/>
                    <GradientStop Color="#0F1021" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="0" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- ═══ Skip Button (top-right) ═══ -->
                <TextBlock Text="Skip" FontSize="13" Foreground="#64748B" Cursor="Hand"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,20,28,0" MouseLeftButtonDown="Skip_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ═══ Main Content Area ═══ -->
                <Grid Margin="48,40,48,72">
                    <!-- ══════════════════════════════════════ -->
                    <!-- STEP 1: Welcome                       -->
                    <!-- ══════════════════════════════════════ -->
                    <StackPanel x:Name="Step1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/FlyShelfIcon.png"
                               Width="120" Height="120" Margin="0,0,0,24"
                               HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Welcome to FlyShelf" FontSize="32" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Your intelligent clipboard companion" FontSize="16"
                                   Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Copy anything. Find everything. Paste instantly." FontSize="13"
                                   Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ══════════════════════════════════════ -->
                    <!-- STEP 2: Alt+C Summon                  -->
                    <!-- ══════════════════════════════════════ -->
                    <StackPanel x:Name="Step2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <!-- Keyboard keys visual -->
                        <StackPanel x:Name="HotkeyKeycapsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                            <!-- Keycaps built dynamically in code-behind -->
                        </StackPanel>

                        <TextBlock Text="Summon Your Shelf" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HotkeyDescriptionText" Text="Press Alt+C anytime to summon or dismiss your clipboard shelf. You can change this in Settings."
                                   FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Margin="0,0,0,8"/>
                        <TextBlock Text="Works from anywhere — even fullscreen apps" FontSize="13"
                                   Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ══════════════════════════════════════ -->
                    <!-- STEP 3: Taskbar Widget                -->
                    <!-- ══════════════════════════════════════ -->
                    <StackPanel x:Name="Step3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="AppsList24" FontSize="48" Foreground="#22D3EE"
                                       HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock Text="Taskbar Widget" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Quick access lives in your taskbar. Click the widget to open your clipboard instantly."
                                   FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,0,0,16"/>
                        <TextBlock Text="Enabled automatically for you ✓" FontSize="12"
                                   Foreground="#10B981" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ══════════════════════════════════════ -->
                    <!-- STEP 4: Key Features (2×2 grid)       -->
                    <!-- ══════════════════════════════════════ -->
                    <StackPanel x:Name="Step4" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Powerful Features" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                        <Grid HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Clipboard History -->
                            <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="16"
                                    Background="#1E2035" BorderBrush="#2A2D3E" BorderThickness="1"
                                    Width="240" Margin="0,0,10,10">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="24" Foreground="#A78BFA"
                                                   HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="Clipboard History" FontSize="13" FontWeight="Bold"
                                               Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="Every copy saved automatically" FontSize="11"
                                               Foreground="#94A3B8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Cross-Device Sync -->
                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="16"
                                    Background="#1E2035" BorderBrush="#2A2D3E" BorderThickness="1"
                                    Width="240" Margin="10,0,0,10">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="24" Foreground="#22D3EE"
                                                   HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="Cross-Device Sync" FontSize="13" FontWeight="Bold"
                                               Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="Share between PC and phone" FontSize="11"
                                               Foreground="#94A3B8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Quick Notes & To-Do -->
                            <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Padding="16"
                                    Background="#1E2035" BorderBrush="#2A2D3E" BorderThickness="1"
                                    Width="240" Margin="0,10,10,0">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Notepad24" FontSize="24" Foreground="#FBBF24"
                                                   HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="Quick Notes &amp; To-Do" FontSize="13" FontWeight="Bold"
                                               Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="Built-in notes and task lists" FontSize="11"
                                               Foreground="#94A3B8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Smart Categories -->
                            <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Padding="16"
                                    Background="#1E2035" BorderBrush="#2A2D3E" BorderThickness="1"
                                    Width="240" Margin="10,10,0,0">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Filter24" FontSize="24" Foreground="#34D399"
                                                   HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="Smart Categories" FontSize="13" FontWeight="Bold"
                                               Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="Auto-organized by content type" FontSize="11"
                                               Foreground="#94A3B8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ══════════════════════════════════════ -->
                    <!-- STEP 5: Choose Your Style             -->
                    <!-- ══════════════════════════════════════ -->
                    <StackPanel x:Name="Step5" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Choose Your Style" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Pick a look that suits you — you can always change this later in Settings"
                                   FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Margin="0,0,0,32"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Acrylic Blur Card -->
                            <Border x:Name="ThemeCard_Mica" CornerRadius="16" Width="220" Height="180" Margin="0,0,16,0"
                                    Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click" Tag="mica"
                                    BorderThickness="2" BorderBrush="#2A2D3E">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E2035" Offset="0"/>
                                        <GradientStop Color="#252840" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,0,16"
                                            HorizontalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                <GradientStop Color="#7C3AED" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="✦" FontSize="22" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Acrylic Blur" FontSize="15" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Clean system glass" FontSize="11"
                                               Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- FlyShelf Style Card -->
                            <Border x:Name="ThemeCard_Desktop" CornerRadius="16" Width="220" Height="180"
                                    Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click" Tag="desktop"
                                    BorderThickness="2">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#D97706" Offset="0"/>
                                        <GradientStop Color="#F59E0B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E2035" Offset="0"/>
                                        <GradientStop Color="#252840" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,0,16"
                                            HorizontalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#D97706" Offset="0"/>
                                                <GradientStop Color="#F59E0B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="🖼" FontSize="22"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="FlyShelf Style" FontSize="15" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Desktop wallpaper look" FontSize="11"
                                               Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ══════════════════════════════════════ -->
                    <!-- STEP 6: Shortcuts & Tips              -->
                    <!-- ══════════════════════════════════════ -->
                    <StackPanel x:Name="Step6" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="Lightbulb24" FontSize="36" Foreground="#FBBF24"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Shortcuts &amp; Tips" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Type these anywhere in FlyShelf to save time" FontSize="14"
                                   Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                        <!-- Shortcut cards -->
                        <StackPanel HorizontalAlignment="Center" Width="500">
                            <!-- /10 Timer -->
                            <Border CornerRadius="12" Padding="14,12" Margin="0,0,0,8"
                                    Background="#1E2035" BorderBrush="#2A2D3E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="8" Padding="10,6" Background="#312E81"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="/10" FontSize="15" FontWeight="Bold" Foreground="#A78BFA"
                                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Quick Timer" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock Text="Type /10 to start a 10-minute countdown timer. Works with any number — /5, /30, /60..." FontSize="11"
                                                   Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- /name= -->
                            <Border CornerRadius="12" Padding="14,12" Margin="0,0,0,8"
                                    Background="#1E2035" BorderBrush="#2A2D3E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="8" Padding="10,6" Background="#0C4A6E"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="/name=" FontSize="15" FontWeight="Bold" Foreground="#22D3EE"
                                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Set Your Name" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock Text="Type /name=John to save your name. Paste it instantly anytime with a single click." FontSize="11"
                                                   Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- /email= -->
                            <Border CornerRadius="12" Padding="14,12"
                                    Background="#1E2035" BorderBrush="#2A2D3E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="8" Padding="10,6" Background="#1C3829"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="/email=" FontSize="15" FontWeight="Bold" Foreground="#34D399"
                                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Set Your Email" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock Text="Type /email=you@mail.com to save your email. Always one paste away." FontSize="11"
                                                   Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ═══ Bottom Bar: Dots + Next Button ═══ -->
                <Grid VerticalAlignment="Bottom" Margin="28,0,28,24">
                    <!-- Step indicator dots (center) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="10" Height="10" Margin="4,0"
                                 Fill="#6366F1"/>
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="4,0"
                                 Fill="#374151"/>
                        <Ellipse x:Name="Dot3" Width="6" Height="6" Margin="4,0"
                                 Fill="#374151"/>
                        <Ellipse x:Name="Dot4" Width="6" Height="6" Margin="4,0"
                                 Fill="#374151"/>
                        <Ellipse x:Name="Dot5" Width="6" Height="6" Margin="4,0"
                                 Fill="#374151"/>
                        <Ellipse x:Name="Dot6" Width="6" Height="6" Margin="4,0"
                                 Fill="#374151"/>
                    </StackPanel>

                    <!-- Next / Get Started button (right) -->
                    <Border HorizontalAlignment="Right" CornerRadius="12" Padding="16,8"
                            Cursor="Hand" MouseLeftButtonDown="NextBtn_Click">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="NextBtnText" Text="Next →" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
