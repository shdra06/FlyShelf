<controls:MicaWindow x:Class="FlyShelf.Windows.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:classes="clr-namespace:FlyShelf.Classes"
        Title="Text Shortcuts" Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        SystemBackdropType="Mica" Background="Transparent"
        Icon="/Resources/FlyShelfLogo.ico"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid Margin="24,8,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header: Icon + Title + Count Pill ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,14" WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border CornerRadius="12" Width="40" Height="40" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C3AED" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="Rocket24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Text Shortcuts" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}"/>
                    <TextBlock Text="Copy a /trigger to expand it instantly" FontSize="11" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,2,0,0" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>

            <!-- Count pill and Plus button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Add Shortcut Toggle Button -->
                <ui:Button x:Name="ToggleAddMenuBtn" Appearance="Transparent" Click="ToggleAddMenuBtn_Click"
                           AutomationProperties.Name="Add text shortcut"
                           ToolTip="Add New Shortcut" Padding="6" Margin="0,0,8,0" CornerRadius="8"
                           Background="Transparent" BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:Button.Icon>
                        <ui:SymbolIcon x:Name="ToggleAddMenuIcon" Symbol="Add24" FontSize="18" Foreground="{DynamicResource TypeGroupColor}"/>
                    </ui:Button.Icon>
                </ui:Button>

                <!-- Count pill -->
                <Border CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0A8B5CF6" Offset="0"/>
                            <GradientStop Color="#08FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="ShortcutCountLabel" Text="0/20" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ Info Banner ═══ -->
        <Border Grid.Row="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,12"
                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource TypeTextColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Type /trigger in any text field, copy it, and FlyShelf replaces the clipboard with your expansion text. Paste normally with Ctrl+V."
                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"
                           VerticalAlignment="Center" MaxWidth="380"/>
            </StackPanel>
        </Border>

        <!-- ═══ Shortcuts List ═══ -->
        <Border Grid.Row="2" CornerRadius="12" Padding="6"
                Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}"/>
                    <TextBlock Text="No shortcuts yet — add one below" FontSize="13" Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <ItemsControl x:Name="ShortcutsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type classes:TextShortcut}">
                                <Border Margin="2,2" CornerRadius="10" Padding="10,8"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0AFFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- ═══ VIEW MODE ═══ -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Trigger Badge (purple gradient pill, auto-sized so it's never cut off) -->
                                            <Border Grid.Column="0" CornerRadius="8" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#158B5CF6" Offset="0"/>
                                                        <GradientStop Color="#088B5CF6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Trigger}" FontSize="12.5" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                           Foreground="{DynamicResource TypeGroupColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Label + Expansion -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Expansion}" FontSize="10.5" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorTertiary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Appearance="Transparent" Tag="{Binding}" Click="EditShortcut_Click" 
                                                           ToolTip="Edit" Padding="5,4" Margin="0,0,2,0"
                                                           Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}">
                                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Edit24" FontSize="14"/></ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button Appearance="Transparent" Tag="{Binding}" Click="DeleteShortcut_Click" 
                                                           ToolTip="Remove" Foreground="{DynamicResource DangerColor}" Padding="5,4">
                                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" FontSize="14"/></ui:Button.Icon>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ═══ EDIT MODE ═══ -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding Trigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="/trigger" FontSize="12"/>
                                                <ui:TextBox Grid.Column="2" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="Label" FontSize="12"/>
                                            </Grid>
                                            <ui:TextBox Text="{Binding Expansion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="Expansion text..." FontSize="12" AcceptsReturn="True"
                                                        TextWrapping="Wrap" MinLines="2" MaxLines="3" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ui:Button Content="Cancel" Appearance="Transparent" Padding="14,5" Margin="0,0,6,0"
                                                           Click="CancelEdit_Click" FontSize="12" CornerRadius="8"/>
                                                <ui:Button Content="Save" Appearance="Primary" Padding="14,5"
                                                           Click="SaveEdit_Click" FontSize="12" CornerRadius="8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ Bottom: Add New Shortcut Bar ═══ -->
        <Grid x:Name="AddShortcutPanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <Border CornerRadius="10" Padding="12,8"
                    Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"
                    BorderBrush="{DynamicResource MicaWPF.Brushes.ControlStrokeColorDefault}" BorderThickness="1">
                <StackPanel>
                    <!-- Trigger + Label row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TriggerInput" Grid.Column="0" PlaceholderText="e.g. /address" FontSize="12" AutomationProperties.Name="Shortcut trigger text"/>
                        <ui:TextBox x:Name="LabelInput" Grid.Column="2" PlaceholderText="e.g. Home Address" FontSize="12" AutomationProperties.Name="Shortcut label"/>
                    </Grid>

                    <!-- Expansion input -->
                    <ui:TextBox x:Name="ExpansionInput" PlaceholderText="e.g. 42 Maple Street, Apt 7B, New York, NY 10001" FontSize="12"
                                AutomationProperties.Name="Shortcut expansion text"
                                AcceptsReturn="True" TextWrapping="Wrap" MinLines="1" MaxLines="2" Margin="0,0,0,8"/>

                    <!-- Add button -->
                    <ui:Button x:Name="AddShortcutBtn" Appearance="Primary" Padding="14,6" Click="AddShortcut_Click" FontSize="12" CornerRadius="8" HorizontalAlignment="Right" AutomationProperties.Name="Save shortcut">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Add Shortcut" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</controls:MicaWindow>
