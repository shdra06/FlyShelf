<Window x:Class="FlyShelf.Windows.NoteExpandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Note" Height="420" Width="360"
        WindowStyle="None" AllowsTransparency="False" 
        Background="#1A1A2E"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="10" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Border x:Name="OuterBorder" CornerRadius="10" Background="#1A1A2E" 
                BorderBrush="#2A2A45" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>

                <!-- ═══ TITLE BAR (Sticky Note Style — purple gradient) ═══ -->
                <Border Grid.Row="0" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Left: Title -->
                        <TextBlock x:Name="HeaderTitle" Text="📝 Note" Foreground="White" 
                                   VerticalAlignment="Center" Margin="12,0,0,0" 
                                   FontWeight="SemiBold" FontSize="12" IsHitTestVisible="False"/>

                        <!-- Right: Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                            <!-- Word count -->
                            <Border CornerRadius="4" Padding="5,1" Margin="0,0,4,0" Background="#30FFFFFF" VerticalAlignment="Center">
                                <TextBlock x:Name="WordCountBadge" Text="0" FontSize="9.5" 
                                           Foreground="#E0E0FF" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Copy -->
                            <Border CornerRadius="4" Cursor="Hand" Padding="4,3" Margin="0,0,2,0"
                                    Background="#20FFFFFF" MouseLeftButtonDown="CopyBtn_Click" ToolTip="Copy">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Pin -->
                            <Border CornerRadius="4" Cursor="Hand" Padding="4,3" Margin="0,0,2,0"
                                    Background="#20FFFFFF" MouseLeftButtonDown="PinBtn_Click" ToolTip="Pin on top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Close -->
                            <Border CornerRadius="4" Cursor="Hand" Padding="4,3"
                                    Background="#20FFFFFF" MouseLeftButtonDown="CloseBtn_Click" ToolTip="Close (Esc)">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#60FF4444"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ NOTE CONTENT ═══ -->
                <TextBox x:Name="NoteTextBox" Grid.Row="1" 
                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                         FontSize="13" BorderThickness="0" 
                         Padding="14,10,14,10"
                         Background="#1A1A2E"
                         Foreground="#E8E8F0"
                         CaretBrush="#E8E8F0"
                         SelectionBrush="#608B5CF6"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="NoteTextBox_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- ═══ STATUS BAR ═══ -->
                <Border Grid.Row="2" Background="#14142A" BorderBrush="#2A2A45" BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <TextBlock x:Name="FooterStatus" Text="Ready" FontSize="9.5" 
                                   Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CharCountLabel" Text="" FontSize="9.5" 
                                   Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
