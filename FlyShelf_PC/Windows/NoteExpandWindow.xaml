<Window x:Class="FlyShelf.Windows.NoteExpandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Note" Height="420" Width="360"
        WindowStyle="None" AllowsTransparency="False" 
        Background="#1A1A2E"
        Topmost="False" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="10" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Border x:Name="OuterBorder" CornerRadius="10" Background="#1A1A2E" 
                BorderBrush="#2A2A45" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>

                <!-- ═══ TITLE BAR ═══ -->
                <Border Grid.Row="0" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock x:Name="HeaderTitle" Text="📝 Note" Foreground="White" 
                                   VerticalAlignment="Center" Margin="12,0,0,0" 
                                   FontWeight="SemiBold" FontSize="12" IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Border CornerRadius="4" Padding="5,1" Margin="0,0,4,0" Background="#30FFFFFF" VerticalAlignment="Center">
                                <TextBlock x:Name="WordCountBadge" Text="0" FontSize="9.5" 
                                           Foreground="#E0E0FF" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="4" Cursor="Hand" Padding="4,3" Margin="0,0,2,0"
                                    Background="#20FFFFFF" MouseLeftButtonDown="CopyBtn_Click" ToolTip="Copy">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="4" Cursor="Hand" Padding="4,3" Margin="0,0,2,0"
                                    Background="#20FFFFFF" MouseLeftButtonDown="PinBtn_Click" ToolTip="Pin on top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon x:Name="PinIcon" Symbol="PinOff24" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="4" Cursor="Hand" Padding="4,3"
                                    Background="#20FFFFFF" MouseLeftButtonDown="CloseBtn_Click" ToolTip="Close (Esc)">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#60FF4444"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ FORMAT TOOLBAR ═══ -->
                <Border Grid.Row="1" Background="#14142A" BorderBrush="#2A2A45" BorderThickness="0,0,0,1" Padding="4,2">
                    <Border.Resources>
                        <Style x:Key="FmtBtn" TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="5,3"/>
                            <Setter Property="Margin" Value="1,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="MinWidth" Value="26"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <!-- Row 1: Text Format + Paragraph -->
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="BoldBtn_Click" ToolTip="Bold (Ctrl+B)">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="12" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="ItalicBtn_Click" ToolTip="Italic (Ctrl+I)">
                                <TextBlock Text="I" FontStyle="Italic" FontSize="12" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Georgia"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="UnderlineBtn_Click" ToolTip="Underline (Ctrl+U)">
                                <TextBlock Text="U" FontSize="12" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="Underline"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="StrikeBtn_Click" ToolTip="Strikethrough">
                                <TextBlock Text="S" FontSize="12" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="Strikethrough"/>
                            </Border>
                            <Border Width="1" Background="#2A2A45" Margin="4,4,4,4"/>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="HeadingBtn_Click" ToolTip="Heading (Ctrl+H)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="HeadingLabel" Text="H" FontWeight="Bold" FontSize="12" Foreground="#A0A0E0" VerticalAlignment="Center"/>
                                    <TextBlock Text="▾" FontSize="8" Foreground="#6B6B9B" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Width="1" Background="#2A2A45" Margin="4,4,4,4"/>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="BulletBtn_Click" ToolTip="Bullet list (Ctrl+L)">
                                <TextBlock Text="⊙" FontSize="12" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="NumberedListBtn_Click" ToolTip="Numbered list">
                                <TextBlock Text="1." FontSize="11" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="CheckboxBtn_Click" ToolTip="Checkbox (Ctrl+Shift+C)">
                                <TextBlock Text="☑" FontSize="12" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Width="1" Background="#2A2A45" Margin="4,4,4,4"/>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="OutdentBtn_Click" ToolTip="Decrease indent (Shift+Tab)">
                                <TextBlock Text="⇤" FontSize="13" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="IndentBtn_Click" ToolTip="Increase indent (Tab)">
                                <TextBlock Text="⇥" FontSize="13" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Width="1" Background="#2A2A45" Margin="4,4,4,4"/>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="AlignLeftBtn_Click" ToolTip="Align left">
                                <TextBlock Text="≡" FontSize="13" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="AlignCenterBtn_Click" ToolTip="Align center">
                                <TextBlock Text="≡" FontSize="13" Foreground="#A0A0E0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0" FontStyle="Italic"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="AlignRightBtn_Click" ToolTip="Align right">
                                <TextBlock Text="⫸" FontSize="11" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <!-- Row 2: Insert + Colors + Tools -->
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="LinkBtn_Click" ToolTip="Insert link (Ctrl+K)">
                                <TextBlock Text="🔗" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="DividerBtn_Click" ToolTip="Divider (Ctrl+D)">
                                <TextBlock Text="─" FontSize="11" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="QuoteBtn_Click" ToolTip="Blockquote">
                                <TextBlock Text="❝" FontSize="13" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="CodeBlockBtn_Click" ToolTip="Code block">
                                <TextBlock Text="⟨/⟩" FontSize="10" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Consolas"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="TimestampBtn_Click" ToolTip="Timestamp (Ctrl+T)">
                                <TextBlock Text="⏱" FontSize="11" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Width="1" Background="#2A2A45" Margin="4,4,4,4"/>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="TextColorBtn_Click" ToolTip="Text color">
                                <StackPanel>
                                    <TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Border x:Name="TextColorIndicator" Height="2" CornerRadius="1" Background="#EF4444" Margin="0,-1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="HighlightBtn_Click" ToolTip="Highlight color">
                                <StackPanel>
                                    <TextBlock Text="🖊" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Border x:Name="HighlightColorIndicator" Height="2" CornerRadius="1" Background="#FBBF24" Margin="0,-1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Width="1" Background="#2A2A45" Margin="4,4,4,4"/>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="FontSizeBtn_Click" ToolTip="Font size (Ctrl+Scroll)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Aa" FontSize="10" Foreground="#D0D0FF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FontSizeLabel" Text="13" FontSize="8.5" Foreground="#8888AA" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="ClearFormatBtn_Click" ToolTip="Clear formatting">
                                <TextBlock Text="Tₓ" FontSize="11" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Width="1" Background="#2A2A45" Margin="4,4,4,4"/>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="UndoBtn_Click" ToolTip="Undo (Ctrl+Z)">
                                <TextBlock Text="↩" FontSize="13" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource FmtBtn}" MouseLeftButtonDown="RedoBtn_Click" ToolTip="Redo (Ctrl+Y)">
                                <TextBlock Text="↪" FontSize="13" Foreground="#D0D0FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ RICH TEXT EDITOR ═══ -->
                <RichTextBox x:Name="NoteRichTextBox" Grid.Row="2" 
                             BorderThickness="0" 
                             Padding="14,10,14,10"
                             Background="#1A1A2E"
                             Foreground="#E8E8F0"
                             CaretBrush="#E8E8F0"
                             SelectionBrush="#608B5CF6"
                             FontFamily="Segoe UI" FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsTab="True"
                             TextChanged="NoteRichTextBox_TextChanged"
                             SelectionChanged="NoteRichTextBox_SelectionChanged"
                             PreviewMouseWheel="NoteRichTextBox_PreviewMouseWheel"
                             DataObject.Pasting="NoteRichTextBox_Paste">
                    <RichTextBox.Style>
                        <Style TargetType="RichTextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RichTextBox">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" Margin="0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RichTextBox.Style>
                    <RichTextBox.Document>
                        <FlowDocument PagePadding="0" Foreground="#E8E8F0" FontFamily="Segoe UI" FontSize="13"/>
                    </RichTextBox.Document>
                </RichTextBox>

                <!-- ═══ STATUS BAR ═══ -->
                <Border Grid.Row="3" Background="#14142A" BorderBrush="#2A2A45" BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <TextBlock x:Name="FooterStatus" Text="Ready" FontSize="9.5" 
                                   Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CursorPosLabel" Text="Ln 1, Col 1" FontSize="9.5" 
                                       Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="CharCountLabel" Text="" FontSize="9.5" 
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
