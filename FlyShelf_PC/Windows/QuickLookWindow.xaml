<Window x:Class="FlyShelf.Windows.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Quick Look" Height="500" Width="400"
        WindowStyle="None" AllowsTransparency="False" Background="#1C1C1C"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" 
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseMove="Window_MouseMove" Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Dynamic Frame -->
        <Border x:Name="OuterBorder" CornerRadius="12" Background="#1C1C1C" BorderBrush="#30FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Header Bar -->
                <Grid x:Name="HeaderGrid" Grid.Row="0" Background="#90111111" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <TextBlock x:Name="HeaderTitle" Text="Quick Look" Foreground="#888888" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="Medium" FontSize="11.5" IsHitTestVisible="False"/>
                    
                    <!-- Action Buttons (right side) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- Rotate Button (image only) -->
                        <ui:Button x:Name="RotateBtn" Click="RotateButton_Click" Appearance="Secondary" 
                                   Foreground="#60A5FA" Padding="5,3" Margin="0,0,4,0" ToolTip="Rotate 90° clockwise"
                                   Visibility="Collapsed">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowRotateClockwise24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- OCR Button (image only) -->
                        <ui:Button x:Name="OcrBtn" Click="OcrButton_Click" Appearance="Secondary" 
                                   Foreground="#34D399" Padding="5,3" Margin="0,0,4,0" ToolTip="Extract &amp; Select Text (OCR)"
                                   Visibility="Collapsed">
                            <TextBlock Text="T" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI" Margin="3,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ui:Button>
                        <!-- Copy All OCR Text Button -->
                        <ui:Button x:Name="CopyAllOcrBtn" Click="CopyAllOcrButton_Click" Appearance="Secondary" 
                                   Foreground="#A855F7" Padding="5,3" Margin="0,0,4,0" ToolTip="Copy all detected text"
                                   Visibility="Collapsed">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Pin Button (toggle always on top) -->
                        <ui:Button x:Name="PinBtn" Click="PinButton_Click" Appearance="Secondary" 
                                   Foreground="#F59E0B" Padding="5,3" Margin="0,0,4,0" ToolTip="Pin on top">
                            <ui:Button.Icon><ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Close -->
                        <ui:Button x:Name="CloseBtn" Click="CloseButton_Click" Appearance="Secondary" Foreground="#EF4444" Padding="5,3" ToolTip="Close">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Background="#20000000">
                    <ProgressBar IsIndeterminate="True" x:Name="LoadingProgress" VerticalAlignment="Top" Height="3" Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Visibility="Collapsed" Panel.ZIndex="10" />
                    <!-- Image Mode Grid -->
                    <Grid x:Name="ImageModeGrid" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid x:Name="ImageContainerGrid">
                                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Canvas x:Name="OcrOverlayCanvas" Background="Transparent" ClipToBounds="True"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                    
                    <!-- Dynamic Document Mode (PDF/HTML) -->
                    <WebBrowser x:Name="WebPreview" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    
                    <!-- Raw Text/Code/DOCX Extracted Frame -->
                    <ScrollViewer x:Name="TextPreviewScroll" Visibility="Collapsed" Background="#FF1E1E1E">
                        <TextBlock x:Name="TextPreview" Foreground="#FFD4D4D4" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" />
                    </ScrollViewer>
                    
                    <!-- Document Mode (Fallback when all else fails) -->
                    <StackPanel x:Name="DocumentPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon x:Name="DocIcon" Symbol="Document24" FontSize="120" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DocTitle" Text="Document Name" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,15,0,5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                        <TextBlock x:Name="DocSize" Text="PDF Document - 2.4 MB" FontSize="13" Foreground="#888888" TextAlignment="Center"/>
                        <ui:Button Content="Open Native Tool" Appearance="Primary" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OpenFile_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Open24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    
                    <!-- QR Code Decoded Content Bar -->
                    <Border x:Name="QrContentBar" VerticalAlignment="Bottom" Height="40" Background="#A01A1A1A" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Visibility="Collapsed">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="QRCode24" Foreground="#60A5FA" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="0"/>
                            <TextBlock x:Name="QrContentText" Text="QR Code Text..." Foreground="White" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Grid.Column="1"/>
                            <ui:Button x:Name="CopyQrBtn" Click="CopyQrButton_Click" Content="Copy Text" Appearance="Secondary" Padding="8,3" FontSize="10.5" VerticalAlignment="Center" Grid.Column="2"/>
                        </Grid>
                    </Border>
                    
                    <!-- Instruction Overlay (fades out) -->
                    <TextBlock x:Name="HelperText" Text="Drag image to drop natively" Foreground="#80FFFFFF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="12" IsHitTestVisible="False">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:3" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
