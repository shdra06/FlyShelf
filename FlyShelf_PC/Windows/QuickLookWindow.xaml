<Window x:Class="FlyShelf.Windows.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Quick Look" Height="500" Width="400"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource ThemeWindowFallback}"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" 
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseMove="Window_MouseMove" Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        Icon="/Resources/FlyShelfLogo.ico"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Dynamic Frame -->
        <Border x:Name="OuterBorder" CornerRadius="12" Background="{DynamicResource ThemeWindowFallback}" BorderBrush="{DynamicResource ThemeOverlayBorder}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Header Bar -->
                <Grid x:Name="HeaderGrid" Grid.Row="0" Background="{DynamicResource ThemeOverlayBg}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <TextBlock x:Name="HeaderTitle" Text="Quick Look" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="Medium" FontSize="11.5" IsHitTestVisible="False"/>
                    
                    <!-- Action Buttons (right side) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- Rotate Button (image only) -->
                        <ui:Button x:Name="RotateBtn" Click="RotateButton_Click" Appearance="Secondary" 
                                   Foreground="{DynamicResource InfoColor}" Padding="5,3" Margin="0,0,4,0" ToolTip="Rotate 90° clockwise"
                                   Visibility="Collapsed" AutomationProperties.Name="Rotate image">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowRotateClockwise24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Doodle Button (image only) -->
                        <ui:Button x:Name="DoodleBtn" Click="DoodleButton_Click" Appearance="Secondary" 
                                   Foreground="#A78BFA" Padding="5,3" Margin="0,0,4,0" ToolTip="Draw / Annotate"
                                   Visibility="Collapsed" AutomationProperties.Name="Draw and annotate">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Edit24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Doodle Undo -->
                        <ui:Button x:Name="DoodleUndoBtn" Click="DoodleUndo_Click" Appearance="Secondary" 
                                   Foreground="#94A3B8" Padding="5,3" Margin="0,0,2,0" ToolTip="Undo (Ctrl+Z)"
                                   Visibility="Collapsed" AutomationProperties.Name="Undo drawing">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Doodle Redo -->
                        <ui:Button x:Name="DoodleRedoBtn" Click="DoodleRedo_Click" Appearance="Secondary" 
                                   Foreground="#94A3B8" Padding="5,3" Margin="0,0,2,0" ToolTip="Redo (Ctrl+Y)"
                                   Visibility="Collapsed" AutomationProperties.Name="Redo drawing">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowRedo24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Doodle Save -->
                        <ui:Button x:Name="DoodleSaveBtn" Click="DoodleSave_Click" Appearance="Secondary" 
                                   Foreground="#34D399" Padding="5,3" Margin="0,0,4,0" ToolTip="Save annotated image (Ctrl+S)"
                                   Visibility="Collapsed" AutomationProperties.Name="Save annotated image">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- OCR Button (image only) -->
                        <ui:Button x:Name="OcrBtn" Click="OcrButton_Click" Appearance="Secondary" 
                                   Foreground="{DynamicResource SuccessColor}" Padding="5,3" Margin="0,0,4,0" ToolTip="Extract &amp; Select Text (OCR)"
                                   Visibility="Collapsed" AutomationProperties.Name="Extract text OCR">
                            <TextBlock Text="T" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI" Margin="3,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ui:Button>
                        <!-- Copy All OCR Text Button -->
                        <ui:Button x:Name="CopyAllOcrBtn" Click="CopyAllOcrButton_Click" Appearance="Secondary" 
                                   Foreground="{DynamicResource GeminiAccentColor}" Padding="5,3" Margin="0,0,4,0" ToolTip="Copy all detected text"
                                   Visibility="Collapsed" AutomationProperties.Name="Copy all OCR text">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Translate Button (text items only) -->
                        <ui:Button x:Name="TranslateBtn" Click="TranslateButton_Click" Appearance="Secondary" 
                                   Foreground="{DynamicResource InfoColor}" Padding="5,3" Margin="0,0,4,0" ToolTip="Translate text"
                                   Visibility="Collapsed" AutomationProperties.Name="Translate text">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Earth24" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Zoom Reset Button (markdown only) -->
                        <ui:Button x:Name="ZoomResetBtn" Click="MarkdownZoomReset_Click" Appearance="Secondary"
                                   Foreground="{DynamicResource MicaWPF.Brushes.TextFillColorSecondary}" Padding="5,3" Margin="0,0,4,0" ToolTip="Reset zoom (Ctrl+0)"
                                   Visibility="Collapsed" AutomationProperties.Name="Reset zoom">
                            <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="10.5" FontWeight="SemiBold" Margin="2,0" VerticalAlignment="Center"/>
                        </ui:Button>
                        <!-- Convert to PDF Button (markdown only) -->
                        <ui:Button x:Name="MdToPdfBtn" Click="MarkdownToPdf_Click" Appearance="Secondary"
                                   Foreground="#F472B6" Padding="5,3" Margin="0,0,4,0" ToolTip="Export as PDF"
                                   Visibility="Collapsed" AutomationProperties.Name="Convert markdown to PDF">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentPdf24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- PDF Manage Pages Button -->
                        <ui:Button x:Name="PdfManageBtn" Click="PdfManage_Click" Appearance="Secondary" 
                                   Foreground="{DynamicResource GeminiAccentColor}" Padding="5,3" Margin="0,0,4,0" ToolTip="Manage Pages (Reorder / Add)"
                                   Visibility="Collapsed" AutomationProperties.Name="Manage PDF pages">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Layer24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Zoom Control -->
                        <StackPanel x:Name="ZoomPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="ZoomIn24" FontSize="14" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,4,0"/>
                            <Slider x:Name="ZoomSlider" Width="80" Minimum="0.5" Maximum="3" Value="1" 
                                    ValueChanged="ZoomSlider_ValueChanged" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- PDF Add Pages Button -->
                        <ui:Button x:Name="PdfAddBtn" Click="PdfAdd_Click" Appearance="Secondary" 
                                   Foreground="{DynamicResource SuccessColor}" Padding="5,3" Margin="0,0,4,0" ToolTip="Add Pages from PDF"
                                   Visibility="Collapsed" AutomationProperties.Name="Add PDF pages">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- PDF Save Button (Split) -->
                        <ui:Button x:Name="PdfSaveBtn" Click="PdfSave_Click" Appearance="Primary" 
                                   Foreground="White" Padding="5,3" Margin="0,0,4,0" ToolTip="Save Changes (Right click for more)"
                                   Visibility="Collapsed" AutomationProperties.Name="Save PDF changes">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" Filled="True" FontSize="14"/></ui:Button.Icon>
                            <ui:Button.ContextMenu>
                                <ContextMenu x:Name="PdfSaveMenu">
                                    <MenuItem Header="Overwrite Original" Click="PdfSaveOverwrite_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="SaveEdit24"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Save as Copy..." Click="PdfSaveAs_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="SaveCopy24"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <!-- Pin Button (toggle always on top) -->
                        <ui:Button x:Name="PinBtn" Click="PinButton_Click" Appearance="Secondary" 
                                   Foreground="{DynamicResource PinActiveColor}" Padding="5,3" Margin="0,0,4,0" ToolTip="Pin on top"
                                   AutomationProperties.Name="Pin window on top">
                            <ui:Button.Icon><ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                        <!-- Close -->
                        <ui:Button x:Name="CloseBtn" Click="CloseButton_Click" Appearance="Secondary" Foreground="{DynamicResource DangerColor}" Padding="5,3" ToolTip="Close" AutomationProperties.Name="Close preview">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" Filled="True" FontSize="14"/></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Background="#20000000">
                    <ProgressBar IsIndeterminate="True" x:Name="LoadingProgress" VerticalAlignment="Top" Height="3" Background="Transparent" Foreground="{DynamicResource ThemeAccentLight}" BorderThickness="0" Visibility="Collapsed" Panel.ZIndex="10" />
                    <!-- Image Mode Grid -->
                    <Grid x:Name="ImageModeGrid" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid x:Name="ImageContainerGrid">
                                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Canvas x:Name="OcrOverlayCanvas" Background="Transparent" ClipToBounds="True"/>
                                <!-- Doodle InkCanvas overlay (same size as image, hidden by default) -->
                                <InkCanvas x:Name="DoodleCanvas" Background="Transparent" Visibility="Collapsed"
                                           ClipToBounds="True" EditingMode="Ink"
                                           StrokeCollected="DoodleCanvas_StrokeCollected"
                                           StrokeErased="DoodleCanvas_StrokeErased"/>
                            </Grid>
                        </Viewbox>

                        <!-- Doodle Toolbar (floating at bottom, visible only in doodle mode) -->
                        <Border x:Name="DoodleToolbar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,10" Padding="8,5" CornerRadius="12"
                                Background="#E0181825" BorderBrush="#40A78BFA" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Color presets -->
                                <TextBlock Text="Color" Foreground="#8894A3B8" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border x:Name="DoodleColorWhite" Width="18" Height="18" CornerRadius="9" Background="#FFFFFF" Margin="0,0,3,0" Cursor="Hand"
                                        BorderThickness="2" BorderBrush="#60A78BFA" MouseLeftButtonDown="DoodleColorPick_Click" Tag="#FFFFFF"/>
                                <Border x:Name="DoodleColorRed" Width="18" Height="18" CornerRadius="9" Background="#EF4444" Margin="0,0,3,0" Cursor="Hand"
                                        BorderThickness="1" BorderBrush="Transparent" MouseLeftButtonDown="DoodleColorPick_Click" Tag="#EF4444"/>
                                <Border x:Name="DoodleColorYellow" Width="18" Height="18" CornerRadius="9" Background="#F59E0B" Margin="0,0,3,0" Cursor="Hand"
                                        BorderThickness="1" BorderBrush="Transparent" MouseLeftButtonDown="DoodleColorPick_Click" Tag="#F59E0B"/>
                                <Border x:Name="DoodleColorGreen" Width="18" Height="18" CornerRadius="9" Background="#10B981" Margin="0,0,3,0" Cursor="Hand"
                                        BorderThickness="1" BorderBrush="Transparent" MouseLeftButtonDown="DoodleColorPick_Click" Tag="#10B981"/>
                                <Border x:Name="DoodleColorBlue" Width="18" Height="18" CornerRadius="9" Background="#3B82F6" Margin="0,0,4,0" Cursor="Hand"
                                        BorderThickness="1" BorderBrush="Transparent" MouseLeftButtonDown="DoodleColorPick_Click" Tag="#3B82F6"/>

                                <!-- Color palette toggle -->
                                <Border x:Name="DoodlePaletteBtn" Width="20" Height="20" CornerRadius="12" Cursor="Hand"
                                        Margin="0,0,8,0" ToolTip="More colors"
                                        MouseLeftButtonDown="DoodlePalette_Click">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#EF4444" Offset="0"/>
                                            <GradientStop Color="#F59E0B" Offset="0.25"/>
                                            <GradientStop Color="#10B981" Offset="0.5"/>
                                            <GradientStop Color="#3B82F6" Offset="0.75"/>
                                            <GradientStop Color="#8B5CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Color palette popup -->
                                <Popup x:Name="DoodlePalettePopup" Placement="Top" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=DoodlePaletteBtn}" AllowsTransparency="True"
                                       VerticalOffset="-6" HorizontalOffset="-60">
                                    <Border CornerRadius="12" Padding="10" Background="#F0181825" BorderBrush="#40A78BFA" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Color Palette" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
                                            <UniformGrid x:Name="DoodlePaletteGrid" Columns="7"/>
                                            <Border Margin="0,6,0,0" CornerRadius="8" Padding="6,4" Cursor="Hand"
                                                    Background="#18A78BFA" BorderBrush="#30A78BFA" BorderThickness="1"
                                                    MouseLeftButtonDown="DoodleCustomColor_Click" ToolTip="Custom color picker">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Color24" Foreground="#A78BFA" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Custom Color..." Foreground="#A78BFA" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Separator -->
                                <Border Width="1" Height="18" Background="#30FFFFFF" Margin="0,0,8,0"/>

                                <!-- Brush size -->
                                <TextBlock Text="Size" Foreground="#8894A3B8" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="DoodleSizeSlider" Width="70" Minimum="2" Maximum="16" Value="3" VerticalAlignment="Center"
                                        ValueChanged="DoodleSizeChanged" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock x:Name="DoodleSizeLabel" Text="3" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" Margin="4,0,8,0" MinWidth="12"/>

                                <!-- Separator -->
                                <Border Width="1" Height="18" Background="#30FFFFFF" Margin="0,0,8,0"/>

                                <!-- Eraser toggle -->
                                <Border x:Name="DoodleEraserBtn" CornerRadius="8" Padding="6,3" Cursor="Hand"
                                        Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1"
                                        MouseLeftButtonDown="DoodleEraser_Click" ToolTip="Eraser (click strokes to erase)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="EraserTool24" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DoodleEraserLabel" Text="Eraser" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Clear all -->
                                <Border CornerRadius="8" Padding="6,3" Margin="4,0,0,0" Cursor="Hand"
                                        Background="#18EF4444" BorderBrush="#30EF4444" BorderThickness="1"
                                        MouseLeftButtonDown="DoodleClearAll_Click" ToolTip="Clear all strokes">
                                    <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- Dynamic Document Mode (PDF/HTML) -->
                    <wv2:WebView2 x:Name="WebPreview" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DefaultBackgroundColor="Transparent"/>
                    
                    <!-- PDF Editor Mode (Grid View) -->
                    <Grid x:Name="PdfEditorGrid" Visibility="Collapsed" Background="{DynamicResource ThemeWindowFallback}">
                        <ScrollViewer x:Name="PdfGridScroll" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="PdfThumbnailPanel" Margin="10" HorizontalAlignment="Center"/>
                        </ScrollViewer>
                    </Grid>
                    
                    <!-- Raw Text/Code/DOCX Extracted Frame -->
                    <ScrollViewer x:Name="TextPreviewScroll" Visibility="Collapsed" Background="{DynamicResource ThemeCodePreviewBg}">
                        <TextBlock x:Name="TextPreview" Foreground="{DynamicResource ThemeTextPrimary}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" />
                    </ScrollViewer>
                    
                    <!-- Markdown Rendered Preview (WebView2 for modern JS support) -->
                    <wv2:WebView2 x:Name="MarkdownWebView"
                        Visibility="Collapsed"
                        DefaultBackgroundColor="#1E1E2E" />
                    
                    <!-- Syntax-Highlighted Code Preview -->
                    <avalonEdit:TextEditor x:Name="CodePreview"
                        Visibility="Collapsed"
                        IsReadOnly="True"
                        ShowLineNumbers="True"
                        FontFamily="Cascadia Code, Cascadia Mono, Consolas, monospace"
                        FontSize="13"
                        Background="#1E1E2E"
                        Foreground="#CDD6F4"
                        Padding="12"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        Focusable="True" />

                    <!-- Document Mode (Fallback when all else fails) -->
                    <StackPanel x:Name="DocumentPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon x:Name="DocIcon" Symbol="Document24" FontSize="120" Foreground="{DynamicResource InfoColor}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DocTitle" Text="Document Name" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,15,0,5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                        <TextBlock x:Name="DocSize" Text="PDF Document - 2.4 MB" FontSize="13" Foreground="{DynamicResource ThemeTextMuted}" TextAlignment="Center"/>
                        <ui:Button Content="Open Native Tool" Appearance="Primary" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OpenFile_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Open24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    
                    <!-- QR Code Decoded Content Bar -->
                    <Border x:Name="QrContentBar" VerticalAlignment="Bottom" Height="40" Background="{DynamicResource ThemeOverlayBg}" BorderBrush="{DynamicResource ThemeOverlayBorder}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="QRCode24" Foreground="{DynamicResource InfoColor}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="0"/>
                            <TextBlock x:Name="QrContentText" Text="QR Code Text..." Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Grid.Column="1"/>
                            <ui:Button x:Name="CopyQrBtn" Click="CopyQrButton_Click" Content="Copy Text" Appearance="Secondary" Padding="8,3" FontSize="10.5" VerticalAlignment="Center" Grid.Column="2"/>
                        </Grid>
                    </Border>
                    
                    <!-- Instruction Overlay (fades out) -->
                    <TextBlock x:Name="HelperText" Text="Drag image to drop natively" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="12" IsHitTestVisible="False">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:3" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
