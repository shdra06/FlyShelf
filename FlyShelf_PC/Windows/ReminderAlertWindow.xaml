<Window x:Class="FlyShelf.Windows.ReminderAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" MaxWidth="400"
        Loaded="Window_Loaded" MouseDown="Window_MouseDown"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="20,12,20,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ MAIN CARD ═══ -->
        <Border x:Name="AlertBorder" Grid.Row="0" CornerRadius="18" Padding="0"
                MinWidth="350"
                Background="{DynamicResource ThemeOverflowBg}"
                BorderBrush="{DynamicResource ThemeOverflowBorder}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="{DynamicResource ThemeOverflowShadowColor}"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="AlertTranslate" Y="15"/>
            </Border.RenderTransform>

            <!-- Inner glow layer -->
            <Border CornerRadius="17" Padding="18,16,18,16" BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeOverlayBorder}">
                <StackPanel>

                    <!-- ═══ HEADER ═══ -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Animated bell badge -->
                        <Border Grid.Column="0" CornerRadius="12" Width="36" Height="36" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#D97706" Offset="0.5"/>
                                    <GradientStop Color="#B45309" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.4" Color="#F59E0B"/>
                            </Border.Effect>
                            <ui:SymbolIcon Symbol="Alert24" FontSize="16" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Upcoming Reminder" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock x:Name="TimeText" FontSize="11" Foreground="#F59E0B" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Dismiss X -->
                        <Border Grid.Column="2" CornerRadius="8" Width="28" Height="28" Cursor="Hand"
                                VerticalAlignment="Top" MouseLeftButtonDown="Close_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0AFFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="#666" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Subtle divider -->
                    <Border Height="1" Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#15FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ═══ TITLE ═══ -->
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <!-- ═══ NOTES ═══ -->
                    <TextBlock x:Name="NotesText" FontSize="12.5" LineHeight="18"
                               Foreground="#999" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="Collapsed" MaxHeight="48"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- ═══ META BADGES ═══ -->
                    <WrapPanel Margin="0,0,0,16">
                        <!-- Date badge -->
                        <Border CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#10FFFFFF" Offset="0"/>
                                    <GradientStop Color="#08FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DateText" FontSize="11" Foreground="#AAA"
                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Repeat badge -->
                        <Border x:Name="RepeatBadge" CornerRadius="8" Padding="8,4" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#18F59E0B" Offset="0"/>
                                    <GradientStop Color="#08F59E0B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="RepeatText" FontSize="11" Foreground="#FCD34D"/>
                        </Border>
                    </WrapPanel>

                    <!-- ═══ SNOOZE SECTION ═══ -->
                    <TextBlock Text="SNOOZE FOR" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,8"/>

                    <!-- Snooze pills row 1 -->
                    <WrapPanel Margin="0,0,0,6">
                        <Border CornerRadius="8" Padding="12,7" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="Snooze5_Click" Tag="5m">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0CFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="5 min" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Medium"/>
                        </Border>

                        <Border CornerRadius="8" Padding="12,7" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="Snooze15_Click" Tag="15m">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#15F59E0B"/>
                                    <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#25F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#50F59E0B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="15 min" FontSize="12" Foreground="#FDE68A" FontWeight="SemiBold"/>
                        </Border>

                        <Border CornerRadius="8" Padding="12,7" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="Snooze30_Click" Tag="30m">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0CFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="30 min" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Medium"/>
                        </Border>

                        <Border CornerRadius="8" Padding="12,7" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="Snooze60_Click" Tag="1h">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0CFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="1 hour" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Medium"/>
                        </Border>

                        <Border CornerRadius="8" Padding="12,7" Margin="0,0,6,6" Cursor="Hand"
                                MouseLeftButtonDown="Snooze180_Click" Tag="3h">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0CFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="3 hours" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Medium"/>
                        </Border>

                        <Border CornerRadius="8" Padding="12,7" Margin="0,0,0,6" Cursor="Hand"
                                MouseLeftButtonDown="SnoozeTomorrow_Click" Tag="tmrw">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0CFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌅" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Tomorrow" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- ═══ DONE BUTTON (full width, prominent) ═══ -->
                    <Border CornerRadius="12" Padding="0,11" Margin="0,6,0,0" Cursor="Hand"
                            MouseLeftButtonDown="Done_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#16A34A" Offset="0"/>
                                            <GradientStop Color="#22C55E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#15803D" Offset="0"/>
                                                    <GradientStop Color="#16A34A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15"
                                           Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Mark as Done" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Border>

        <!-- ═══ ARROW TAIL ═══ -->
        <Path x:Name="ArrowTail" Grid.Row="1" HorizontalAlignment="Center" Margin="0,-1,0,0"
              Fill="{DynamicResource ThemeOverflowBg}" Stroke="{DynamicResource ThemeOverlayBorder}" StrokeThickness="1">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,0" IsClosed="True">
                        <LineSegment Point="14,14"/>
                        <LineSegment Point="28,0"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Grid>
</Window>
