<Window x:Class="FlyShelf.Windows.ReminderAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" MaxWidth="400"
        Loaded="Window_Loaded" MouseDown="Window_MouseDown">

    <Grid Margin="20,12,20,12">
        <Border x:Name="AlertBorder" CornerRadius="16" Padding="0"
                Background="{DynamicResource ThemeOverflowBg}"
                BorderBrush="{DynamicResource ThemeOverflowBorder}"
                BorderThickness="1" MinWidth="320">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5"
                                  Color="{DynamicResource ThemeOverflowShadowColor}"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="AlertTranslate" Y="15"/>
            </Border.RenderTransform>

            <!-- Inner glow border -->
            <Border CornerRadius="15" Padding="16" BorderThickness="1" BorderBrush="#0AFFFFFF">
                <StackPanel>
                    <!-- ═══ Header Row ═══ -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Alert24" FontSize="20" Foreground="#F59E0B"
                                       VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Reminder" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextSecondary}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" x:Name="TimeText" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ═══ Title ═══ -->
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextPrimary}"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <!-- ═══ Notes ═══ -->
                    <TextBlock x:Name="NotesText" FontSize="13"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="Collapsed" MaxHeight="60"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- ═══ Date Line ═══ -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="📅" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DateText" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RepeatText" FontSize="11"
                                   Foreground="#F59E0B" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- ═══ Separator ═══ -->
                    <Border Height="1" Background="{DynamicResource ThemeSeparator}" Margin="0,0,0,12"/>

                    <!-- ═══ Button Row ═══ -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Snooze Button -->
                        <ui:Button x:Name="SnoozeBtn" Click="Snooze_Click"
                                   Appearance="Secondary" Cursor="Hand"
                                   Padding="10,6" MinWidth="110"
                                   ToolTip="Click to snooze 15 minutes, or expand for more options">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="AlertSnooze24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Snooze (15m)" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" FontSize="10" Margin="6,0,0,0" Opacity="0.6"
                                           VerticalAlignment="Center" Cursor="Hand"
                                           MouseLeftButtonDown="SnoozeDropdown_Click"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Snooze Presets Popup -->
                        <Popup x:Name="SnoozePopup" PlacementTarget="{Binding ElementName=SnoozeBtn}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade" VerticalOffset="-4">
                            <Border CornerRadius="12" Padding="4"
                                    Background="{DynamicResource ThemeOverflowBg}"
                                    BorderBrush="{DynamicResource ThemeOverflowBorder}"
                                    BorderThickness="1" MinWidth="160">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4"
                                                      Color="{DynamicResource ThemeOverflowShadowColor}"/>
                                </Border.Effect>
                                <Border CornerRadius="11" BorderThickness="1" BorderBrush="#08FFFFFF" Padding="2">
                                    <StackPanel>
                                        <Border CornerRadius="8" Padding="10,7" Cursor="Hand"
                                                Background="Transparent" MouseLeftButtonDown="Snooze5_Click"
                                                MouseEnter="SnoozeOption_MouseEnter" MouseLeave="SnoozeOption_MouseLeave">
                                            <TextBlock Text="⏰  5 minutes" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Border>
                                        <Border CornerRadius="8" Padding="10,7" Cursor="Hand"
                                                Background="Transparent" MouseLeftButtonDown="Snooze15_Click"
                                                MouseEnter="SnoozeOption_MouseEnter" MouseLeave="SnoozeOption_MouseLeave">
                                            <TextBlock Text="⏰  15 minutes" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Border>
                                        <Border CornerRadius="8" Padding="10,7" Cursor="Hand"
                                                Background="Transparent" MouseLeftButtonDown="Snooze30_Click"
                                                MouseEnter="SnoozeOption_MouseEnter" MouseLeave="SnoozeOption_MouseLeave">
                                            <TextBlock Text="⏰  30 minutes" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Border>
                                        <Border CornerRadius="8" Padding="10,7" Cursor="Hand"
                                                Background="Transparent" MouseLeftButtonDown="Snooze60_Click"
                                                MouseEnter="SnoozeOption_MouseEnter" MouseLeave="SnoozeOption_MouseLeave">
                                            <TextBlock Text="⏰  1 hour" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Border>
                                        <Border CornerRadius="8" Padding="10,7" Cursor="Hand"
                                                Background="Transparent" MouseLeftButtonDown="Snooze180_Click"
                                                MouseEnter="SnoozeOption_MouseEnter" MouseLeave="SnoozeOption_MouseLeave">
                                            <TextBlock Text="⏰  3 hours" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Border>
                                        <Border Height="1" Background="{DynamicResource ThemeSeparator}" Margin="6,2"/>
                                        <Border CornerRadius="8" Padding="10,7" Cursor="Hand"
                                                Background="Transparent" MouseLeftButtonDown="SnoozeTomorrow_Click"
                                                MouseEnter="SnoozeOption_MouseEnter" MouseLeave="SnoozeOption_MouseLeave">
                                            <TextBlock Text="🌅  Tomorrow 9 AM" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Popup>

                        <!-- Done Button -->
                        <ui:Button x:Name="DoneBtn" Click="Done_Click"
                                   Appearance="Secondary" Cursor="Hand"
                                   Padding="10,6" Margin="8,0,0,0" MinWidth="80">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14"
                                               Foreground="#22C55E" Margin="0,0,6,0"/>
                                <TextBlock Text="Done" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
