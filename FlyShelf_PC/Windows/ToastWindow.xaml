<Window x:Class="AdvanceClip.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Notification" Height="Auto" Width="Auto"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" Loaded="Window_Loaded">
    
    <Grid Margin="16,8,16,8">
        <Border x:Name="ToastBorder" CornerRadius="24" Padding="0"
                BorderThickness="1" BorderBrush="#18FFFFFF"
                Background="#E8101018" MinWidth="220" MaxWidth="460">
            <Border.Effect>
                <DropShadowEffect x:Name="ToastShadow" BlurRadius="16" Opacity="0.30" ShadowDepth="2" Direction="270" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="12"/>
            </Border.RenderTransform>
            
            <Grid>
                <!-- Subtle inner glow border for depth -->
                <Border CornerRadius="24" BorderThickness="1" BorderBrush="#08FFFFFF" Margin="0"/>
                
                <!-- Left accent glow — subtle gradient pill edge -->
                <Border x:Name="AccentGlow" CornerRadius="24" HorizontalAlignment="Left" Width="3" Margin="0,6,0,6"
                        Opacity="0.85">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="AccentGlowStart" Color="#818CF8" Offset="0"/>
                            <GradientStop x:Name="AccentGlowEnd" Color="#6366F1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                
                <!-- Content -->
                <StackPanel Orientation="Horizontal" Margin="16,8,20,8" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="ToastIcon" Symbol="CheckmarkCircle24" Foreground="#818CF8" FontSize="16" 
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MessageText" Text="" FontSize="12.5" FontWeight="Medium" 
                               Foreground="#E8E8EE" VerticalAlignment="Center" TextWrapping="NoWrap" 
                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
