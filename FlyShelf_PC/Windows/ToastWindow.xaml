<Window x:Class="FlyShelf.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Notification" Height="Auto" Width="Auto"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" Loaded="Window_Loaded"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    
    <Grid Margin="16,8,16,8">
        <Border x:Name="ToastBorder" CornerRadius="24" Padding="0"
                BorderThickness="1" BorderBrush="{DynamicResource ThemeToastBorder}"
                Background="{DynamicResource ThemeToastBg}" MinWidth="220" MaxWidth="460">
            <Border.Effect>
                <DropShadowEffect x:Name="ToastShadow" BlurRadius="16" Opacity="0.30" ShadowDepth="2" Direction="270" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ToastScale" ScaleX="0.97" ScaleY="0.97"/>
                    <TranslateTransform x:Name="ToastTranslate" Y="12"/>
                </TransformGroup>
            </Border.RenderTransform>
            
            <Grid>
                <!-- Subtle inner glow border for depth -->
                <Border CornerRadius="24" BorderThickness="1" BorderBrush="{DynamicResource ThemeToastInnerGlow}" Margin="0"/>
                

                
                <!-- Content -->
                <StackPanel Orientation="Horizontal" Margin="16,8,20,8" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="ToastIcon" Symbol="CheckmarkCircle24" Foreground="{DynamicResource ThemeAccentLight}" FontSize="16" 
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MessageText" Text="" FontSize="12.5" FontWeight="Medium" 
                               Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" TextWrapping="NoWrap" 
                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
