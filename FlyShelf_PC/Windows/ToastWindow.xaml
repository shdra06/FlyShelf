<Window x:Class="AdvanceClip.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Notification" Height="78" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" Loaded="Window_Loaded">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CornerRadius="16" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid Margin="12">
        <Border x:Name="ToastBorder" BorderThickness="1" CornerRadius="16" Padding="0" Background="#F015151F" BorderBrush="#1AFFFFFF">
            <Border.Effect>
                <DropShadowEffect x:Name="ToastShadow" BlurRadius="24" Opacity="0.45" ShadowDepth="4" Direction="270" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="20"/>
            </Border.RenderTransform>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- Left accent strip -->
                <Border x:Name="AccentStrip" Grid.Column="0" Width="4.5" CornerRadius="16,0,0,16" Background="#818CF8" />
                
                <!-- Content Area -->
                <Border Grid.Column="1" Padding="18,12,20,12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" MinWidth="260" MaxWidth="500">
                        <ui:SymbolIcon x:Name="ToastIcon" Symbol="CheckmarkCircle24" Foreground="#818CF8" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MessageText" Text="Notification message goes here..." FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
