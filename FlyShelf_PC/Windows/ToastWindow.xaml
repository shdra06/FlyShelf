<Window x:Class="FlyShelf.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Notification" Height="Auto" Width="Auto"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" Loaded="Window_Loaded"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    
    <Grid Margin="16,8,16,8">
        <Border x:Name="ToastBorder" CornerRadius="12" Padding="0"
                BorderThickness="1" BorderBrush="{DynamicResource ThemeToastBorder}"
                Background="{DynamicResource ThemeToastBg}" MinWidth="200" MaxWidth="380">
            <Border.Effect>
                <DropShadowEffect x:Name="ToastShadow" BlurRadius="20" Opacity="0.25" ShadowDepth="4" Direction="270" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ToastScale" ScaleX="0.97" ScaleY="0.97"/>
                    <TranslateTransform x:Name="ToastTranslate" Y="12"/>
                </TransformGroup>
            </Border.RenderTransform>
            
            <Grid>
                <!-- Subtle inner glow border for depth -->
                <Border CornerRadius="12" BorderThickness="1,1,1,0" 
                        BorderBrush="{DynamicResource ThemeToastInnerGlow}" Margin="0"/>
                
                <Grid>
                    <!-- ═══ STANDARD TOAST LAYOUT ═══ -->
                    <Grid x:Name="StandardLayout" Margin="14,10,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Accent dot indicator (replaces large icon for subtlety) -->
                        <Border x:Name="AccentDot" Grid.Column="0" 
                                Width="3" CornerRadius="2"
                                VerticalAlignment="Stretch" Margin="0,1,12,1"
                                Background="{DynamicResource ThemeAccentLight}"/>
                        
                        <TextBlock x:Name="MessageText" Grid.Column="1" Text="" 
                                   FontSize="12.5" FontWeight="Medium" 
                                   Foreground="{DynamicResource ThemeTextPrimary}" 
                                   VerticalAlignment="Center" TextWrapping="NoWrap" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </Grid>
                    
                    <!-- ═══ PROGRESS TOAST LAYOUT (compact, sleek) ═══ -->
                    <Grid x:Name="ProgressLayout" Visibility="Collapsed" Margin="12,8,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Accent dot -->
                        <Border x:Name="ProgressAccentDot" Grid.Column="0" Grid.RowSpan="2"
                                Width="3" CornerRadius="2"
                                VerticalAlignment="Stretch" Margin="0,1,12,1"
                                Background="{DynamicResource ThemeAccentLight}"/>
                        
                        <!-- Title row -->
                        <TextBlock x:Name="ProgressTitle" Grid.Column="1" Grid.Row="0"
                                   Text="Converting to PDF" 
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimary}" 
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        
                        <!-- Percentage -->
                        <TextBlock x:Name="ProgressPercent" Grid.Column="2" Grid.Row="0"
                                   Text="0%" 
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontFamily="Consolas"/>
                        
                        <!-- Progress bar -->
                        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" 
                              Margin="0,5,0,0" Height="2.5">
                            <!-- Track -->
                            <Border CornerRadius="1.5" 
                                    Background="{DynamicResource MicaWPF.Brushes.SubtleFillColorSecondary}"/>
                            <!-- Fill -->
                            <Border x:Name="ProgressFill" CornerRadius="1.5" 
                                    HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource ThemeAccentLight}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
