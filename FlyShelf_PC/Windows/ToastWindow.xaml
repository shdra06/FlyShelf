<Window x:Class="AdvanceClip.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Notification" Height="78" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" Loaded="Window_Loaded">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CornerRadius="16" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid Margin="12">
        <Border x:Name="ToastBorder" BorderThickness="1.5" CornerRadius="16" Padding="18,12" Background="#FA1A1A24">
            <Border.Effect>
                <DropShadowEffect x:Name="ToastShadow" BlurRadius="24" Opacity="0.45" ShadowDepth="4" Direction="270" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="20"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="260" MaxWidth="500">
                <ui:SymbolIcon x:Name="ToastIcon" Symbol="Checkmark24" Foreground="#10B981" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="MessageText" Text="Notification message goes here..." FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
