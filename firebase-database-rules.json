{
  "rules": {
    // ═══════════════════════════════════════════════════
    // FlyShelf Firebase Realtime Database Security Rules
    // ═══════════════════════════════════════════════════
    //
    // PRINCIPLE: All reads/writes require Firebase Auth.
    // Users can only access data under their pairing key.
    // No global read/write — everything is path-scoped.

    // DEFAULT: Deny all at root level
    ".read": false,
    ".write": false,

    // ─── CLIPBOARD DATA ───
    // Scoped per pairing key. Only authenticated users can read/write.
    "clipboard": {
      "$pairingKey": {
        ".read": "auth != null",
        ".write": "auth != null",
        // Individual entries
        "$entryId": {
          ".validate": "newData.hasChildren(['Title', 'Type'])",
          "downloadedBy": {
            "$deviceId": {
              ".validate": "newData.isNumber() || newData.isString()"
            }
          },
          "downloadStatus": {
            "$deviceId": {
              ".validate": "newData.hasChildren(['status'])"
            }
          }
        }
      }
    },

    // ─── ACTIVE DEVICES (Presence & URL Exchange) ───
    // Each device registers under its pairing key with URL, IP, etc.
    "active_devices": {
      "$pairingKey": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$deviceId": {
          ".validate": "newData.hasChildren(['DeviceName', 'IsOnline', 'Timestamp'])"
        }
      }
    },

    // ─── PAIRING CODES (Short-lived 6-char codes) ───
    // Used during device pairing flow. Written by initiator, read by joiner.
    "pairing_codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        // Auto-expire: clients should delete after use
        ".validate": "newData.hasChildren(['deviceId', 'deviceName', 'deviceType', 'pairingKey'])"
      }
    },

    // ─── PAIRING HANDSHAKE (Device discovery during pair) ───
    "pairing_handshake": {
      "$pairingKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    // ─── ROOM MEMBERS (Who's in a pairing group) ───
    "members": {
      "$pairingKey": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$uid": {
          ".validate": "newData.isBoolean()"
        }
      }
    },

    // ─── DEVICE GROUPS (Named groups of devices) ───
    "device_groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null"
      }
    },

    // ─── FORCED SYNC (Push notifications between devices) ───
    "forced_sync": {
      "$targetDeviceId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$entryKey": {
          ".validate": "newData.isString() || newData.hasChildren()"
        }
      }
    }
  }
}
