# ═══════════════════════════════════════════════════════════════
#  FlyShelf — Root .gitignore
#  Structure:
#    FlyShelf_PC/       ← Windows desktop app (C# / WPF)
#    FlyShelf_Android/  ← Android companion (React Native + Kotlin)
#    version.json       ← update manifest (COMMITTED)
# ═══════════════════════════════════════════════════════════════

# ─── Leftover old folders ─────────────────────────────────────
# AndroidCompanion/
# FlyShelf_PC/
# FlyShelf_Android/

# ─── .NET / C# Build Artifacts ────────────────────────────────
FlyShelf_PC/bin/
FlyShelf_PC/obj/
FlyShelf_PC/*.zip
FlyShelf_PC/*_wpftmp.csproj*
FlyShelf_PC/.vs/
FlyShelf_PC/**/*.user
FlyShelf_PC/**/*.suo
FlyShelf_PC/publish/
FlyShelf_PC/publish2/

# ─── Published / Release Binaries (uploaded to GitHub Releases) ─
FlyShelf_PC/FINAL/
FINAL/
release_build/
release_build_v4/
v4_release/
publish_out/
publish/
test/

# ─── Android Build Artifacts ──────────────────────────────────
FlyShelf_Android/node_modules/
FlyShelf_Android/.expo/
FlyShelf_Android/android/build/
FlyShelf_Android/android/app/build/
FlyShelf_Android/android/.gradle/
FlyShelf_Android/android/.idea/
FlyShelf_Android/.idea/
FlyShelf_Android/dist/

# ─── Android Sensitive / Local-only Files ─────────────────────
FlyShelf_Android/android/local.properties
FlyShelf_Android/android/app/debug.keystore

# ─── Python virtual env ───────────────────────────────────────
.venv/
__pycache__/
*.pyc

# ─── OS junk ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────────────────────
.vscode/settings.json
*.swp
*.bak

# ─── Logs & Temp ──────────────────────────────────────────────
*.log
*.tmp
*.temp

# ─── NuGet cache (auto-restored via dotnet restore) ───────────
FlyShelf_PC/.nuget/

# ─── Root-level binaries ──────────────────────────────────────
FlyShelf.exe
FlyShelf_Mobile.apk
FlyShelf.exe
FlyShelf_Mobile.apk

# ─── Debug screenshots & temp files ──────────────────────────
*.png
!FlyShelf_PC/Resources/**/*.png
!FlyShelf_Android/assets/**/*.png
!MicrosoftBuild/Assets/**/*.png

# ─── Firebase Security Credentials ────────────────────────────
FlyShelf_PC/Classes/FirebaseSecrets.cs

# ─── License Key Generator (contains HMAC secret — NEVER push) ─
FlyShelf_PC/Tools/

# ─── Website (Next.js) Build Artifacts ────────────────────────
flyshelf-web/node_modules/
flyshelf-web/.next/
flyshelf-web/out/

# ─── Payment Backend — Secrets & Build Artifacts ─────────────
FlyShelf_Payment/functions/.env
FlyShelf_Payment/functions/node_modules/

# ─── Microsoft Store Build Output ─────────────────────────────
MicrosoftBuild/Output/