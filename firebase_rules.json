{
  "rules": {
    "members": {
      "$pairingKey": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('members/' + $pairingKey + '/' + auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid"
        }
      },
      ".read": false,
      ".write": false
    },
    "clipboard": {
      "$pairingKey": {
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        ".write": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        "$entryId": {
          ".validate": "newData.hasChildren(['Type', 'Timestamp'])"
        }
      },
      ".read": false,
      ".write": false
    },
    "active_devices": {
      "$pairingKey": {
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        ".write": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()"
      },
      ".read": false,
      ".write": false
    },
    "pairing_codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['deviceId', 'pairingKey'])"
      },
      ".read": false,
      ".write": false
    },
    "pairing_handshake": {
      "$pairingKey": {
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        ".write": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()"
      },
      ".read": false,
      ".write": false
    },
    "forced_sync": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      ".read": false,
      ".write": false
    },
    "device_groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null"
      }
    },
    "global_clipboard": {
      ".read": false,
      ".write": false
    },
    "nodes": {
      "$pairingKey": {
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        ".write": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()"
      },
      ".read": false,
      ".write": false
    },
    ".read": false,
    ".write": false
  }
}
