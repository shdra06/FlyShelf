{
  "rules": {
    "members": {
      "$pairingKey": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('members/' + $pairingKey + '/' + auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid && (!data.parent().exists() || root.child('members/' + $pairingKey + '/' + auth.uid).exists() || root.child('pairing_handshake/' + $pairingKey + '/' + auth.uid).exists())"
        }
      },
      ".read": false,
      ".write": false
    },
    "clipboard": {
      ".read": false,
      ".write": false
    },
    "peer_transfers": {
      ".read": false,
      ".write": false
    },
    "active_devices": {
      "$pairingKey": {
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        ".write": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        "$deviceId": {
          ".validate": "newData.hasChildren(['DeviceId', 'DeviceType']) && newData.child('DeviceType').isString() && !newData.hasChild('Raw') && !newData.hasChild('FileContent')"
        }
      },
      ".read": false,
      ".write": false
    },
    "pairing_codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !data.child('uid').exists() || data.child('uid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['deviceId', 'uid'])",
        "response": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['deviceId', 'deviceName'])"
        }
      },
      ".read": false,
      ".write": false
    },
    "pairing_handshake": {
      "$pairingKey": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('members/' + $pairingKey + '/' + auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid"
        },
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        ".write": false
      },
      ".read": false,
      ".write": false
    },
    "forced_sync": {
      ".read": false,
      ".write": false
    },
    "device_groups": {
      "$pairingKey": {
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        "$groupId": {
          ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)"
        }
      },
      ".read": false,
      ".write": false
    },
    "global_clipboard": {
      ".read": false,
      ".write": false
    },
    "nodes": {
      "$pairingKey": {
        ".read": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()",
        ".write": "auth != null && root.child('members/' + $pairingKey + '/' + auth.uid).exists()"
      },
      ".read": false,
      ".write": false
    },
    "licenses": {
      "revoked": {
        "$keyId": {
          ".read": false,
          ".write": false
        }
      },
      "activations": {
        "$keyId": {
          ".read": false,
          "$deviceId": {
            ".write": false,
            ".validate": "newData.hasChildren(['deviceId', 'activatedAt', 'uid']) && newData.child('uid').val() === auth.uid"
          }
        }
      },
      "keys": {
        ".read": false,
        ".write": false
      },
      ".read": false,
      ".write": false
    },
    "payments": {
      ".indexOn": ["email"],
      ".read": false,
      ".write": false
    },
    "rate_limits": {
      ".read": false,
      ".write": false
    },
    ".read": false,
    ".write": false
  }
}

