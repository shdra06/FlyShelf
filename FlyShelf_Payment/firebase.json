{
  "functions": {
    "source": "functions",
    "runtime": "nodejs18"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/createOrder",
        "function": "createRazorpayOrder"
      },
      {
        "source": "/api/verifyPayment",
        "function": "verifyRazorpayPayment"
      }
    ]
  }
}
