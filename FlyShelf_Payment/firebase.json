{
  "functions": {
    "source": "functions",
    "runtime": "nodejs18"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/api/createOrder",
        "destination": "https://fly-shelf.vercel.app/api/createOrder",
        "type": 307
      },
      {
        "source": "/api/verifyPayment",
        "destination": "https://fly-shelf.vercel.app/api/verifyPayment",
        "type": 307
      },
      {
        "source": "/api/activate",
        "destination": "https://fly-shelf.vercel.app/api/activate",
        "type": 307
      },
      {
        "source": "/api/recoverKey",
        "destination": "https://fly-shelf.vercel.app/api/recoverKey",
        "type": 307
      },
      {
        "source": "/api/revalidate",
        "destination": "https://fly-shelf.vercel.app/api/revalidate",
        "type": 307
      }
    ]
  }
}
